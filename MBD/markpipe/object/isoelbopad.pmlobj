define object isoelbopad
	member .elboname is string
	member .name is string
	member .attapos is position

	member .pos is position
	member .ori  is orientation
	member .rinside is real
	member .routside is real
	member .axisangle is real
	member .radiusangle is real
	member .axisarc is arc

	member .nsAndSpref is array	$*instore ns and spref

	member .itemcode is string
endobject

define method .isoelbopad(!elboname is string,!name is string,!pos is position,!ori is orientation,!rinside is real,!routside is real,!axisangle is real,!radiusangle is real)
	!this.elboname = !elboname
	!this.name = !name
	!this.attapos = pos of $!this.name wrt/*
	!this.pos = !pos
	!this.ori = !ori
	!this.rinside = !rinside
	!this.routside = !routside
	!this.axisangle = !axisangle
	!this.radiusangle = !radiusangle

	!this.axisarc = object arc(!this.pos,!this.ori,0,!this.axisangle,!this.routside,true)

	!this.itemcode = :itemcode of $!name
endmethod




