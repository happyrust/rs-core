define object isopad
	member .name is string
	member .attapos is position

	member .pos is position
	member .ori  is orientation
	member .rinside is real
	member .routside is real
	member .angle is real
	member .height is real
	member .dir is direction

	member .nsAndSpref is array	$*instore ns and spref

	member .itemcode is string
endobject

define method .isopad(!name is string,!pos is position,!ori is orientation,!rinside is real,!routside is real,!angle is real,!height is real,!dir is direction)
	!this.name = !name
	!this.attapos = pos of $!this.name wrt/*
	!this.pos = !pos
	!this.ori = !ori
	!this.rinside = !rinside
	!this.routside = !routside
	!this.angle = !angle
	!this.height = !height
	!this.dir = !dir

	!this.itemcode = :itemcode of $!name
endmethod




