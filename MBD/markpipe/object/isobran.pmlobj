--sumMaterials(!atts is array) is array    $*atts must include 'quantity' and 'weight'  	$*get materials		for list2 in markpipeform
--getweldlist() is array													$*get weld for list2 in markpipeform
--getSpecialMaterials(!atts is array) is array  							$*get materials without summarizing		for list4 in markpipeform
--getcuttubi(!atts is array) is array   									$*get cut pipe length		for list5 in markpipeform
--getJsonData(!materialAttS is array, !materialAttShow is array, !BranAtts is array ,!branAttShow is array ,!cutpipelengthatts is array, !cutpipelengthattshow is array, !merge is boolean) is array	$*
-------------get json



--Private method:
--addDmfMemUsedDir(!mem is any , !dir is direction) 						$*add used dir of dmf mem
