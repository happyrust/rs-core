define function !!sumMaterials(!sumedMaterials is array, !sumedUniquecodes is array, !addmaterials is array) is array
--define function !!sumMaterials(!sumedMaterials is array, !sumedUniquecodes is array, !addmaterials is array, !setorder is boolean) is array
	!result = array()
	if !addmaterials.unset() then
		!result[1] = !sumedMaterials
		!result[2] = !sumedUniquecodes
		return !result
	endif


	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 1: sum tube with angle lick pad lug
	!angleIsomaterials = array()
	!angleuniquecodes = array()
	!angles = array()

	!tempmaterials = !addmaterials
	do !x indices !tempmaterials
		!isomaterial = !tempmaterials[!x]
		if !isomaterial.ns.match('бу') ne 0 then
			var !branname ref of bran of $!isomaterial.name
			!uniquecode = !isomaterial.uniquecode & !branname	$*only sum angle pad and lug in same branch
			!index = !angleuniquecodes.findfirst(!uniquecode)
			if !index.unset() then
				!isomaterial.ns = !isomaterial.ns.before(' x ')
				!angleIsomaterials.append(!isomaterial)
				!angleuniquecodes.append(!uniquecode)
				!angles.append(!isomaterial.materialangle)
			else
				if !angles[!index] + !isomaterial.materialangle gt 360 then
					!angleIsomaterials[!index].quantity = !angleIsomaterials[!index].quantity + !isomaterial.quantity
					!angleIsomaterials[!index].weight = !angleIsomaterials[!index].weight + !isomaterial.weight
					!angles[!index] = !isomaterial.materialangle
				else
					!angles[!index] = !angles[!index] + !isomaterial.materialangle
				endif
			endif
			!tempmaterials[!x].delete()
		endif
	enddo
	!tempmaterials.compress()
	!tempmaterials.appendarray(!angleIsomaterials)
	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 2:end

	!isomaterials = !sumedMaterials
	!uniquecodes = !sumedUniquecodes
	do !isomaterial values !tempmaterials
		!index = !uniquecodes.findfirst(!isomaterial.uniquecode)
		if !index.unset() then
			!isomaterials.append(!isomaterial)
			!uniquecodes.append(!isomaterial.uniquecode)
		else
			!isomaterials[!index].quantity = !isomaterials[!index].quantity + !isomaterial.quantity
			!isomaterials[!index].weight = !isomaterials[!index].weight + !isomaterial.weight
		endif
	enddo

	!isomaterials = !!classmaterial(!isomaterials)

	--$(
	--if !setorder then
		do !x indices !isomaterials
			!isomaterials[!x].order = !x
		enddo
	--endif
	--$)

	!result[1] = !isomaterials
	!result[2] = !uniquecodes
	return !result
endfunction
k