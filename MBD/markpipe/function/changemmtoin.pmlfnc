define function !!changemmtoin(!input is any) is string
	!mm = array()
	!in = array()
	!mm.append(6)
	!in.append('1/8')
	!mm.append(8)
	!in.append('1/4')
	--!mm.append(9)
	--!in.append('3/8')
	!mm.append(10)
	!in.append('3/8')
	!mm.append(14)			$* for BOLT
	!in.append('1/2')
	!mm.append(15)
	!in.append('1/2')
	!mm.append(16)			$* for BOLT
	!in.append('5/8')
	!mm.append(20)
	!in.append('3/4')
	!mm.append(24)			$* for BOLT
	!in.append('7/8')
	!mm.append(25)
	!in.append('1')
	!mm.append(27)			$* for BOLT
	!in.append('1')
	!mm.append(30)
	!in.append('1 1/8')
	!mm.append(32)
	!in.append('1 1/4')
	!mm.append(33)			$* for BOLT
	!in.append('1 1/4')
	!mm.append(36)			$* for BOLT
	!in.append('1 3/8')
	!mm.append(39)			$* for BOLT
	!in.append('1 1/2')
	!mm.append(40)
	!in.append('1 1/2')
	!mm.append(42)			$* for BOLT
	!in.append('1 5/8')
	!mm.append(50)
	!in.append('2')
	!mm.append(65)
	!in.append('2 1/2')
	!mm.append(80)
	!in.append('3')
	!mm.append(90)
	!in.append('3 1/2')
	!mm.append(100)
	!in.append('4')
	!mm.append(125)
	!in.append('5')
	!mm.append(150)
	!in.append('6')
	do !x from 1 to 100
		!bore = !mm.last() + 50
		!mm.append(!bore)
		!in.append(string(!bore / 25))
	enddo
	--q var !mm.last()

	if !input.objecttype() eq 'STRING' then
		!inputbore = !input.real()
	else
		!inputbore = !input
	endif
	--q var !inputbore
	!result = !in[!mm.findfirst(!inputbore)] + |"|
	handle any
		return |0"|
	endhandle
	return !result
endfunction
