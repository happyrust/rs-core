define function !!compareqa(!tubeqa is array, !tempqa is array) is real
	!matchnum = !tubeqa[2].size()
	do !x indices !tubeqa[2]
		if !tubeqa[2][!x] ne !tempqa[2][!x] then
			!matchnum = !x
			break
		endif
	enddo
	return !matchnum
endfunction
