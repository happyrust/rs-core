			Button .Addlist '添加List' anchor l + b tooltip |Add 列表|  width 5  callback '!this.Addlist()'
			Button .Remitem '移除CE'  anchor l + b  tooltip |Remove select|  width 5  callback '!this.RemoveCE()'
