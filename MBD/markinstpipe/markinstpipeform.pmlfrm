			combobox .considerprenextdir '空间布局参考前后段的标注方位' tooltip '会刷新空间占位数据' tagwidth $!comboboxlen call|!this.instoreset(true)| width 4
			!this.considerprenextdir.dtext = split('true false')
			!this.considerprenextdir.select('dtext','true')
			!this.instoreStrings.append('considerprenextdir')

			combobox .lookangle '习惯俯视角度' tooltip '习惯性观察的角度与水平面夹角 会刷新空间占位数据' tagwidth $!comboboxlen call|!this.instoreset(true)| width 4
			!this.lookangle.dtext = split('0 15 30 45 60 90')
			!this.lookangle.select('dtext','0')
