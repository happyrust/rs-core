		return
	endif

	if !onlyselection then
		!vals = !this.list.val
		if !vals.unset() then
			if !this.list.dtext.size() eq 1 then
				!vals[1] = 1
			else
				return
			endif
		endif
	else
		!vals = !this.list.dtext.indices()
		if !vals.unset() then
			return
		endif
	endif


	--$(
	--!merge = !this.jsonmerge.displaytext().boolean()
	do !val values !vals
		!filename = !this.brandatas[!val].branName.replace('=','_').replace('/','_').replace('\','_')
		--!result = !this.brandatas[!val].getjsondata(!this.materialAttS, !this.materialAttShow, !this.BranAtts ,!this.branAttShow , !this.cutpipelengthatts, !this.cutpipelengthattshow)
		!result = !this.brandatas[!val].getjsondata(!this.materialAttS, !this.materialAttShow,!this.elematerialAttS, !this.elematerialAttShow, !this.BranAtts ,!this.branAttShow , !this.cutpipelengthatts, !this.cutpipelengthattshow)
		--!result = !this.brandatas[!val].getjsondata(!this.materialAttS, !this.materialAttShow, !this.BranAtts ,!this.branAttShow , !this.cutpipelengthatts, !this.cutpipelengthattshow, !merge)
		--if !merge then
			!this.instore(!result,!filename,!path)
		--else
		--	!strings = split('DimAidLabel Materials specialMaterials BranAtt WeldText CutPipeLength')
		--	do !x indices !result
		--		!this.instore(!result[!x],!filename + '_' + !strings[!x],!path)
		--	enddo
		--endif
	enddo

	!folder = object file(!path)
	Syscom 'start $!folder &'
	--$)

	$(
	!items = array()
	do !val values !vals
		!items.append(!this.brandatas[!val].branname)
	enddo
	!emptyarr = array()
	!names = !!getjson(!items,!emptyarr,!path & '\json')

	!folder = object file(!path)
	Syscom 'start $!folder &'
	$)
endmethod

define method .toTplant()		$* for test
	if !this.checkfilepath().not() then
		return
	endif
	!filepath = !this.filepath.displaytext().trim()
	do !bran values !this.brandatas
		!bran.generatejson = true
		!bran.filepath = !filepath
		!bran.totplant()
	enddo
	!folder = object file(!filepath)
	Syscom 'start $!folder &'
	return


	!vals = !this.list.dtext.indices()
	if !vals.unset() then
		return
	endif

	!items = array()
	do !val values !vals
		!items.append(!this.brandatas[!val].branName)
	enddo
	!a = !!jsontotplant(!items,'','','','','','','em9pipe')
endmethod

define method .instore(!result is array,!filename is string,!path is string)
	--!result.insert(1,|{|)
	--!result.insert(2,|  "list": [|)
	--!result.append(|  ]|)
	--!result.append(|}|)

	--!dt = object datetime()
	--!name = !dt.year() & !dt.month() & !dt.date() & !dt.hour() & !dt.minute() & !dt.second()
	--!name = 'Tplant-'
	--if !path.matchwild('*\').not() or !path.matchwild('*/').not() then
	--	!path = !path + '\'
	--endif
	--!file = object file(!path + !filename + '.json')

	!goodpath = !path
	if !goodpath.matchwild('*\').not() or !goodpath.matchwild('*/').not() then
		!goodpath = !goodpath + '\'
	endif
	!file = object file(!goodpath + !filename + '.json')
	!file.writefile('overwrite',!result)
endmethod

define method .getJsonIndex() is real
	!vals = !this.list.val
	!val = !vals[1]
	handle any
		if !this.list.dtext.set() then
			!val = 1
		else
			--$p Choose One bran
			return 0
		endif
	endhandle
	return !val
endmethod

