	member .charDirs is array
	!this.chardirs[1] = u
	!this.chardirs[2] = s
	!this.chardirs[3] = e
	$)

	member .maxslope is real
	member .minslope is real
	!this.maxslope = 0.1
	!this.minslope = 0.001

	member .firstDimTimes is real
	!this.firstdimtimes = 0.5
	member .secondDimTimes is real
	!this.seconddimtimes = 1.7

	member .brandatas is array

	--member .useGooddirs is boolean

	member .BranAtts is array
	member .BranAttShow is array

	member .MaterialAtts is array
	member .MaterialAttShow is array

	member .EleMaterialAtts is array
	member .EleMaterialAttShow is array

	member .cutpipelengthatts is array
	member .cutpipelengthattshow is array
exit



define method .markinstpipeform()
	!!updatembdfiles()
	!!setmbdfmt()
	!!setmbdformtitle(!this)
	handle any
		q var !!error
	endhandle
	if !!checkmbdproject().not() then
		--!formname = !this.fullname()
		--hide $!formname
		!this.AddItem.active = false
		!this.remItem.active = false
		!this.clearlist.active = false
		!this.drawAll.active = false
		!!alert.warning('此项目尚不能使用MBD')
	endif
	!this.cancelcall = '!this.hideform()'
	--!this.functionlist.setheadings('Function')
	--!this.useGoodDirs = true
	--!this.useGoodDirs = false
	$(
	!Materialattarr = split('order/序号,desc/材料描述,ns/类型,quantity/数量,itemcode/Item code,weight/重量,rev/版本',',')
	!BranAttarr = split('Duty/系统,Pspec/管道等级,RCCM/RCCM,CLEAN/清洁度,TEMP/温度,ISPEC/保温,POWERCAL/力学计算,DRAW/图号',',')
	!cutpipelengtharr = split('tubinum/PIECE NO,quantity/CUT LENGTH,ns/DN,remark/REMARK',',')

	!this.materialAtts = array()
	!this.materialAttShow = array()
	do !string values !materialattarr
		!this.materialAtts.append(!string.part(1,'/'))
		!this.materialAttShow.append(!string.part(2,'/'))
	enddo

	!this.branAtts = array()
	!this.branAttShow = array()
	do !string values !branattarr
		!this.branAtts.append(!string.part(1,'/'))
		!this.branAttShow.append(!string.part(2,'/'))
	enddo

	!this.cutpipelengthAtts = array()
	!this.cutpipelengthAttShow = array()
	do !string values !cutpipelengtharr
		!this.cutpipelengthAtts.append(!string.part(1,'/'))
		!this.cutpipelengthattShow.append(!string.part(2,'/'))
	enddo
	$)
	------set MaterialAtts MaterialAttShow suppAtts suppAttShow cutpipelengthAtts cutpipelengthAttShow
	!result = !!getattlist('instbran')

	do !x indices !result[1]
		!com = '!this.' + !result[2][!x] + ' = !result[1][!x]'
        --q var !result[1][!x]
        --q var !com
		$!com
	enddo

	!this.recoversetting()
endmethod


define method .hideform()
	!this.recoversetting()
	HIDE !!markinstpipeform
endmethod

define method .getjsonarray() is array
	!result = !this.brandatas[1].getjsonarray()
	handle any
		!result = array()
	endhandle
	return !result
endmethod

define method .instoreset(!refresh is boolean)
	--HIDE !!markinstpipeform
	--SHOW !!markinstpipeform
	!this.settotplant()

	!result = array()
	--!strings = split('cheightbili jsonmerge')
	--!strings = split('cheightbili autocheight sepSmallDim ignoreline considerprenextdir lookangle enhancered colcombobox autocheightbili plusstringcheightbili')
	!strings = !this.instoreStrings
	do !string values !strings
		!com = '!this.' + !string + '.refresh()'
		$!com

		!com = '!dtext = !this.' + !string + '.dtext'
		$!com
		handle any
			!com = '!val = !this.' + !string + '.val.string()'
		elsehandle none
			!com = '!val = !this.' + !string + '.displaytext()'
		endhandle

		--if !string eq 'enhancered' then
		--	!com = '!val = !this.' + !string + '.val.string()'
		--else
		--	!com = '!val = !this.' + !string + '.displaytext()'
		--endif
		$!com
		!line = !string & ':' & !val
		!result.append(!line)
	enddo
	!path = !!pml.getpathname(!this.name().lowcase() + '.pmlfrm').before(!this.name().lowcase() + '.pmlfrm') + 'setting\markinstpipeformSetting.txt'
	--!path = !!pml.getpathname('markinstpipeform.pmlfrm').before('markinstpipeform.pmlfrm') + 'markinstpipeformSetting.txt'
	!file = object file(!path)
	!file.writefile('overwrite',!result)


	!this.refreshdata(!refresh)
	--!this.mark('ALL')
	!this.red()
endmethod

define method .refreshdata(!refresh is boolean)
	if !refresh.not() then
		return
	endif
	!brannames = array()
	do !x indices !this.brandatas
		!brannames.append(!this.brandatas[!x].branname)
	enddo

	!this.clearList()
	do !branname values !brannames
		$!branname
		!this.addonece()
	enddo
endmethod

define method .recoversetting()
	!path = !!pml.getpathname(!this.name().lowcase() + '.pmlfrm').before(!this.name().lowcase() + '.pmlfrm') + 'setting\markinstpipeformSetting.txt'
	--!path = !!pml.getpathname('markinstpipeform.pmlfrm').before('markinstpipeform.pmlfrm') + 'markinstpipeformSetting.txt'
	!file = object file(!path)
	!lines = !file.readfile()
	handle any
		return
	elsehandle none
	--q var !lines
		do !line values !lines
			!name = !line.before(':')
			!val = !line.after(':')

			!com = '!dtext = !this.' + !name + '.dtext'
			$!com
			handle any
			--if !name eq 'enhancered' or !name eq 'filepath' then
				!com = '!this.' + !name + '.val = ' & !val
			elsehandle none
				!com = '!this.' + !name + '.select(|dtext|,|' + !val + '|)'
			endhandle
			--q var !com
			$!com
			handle any
				!com = '!this.' + !name + '.val = |' &!val & '|'
				$!com
				handle any
				endhandle
			endhandle
		enddo
	endhandle
	!this.settotplant()
endmethod

define method .settotplant()
	return
	if !this.generatejson.selection('dtext').boolean() then
		!this.ToTplant.active = true
	else
		!this.ToTplant.active = false
	endif
endmethod


define method .inputpath()
    !string = !this.filepath.val.trim()
	if !string eq '' then
		!this.filepath.val = 'D:\'
        golabel /end
	endif
    !folder = object file(!string)
    if !folder.exists().not() then
        !ans = !!alert.confirm('路径不存在,是否新建？')
        if !ans ne 'YES' then
            !this.filepath.val = 'D:\'
            golabel /end
        else
            syscom |mkdir $!folder|
        endif
    endif
    if !string.substring(-1,1) ne '/' and !string.substring(-1,1) ne '\' then
        !string = !string + '\'
    endif
    !this.filepath.val = !string

    label /end
    !this.instoreset(false)
endmethod

define method .selectbran()
	!bran = !this.list.selection()
	!BA = !bran[1].PART(1,'	')
	$!BA
	add ce auto ce
	handle any
	endhandle
	!this.setOtherList()
endmethod

define method .setOtherList()
	!val = !this.getJsonIndex()
	if !val eq 0 then
		return
	endif
	!this.setlist2(!val)
	!this.setlist3(!val)
	!this.setlist4(!val)
	!this.setlist5(!val)
	!this.setlist6(!val)
	!this.setlist7(!val)
endmethod


define method .setred()
	!this.instoreset(false)
	!this.red()
endmethod
define method .red()
	!vals = !this.list.val
	if !vals.unset() then
		!vals = !this.list.dtext.indices()
	endif

	!col = !this.colcombobox.displaytext()
	do !val values !vals
		!mbdstru = !this.brandatas[!val].mbdstru.mbdstru
		-----------------------
		-----------------------sometimes only part of mbdstru are enhanced when unenhance are not used
		unenhance $!mbdstru
		handle any
		elsehandle none
			if !this.enhancered.val then
				--enhance $!mbdstru col red
				--enhance $!mbdstru col blue
				enhance $!mbdstru col $!col
			endif
		endhandle
	enddo
endmethod

define method .setlist2(!val is real)
	!this.list2.setheadings(!this.materialAttShow)
	!rows = !this.brandatas[!val].sumMaterials(!this.materialAttS)

	!newrows = array()
	do !x indices !rows
		do !y indices !rows[!x]
			!newrows[!x][!y] = !rows[!x][!y].string()					$* to string
		enddo
	enddo
	!this.list2.setrows(!newrows)
endmethod

define method .setlist3(!val is real)
	!maxnum = 16
	!arrs = !this.brandatas[!val].getweldlist()
	!rows = array()
	do !arr values !arrs
		!temparr = array()
		do !x indices !arr
			!temparr.append(!arr[!x])
			if !x / !maxnum eq int(!x / !maxnum) then
				!rows.append(!temparr)
				!temparr = array()
			elseif !x eq !arr.size() then
				!rows.append(!temparr)
			endif
		enddo
	enddo

	do !x indices !rows
		do !y from 1 to !maxnum - !rows[!x].size()
			!rows[!x].append('')
		enddo
	enddo

	!this.list3.setrows(!rows)
endmethod

define method .setlist4(!val is real)
	--!this.list4.setheadings(!this.materialAttShow)
	--!rows = !this.brandatas[!val].getspecialMaterials(!this.materialAttS)
	!this.list4.setheadings(!this.elematerialAttShow)
	!rows = !this.brandatas[!val].getspecialMaterials(!this.elematerialAttS)
	!newrows = array()
	do !x indices !rows
		do !y indices !rows[!x]
			!newrows[!x][!y] = !rows[!x][!y].string()					$* to string
		enddo
	enddo
	!this.list4.setrows(!newrows)
endmethod
define method .selectmaterial()
	!vals = !this.list4.val
	if !vals.set() then
		!branindex = !this.getJsonIndex()
		!materials = !this.brandatas[!branindex].materials
		!specialnums = array()
		!mems = array()
		do !x indices !materials
			!specialnums.append(!materials[!x].specialnum)
			!mems.append(!materials[!x].name)
		enddo
		!dtext = !this.list4.dtext
		!items = array()
		do !val values !vals
			!row = !dtext[!val]
			!specialnum = !row.split('	')[1]
			!index = !specialnums.findfirst(!specialnum)
			!items.append(!mems[!index])
		enddo
		--unenhance all
		--do !item values !items
		--	enhance $!item col red
		--enddo

		$!items[1]
	endif
endmethod
define method .setlist5(!val is real)
	!this.list5.setheadings(!this.cutpipelengthattshow)
	!rows = !this.brandatas[!val].getcuttubi(!this.cutpipelengthatts)
	!newrows = array()
	do !x indices !rows
		do !y indices !rows[!x]
			if !y eq 1 then
				!newrows[!x][!y] = '<' + !rows[!x][!y].string() + '>'					$* to string
			else
				!newrows[!x][!y] = !rows[!x][!y].string()					$* to string
			endif
		enddo
	enddo
	!this.list5.setrows(!newrows)
endmethod
define method .setlist6(!val is real)
	!object = !this.brandatas[!val]
	!tempfile = object file(!!commonpath() + 'functionsetdrawinfo.txt')
	!lines = !tempfile.readfile()
	do !line values !lines
		if !line.trim().trim('	') ne '' then
			$!line
		endif
	enddo
endmethod

define method .setlist7(!val is real)
	!object = !this.brandatas[!val]
	!tempfile = object file(!!commonpath() + 'functionsetproofreading.txt')
	!lines = !tempfile.readfile()
	do !line values !lines
		if !line.trim().trim('	') ne '' then
			$!line
		endif
	enddo
endmethod
