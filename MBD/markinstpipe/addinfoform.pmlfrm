kill !!addinfoform
setup form !!addinfoform RESIZE
	title '添加连接信息'
    text .info '连接信息' tagwidth 8  callback|!this.infotext()| width 30 scroll 100  is string
    toggle .head '头部' at xmin.info + 0.5 ymax.info + 0.5 anchor l + b tagwidth 4 callback|!this.selectPointA()|
    toggle .tail '尾部' at xmax.head + 0.5 ymax.info + 0.5 anchor l + b tagwidth 4 callback|!this.selectPointB()|
	Button .pick '捕捉' AT x 1  ymax + 0.5  anchor l + b tooltip |pick CE|  width 5  callback '!this.pick()'
	Button .clear '清除'  anchor l + b  tooltip |Remove select|  width 5  callback '!this.clear()'
	Button .add '添加' anchor l + b   tooltip |Add info| width 4  call'!this.addinfo()'
    Button .back '撤回' anchor l + b   tooltip |back info| width 4  call'!this.backinfo()'

    mem .data is string   $*连接信息/注释信息
    mem .branch is string $*管线号
    mem .pos is POSITION  $*注释信息坐标点
    mem .newinfo is array $*记录add数据，用于撤回功能使用

exit

define method .addinfoform()
	!this.head.val = true
    !this.branch = !!CurrentForm.list.selection()[1]
    handle any
        !this.branch = !!CurrentForm.list.dtext[1].part(1)
        handle any
            !!Alert.message('请添加最小交付单元到list列表！！')
        endhandle
    endhandle
    !this.selectPointA()
endmethod


define method .pick()
	--id   equi bran  @
    !this.newinfo.clear()
    id @
    handle any
        return
    elsehandle none
        !onename = name
        equi
        handle any
            branch
            !namn = namn
            !ZoneName = name of zone
            if  !ZoneName.Matchwild('*HVAC*') then
                !Hsectcode = :H-SECTCODE of $!onename
                !Branname = name of bran
                !NBBM = !Branname.Dbref().:ZD_NBBM
                !namn = !namn + ' ' + !Hsectcode + ' ' + !NBBM
            else
                !Branname = name of bran
                !NBBM = !Branname.Dbref().:ZD_NBBM
                !namn = !namn + ' ' + !NBBM
                --!!alert.message('请选择通风管道！')
                --return
            endif
        elsehandle none
            !namn = namn
            !this.info.val = !namn
        endhandle
        !this.info.val = !namn
        !this.data = !namn
    endhandle

    !this.branch = !!CurrentForm.list.selection()[1]
    handle any
        !this.branch = !!CurrentForm.list.dtext[1].part(1)
        handle any
            !!Alert.message('请添加最小交付单元到list列表！！')
        endhandle
    endhandle
endmethod

define method .clear()
	!this.info.val = ''
endmethod

define method .infotext()
	!this.data = !this.info.val
endmethod

define method .addinfo()
	!MbdLocal = !this.branch + '-DIM'
    !desc = 'node:' + !this.branch
    !dist = 1000000
    !newpos = !this.pos
    !Newonemlabel = ''

    if  !!CurrentForm.name().lowcase() inset('markinstequiform','marksuppform') then
        !function = '设备信息'
        var !allmlabel coll all mlabel with function eq '设备坐标' for $!MbdLocal
        do  !onemlabel values !allmlabel
            if  !onemlabel.dbref().stext.matchwild('PE*') then
                !newpos = !onemlabel.dbref().pos
                !Newonemlabel = !onemlabel
                !ori = !onemlabel.dbref().ori.wrt( world )
            else
                skip
            endif
        enddo
    else
        !function = '连接信息'
        var !allmlabel coll all mlabel with function eq '连接信息' for $!MbdLocal
        do  !onemlabel values !allmlabel
            if  !onemlabel.dbref().stext.matchwild('PE*') then
                if  !onemlabel.dbref().pos.distance(!this.pos) lt !dist then
                    !dist = !onemlabel.dbref().pos.distance(!this.pos)
                    !newpos = !onemlabel.dbref().pos
                    !Newonemlabel = !onemlabel
                    !ori = !onemlabel.dbref().ori.wrt( world )
                endif
            else
                skip
            endif
        enddo
    endif

    !DistDir = !ori.ydir()
    !cheight = !Newonemlabel.dbref().cheight

    $!MbdLocal
    new mlabel
    !this.newinfo.append(ce)
    func '$!function'
    desc '$!desc'
    purp MANU
    cheight $!cheight
    position $!newpos
    move $!DistDir dist -$!cheight
    ori $!ori
    stext '$!<this.data>'
    enhance ce col RED

endmethod

define method .selectPointA()
	if  !this.head.val then
        !this.tail.val = false
        --q var !this.branch
        !this.pos = !this.branch.Dbref().hpos
        handle any
        endhandle
    endif
    --q var  !this.pos

endmethod

define method .selectPointB()
    if  !this.tail.val then
        !this.head.val = false
        !this.pos = !this.branch.Dbref().tpos
        handle any
        endhandle
    endif
endmethod

define method .backinfo()
    do  !oneinfo values !this.newinfo
        !type = type of $!oneinfo
        $!oneinfo
        delete $!type
    enddo
    !this.newinfo.clear()
endmethod

define method .setForm()
    do  !oneinfo values !this.newinfo
        !type = type of $!oneinfo
        $!oneinfo
        delete $!type
    enddo
    !this.newinfo.clear()
endmethod

