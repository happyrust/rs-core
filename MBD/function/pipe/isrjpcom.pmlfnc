define function !!isrjpcom(!mem is any) is boolean
    --q var !mem
	!memtype = type of $!mem
    !memname = name of $!mem
	if !memtype ne 'PCOM' then
		return false
	endif
	!name = name of $!mem
	if !name.substring(-2,2) eq 'RJ' then
		return true
	else
		return false
	endif
endfunction