----------------------------------------
-- 删除没用的VIEW和DRAWLIST（程序出错，或者form关闭时没有处理都有可能产生多余的）
define function !!cleardrawlist()
    --q var !!gphviews !!gphdrawlists

    !oldnum = !!gphviews.views.size()
    do !x indices !!gphviews.views
        --$p $!x
        !view = !!gphviews.views[!x]
        !a = !view.attributes()
        handle any
            !!gphviews.views[!x].delete()
        endhandle
    enddo

    !allviews = array()
    !allmembers = array()
    do !x indices !!gphdrawlists.drawlists
        if !!gphdrawlists.drawlists[!x].views().set() then
            !allviews.append(!!gphdrawlists.drawlists[!x].views())
            !allmembers.append(!!gphdrawlists.drawlists[!x].members())
        endif
    enddo

    --q var !allviews.size()
    do !x indices !!gphdrawlists.drawlists
        if !x eq 1 then
            skip
        endif
        !!gphdrawlists.drawlists[!x].delete()
    enddo
    !!gphdrawlists.drawlists.compress()
    !!gphviews.views.compress()

--q var !allviews.size()
--$p q var !!gphviews !!gphdrawlists
--q var !!gphviews !!gphdrawlists

    do !x indices !allviews
        !token = !!gphdrawlists.createdrawlist()
        do !view values !allviews[!x]
            !!gphdrawlists.attachview(!token,!view)
        enddo
        !!gphdrawlists.drawlists[!token].addmembers(!allmembers[!x])
    enddo

--$p q var !!gphviews !!gphdrawlists
--q var !!gphviews !!gphdrawlists
    return
endfunction
