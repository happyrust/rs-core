define function !!GetSuppData(!suppname is string,!Supp is string,!rev is string) is array
    !SuppDataPath = !!pml.getpathname('suppmaterial.pmldat')
    !SuppDataFile = object file(!SuppDataPath)
    !SuppDatas = !SuppDataFile.readfile()
    !SuppType  = !SuppDatas[1].split(',').Findfirst('SUPP')
    !SuppStand = !SuppDatas[1].split(',').Findfirst('STAND')
    !SuppDesc  = !SuppDatas[1].split(',').Findfirst('DESC')
    !SuppQuantity = !SuppDatas[1].split(',').Findfirst('QUANTITY')

    !AllData = array()
    !CurrentSupp = ''
    !id = 1

    !SuppWall = false
    if  !Supp inset('R10','R83')then
        var !allHele coll all hele for $!suppname
        if  !allHele.size() gt 0 then
            do  !hele values !allHele
                var !allStwall coll all stwall within vol $!hele 105
                if  !allStwall.size() gt 0 then
                    !SuppWall = true
                endif
            enddo
        endif
    endif

    if  !SuppWall then
        !Supp = !Supp + 'wall'
    endif
    --q var !Supp
    --Q VAR !SuppDatas
    do  !SuppData values !SuppDatas
        !SuppDataList = !SuppData.split(',')
        --Q VAR !SuppDataList
        !type = !SuppDataList[!SuppType]
        if not !type.empty() then
            !CurrentSupp = !type
        endif

        if  !Supp neq !CurrentSupp then
            skip
        endif

        !Stand = !SuppDataList[!SuppStand]
        !Desc = !SuppDataList[!SuppDesc]
        !Quantity = !SuppDataList[!SuppQuantity]
        if  !rev eq 'merge' then
            --merge是汇总材料清单,其他的是零部件清单
            !info = !id.string() + ',' + !Stand + ' ' + !Desc + ',' + !Quantity.string() + ',0,0,'
        else
            !info = !id.string() + ',' + !Stand + ' ' + !Desc + ',' + !Quantity.string() + ',0,0,' + !rev + ',,'
        endif
        !id = !id + 1
        --q var !info
        !AllData.append(!info.split(','))
    enddo
    --Q VAR !AllData
    return  !AllData

endfunction
Og