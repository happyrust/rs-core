define function !!mergerange(!ranges is array) is array
	!newranges = array()
	do !newrange values !ranges
		!newranges = !!addonerangetoranges(!newrange,!newranges)
	enddo
	!starts = array()
	do !range values !newranges
		!starts.append(!range[1])
	enddo
	!newranges.reindex(!starts.sortedindices())
	return !newranges
endfunction
