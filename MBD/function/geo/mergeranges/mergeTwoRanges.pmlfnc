define function !!mergeTwoRanges(!range1 is array,!range2 is array) is array
	!ranges = array()
	if !range1[2] lt !range2[1] or !range1[1] gt !range2[2] then
		!ranges.append(!range1)
		!ranges.append(!range2)
	else
		!range[1] = min(!range1[1],!range2[1])
		!range[2] = max(!range1[2],!range2[2])
		!ranges.append(!range)
	endif
	return !ranges
endfunction
