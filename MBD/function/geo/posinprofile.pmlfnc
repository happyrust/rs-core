define function !!posinprofile(!pos is position,!profile is profile) is boolean
	if !profile.isclosed().not()then
		!profile.close()
	endif
	!plane = !profile.plane()
	!point = !plane.near(!pos)
--$P A

	!a = !profile.iswithin(!point)
	handle any
	--$P B
	elsehandle none
	--$P C
		if !a then
			return true
		endif
	endhandle
	!b = !profile.iswithout(!point)
	handle any
		return false
	elsehandle none
		if !b.not() then
			return true
		else
			return false
		endif
	endhandle

endfunction
T