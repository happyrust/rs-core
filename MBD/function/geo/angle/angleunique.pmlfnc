define function !!angleunique(!inputangle is real) is real
	!angle = !inputangle
	do
		if !angle lt 0 then
			!angle = !angle + 360
		elseif !angle gt 360 then
			!angle = !angle - 360
		else
			break
		endif
	enddo
	return !angle
endfunction
