define function !!writembdversion(!form is form)
	!file = !!getmbdversionfile(!form)
	if !file.unset() then
		return
	endif
	--syscom 'start $!file&'
	!lines = !form.versioncontext.val
	!file.writefile('overwrite',!lines)
endfunction
