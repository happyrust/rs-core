define function !!getmbdmaterialdata(!string is string)
	if undefined(!!mbdmaterialdata) then
		!!mbdmaterialdata = object mbdinputdata(!string)
		handle any
			!!alert.warning('Failed to read data of ' + !string)
		endhandle
	else
		!!mbdmaterialdata.add(!string)
		handle any
			!!alert.warning('Failed to read data of ' + !string)
		endhandle
	endif
endfunction
