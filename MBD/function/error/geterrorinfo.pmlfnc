--[Function]:	return array whick include information of inputed error
------------------------------------------

define function !!geterrorinfo() is array
	!result = array()
	!result.append(!!error.text)
	!result.append(!!error.line)
	!result.append(!!error.command)
	!result.appendarray(!!error.callstack)
	return !result
endfunction
