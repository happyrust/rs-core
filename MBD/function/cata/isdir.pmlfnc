--[Function]:jugde the string is express of direction
------------------------------------------

define function !!isdir(!string is string) is boolean
	!isdir = false

	!inputdirstring = !string
	if !inputdirstring.substring(1,1) eq '(' and !inputdirstring.substring(-1,1) eq ')' then
		!inputdirstring = !inputdirstring.substring(2,!inputdirstring.length() - 2)
	endif
	!inputdirstring = !inputdirstring.replace('-X','X').replace('-Y','Y').replace('-Z','Z').replace('-P','P').replace(' ','').trim()
	--!inputdirstring = !inputdirstring.replace('X',' X ').replace('Y',' Y ').replace('Z',' Z ').replace('- X','-X').replace('- Y','-Y').replace('- Z','-Z')
	!dirstrings = split('X Y Z P')

	--$p aaa $!inputdirstring

	!firstletter = !inputdirstring.substring(1,1)
	--$p first $!firstletter
	if !dirstrings.findfirst(!firstletter).set() then
		--$p in
		--q var !inputdirstring.length()
		if !inputdirstring.length() eq 1 then
			if !inputdirstring ne 'P' then
				!isdir = true
			endif
			golabel /end
		else
			!secondletter = !inputdirstring.substring(2,1)
			--$p second $!secondletter
			if !secondletter inset ('1','2','3','4','5','6','7','8','9') then
				!isdir = true
			endif
			golabel /end
		endif
	endif


	label /end

	--$p iaasdir $!isdir
	return !isdir
endfunction
