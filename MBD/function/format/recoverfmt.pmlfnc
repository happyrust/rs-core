define function !!recoverfmt()
	!path = !!pml.getpathname('setmbdfmt.pmlfnc')
	!filepath = !path.before('setmbdfmt.pmlfnc') & 'distancefmt.txt'
	!file = object file(!filepath)
	!lines = !file.readfile()
	handle any
	elsehandle none
		!file.close()
		if !lines.set() then
			!dp = !lines[1].after(':').real()
			!label = !lines[2].after(':')
		endif
	endhandle

	if undefined(!dp) then
		!dp = 2
		!label = 'UNITS'
	endif
	!!distancefmt.dp = !dp
	!!distancefmt.label = !label
endfunction
s=