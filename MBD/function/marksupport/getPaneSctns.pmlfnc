define function !!getPaneSctns(!stru is string) is array
	!paneSctns = array()
	!restpanes = array()
	!allsupportpanes = array()
	!specialpanes = array()
	var !panes coll all pane for $!stru
	--!panes.append('=17458/46210')
	--q var !panes.size()
	$(
	!panes = array()
	!panes.append('=17590/464')
	!panes.append('=17590/488')
	!panes.append('=17590/476')
	!panes.append('=17590/482')
	!panes.append('=17590/470')
	$)
	$(
	!panes1 = array()
	!panes1.append('=17590/578')
	!panes1.append('=17590/524')
	!panes1.append('=17590/530')
	!panes1.append('=17590/572')
	!panes1.append('=17590/536')
	$)

	!notfourpointspanes = array()
	!sps = array()
	--!x = 0
	do !pane values !panes
		!sp = object supportpane(!pane)
		handle any
			$p $!pane 识别不了
			--$p $!pane cant be got as supportpane
			--!specialpanes.append(!pane)
			skip
		elsehandle none
            --q var !sp
			if !sp.height.unset() then
				--$p $!pane cant be got as supportpane
				!supppanepad = object supppanepad(!pane)
				handle any
					$p $!pane 识别不了
					--$p $!pane cant be got as supportpane
					skip
				elsehandle none
					if !supppanepad.thick.set() then
						!specialpanes.append(!supppanepad)
					else
						$p $!pane 识别不了
						--$p $!pane cant be got as supportpane
					endif
					skip
				endhandle
			else
				if !sp.poss.size() ne 4 then
					!notfourpointspanes.append(!sp)
					skip
				endif
			endif
		endhandle
		!sps.append(!sp)
		--!x = !x + 1
		--!midpos = !sp.midposs[1].midpoint(!sp.midposs[3])
		--aid text number 1234 '$!x' at $!midpos
	enddo
    --Q VAR !sps[1]
	--------
	-----------------------------------------------------------------------------got sps (supportpane)

    --q var !sps.unset()

	-----put all sps (supportpane) into group ppg
	if !sps.unset() then
    --$p 55555
		golabel /end
	else
		!allsupportpanes = !sps
	endif

    --$p 456

	!restSps = !sps
	--clock init
	!allPpgs = array()
	do
		!ppg = object panePurposeGroup(!restSps[1])		$*group for sctn pane
		!restSps[1].delete()
		!size = !restSps.size()
		do !x indices !restSps
			if !ppg.add(!restsps[!x]) then
				!restSps[!x].delete()
			endif
		enddo
		!allPpgs.append(!ppg)
		if !restSps.unset() then
			break
		else
			!restSps.compress()
		endif
	enddo
	--clock read elapsed
	-------------------------------------------------------------------------------------got group of pane (make of sctn)

    --q var !allPpgs[1].lines1 !allPpgs[1].widths1
    --q var !allPpgs
	--$p 123


	do !ppg values !allppgs
		do !x from 1 to 2
			!tempdir = !ppg.dir$!x
			if !tempdir.set() then
				!panesctn = object panesctn(!ppg.sps,!tempdir)

				if !panesctn.zdir.set() then
					!paneSctns.append(!panesctn)
					break
				endif
			endif
		enddo
		!restPanes.appendarray(!paneSctn.restSupportPanes)
	enddo
    --q var !restPanes[1]
-------------------------------------------------------------------------got panesctns and restpanes



	var !sctns coll all sctn for $!stru
    --q var !sctns
	!sctnlines = array()
	do !sctn values !sctns
		!pos1 = posstart of $!sctn wrt/*
		!pos2 = posend of $!sctn wrt/*
		!line = !pos1.line(!pos2)
		!sctnLines.append(!line)
	enddo

	--q var !panesctns
    --$p 111111
	do !x indices !panesctns
		!panesctn = !panesctns[!x]
		!temparr1 = array()
		!temparr1.append(!panesctn.axis)
		!temparr1.append(max(!panesctn.xlen,!panesctn.ylen))

		!delete = false
		do !sctnLine values !sctnLines
			!temparr2 = array()
			!temparr2.append(!sctnline)
			if !!checkAxisOk(!temparr1,!temparr2) then

				--!restPanes.appendarray(!panesctns[!x].group)
				!panesctns[!x].delete()						$*pane around SCTN is not unnecessary to consider
				!delete = true
				break
			endif
		enddo

		if !delete.not() then

			if !panesctns[!x].checkIfTogether().not() then

				!restPanes.appendarray(!panesctns[!x].group)
				!panesctns[!x].delete()						$*separate panes cant be a SCTN
			endif
		endif

	enddo
	!panesctns.compress()
    --q var !panesctns
	--------------------------------------------------------------------------delete bad panesctns which not together or repeated with sctn




	label /end
	!restpanes.appendarray(!notfourpointspanes)
	!allsupportpanes.appendarray(!notfourpointspanes)
	--q var !panesctns
	!result = array()
	!result.append(!panesctns)
	!result.append(!restPanes)
	!result.append(!allsupportpanes)
	!result.append(!specialpanes)
	return !result

$(
-------------------------------------------------------------------------old 202302091340 way 2
	!paneSctnData = array()
	!paneSctnNums = array()

	!size = !sps.size()
	do !x from 1 to !size - 1
		do !y from !x + 1 to !size
			if defined(!paneSctnNums[!x]) and defined(!paneSctnNums[!y]) and !paneSctnNums[!x] eq !paneSctnNums[!y] then	$*X should be checked with other axis in method CheckAxisOk

					skip
			endif
		--q var !sps[!x] !sps[!y]

			!temparr = !!checkIfSameSctn(!sps[!x],!sps[!y])
			--if !panes1.findfirst(!sps[!x].ref).set() and !panes1.findfirst(!sps[!y].ref).set() then

			--endif




			if !temparr.set() then	$* same SCTN
				if undefined(!paneSctnNums[!x]) and undefined(!paneSctnNums[!y]) then
					!paneSctnData.append(!temparr)
					!paneSctnNums[!x] = !paneSctnData.indices().last()
					!paneSctnNums[!y] = !paneSctnData.indices().last()
				elseif defined(!paneSctnNums[!x]) and undefined(!paneSctnNums[!y]) then			$*Y should be checked with other axis in method CheckAxisOk
					!sctnNum = !paneSctnNums[!x]
					if !!checkPaneIfInSctn(!paneSctnData[!sctnNum],!sps[!y]) then
					--if !!checkIfInSctn(!paneSctnData[!sctnNum],!temparr[2]) then
						!paneSctnData[!sctnNum].append(!temparr[2])
						!paneSctnNums[!y] = !sctnNum
					endif
				elseif undefined(!paneSctnNums[!x]) and defined(!paneSctnNums[!y]) then			$*X should be checked with other axis in method CheckAxisOk
					!sctnNum = !paneSctnNums[!y]
					if !!checkPaneIfInSctn(!paneSctnData[!sctnNum],!sps[!x]) then
					--if !!checkIfInSctn(!paneSctnData[!sctnNum],!temparr[1]) then
						!paneSctnData[!sctnNum].append(!temparr[1])
						!paneSctnNums[!x] = !sctnNum
					endif
				elseif defined(!paneSctnNums[!x]) and defined(!paneSctnNums[!y]) then			$*All Axis with sctn num Y should be checked with all axis with Sctn num X in method CheckAxisOk
					!sctnNum1 = !paneSctnNums[!x]
					!sctnNum2 = !paneSctnNums[!y]

if !panes1.findfirst(!sps[!x].ref).set() and !panes1.findfirst(!sps[!y].ref).set() then

				if undefined(!paneSctnNums[!x]) then
					!tempaa = 0
				else
					!tempaa = !paneSctnNums[!x]
				endif

				if undefined(!paneSctnNums[!y]) then
					!tempaa1 = 0
				else
					!tempaa1 = !paneSctnNums[!y]
				endif

endif


					!append = true
					do !temparr2 values !paneSctnData[!sctnNum2]
						if !!checkIfInSctn(!paneSctnData[!sctnNum1],!temparr2).not() then
							!append = false
							break
						endif
					enddo
					if !append then
						!paneSctnData[!sctnNum1].appendarray(!paneSctnData[!sctnNum2])
						!paneSctnData[!sctnNum2].delete()
						do !z indices !paneSctnNums
							if !paneSctnNums[!z] eq !sctnNum2 then
								!paneSctnNums[!z] = !sctnNum1
							endif
						enddo
					endif
				endif
			endif

if !panes1.findfirst(!sps[!x].ref).set() and !panes1.findfirst(!sps[!y].ref).set() then

				if undefined(!paneSctnNums[!x]) then
					!tempaa = 0
				else
					!tempaa = !paneSctnNums[!x]
				endif

				if undefined(!paneSctnNums[!y]) then
					!tempaa1 = 0
				else
					!tempaa1 = !paneSctnNums[!y]
				endif

endif

		enddo
	enddo




----------------------------------------------got pane sctn data, to separate pane
	!restPanes = array()
	do !x indices !paneSctnData
		!group = array()
		do !y indices !paneSctnNums
			if !paneSctnNums[!y] eq !x then
				!group.append(!sps[!y])
			endif
		enddo
		if !group.set() then


			!panesctn = object panesctn(!group,!paneSctnData[!x][1][1].direction())

			if !panesctn.zdir.set() then
				!paneSctns.append(!paneSctn)
				if !paneSctn.restSupportPanes.set() then
					!restPanes.appendarray(!paneSctn.restSupportPanes)
				endif
			else
				do !y indices !paneSctnNums
					if !paneSctnNums[!y] eq !x then
						!paneSctnNums[!y].delete()
					endif
				enddo
			endif

		endif
	enddo



	do !x indices !panes
		if undefined(!paneSctnNumS[!X]) then
			!restPanes.append(!sps[!x])

		endif
	enddo
-----------------------------------------------------------------------






	var !sctns coll all sctn for $!stru
	!sctnlines = array()
	do !sctn values !sctns
		!pos1 = posstart of $!sctn wrt/*
		!pos2 = posend of $!sctn wrt/*
		!line = !pos1.line(!pos2)
		!sctnLines.append(!line)
	enddo


	do !x indices !panesctns
		!panesctn = !panesctns[!x]
		!temparr1 = array()
		!temparr1.append(!panesctn.posstart.line(!panesctn.posend))
		!temparr1.append(max(!panesctn.xlen,!panesctn.ylen))

		!delete = false
		do !sctnLine values !sctnLines
			!temparr2 = array()
			!temparr2.append(!sctnline)
			if !!checkAxisOk(!temparr1,!temparr2) then

				--!restPanes.appendarray(!panesctns[!x].group)
				!panesctns[!x].delete()						$*pane around SCTN is not unnecessary to consider
				!delete = true
				break
			endif
		enddo

		if !delete.not() then

			if !panesctns[!x].checkIfTogether().not() then

				!restPanes.appendarray(!panesctns[!x].group)
				!panesctns[!x].delete()						$*separate panes cant be a SCTN
			endif
		endif

	enddo
	!panesctns.compress()



	--label /end
	!result = array()
	!result.append(!panesctns)
	!result.append(!restPanes)
	return !result
$)
----------------------------------------------------------old old way  1
$(
	!groups = !!getpanegroups(!stru)
	!paneSctns = array()
	do !x indices !groups
		!group = !groups[!x]
		!paneSctn = object paneSctn(!group)
		!paneSctns.append(!paneSctn)
	enddo
	return !paneSctns
$)
endfunction
