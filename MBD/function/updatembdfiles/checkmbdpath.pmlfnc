define function !!checkmbdpath() is string
	!path = !!pml.getpathname('checkmbdpath.pmlfnc').lowcase().before('checkmbdpath.pmlfnc') & 'inputfolderpath.txt'
	!txtfile = object file(!path)
	!lines = !txtfile.readfile()
	handle any
		return ''
	endhandle
	!inputfrompath = !lines[1]
	handle any
		return ''
	endhandle

	!frompath = !inputfrompath.trim().lowcase()
	if !frompath.match('myproj') eq 0 then
		$p 请管理员在 inputfolderpath.txt文件中 设置好程序源文件夹的正确地址
		--$p Input the right path
		return ''
	else
		!frompath = !frompath.before('myproj')
		!tempstring = !frompath.substring(-1,1)
		if !tempstring ne '\' and !tempstring ne '/' then
			!frompath = !frompath + '\'
		endif
		!frompath = !frompath & 'myprojects'
	endif
	return !frompath
endfunction
