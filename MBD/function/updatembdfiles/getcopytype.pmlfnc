define function !!getcopytype() is string
----------------------
----------------------Step x:check if to cpy
	!path = !!pml.getpathname('getcopytype.pmlfnc').lowcase().before('getcopytype.pmlfnc')

	!uncopyfile = object file(!path & 'uncopylist.txt')
	!uncopylist = !uncopyfile.readfile()
	handle any
		!uncopylist = array()
	endhandle
	!session = current session
	do !login values !uncopylist
		if !login.match(!session.login) ne 0 then	$*avoid to make mistake to replace my new files
			--$p 在不复制 uncopylist.txt 清单里面，不运行
			return 'uncopy'
		endif
	enddo


	----------------------
	----------------------Step x:check if only copy server
	!onlyserverfile = object file(!path & 'onlyserverlist.txt')
	!onlyserverlist = !onlyserverfile.readfile()
	handle any
		!onlyserverlist = array()
	endhandle
	!session = current session
	do !login values !onlyserverlist
		if !login.match(!session.login) ne 0 then	$*avoid to make mistake to replace new files
			--$p 在只复制 onlyserverlist.txt 清单里面，不运行
			return 'onlyserver'
		endif
	enddo

	return 'copy'
endfunction
