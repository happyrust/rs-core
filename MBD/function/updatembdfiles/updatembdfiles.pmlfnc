define function !!updatembdfiles()
	------------------------------------------------------新方式，减少调用次数，节约时间
	!session = current session
	if !session.login eq 'pdms-bj-230-56' then	$*我不更新
		return
		!frompath = 'C:\Users\pdms-bj-c103-03.PDMS\Desktop\myprojects'
		!frompath = !frompath.lowcase()

		!topaths = array()
		!topaths.append('D:\server')
		!topaths.append('D:\copyfiles\myprojects')
		!newtime = !!getversiontime(!frompath)
	else
		!frompath = '\\10.102.2.77\Evars\E3D\MbdProject\myprojects'
		!topath = '\\10.102.2.77\Evars\E3D\PDMSTOOLS\SupportPmllib\myprojects'

		--!frompath = 'C:\Users\pdms-bj-c103-03.PDMS\Desktop\myprojects'
		--!topath = 'd:\server'

		!frompath = !frompath.lowcase()
		!topath = !topath.lowcase()


		!topaths = array()
		!topaths.append(!topath)

		------------------------------------------------------got newest time s
		!newversionfile = object file(!frompath & '/function/updatembdfiles/updatetime.txt')
		!exist = !newversionfile.exists()
		handle any	$*应该是路径有问题，所以返回最新的，避开后面更新报错
			$p 源文件路径有问题 1
			return
		endhandle
		if !exist.not() then
			$p 没有版本文件
			return
		else
			!newlines = !newversionfile.readfile()
			handle any
				!newtime = !newversionfile.dtm()
			elsehandle none
				if !newlines.unset() then
					!newtime = !newversionfile.dtm()
				else
					!newtime = object datetime($!newlines[1])
					handle any
						!newtime = !newversionfile.dtm()
					endhandle
				endif
			endhandle
		endif
		------------------------------------------------------got newest time e


		if !session.login ne 'pengkang' then	$*彭工只更新服务器上的，其它用户会在服务器上和自己本地都检查更新
			------------------------------------------------------get local path s
			var !pmllibstring evar pmllib
			!pmllibs = !pmllibstring.split(';')
			do !pmllib values !pmllibs
				!lowstring = !pmllib.lowcase()
				if !lowstring.matchwild('c:*myproj*') or !lowstring.matchwild('d:*myproj*') then
					!localpath = !lowstring
					break
				elseif !lowstring.matchwild('c:*aveva*pmllib*') or !lowstring.matchwild('d:*aveva*pmllib*') then	$*有些人有其它工具
					!localpath = !lowstring
				endif
			enddo
			!file = object file(!localpath)
			if undefined(!localpath) then
				$p 没找到可以存放的地方
				return ''
			else
				!tempstring = !localpath.substring(-1,1)
				if !localpath.match('myproj') eq 0 then
					if !tempstring ne '\' and !tempstring ne '/' then
						!localpath = !localpath + '\'
					endif
					!localpath = !localpath & 'myprojects'
				else
					if !tempstring eq '\' or !tempstring eq '/' then
						!localpath = !localpath.substring(1,!localpath.length() - 1)
					endif
				endif
			endif
			------------------------------------------------------get local path e


			------------------------------------------------------got old time s
			!localversionfile = object file(!localpath & '/function/updatembdfiles/updatetime.txt')
			!exist = !localversionfile.exists()
			handle any	$*应该是路径有问题，所以返回最新的，避开后面更新报错
				$p 本地路径有问题 2
				return
			endhandle
			if !exist.not() then	$*不存在，说明是旧版
				!oldtime = object datetime(2000,01,01)
			else
				!newlines = !localversionfile.readfile()
				handle any
					!oldtime = object datetime(2000,01,01)
				elsehandle none
					if !newlines.unset() then
						!oldtime = !localversionfile.dtm()
					else
						!oldtime = object datetime($!newlines[1])
						handle any
							!oldtime = !localversionfile.dtm()
						endhandle
					endif
				endhandle
			endif
			------------------------------------------------------got old time e

			if !oldtime ge !newtime then	$*对于用户来说，请检查是否需要更新，不需要直接退出这function,需要的话，后面时间长一点影响不大，这之前时间要短
				return
			else
				!topaths.append(!localpath)
			endif
		endif
	endif

	$(
	------------------------------------------------------旧方式，方便配置，但是调用服务器上的function次数多不少，时间太对用户来说不友好
	!topaths = array()
	!copytype = !!getcopytype()
	if !copytype eq 'uncopy' then
		return
	else
		!frompath = !!checkmbdpath()
		if !frompath eq '' then
			return
		endif
		!comparetime = object datetime(2000,01,01)
		!newtime = !!getversiontime(!frompath)
		if !newtime eq !comparetime then
			$p 没有版本文件
			return
		endif

		!topaths = array()
		!topaths.append(!!checkserverpath())
		if !topaths[1] eq '' then
			return
		endif
		if !copytype eq 'copy' then
			!topaths.append(!!getlocalmbdpath())
		endif
	endif
	$)

	!topaths.unique()

	--!topaths = array()

	--q var !topaths
	--return

	----------------------
	----------------------Step 1:start to copy
	!filefolders = !!getallfileandfolders(!frompath)
	--q var !frompath !filefolders
	!files = !filefolders[1]
	!folders = !filefolders[2]


	!allpathstring = ''
	!size = 0
	do !times indices !topaths
		!topath = !topaths[!times]
		if !topath eq '' then
			skip
		endif
		!oldtime = !!getversiontime(!topath)
		if !oldtime ge !newtime then
			skip
		endif
		if !times eq 1 then
			----------------------
			----------------------Step 1:只取需要的插件主窗口文件和更新版本所需程序文件
			!newfiles = array()
			!newfolders = array()
			do !file values !files
				!name = !file.name().lowcase()
				--if !name.part(-1,'.') eq 'pmlfrm' or !name.matchwild('*updatembdfiles*') then
				if !name.matchwild('*updatembdfiles*') then
					!newfiles.append(!file)
					!lastpart = !name.part(-1,'/').part(-1,'\')
					!newfolder = !name.before(!lastpart)
					!newfolders.append(!newfolder)
				endif
			enddo
			!allfiles[!times] = !newfiles
			!allfolders[!times] = !newfolders.unique()
		else
			!allfiles[!times] = !files
			!allfolders[!times] = !folders
		endif
		if !allpathstring ne '' then
			!allpathstring = !allpathstring & ' 和 ' & !topath
		else
			!allpathstring = !topath
		endif
		!size = !size + !allfiles[!times].size() + !allfolders[!times].size()
	enddo

	if !allpathstring ne '' then
		!ans = !!alert.confirm('确定更新程序至 ' & !allpathstring)
		if !ans ne 'YES' then
			return
		endif
	endif

	--return
	!allcopyfiles = array()
	do !times indices !allfiles
		!copyfiles = array()
		!files = !allfiles[!times]
		!folders = !allfolders[!times]
		!topath = !topaths[!times]

		$p
		$p 更新程序至：$!topath


		----------------------
		----------------------Step 1:
		!deleteinfos = array()
		--if !times eq 2 then $*local path
		!needcopyfilepaths = array()
		do !file values !files
			!filename = !file.name().replace(!frompath,!topath).lowcase()
			!needcopyfilepaths.append(!filename)
		enddo

		!localfilefolders = !!getallfileandfolders(!topath)
		!localfiles = !localfilefolders[1]
		handle any
			!localfiles = array()
		endhandle
		do !localfile values !localfiles
			!localname = !localfile.name().lowcase()
			if !needcopyfilepaths.findfirst(!localname).unset() then
				!localfile.deletefile()
				handle any
					!deleteinfos.append(!localname & | delete failed|)
					--$p $!localname delete failed
				elsehandle none
					!deleteinfos.append(!localname & | deleted|)
					--$p $!localname deleted
				endhandle
			endif
		enddo
		if !deleteinfos.set() then
			!tempsize = !deleteinfos.size()
			$p $!tempsize 多余文件被删除:
			do !infostring values !deleteinfos
				$p $!infostring
			enddo
		endif
		--endif

		$p--创建文件夹--

		!cs = 0
		do !folder values !folders			$* create folders				3
			!newfolder = !folder.replace(!frompath,!topath)
			!tempfile = object file(!newfolder)
			if !tempfile.exists().not() then
				SYSCOM |MD $!newfolder|
			endif
			!cs = !cs + 1
			!!fmsys.setprogress(nint(!cs / !size * 100))
		enddo

		$p--更新文件--
		do !file values !files
			!name = !file.name().lowcase()
			if !name.matchwild('*error.txt') then	$*错误日志文件不替换
				skip
			endif
			!newname = !name.replace(!frompath,!topath).lowcase()

			!newfile = object file(!newname)
			if !newfile.exists() then
				if !file.dtm() le !newfile.dtm() then
					golabel /unnecessarytoupdate
				else
					!newfile.deletefile()
					handle any
						$p 更新此文件失败： $!file
						golabel /unnecessarytoupdate
					endhandle
				endif
			endif
			!file.copy(!newfile)
			handle any
				$p 更新此文件失败： $!file
			elsehandle none
				!copyfiles.append(!file)
			endhandle
			label /unnecessarytoupdate

			!cs = !cs + 1
			!!fmsys.setprogress(nint(!cs / !size * 100))
		enddo

		if !copyfiles.set() then
			!size = !copyfiles.size()
			$p 更新了 $!size 个文件
			!allcopyfiles.appendarray(!copyfiles)
		endif
	enddo


	if !allcopyfiles.set() then
		$p
		!size = !allcopyfiles.size()
		--$p $!size Files updated
		$p 一共更新了 $!size 个文件

		--pml rehash all
		!print = |!!reloadmbdfiles()|
		$p
		--$p 更新完毕，请重启E3D
		$p 更新完毕，请重启E3D，或者 在命令行运行!!reloadmbdfiles(),否则运行会报错
		--$p 更新完毕，请在命令行运行!!reloadmbdfiles(),否则运行会报错
		$p $!print
		--!!alert.warning('更新完毕，请在命令行运行 !!reloadmbdfiles() ,否则运行会报错')
		!!alert.warning('更新完毕，请重启E3D，或者 在命令行运行 !!reloadmbdfiles() ,否则运行会报错')
		--!!alert.warning('更新完毕，请重启E3D')
	else
		!!alert.confirm('更新完毕')
	endif
	!!fmsys.setprogress(0)
endfunction
J