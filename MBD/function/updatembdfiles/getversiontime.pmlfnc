define function !!getversiontime(!path is string) is datetime
	!newversionfile = object file(!path & '/function/updatembdfiles/updatetime.txt')
	--q var !newversionfile.exists()
	!exist = !newversionfile.exists()
	handle any	$*应该是路径有问题，所以返回最新的，避开后面更新报错
		!dt = object datetime()
		return !dt
	endhandle
	if !exist.not() then	$*不存在，说明是旧版
		!dt = object datetime(2000,01,01)
		return !dt
	else
		!newlines = !newversionfile.readfile()	$*读不到，默认是最新的了,主要考虑怕读取有问题
		handle any
			!dt = object datetime()
			return !dt
		endhandle
		if !newlines.unset() then
			!newtime = !newversionfile.dtm()
		else
			!newtime = object datetime($!newlines[1])
			handle any
				--$p 新版本文件的内容格式不对，不影响更新
				--$p The format of version time in new version is bad
				!newtime = !newversionfile.dtm()
			endhandle
		endif
	endif
	return !newtime
endfunction
