--[Function]:	update json of items into tplant
------------------------------------------

----init args
----get rvm att json
----login and check project model, get projectid and modelid or modelname
----update file to tplant
----return result
define function !!jsontotplant(!items is array, !username1 is string, !password1 is string, !projectidOrName1 is string, !modelidOrName1 is string, !attIdOrName1 is string, !http1 is string, !datatype is string) is boolean
	------------------------------------------------------new way
	!cename = name

	if !modelidOrName1.unset() or !modelidOrName1 eq '' then
		!modelidOrName = 'MBD-' + !datatype.upcase()
	else
		!modelidOrName = !modelidOrName1
	endif

	do !name  values !items
		!type = !!getmbdtype(!name)
		!setformcom = |!form = | & |!!mark| & !type & |form|
		$!setformcom
		handle any
			!reloadcom = |pml reload form | & |!!mark| & !type & |form|
			$!reloadcom
			$!setformcom
			handle any
				skip
			endhandle
		endhandle

		!form.clearlist()
		$!name

		$p Deal $!name
		$p add
		!form.addce()
		if !form.functionlist.dtext.unset() then
			$p draw
			!form.drawall()
		endif

		if !form.functionlist.dtext.set() then
			$p get files: rvm att json
			!paths = !form.generatefiles()
			if !paths.size() ge 4 then
				$p update to tplant
				--!uptotplant = object updatefiles(!paths , !http1, !username1, !password1, !projectidOrName1, !attIdOrName1, !modelidOrName1)
				if !modelidOrName1.unset() or !modelidOrName1 eq '' or !modelidOrName1 eq 'MBD-' then
					!uptotplant = object updatefiles(!paths,'MBD-'&!type)
				else
					!uptotplant = object updatefiles(!paths,!modelidOrName1)
				endif
			endif
		else
			$p Failed to draw $!name
		endif
	enddo
	$!cename
	return


	!cename = name
	--------------------------------------
	--------------------------------------Step x:配置项目、模型服务、账号、密码等

	-------init args s
	if !username1.unset() or !username1 eq '' then
		!username = 'ccc'
	else
		!username = !username1
	endif

	if !password1.unset() or !password1 eq '' then
		!password = 'Admin123#'
	else
		!password = !password1
	endif

	if !projectidOrName1.unset() or !projectidorName1 eq '' then
		!projectidOrName = '示例项目'
	else
		!projectidOrName = !projectidOrName1
	endif

	if !modelidOrName1.unset() or !modelidOrName1 eq '' then

		--!modelidOrName = 'MBDequi'
		!modelidOrName = 'MBD-' + !datatype.upcase()
		--!modelidOrName = 'MBD-onlyrvm-' + !datatype.upcase()
	else
		!modelidOrName = !modelidOrName1
	endif

	if !attidOrName1.unset() or !attidOrName1 eq '' then
		--1￥获取成功￥
		--1455452672595419138￥PDMS-长属性名 (att)
		--1455745202897641473￥PDMS-短属性名 (att)
		--1648981779037097985￥3DMax (max)
		--!attidOrName = 'PDMS-长属性名 (att)'
		!attidOrName = 'PDMS-长属性名 (type)'
	else
		!attidOrName = !attidOrName1
	endif


	if !http1.unset() or !http1 eq '' then
		!http = 'http://10.30.200.43'
	else
		!http = !http1
	endif
	-------init args e


	--------------------------------------
	--------------------------------------Step x:得到rvm att json文件，其中json文件可能有多个
	!newitems = array()
	do !item values !items
		!tempname = name of $!item
		handle any
			!struname = !item & '/STRU'
			!struname = name of $!struname
			handle any
			elsehandle none
				!newitems.append(!struname)
			endhandle

			!restname = !item & '/REST'
			!restname = name of $!restname
			handle any
			elsehandle none
				!newitems.append(!restname)
			endhandle
		elsehandle none
			!newitems.append(!item)
		endhandle
	enddo


	--$(
	!remitems = array()
	--$(
	!rvmpath = !!getrvm(!newitems,!remitems,'')
	if !rvmpath eq '' then
		$p rvm error
		$!cename
		return false
	endif

	!attpath = !!getatt(!newitems,!remitems,'')
	if !attpath eq '' then
		$p att error
		$!cename
		return false
	endif



	--$)
	--q var !newitems
	--!jsonpaths = !!getjson(!newitems,!remitems,'')
	!jsonpaths = !!getjson(!newitems,'')
	if !jsonpaths.unset() then
		$p json error in jsontotplant pmlfnc
		$!cename
		return false
	endif



	$(
	!txtpath = !!gettxt(!newitems,'')
	if !txtpath eq '' then
		$p txt error
		$!cename
		return false
	endif
	return true
	$)
	$(
	!rvmpath = 'd:\APS_RVM(22-28-32_2_November_202).rvm'
	!attpath = 'd:\APS_ATT(22-28-32_2_November_).att'
	!jsonpath = 'd:\json1.json'
	!jsonpath = ''
	$)
	$!cename


	--------------------------------------
	--------------------------------------Step x:登陆，获取项目ID,模型服务ID，token等
	----login and check project model, get projectid and modelid or modelname  s
	if !!importtplantnet().not() then
		return
	endif
	using namespace 'UpFileToPlatform.Interface'
	!obj = object ApiRequest()
	handle any
		$p apirequest error
		return false
	endhandle

	!resultstring = !obj.Login( !username,!password,!http)
	handle any
		$p resultstring error
		return false
	endhandle

	!list = !resultstring.Split('￥')
	if !list[1] eq '1' then
		!token = !list[3]
	else
		$p Fail to get token
		$p $!list[3]
		return false
	endif

	!projectarr = !obj.GetProject( !token,!http)
	if (!projectarr.size() gt 0) then
		!list = !projectarr[1].Split('￥')
		if ( !list[1] eq '0' ) then
			!info = '获取项目数据失败，' + !list[3]
			$p $!info
			--!!alert.warning(!list[3])
			return false
		endif
	else
		$p Fail to get project in Tplant
		--!!alert.warning('获取项目数据失败，无错误信息')
		return false
	endif

	!attarr = !obj.GetAttData( !TOKEN, !http )
	if (!attarr.size() gt 0) then
		!list = !attarr[1].Split('￥')
		if ( !list[1] eq '0' ) then
			!info = '获取属性类别键失败，' + !list[3]
			$p $!info
			--!!alert.warning(!list[3])
			return false
		endif
	else
		$p Fail to get att list in Tplant
		--!!alert.warning('获取属性类别键失败，无错误信息')
		return false
	endif

	!find = false
	Do !index from 2 to !attarr.size()
		!dataList = !attarr[!index].Split('￥')
		!tempid = !dataList[1]
		!tempName = !dataList[2]
		--$p $!tempname $!attidorname
		if !tempid eq !attidorname or !tempname eq !attidorname then
			!attid = !tempid
			!find = true
			break
		endif
		--q '项目ID：$!dataList[1]，项目名称：$!dataList[2]，项目代码：$!dataList[3]'
	enddo

	--q var !attarr
	--q var !attarr[1]
	--$P $!attid
	--return

	if !find.not() then
		!!alert.warning('ATT ID不存在' + !attidorname)
		return false
	endif
	--!attid = !attarr[1].Split('￥')[1]

	!find = false
	Do !index from 2 to !projectarr.size()
		!dataList = !projectarr[!index].Split('￥')
		!tempid = !dataList[1]
		!tempName = !dataList[2]
		if !tempid eq !projectidorname or !tempname eq !projectidorname then
			!projectid = !tempid
			!find = true
			break
		endif
		--q '项目ID：$!dataList[1]，项目名称：$!dataList[2]，项目代码：$!dataList[3]'
	enddo

	if !find.not() then
		!!alert.warning('项目名字或ID不存在' + !projectidorname)
		return false
	endif
	!times = 0

	label /getmodelagain
	!times = !times + 1

	if !times le 2 then
		!modelarr = !obj.GetModelServer( !token,!projectid,!http)
		if(!modelarr.size() gt 0) then
			!list = !modelarr[1].Split('￥')
			if( !list[1] eq '0' ) then
				!info = '获取模型数据失败，' + !list[3]
				$p $!info
				--!!alert.warning(!list[3])
				return false
			endif
		else
			$p Fail to get model list
			return false
		endif


		!find = false
		Do !index from 2 to !modelarr.size()
			!dataList = !modelarr[!index].Split('￥')
			!tempid = !dataList[1]
			!tempName = !dataList[2]
			if !tempid eq !modelidorname or !tempname eq !modelidorname then
				!modelid = !tempid
				!modelServerName = ''
				!find = true
				break
			endif
			--q '模型服务ID：$!dataList[1]，模型服务名称：$!dataList[2]'
		enddo

		if !find.not() then
			if !modelidOrName.set() and !modelidOrName ne '' then
				!modelid = ''
				!modelServerName = !modelidOrName
			else
				!!alert.warning('模型名字或ID不应该为空值')
				return false
			endif
		endif


		-- 上传操作， 0删除替换， 1覆盖更新，2追加更新
		if !modelid.unset() or !modelid eq '' then
			!impModel = '2'
		else
			!impModel = '1'
		endif
	endif

	----login and check project model, get projectid and modelid or modelname e

	--!rvmpath = ''
	--!attpath = ''
	--!jsonpath = ''

	!jsonpath = !jsonpaths[$!times]

	--return
	--$(
	if !times eq 1 then
		$p
		$p rvm: $!rvmpath
		$p att: $!attpath
		$p project id: $!projectid
		$p model id:   $!modelid
		$p model server name: $!modelservername
		$p impModel: $!impmodel
		$p http: $!http
		$p token: $!token
		$p att id: $!attid
		$p json path: $!jsonpath
	else
		$p
		$p json path: $!jsonpath
	endif
	--$)



	--!rvmpath = ''
	--!attpath = ''
	--!jsonpath = 'D:\_6TFA0001B-S104-01.json'

	----update file to tplant s
	--!result = !obj.UpModelFile('','', !projectid,!modelid, !modelServerName, '',!http, !token, !attid,!jsonpath)		$*ONLY JSON for temp
	if !times eq 1 then
		!result = !obj.UpModelFile(!rvmPath,!attpath, !projectid,!modelid, !modelServerName, !impModel,!http, !token, !attid,!jsonpath)
	else
		!result = !obj.UpModelFile('','', !projectid,!modelid, !modelServerName, !impModel,!http, !token, !attid,!jsonpath)
	endif
--!!1l(!result,!times)
	----update file to tplant e
	--q var !result
	----return result s
	-- 处理结果信息
	!list = !result.Split('￥')
	if ( !list[1] eq '1' ) then
		!info = '发布成功 ' + !list[3]
		$p $!info
		--q var !list[3]
		--!!alert.message('发布成功')
		--return true
	elseif (!list[1] eq '0') then
		if !list[3].trim() eq '' then
		--q var !list[3]
			!info = '发布失败 没有返回其它信息'
		else
		--q var !list[3]
			--!info = '发布失败 ' + !list[3]
			!info = !list[3]
		endif
		--$p $!info
		!!alert.warning(!info)
		return false
	endif

	if !times lt !jsonpaths.size() then
		golabel /getmodelagain
	endif

	!!alert.message('发布成功')
	return true
endfunction
