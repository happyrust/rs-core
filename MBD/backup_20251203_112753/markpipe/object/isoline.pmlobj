--Method:
--Public method:
--isoline(!branname is string,!mems is array,!pipedir is direction, !minslope is real, !maxslope is real)   	$*init isoline
--draw()																	$*draw all objects in view

--Private method:
--draw(!type is string) 													$*draw all objects which object type is !type    useless now
--drawOneObject(!objectIndex is real)   									$*draw one object with index is !objectIndex
--getAttaDims() 															$*add ATTA object
--getusedDirs(!mindis is real, !maxdis is real) is array  				$*get all handledirs(used dirs) at one place with mindis and maxdis
--getIsoUsedDirs()  														$*get used dirs whick made of element with hand like TEE VALV
--getminMax(!object is any) is array										$*get min distance and max distance of element from start position of isoline
--getobjects()  															$*get attribution main dimension, objects, cheight, od
--getpoints(!mem is string) is array										$*get 8 points of volume of member
--tagori(!dimdir is direction) is orientation   							$*get orientation for tag


define object isoline
	member .branname is string
	member .mems is array
	member .pipedir is direction

	member .line is line

	member .od is real

	member .pos is position

	member .dimdir is direction

	member .usedDirs is array       $*array of isoUsedDir

	member .objects is array

	member .twoormoredims is boolean

	member .dimdirs is array
	member .chardirs is array
	--member .useGoodDirs is boolean


	member .mbdstru is mbdstru
	$(
	member .dimgro is string    $*Dimgro lindim

	member .dimslopelineGro is string   $*AIDGRO aidline    斜管
	member .dimslopeTextGro is string   $*AIDGRO aidtext    斜管

	member .slopeAidLineGro is string   $*aidGro aidline    坡管
	member .slopeAidTextGro is string   $*aidGro aidtext    坡管

	member .refMlabelGro is string $*dimGRO     mlabel
	member .posMlabelGro is string $*dimGro     mlabel
	$)

	member .cheight is real
	member .changeCheightAuto is boolean
	member .changeCheightAutobili is real
	member .sepSmallDim is boolean

	member .plusstringcheightbili is real

	member .cheightbili is real
	member .minslope is real
	member .maxslope is real

	member .firstDimTimes is real
	member .secondDimTimes is real

	--member .handleTypes is array

	--member .isoDim is isoDim
	--member .attadimarrs is array    $* array of isoDim
	--member .tags is array
	--member .meterials is array
	--member .welds is array

	member .polarsystem is polarsystem

	member .usepolarsystem is boolean
	--member .drawitems is array
	member .ignoreline is boolean
	member .considerprenextdir is boolean
	member .lookangle is real

	member .fromltor is boolean
	member .branlookdirection is direction
	member .prehoridir is direction

	member .isinstpipe is boolean

	member .wronglines is array

	member .tspec is string


	member .drawPforInst is boolean	$*仪表管加P
	member .addEleNum is boolean	$*材料加(X)

	member .obstline is line 	$*different from line, becase it maybe contains the elbo isoleg
endobject

define method .isoline(!branname is string,!mems is array,!pipedir is direction, !minslope is real, !maxslope is real, !considerprenextdir is boolean, !lookangle is real,!branlookdirection is direction,!isinstpipe is boolean,!prehoridir is direction)
	!this.branlookdirection = !branlookdirection
	if !prehoridir.set() then
		!this.prehoridir = !prehoridir
	endif
	!this.isoline(!branname,!mems,!pipedir, !minslope, !maxslope, !considerprenextdir, !lookangle,!isinstpipe)
endmethod
define method .isoline(!branname is string,!mems is array,!pipedir is direction, !minslope is real, !maxslope is real, !considerprenextdir is boolean, !lookangle is real,!fromltor is boolean,!isinstpipe is boolean,!prehoridir is direction)
	!this.fromltor = !fromltor
    --q var !prehoridir.set() !prehoridir
	if !prehoridir.set() then
		!this.prehoridir = !prehoridir
	endif
	!this.isoline(!branname,!mems,!pipedir, !minslope, !maxslope, !considerprenextdir, !lookangle,!isinstpipe)
endmethod
define method .isoline(!branname is string,!mems is array,!pipedir is direction, !minslope is real, !maxslope is real, !considerprenextdir is boolean, !lookangle is real,!isinstpipe is boolean)
	--!this.handleTypes = split('VALV PCOM INST VTWA TEE OLET')
	--q var !pipedir
	--!this.usepolarsystem = !usepolarsystem
    --q var !mems
    --return
	!this.usepolarsystem = true
	!this.considerprenextdir = !considerprenextdir
	!this.lookangle = !lookangle
	!this.branname = !branname
	!this.mems = !mems
	!this.minslope = !minslope
	!this.maxslope = !maxslope

	--

	--q var !this.mems
	!this.isinstpipe = !isinstpipe
	if !this.mems[1] eq 'Head' then
		!this.pos = hpos of $!this.branname wrt/*
	else
		!mem = !this.mems[1]
		if !!isrjpcom(!mem) then
			!p1pos = p1 pos of $!mem wrt/*
			!p9pos = p9 pos of $!mem wrt/*

			!p1dir = p1 dir of $!mem wrt/*
			if abs(!p1dir.angle(u) - 90) lt 10 then
				!adir = adir of $!mem wrt/*
				!templine = !p1pos.line(!p1pos.offset(!adir,-10000))
				!pos = !templine.near(!p9pos)
				!this.pos = !pos
			else
				if abs(!pipedir.angle(u) - 90) lt 10 then
					!this.pos = !p1pos
				else
					!p0pos = p0 pos of $!mem wrt/*
					!p3pos = p3 pos of $!mem wrt/*
					!tempdir = !p0pos.direction(!p3pos)
					!templine = !p1pos.line(!p1pos.offset(!tempdir,10000))
					!pos = !templine.near(!p9pos)
					!this.pos = !pos
					--!templine = !pos.line(!pos.offset(!pipedir,1000))
					--!this.pos = !templine.near(!p9pos)
				endif
			endif
		else
			!lpos = lpos of $!mem wrt/*
			!ldir = ldir of $!mem wrt/*
			!line = !lpos.line(!lpos.offset(!ldir,1000))
			!pos = pos of $!mem wrt/*
            --q var !line.distance(!pos)
			if !line.distance(!pos) gt 1 then	$* incase special element
				!pos = pos of $!mem wrt/*
				!this.pos = !line.near(!pos)
				--q var !pipedir
			else
				!this.pos = pos of $!this.mems[1] wrt/*
			endif
		endif
	endif
	!this.pipedir = !pipedir

	!this.getisolineinfo()

	!this.getIsoDims()
	if !this.wronglines.set() then
		return
	endif

	--if !this.usepolarsystem then
	--	!this.addpipeselftopolarsystem()
	--endif
	!this.ignoreline = false
endmethod



--202305221145 set line and polarsystem
define method .getisolineinfo()
	var !volume volume $!this.branname
	!pos1 = !volume.before(' to ').position().wrt(world)
	!pos2 = !volume.after(' to ').position().wrt(world)
	!cenpos = !pos1.midpoint(!pos2)

	!line = !this.pos.line(!this.pos.offset(!this.pipedir,1000))
	--!line.draw(1,1,1)
	!this.od = 0
	!maxdis = 0
    --q var !this.mems
	do !mem values !this.mems
        --q var !mem
		if !mem eq 'Head' then
			!pos = hpos of $!this.branname wrt/*
		elseif !mem eq 'Tail' then
			!pos = tpos of $!this.branname wrt/*
		else
			if !!isrjpcom(!mem) then
				if !this.pipedir.angle(d) lt 10 then
					!pos = p1 pos of $!mem wrt/*
				else
					!p9pos = p9 pos of $!mem wrt/*
					!templine = !this.pos.line(!this.pos.offset(!this.pipedir,10000))
					!pos = !templine.near(!p9pos)
				endif
			else
				!pos = pos of $!mem wrt/*
			endif
		endif
		!dis = !line.near(!pos).distance(!this.pos)
        --q var !dis
		!maxdis = max(!maxdis,!dis)
		--$p $!mem
		!this.od = max(!this.od,!this.getod(!mem))
	enddo
	--q var !maxdis


	--$p finish
	--$p
    --q var !this.pos !this.pipedir !maxdis
	!temppos = !this.pos.offset(!this.pipedir,!maxdis)

    --modify by jyg 20240808
    if !temppos eq  !this.pos then  $*起点和终点重合，会导致生产line失败。
       !temppos = !this.pos.offset(!this.pipedir,1)
    endif
	!this.line = !this.pos.line(!temppos)

    --!this.line.draw(1,1,1)
	if !this.usepolarsystem then

		if !this.considerprenextdir.set() and !this.considerprenextdir then
			!referencedirs = !this.getpreandnextdir()
		else
			!referencedirs = object array()
		endif
		--q var !this.branlookdirection
		--q var !this.od
		if !this.branlookdirection.set() then
			!this.polarsystem = object polarsystem(!this.pos,!this.line.endposition,!cenpos,!this.od / 2,!this.lookangle,!referencedirs,!this.branlookdirection,!this.isinstpipe,!this.prehoridir)
		else
			!this.polarsystem = object polarsystem(!this.pos,!this.line.endposition,!cenpos,!this.od / 2,!this.lookangle,!referencedirs,!this.fromltor,!this.isinstpipe,!this.prehoridir)
		endif
        --q var !this.polarsystem
		--!this.polarsystem = object polarsystem(!this.pos,!this.line.endposition,!cenpos,!this.od / 2)
		!this.addpipeselftopolarsystem()

		!this.addrealods()
	else
		!this.getIsoUsedDirs()
	endif
endmethod

define method .getpreandnextdir() is array $*获取管道的轴向（管道分段的朝向）
	!result = array()
	do !mem values !this.mems
		if !mem eq 'Head' or !mem eq 'Tail' then
			skip
		endif
		!adir = adir of $!mem wrt/*
		handle any
			skip
		elsehandle none
			!adir = !adir.opposite()	$*flow direction
		endhandle
		!ldir = ldir of $!mem wrt/*
		handle any
			skip
		endhandle
        --q var !mem !adir !ldir
		if !adir.angle(!ldir) gt 1 then
			!tempangle1 = abs(!adir.angle(!this.pipedir) - 90)
			!tempangle2 = abs(!ldir.angle(!this.pipedir) - 90)
			if !tempangle1 le !tempangle2 then
				!result.append(!adir)
			else
				!result.append(!ldir)
			endif

			if !result.size() eq 2 then
				break
			endif
		endif
	enddo
	!result.unique()
    --q var !result
	return !result
endmethod

define method .getod(!mem is any) is real
	!od = aod of $!mem wrt/*
	handle any
		if !this.mems.set() then
			!od = aod of first tubi of $!this.branname
			handle any
				!od = aod of first mem of $!this.branname
				handle any
                        !od = 0
				endhandle
			endhandle


		else
			!od = aod of last tubi of $!this.branname
			handle any
				!od = lod of last mem of $!this.branname
				handle any
					!od = 0
				endhandle
			endhandle
		endif
	endhandle

    --modify by jyg 20241118 解决firstmem是cap，处理无法获取od的情况。
    var !Memtype type of first mem of $!this.branname
    if  !od.value() eq 0 and !Memtype eq 'CAP' then
        !od = lod of first mem of $!this.branname
    endif

	if !od eq 0 then
		if !mem ne 'Head' and !mem ne 'Tail' then
            --modify by jyg 20240925
            if  type of $!mem inset('PCOM') then
                !abore = abore of $!mem
                handle any
                    !abore = lbore of $!mem
                endhandle
                !lbore = lbore of $!mem
            else
                !abore = abore of $!mem
                !lbore = lbore of $!mem
            endif

			if !abore eq !lbore then
				!od = lod of $!mem wrt/*
			endif
			if !od eq 0 then
				!bore = abore of $!mem
				!od = min(!bore.real() * 1.1,!bore.real() + 10)
			endif
		elseif !mem eq 'Head' then
			!bore = hbore of $!this.branname
            --modify by jyg 20241128 解决hbore为空的问题
            if !bore.unset() then
                !bore = abore of first mem of $!this.branname
            endif
			!od = min(!bore.real() * 1.1,!bore.real() + 10)
		elseif !mem eq 'Tail' then
			!bore = tbore of $!this.branname
            --modify by jyg 20241128 解决hbore为空的问题
            if !bore.unset() then
                !bore = abore of last mem of $!this.branname
            endif
			!od = min(!bore.real() * 1.1,!bore.real() + 10)
		endif
	endif
	return !od
endmethod

define method .getIsoDims()
	!isoDim = object isoDim(!this.branname,!this.mems,!this.pipedir,!this.minslope,!this.maxslope,!this.od)
    --Q VAR !isoDim
	--q var !isodim.wronglines
    --q var !isodim
	if !isodim.wronglines.set() then
		!this.wronglines.appendarray(!isodim.wronglines)
		return
	endif
	!isoDim.mainDim = true
	if !isodim.poss[1].distance(!isodim.poss.last()) lt 1 then
        --Q VAR !isoDim
		return
	endif


	--!isoDim.usepolarsytem = !this.usepolarsystem
	--!isodim.polarsystem = !this.polarsystem
	--Q VAR !this.usepolarsystem.not()
	if !this.usepolarsystem.not() then
		!this.objects.append(!isoDim)
		--!this.usedDirs.appendarray(!isoDim.usedDirs)
		--!this.od = !isodim.od



		--$p $!this.od
		--!this.getcheight()
		--!this.dimdir = !isodim.dimdir
		!this.getAttaDims(!isodim)
		if !this.wronglines.set() then
			return
		endif
	else
		!this.getAttaDims(!isodim)
		if !this.wronglines.set() then
			return
		endif
		!this.objects.append(!isoDim)
	endif

	--Q VAR !this.objects
	--------set line and polarsystem		202305191832
	--!this.line = !isodim.poss[1].line(!isodim.poss.last())
endmethod

--define method .getcheight(!cheightBili is real) is real
--!this.cheight = int(!this.od * !cheightBili)
--return !this.cheight
--endmethod

define method .getIsoUsedDirs()

	do !mem values !this.mems
		!memtype = type of $!mem
		handle any
			skip
		endhandle

		--if !mem eq 'Head' or !mem eq 'Tail' then
		--    skip
		--endif


		!p3pos = p3 pos of $!mem wrt/*
		handle any
			!havehand = false
		elsehandle none
			!p1dir = p1 dir of $!mem wrt/*
			!p1pos = p1 pos of $!mem wrt/*
			!line = !p1pos.line(!p1pos.offset(!p1dir,1000))
			if !line.distance(!p3pos) gt 1 then
				!p2pos = p2 pos of $!mem wrt/*
				if !p2pos.distance(!p1pos) lt 1 then
					!havehand = true
				else
					if !line.distance(!p2pos) gt 1 then
						!havehand = false		$* elbo bend and so on
					else
						!havehand = true
					endif
				endif
			else
				!havehand = false
			endif
		endhandle

		!handledirs = array()
		--if !this.handletypes.findfirst(!memtype).set() then
		if !havehand then

			if !memtype eq 'TEE' or !memtype eq 'OLET' then
				!dir1 = p1 dir of $!mem
				if abs(abs(!dir1.angle(!this.pipedir) - 90) - 90) lt 1 then
					!handledir = p3 dir of $!mem
					handle any                      $*应该是模型有问题
						skip
					endhandle
					!handledirs.append(!handledir)
				else
					!handledir = p1 dir of $!mem
					!handledirs.append(!handledir)
					!handledir = p2 dir of $!mem
					!handledirs.append(!handledir)
				endif
			else
				!handledir = p3 dir of $!mem
				--!ori = ori of $!mem wrt/*
				--!handledir = !ori.zdir()
				!handledirs.append(!handledir)

			endif
		else
			skip
		endif


		!poss = !this.getpoints(!mem)
		!mindis = 100000000
		!maxdis = -100000000

		do !pos values !poss
			!nearpos = !this.line.near(!pos)
			!dis = !this.pos.distance(!nearpos)
			!dir = !this.pos.direction(!nearpos)
			handle any
			elsehandle none
				if !dir.angle(!this.line.direction()) gt 90 then
					!dis = - !dis
				endif
			endhandle
			!mindis = min(!mindis,!dis)
			!maxdis = max(!maxdis,!dis)
		enddo

		do !handledir values !handledirs
			!isousedDir = object isoUsedDir(!mem,!handledir,!mindis,!maxdis,'Handle',60)
			!this.useddirs.append(!isousedDir)
		enddo
	enddo
endmethod

define method .addrealods()
	!sprefs = array()
	!ods = array()

	do !index indices !this.mems
		!mem = !this.mems[!index]
		!memtype = type of $!mem
		handle any
			skip
		endhandle
		if !mem eq 'Head' or !mem eq 'Tail' then
			skip
		endif
		if !memtype eq 'TUBI' or !memtype eq 'FTUB' or !memtype eq 'ATTA' then
			skip
		endif

		!spref = name of spref of $!mem
		!sprefindex = !sprefs.findfirst(!spref)
		if !sprefindex.unset()then
			!od = !!getpipemaxdia(!mem)
			if !od eq 0 then
				!od = !this.od
			endif
			!sprefs.append(!spref)
			!ods.append(!od)
		else
			!od = !ods[!sprefindex]
		endif

        --modify by jyg 20240925
        !lconn = lconn of $!mem
		!aconn = aconn of $!mem
        handle any
            !aconn = !lconn
        endhandle


		!matchtypes = split('SW SC EU')

		!amatch = false
		do !onetype values !matchtypes
			if !aconn.match(!onetype) ne 0 then
				!amatch = true
				break
			endif
		enddo

		!lmatch = false
		do !onetype values !matchtypes
			if !lconn.match(!onetype) ne 0 then
				!lmatch = true
				break
			endif
		enddo

        --modify by jyg 20240925
        !ldir = ldir of $!mem wrt/*
        !lpos = lpos of $!mem wrt/*
        !adir = adir of $!mem wrt/*
        handle any
            !adir = !ldir.opposite()
        endhandle
        !apos = apos of $!mem wrt/*
        handle any
            !apos = !lpos
        endhandle


		--!apos = !apos.offset(!this.pipedir, - !this.od)
		!apos = !apos.offset(!this.pipedir, - !od)
		--!lpos = !lpos.offset(!this.pipedir, !this.od)
		!lpos = !lpos.offset(!this.pipedir, !od)
		!pos = pos of $!mem wrt/*
		if !amatch and !lmatch then
			if !adir.angle(!ldir) lt 178 then
				if !adir.angle(!this.pipedir) gt 178 then
					!polarcyli = object polarcyli(!apos.midpoint(!pos),!this.polarsystem.ori,!od,!apos.distance(!pos))
				else
					!polarcyli = object polarcyli(!lpos.midpoint(!pos),!this.polarsystem.ori,!od,!lpos.distance(!pos))
				endif
				!this.polarsystem.add(!polarcyli,true)
			else
				!polarcyli = object polarcyli(!apos.midpoint(!lpos),!this.polarsystem.ori,!od,!apos.distance(!lpos))
				!this.polarsystem.add(!polarcyli,true)
			endif

			if !memtype eq 'TEE' then
				!arrive = arrive of $!mem
				!leave = leave of $!mem
				!temparr = split('1 2 3')
				!temparr[!temparr.findfirst(!arrive.string())].delete()
				!temparr[!temparr.findfirst(!leave.string())].delete()
				!temparr.compress()
				!p3num = !temparr[1]

				!p3pos = p$!p3num pos of $!mem wrt/*
				!p3dir = p$!p3num dir of $!mem wrt/*

				!p3pos = !p3pos.offset(!p3dir,!od)

				!tempori = z is $!p3dir
				!polarcyli = object polarcyli(!pos.midpoint(!p3pos),!tempori,!od,!pos.distance(!p3pos))
				!this.polarsystem.add(!polarcyli,true)
			endif
		elseif !amatch then
			if !adir.angle(!this.pipedir) gt 178 then
				!polarcyli = object polarcyli(!apos.midpoint(!pos),!this.polarsystem.ori,!od,!apos.distance(!pos))
				!this.polarsystem.add(!polarcyli,true)
			endif
		elseif !lmatch then
			if !ldir.angle(!this.pipedir) lt 2 then
				!polarcyli = object polarcyli(!lpos.midpoint(!pos),!this.polarsystem.ori,!od,!lpos.distance(!pos))
				!this.polarsystem.add(!polarcyli,true)
			endif
		elseif !memtype eq 'FLAN' or !memtype eq 'FBLI' then
			!polarcyli = object polarcyli(!apos.midpoint(!lpos),!this.polarsystem.ori,!od,!apos.distance(!lpos))
			!this.polarsystem.add(!polarcyli,true)
		endif
	enddo
endmethod

define method .addpipeselftopolarsystem()
	-----------add pipe self and set basic radius for polarsystem
	!ori = !this.polarsystem.ori
	--q var !ori
	!diss = array()
	!diss.append(0)
    --Q VAR !this.line
	!diss.append(!this.line.length())
	var !attas coll all atta for $!this.branname
    --Q VAR !attas
	!tolerance = 5
	do !mem values !attas
		!mempos = pos of $!mem wrt/*
		if !mempos.distance(!this.line.startposition) lt !tolerance or !mempos.distance(!this.line.endposition) lt !tolerance then
			!p1dir = p1 dir of $!mem wrt/*
			!p2dir = p2 dir of $!mem wrt/*
			if !p1dir.angle(!p2dir) lt 170 then
				!temparr = array()
				!temparr.append(!mem)
				!pipeatta = object pipeatta(!temparr)
				do !object values !pipeatta.attaobjects
					if !object.objecttype() eq 'ISOLEG' and !object.elboname.set() then
						!angle = !object.ori.zdir().angle(!this.pipedir)
						if !angle lt 1 or !angle gt 179 then
							!diss.append(!!suidirdis(!this.line.startposition,!this.line.direction(),!object.pos.offset(!object.ori.zdir(),!object.height / 2)))
							!diss.append(!!suidirdis(!this.line.startposition,!this.line.direction(),!object.pos.offset(!object.ori.zdir(), - !object.height / 2)))

						endif
					endif
				enddo
			endif
		endif
	enddo
	!diss.sort()
	--q var !this.line.startposition !diss[1]
	!obstlinepos1 = !this.line.startposition.offset(!this.line.direction(),!diss[1])
	!obstlinepos2 = !this.line.startposition.offset(!this.line.direction(),!diss.last())
	!this.obstline = !obstlinepos1.line(!obstlinepos2)	$* add a new member for elbo isoleg



	!polarcyli = object polarcyli(!this.pos.offset(!this.pipedir,!this.obstline.length() / 2),!ori,!this.od,!this.obstline.length())
	--!polarcyli = object polarcyli(!this.pos.offset(!this.pipedir,!this.line.length() / 2),!ori,!this.od,!this.line.length())
	!this.polarsystem.add(!polarcyli,true)
	handle any
		return  		$* it is very possible that the model is wrong
	endhandle
	--!this.polarsystem.basicRadius = !this.od / 2


	-----------add mem
    --Q VAR !this.mems
	do !index indices !this.mems
		!mem = !this.mems[!index]
		--do !mem values !this.mems
		!memtype = type of $!mem
		handle any
			skip
		endhandle


		--if !memtype eq 'INST' then
		if !this.isinstpipe and !memtype eq 'INST' then
			!havehand = true
			golabel /handok
		endif

		if !memtype eq 'PCOM' then	$*because p3 of pcom is on line of p1 an p2
			--if !!isrjpcom(!mem) and !index eq !this.mems.size() then
			--	skip
			--endif
			!havehand = true
			golabel /handok
		endif

		!p3pos = p3 pos of $!mem wrt/*
		handle any
			!havehand = false
		elsehandle none
			!p1dir = p1 dir of $!mem wrt/*
			!p1pos = p1 pos of $!mem wrt/*
			handle any
				-----------------------
				-----------------------ATTA for 挡块 e.g. /K104.002/ATTA-05
				!havehand = false
			elsehandle none
				!line = !p1pos.line(!p1pos.offset(!p1dir,1000))
				if !line.distance(!p3pos) gt 1 then
					!p2pos = p2 pos of $!mem wrt/*
					if !p2pos.distance(!p1pos) lt 1 then
						!havehand = true
					else
						if !line.distance(!p2pos) gt 1 then
							!havehand = false		$* elbo bend and so on
						else
							!havehand = true
                            --$p 58
						endif
					endif
				else
					!havehand = false
				endif
			endhandle
		endhandle
		--Q VAR !HAVEHAND
		label /handok
		!handledirs = array()
		--if !this.handletypes.findfirst(!memtype).set() then
		if !havehand then
			--q var !mem
			!temppos = pos of $!mem wrt/*
			!p3pos = p3 pos of $!mem wrt/*
			handle any
				if !memtype ne 'INST' and !memtype ne 'PCOM' then
					skip
				endif
			endhandle

			--$p $!mem 0 $!index
            --Q VAR !mem
			if !memtype eq 'TEE' or !memtype eq 'OLET' then
				--!p3pos = p3 pos of $!mem wrt/*
				if !memtype eq 'TEE' then
					!aconn = aconn of $!mem

					!matchtypes = split('SW SC EU')

					!amatch = false
					do !onetype values !matchtypes
						if !aconn.match(!onetype) ne 0 then
							!amatch = true
							break
						endif
					enddo
					if !amatch then
						skip	$*considered in addrealods()
					endif
				endif
				!dir1 = p1 dir of $!mem
				!aod = aod of $!mem
				!p1bore = p1 bore of $!mem
				!thick = !aod.value() - !p1bore.real().value()
				if abs(abs(!dir1.angle(!this.pipedir) - 90) - 90) lt 1 then		$* 1 2 点在管段轴线上
					--$p $!mem 1
					if !index eq !this.mems.size() then
						skip
					endif
					!handledir = p3 dir of $!mem wrt/*
					handle any                      $*应该是模型有问题
						skip
					endhandle
					--$p $!mem 2
					!p3bore = p3 bore of $!mem
                    --modify by jyg 20241220 处理oletp3点口径为0时的问题
                    if  !p3bore.unset() then
                        !p3bore = object bore(0)
                    endif
                    --Q VAR  !p3bore !thick
					!diameter = !p3bore.real().value() + !thick
					!tempori = z is $!handledir
					!temppos = !temppos.offset(!handledir,!this.od / 2)

					--!p3pos = !p3pos.offset(!handledir,!this.od * 10)	$*2022306141708
					!p3conn = p3 conn of $!mem
					--q var !p3conn
					if !p3conn.match('SW') ne 0 or !p3conn.match('EUF') ne 0 then
						if !this.isinstpipe then
							!p3pos = !p3pos.offset(!handledir,!this.od * 3)
						else
							!p3pos = !p3pos.offset(!handledir,!this.od)
						endif
					else
						!p3pos = !p3pos.offset(!handledir,!this.od * 0.5)
					endif

					!polarcyli = object polarcyli(!temppos.midpoint(!p3pos),!tempori,!diameter, !temppos.distance(!p3pos))
					!this.polarsystem.add(!polarcyli,true)
				else
					-----------------------
					-----------------------3点在管段轴线上
					--$p $!mem 3
					!handledir = p1 dir of $!mem

					!p1pos = p1 pos of $!mem wrt/*
					!p1bore = p1 bore of $!mem
					!diameter = !p1bore.real().value() + !thick
					!tempori = z is $!handledir

					!p1pos = !p1pos.offset(!handledir,!this.od * 0.5) $*202309071121
					--!p1pos = !p1pos.offset(!handledir,!this.od * 10)	$*2022306141708
					!polarcyli = object polarcyli(!temppos.midpoint(!p1pos),!tempori,!diameter, !temppos.distance(!p1pos))
					!this.polarsystem.add(!polarcyli,true)


					!handledir = p2 dir of $!mem
					!p2pos = p2 pos of $!mem wrt/*
					!p2bore = p2 bore of $!mem
					!diameter = !p2bore.real().value() + !thick
					!tempori = z is $!handledir
					--!p2pos = !p2pos.offset(!handledir,!this.od * 10)	$*2022306141708
					!p2pos = !p2pos.offset(!handledir,!this.od * 0.5)	$*2022309071121

					!polarcyli = object polarcyli(!temppos.midpoint(!p2pos),!tempori,!diameter, !temppos.distance(!p2pos))
					!this.polarsystem.add(!polarcyli,true)
				endif
			else
				--------bad
				--$p $!mem
				!polarbox = !this.getpolarbox(!mem)

				!this.polarsystem.add(!polarbox,true)
				skip

				--!p3pos = p3 pos of $!mem wrt/*
				-----------------------
				-----------------------for valvs, it needs too much time to calculate primitive
				!temppos = pos of $!mem wrt/*
				--q var !mem
				!nvol = nvol of $!mem

				!handledir = p3 dir of $!mem
				!poss = !this.getpoints(!mem)
				!mindis = 100000000
				!maxdis = -100000000

				!zmindis = 100000000
				!zmaxdis = -100000000
				do !pos values !poss
					!dis = !!suidirdis(!this.pos,!this.pipedir,!pos)
					$(
					!nearpos = !this.line.near(!pos)
					!dis = !this.pos.distance(!nearpos)
					!dir = !this.pos.direction(!nearpos)
					handle any
					elsehandle none
						if !dir.angle(!this.line.direction()) gt 90 then
							!dis = - !dis
						endif
					endhandle
					$)
					!mindis = min(!mindis,!dis)
					!maxdis = max(!maxdis,!dis)

					!zdis = !!suidirdis(!temppos,!handledir,!pos)
					!zmindis = min(!zmindis,!zdis)
					!zmaxdis = max(!zmaxdis,!zdis)
				enddo
				!diameter = !maxdis - !mindis


				$(
				------------------------------------------------------202311241509
				!apos = apos of $!mem
				!lpos = lpos of $!mem
				!aldis = !apos.distance(!lpos)
				if !aldis gt 1 then
					!diameter = min(!diameter,!aldis)
				endif
				$)
				--$(
				--202311241509
				if !memtype eq 'VALV' then

					-----------------------
					-----------------------valv volume maybe too large, use this method to get a better one
					!tempvol = pi * !diameter.power(2) / 4 * (!zmaxdis - !zmindis)
					!voltimes = 10
					if !tempvol gt !nvol * !voltimes then

						!diameter = !diameter / (!tempvol / (!nvol * !voltimes))

					endif
				endif
				--$)

				!tempori = z is $!handledir

				--!polarcyli = object polarcyli(!temppos.offset(!handledir,(!zmindis + !zmaxdis) / 2),!tempori,!diameter, !zmaxdis - !zmindis)
				--$p $!mem $!diameter
				--if - !zmindis gt !this.od then
				--$(
				!flag = 0
				if - !zmindis gt 1.5 * !this.od / 2 then  $*202308261447
					!flag = 1
					--if - !zmindis gt !diameter / 2 then
					-----------------------
					-----------------------if the lower part is large, consider this part
					--$p $!mem $!zmindis $!diameter $!this.od

					!xlen = !poss[1].distance(!poss[3])
					!ylen = !poss[1].distance(!poss[4])
					!zlen = !poss[1].distance(!poss[5])
					if !zlen ge !xlen and !zlen ge !ylen then
						!polarcyli = object polarcyli(!temppos.offset(!handledir,(!zmindis + !zmaxdis) / 2),!tempori,!diameter, !zmaxdis - !zmindis)
					else
						!adir = adir of $!mem wrt/*
						!xangle = !adir.angle(e)
						if !xangle lt 20 or !xangle gt 160 and !xlen gt !zlen then
							!tempori = z is e and y is u
							!polarcyli = object polarcyli(!poss[1].midpoint(!poss[2]),!tempori,max(!zlen,!ylen), !xlen)
						else
							!yangle = !adir.angle(n)
							if !yangle lt 20 or !yangle gt 160 and !ylen gt !zlen then
								!tempori = z is n and y is u
								!polarcyli = object polarcyli(!poss[1].midpoint(!poss[2]),!tempori,max(!zlen,!xlen), !ylen)
							else
								!polarcyli = object polarcyli(!temppos.offset(!handledir,(!zmindis + !zmaxdis) / 2),!tempori,!diameter, !zmaxdis - !zmindis)
							endif
						endif
					endif
				else
					--in order to save calculating time
					!flag = 2
					!temppos = pos of $!mem wrt/*
					!p3pos = p3 pos of $!mem wrt/*
					if !memtype eq 'VALV' then
						!p3pos = !p3pos.offset(!handledir, !temppos.distance(!p3pos))		$*valv height is not decided by p3, so extend 2 times
					endif
					!polarcyli = object polarcyli(!temppos.midpoint(!p3pos),!tempori,!diameter, !temppos.distance(!p3pos))
				endif

				--$)
				!this.polarsystem.add(!polarcyli,true)
			endif
		else
			skip
		endif
	enddo
endmethod

define method .getpoints(!mem is string) is array
	--q var !mem
    --$p 5656
	var !volume vol $!mem
	!pos1 = !volume.before(' to ').position().wrt(world)
	!pos2 = !volume.after(' to ').position().wrt(world)


	!poss = array()
	!poss.append(!pos1)
	!poss.append(!pos2)
	!temppos = !pos1
	!temppos.east = !pos2.east
	!poss.append(!temppos)

	!temppos = !pos1
	!temppos.north = !pos2.north
	!poss.append(!temppos)

	!temppos = !pos1
	!temppos.up = !pos2.up
	!poss.append(!temppos)

	!temppos = !pos2
	!temppos.east = !pos1.east
	!poss.append(!temppos)

	!temppos = !pos2
	!temppos.north = !pos1.north
	!poss.append(!temppos)

	!temppos = !pos2
	!temppos.up = !pos1.up
	!poss.append(!temppos)
	return !poss
endmethod


define method .getpolarbox(!mem is string) is polarbox
	var !volume vol $!mem
	!pos1 = !volume.before(' to ').position().wrt(world)
	!pos2 = !volume.after(' to ').position().wrt(world)
	!pos = !pos1.midpoint(!pos2)
	!ori = x is e and z is u
	!xlen = abs(!pos1.east - !pos2.east)
	!ylen = abs(!pos1.north - !pos2.north)
	!zlen = abs(!pos1.up - !pos2.up)
	!polarbox = object polarbox(!pos,!ori,!xlen,!ylen,!zlen)
	return !polarbox
endmethod


------------------------------------------------------------------------------------------------------------------
define method .getelbolegdims()
----------------------
----------------------Step x:change elbo isoleg to isodim
--$p 1
	do !index indices !this.objects
    --$p 2
		!object = !this.objects[!index]
        --q var !object
		if !object.objecttype() eq 'ISOLEG' and !object.elboname.set() then
			!isoDim = object isoDim(!object)
            --q var !isoDim
			!this.objects[!index].delete()
			!this.objects[!index] = !isodim

			!have = true
		endif
		!object.delete()
	enddo
endmethod
define method .getAttaDims(!mainisodim is isodim)
	!this.twoormoredims = false

	$(
	do !object values !this.objects
		if !object.objecttype() eq 'ISODIM' then
			!mainisodim = !object
			break
		endif
	enddo
	--q var !mainisodim
	if undefined(!mainIsoDim) then
		return
	endif
	$)
	!attaDims = array()
	var !mode mode


	do !mem values !this.mems
        --q var !mem
		!memtype = type of $!mem
		if !memtype eq 'ATTA' then
			!attapos = pos of $!mem wrt/*
			!attadis = !!suidirdis(!this.line.startposition,!this.pipedir,!attapos)

			!mindis = 1000000
			if !attadims.set() then
				!findattadim = false
				do !dimindex indices !attadims

					if !attadims[!dimindex].diss[1] le !attadis and !attadims[!dimindex].diss.last() ge !attadis then


						!attaDims[!dimindex].addmem(!mem)
						if !attaDims[!dimindex].wronglines.set() then
							!this.wronglines.appendarray(!attaDims[!dimindex].wronglines)
							return
						endif

						!findattadim = true
						break
					elseif !attadis gt !attadims[!dimindex].diss.last() then
						!tempdis = !attadis - !attadims[!dimindex].diss.last()
						if !tempdis lt !mindis then
							!goodindex = !dimindex
							!mindis = !tempdis
						endif
					endif
				enddo
				if !findattadim then
					skip
				endif
			endif


			!findmaindim = false
			!mainmindis = 1000000
			do !index indices !mainisodim.diss
				if !mainisodim.diss[!index] gt !attadis then
					if !index eq 1 then
						$p 请检查该元件 $!mem 在Bran中的顺序或坐标是否在相应管段上 1 /Please check the position/order of ATTA
						!this.wronglines.append('请检查该元件 $!mem 在Bran中的顺序或坐标是否在相应管段上 1 /Please check the position/order of ATTA ' & !mem)
						return
					endif
					!mainmindis = !attadis - !mainisodim.diss[!index - 1]
					if !index eq 1 then
						!mainisodim.addmem(!mem)
						--q var !mainisodim.wronglines !aa !mem
						if !mainisodim.wronglines.set() then
							!this.wronglines.appendarray(!mainisodim.wronglines)
							return
						endif

						--!attaDim = !mainIsoDim.copy(0,!mem)
						--!attaDims.append(!attaDim)
						!findmaindim = true
						break
					elseif !mainmindis lt !mindis then

						!attaDim = !mainIsoDim.copy(!index - 1,!mem)
						if !attaDim.wronglines.set() then
							!this.wronglines.appendarray(!attaDim.wronglines)
							return
						endif

						!attaDims.append(!attaDim)


						!findmaindim = true
						break
					endif
					break
				endif
			enddo



			if !findmaindim.not() then
				if !mainmindis eq 1000000 then
					!mainmindis = !attadis - !mainisodim.diss.last()
				endif
				if !mainmindis lt !mindis then
					!mainisodim.addmem(!mem)
					if !mainisodim.wronglines.set() then
						!this.wronglines.appendarray(!mainisodim.wronglines)
						return
					endif
				else
					!attaDims[!goodindex].addmem(!mem)
					if !attaDims[!goodindex].wronglines.set() then
						!this.wronglines.appendarray(!attaDims[!goodindex].wronglines)
						return
					endif
				endif
			endif
		endif
	enddo

	$(
	do !mem values !this.mems
		!memtype = type of $!mem
		--$p $!memtype
		if !memtype eq 'ATTA' then
			!premem = !mem
			!find = false
			--$p $!premem   asdfasdf
			do
				var !premem ref of pre of $!premem
				handle any
					!premem = 'Head'
				endhandle
				if !attaDims.set() then
					if !attaDims.last().mems.last() eq !premem then
						!attaDims[!attaDims.size()].addmem(!mem)
						!find = true
						break
					endif
				endif

				!index = !mainIsoDim.mems.findfirst(!premem)
				--q var !index
				if !index.set() then
					!attaDim = !mainIsoDim.copy(!index,!mem)


					!attaDims.append(!attaDim)
					break
				else
					-- normal  ex  weld
					--$p jkkk
					--$p $!premem
				endif
			enddo
		endif
	enddo
	$)

	$!mode
	if !attadims.size() ne 0 then
		!this.twoormoredims = true
	endif
	do !attadim values !attadims
		if !attadim.poss.size() ge 2 and !attadim.poss[1].distance(!attadim.poss.last()) gt 1 then
			!this.objects.append(!attadim)
		endif
	enddo
	--!this.objects.appendarray(!attaDims)
endmethod

define method .mergebolttext(!x is real, !otherboltindices is array ,!othershowitems is array) is string
	--modify by jyg 20241119 修改法兰垫片显示为零部件序号
    --!showtext = 'B' + !this.objects[!x].order.string()
    !showtext = !this.objects[!x].specialnum

	!elenumtext = '(' & !this.objects[!x].specialnum & ')'
	!tempindices = !othershowitems.find(!this.objects[!x].showitem)
	do !y values !tempindices
		!objectindex = !otherboltindices[!y]
		-----------------------
		-----------------------some bolt things such as cap tap wash nut and so on, to show them with stud
        --modify by jyg 20241119 修改法兰垫片显示为零部件序号
		--!showtext = !showtext + '/B' + !this.objects[!objectindex].order.string()
        !showtext = !showtext + '/' + !this.objects[!objectindex].specialnum

        !elenumtext = !elenumtext & '/(' & !this.objects[!objectindex].specialnum & ')'
        --q var !elenumtext
		!this.objects[!objectindex].toshow = false

		!otherboltindices[!y].delete()
		!othershowitems[!y].delete()
	enddo
	!otherboltindices.compress()
	!othershowitems.compress()

	!this.objects[!x].elenumtext = !elenumtext
	return !showtext
endmethod

define method .mergeshowtext()
	!boltindices = array()
	!boltitems = array()
	!showitems = array()

	!otherboltindices = array()		$*cap wash nut and so on
	!otherboltitems = array()
	!othershowitems = array()

	!indices = array()
	!names = array()


	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 1:separate 1 bolt, 2 bolt-cap nut wash and so on, 3 other things
	do !x indices !this.objects
		if !this.objects[!x].objecttype() eq 'ISOMATERIAL' then
			if !this.objects[!x].type eq 'BOLT' then
				!boltindices.append(!x)
				!boltitems.append(!this.objects[!x].name)
				!showitems.append(!this.objects[!x].showitem)
			elseif !this.objects[!x].type.matchwild('BOLT*') then
				!otherboltindices.append(!x)
				!otherboltitems.append(!this.objects[!x].name)
				!othershowitems.append(!this.objects[!x].showitem)
			else
				!indices.append(!x)
				!names.append(!this.objects[!x].name)
			endif
		endif
	enddo

	--q var !names

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 2: merge texts for bolt things
	--!bolttexts = array()
	--!boltshowitems = array()
	!considers = array()
	do !x values !boltindices
		--!!2l(!otherboltindices,!othershowitems,'before')

		!showtext = !this.mergebolttext(!x,!otherboltindices,!othershowitems)
        --q var !showtext
		--!!2l(!otherboltindices,!othershowitems,'after')
		-----------------------
		-----------------------otherboltindices othershowitems would be less and less than before


		--!!2l(!this.objects[!x],!this.objects[!x].showitem,'after')
		if !this.objects[!x].showitem.split().size() eq 1 then				$*showitem is item
			!this.objects[!x].toshow = false
			--!bolttexts.append(!showtext)
			--!boltshowitems.append(!this.objects[!x].showitem)
			--!!3l(!showtext,!this.objects[!x].showitem,!this.objects[!x],!x)
			--!considers.appendarray(!this.mergebolttexttoshowitem(!this.objects[!x].showitem, !showtext, !indices, !names))
			!considers.appendarray(!this.mergebolttexttoshowitem(!x, !showtext, !indices, !names))
		else																$*showitem is position
			!this.objects[!x].isotext = !showtext
			!this.objects[!x].boltshowpos = !this.objects[!x].showitem.position()
		endif
	enddo


	-----------------------------------------------------------------------------------only for some flan and gask which are not in relativemems of bolt
	-----------------------------------------------------------------------------------Step 3:merge flan and gask, and attach bolt text to showitem

	do !x indices !indices
		if !considers.findfirst(!x).set() then
			skip
		endif
		!considers.append(!x)
		!xtype = type of $!names[$!x]
		if not(!xtype inset ('FBLI','FLAN','GASK')) then
			skip
		endif
		!tempname = !!getpremem(!names[!x])
		!theotherindex = !names.findfirst(!tempname)
		if !theotherindex.unset() or !considers.findfirst(!theotherindex).set() then
			!tempname = !!getnextmem(!names[!x])
			!theotherindex = !names.findfirst(!tempname)
			if !theotherindex.unset() or !considers.findfirst(!theotherindex).set() then
				skip
			endif
		endif

		!index1 = !indices[!x]
		!index2 = !indices[!theotherindex]

		!mem1 = !names[!x]
		!mem2 = !names[!theotherindex]
		!mem1type = type of $!mem1
		!mem2type = type of $!mem2

		if !mem1type eq 'GASK' and !mem2type inset ('FLAN','FBLI') then
			!gaskindex = !index1
			!flanindex = !index2
		elseif !mem2type eq 'GASK' and !mem1type inset ('FLAN','FBLI') then
			!gaskindex = !index2
			!flanindex = !index1
		else
			skip
		endif
        --q var !theotherindex
		!considers.append(!theotherindex)
		!this.objects[!index1].toshow = false
        --modify by jyg 20241119 修改法兰垫片显示为零部件序号
		--!this.objects[!index2].isotext = 'F' + !this.objects[!index2].order.string() + '/G' + !this.objects[!index1].order.string()
		!this.objects[!index2].isotext = !this.objects[!index2].specialnum + '/' + !this.objects[!index1].specialnum

		!elenumtext = '(' & !this.objects[!index2].specialnum & ')/(' + !this.objects[!index1].specialnum & ')'
		!this.objects[!index2].elenumtext = !elenumtext
	enddo


	$(
	!merge = false
	do !x from 1 to !indices.size() - 1
		if !merge then
			!merge = false
			skip
		endif
		if !considers.findfirst(!x).set() or !considers.findfirst(!x + 1).set() then
			skip
		endif
		!index1 = !indices[!x]
		!index2 = !indices[!x + 1]
		--q var !indices !x
		!mem1 = !names[!x]
		!mem2 = !names[!x + 1]
		!mem1type = type of $!mem1
		!mem2type = type of $!mem2

		if !mem1type eq 'GASK' and !mem2type inset ('FLAN','FBLI') then
			!this.objects[!index1].toshow = false
			!this.objects[!index2].isotext = 'F' + !this.objects[!index2].order.string() + '/G' + !this.objects[!index1].order.string()
		elseif !mem2type eq 'GASK' and !mem1type inset ('FLAN','FBLI') then
			!this.objects[!index2].toshow = false
			!this.objects[!index1].isotext = 'F' + !this.objects[!index1].order.string() + '/G' + !this.objects[!index2].order.string()
		endif
	enddo
	$)
endmethod

-----------------------
-----------------------add Fxxxxx/Gxxxx in relativemems of one bolt
define method .mergebolttexttoshowitem(!inputx is real, !bolttext is string, !indices is array, !names is array) is array
	!x = !inputx
	!relativemems = !this.objects[!x].relativemems
	do !x indices !relativemems
		if name of owner of $!relativemems[$!x] ne !this.branname then
			!relativemems[!x].delete()
		endif
	enddo
	!relativemems.compress()

	!showitem = !this.objects[$!inputx].showitem
	!relaindex = !relativemems.findfirst(!showitem)
	if !relaindex.unset() then
		!tempitem = name of $!showitem
		!relaindex = !relativemems.findfirst(!tempitem)
	endif
	!showtype = type of $!showitem

	!oneconsiders = array()
	!oneconsiders.append(!relaindex)

	!considers = array()

	!tempindex = !names.findfirst(!showitem)
	if !tempindex.unset() then
		var !showref ref of $!showitem
		!tempindex = !names.findfirst(!showref)
	endif

	!considers.append(!tempindex)
	!objectshowindex = !indices[!tempindex]

	do !times from 1 to 2
		if !times eq 1 then
			!tempindex = !relaindex + 1
		elseif !times eq 2 then
			!tempindex = !relaindex - 1
		endif

		!nextorpre = !relativemems[!tempindex]
		handle any
			skip
		endhandle
		--$p $!nextorpre
		var !nextorpre ref of $!nextorpre
		!index = !names.findfirst(!nextorpre)
		!nextorpretype = type of $!nextorpre
		!objectindex = !indices[!index]
		if !showtype eq 'GASK' and !nextorpretype inset ('FLAN','FBLI') then
			!considers.append(!index)
			!oneconsiders.append(!tempindex)
			!this.objects[!objectindex].toshow = false
            --modify by jyg 20241119 修改法兰垫片显示为零部件序号
			--!showtext = 'F' + !this.objects[!objectindex].order.string() + '/G' + !this.objects[!objectshowindex].order.string()
            !showtext = !this.objects[!objectindex].specialnum + '/' + !this.objects[!objectshowindex].specialnum

			!elenumtext = '(' & !this.objects[!objectindex].specialnum & ')/(' + !this.objects[!objectshowindex].specialnum & ')'
		elseif !nextorpretype eq 'GASK' and !showtype inset ('FLAN','FBLI') then
			!considers.append(!index)
			!oneconsiders.append(!tempindex)
			!this.objects[!objectindex].toshow = false
            --modify by jyg  20241119 修改法兰垫片显示为零部件序号
			--!showtext = 'F' + !this.objects[!objectshowindex].order.string() + '/G' + !this.objects[!objectindex].order.string()
            !showtext = !this.objects[!objectshowindex].specialnum + '/' + !this.objects[!objectindex].specialnum

			!elenumtext = '(' & !this.objects[!objectshowindex].specialnum & ')/(' + !this.objects[!objectindex].specialnum & ')'
		elseif !times eq 2 then
			if !showtype eq 'GASK' then
                --modify by jyg  20241119 修改法兰垫片显示为零部件序号
				--!showtext = 'G' + !this.objects[!objectshowindex].order.string()
                !showtext = !this.objects[!objectshowindex].specialnum
			elseif !showtype inset ('FLAN','FBLI') then
                --modify by jyg  20241119 修改法兰垫片显示为零部件序号
				--!showtext = 'F' + !this.objects[!objectshowindex].order.string()
                !showtext = !this.objects[!objectshowindex].specialnum
			else
				!showtext = !order.string()	$*impossible
			endif
			!elenumtext = '(' & !this.objects[!objectshowindex].specialnum & ')'
		else
			skip
		endif
		!this.objects[!objectshowindex].isotext = !showtext + '/' + !bolttext
		!this.objects[!objectshowindex].elenumtext = !elenumtext + '/' + !this.objects[!inputx].elenumtext
		--return !considers
	enddo


	--!find = false
	-----------------------
	-----------------------find group which include a flan and a gask
	do !x from 1 to !relativemems.size() - 1
		if !oneconsiders.findfirst(!x).set() or !oneconsiders.findfirst(!x + 1).set() then
			skip
		endif

		!type1 = type of $!relativemems[$!x]
		!y = !x + 1
		!type2 = type of $!relativemems[$!y]
		if !type1 eq 'GASK' and !type2 inset ('FLAN','FBLI') then
			!gask = !relativemems[!x]
			!flan = !relativemems[!y]
		elseif !type2 eq 'GASK' and !type1 inset ('FLAN','FBLI') then
			!gask = !relativemems[!y]
			!flan = !relativemems[!x]
		else
			skip
		endif
		!oneconsiders.append(!y)


		!flanindex = !names.findfirst(!flan)
		if !flanindex.unset() then
			var !flanref ref of $!flan
			!flanindex = !names.findfirst(!flanref)
		endif

		!gaskindex = !names.findfirst(!gask)
		if !gaskindex.unset() then
			var !gaskref ref of $!gask
			!gaskindex = !names.findfirst(!gaskref)
		endif

		!considers.append(!flanindex)
		!considers.append(!gaskindex)

		!gaskobjectindex = !indices[!gaskindex]
		!flanobjectindex = !indices[!flanindex]

		!this.objects[!gaskobjectindex].toshow = false
        --modify by jyg  20241119 修改法兰垫片显示为零部件序号
		--!showtext = 'F' + !this.objects[!flanobjectindex].order.string() + '/G' + !this.objects[!gaskobjectindex].order.string()
        !showtext = !this.objects[!flanobjectindex].specialnum + '/' + !this.objects[!gaskobjectindex].specialnum

		!elenumtext = '(' & !this.objects[!flanobjectindex].specialnum & ')/(' + !this.objects[!gaskobjectindex].specialnum & ')'
		!this.objects[!flanobjectindex].isotext = !showtext
		!this.objects[!flanobjectindex].elenumtext = !elenumtext
	enddo

	return !considers


	$(
	--q var !find
	-----------------------
	-----------------------if bolt does not belong to a group which include a flan and gask
	if !find.not() then
		!showtype = type of $!this.objects[$!inputx].showitem
		!tempindex = !names.findfirst(!this.objects[!inputx].showitem)
		!considers.append(!tempindex)
		!objectshowindex = !indices[!tempindex]
		if !showtype eq 'GASK' then
			!showtext = 'G' + !this.objects[!objectshowindex].order.string()
		elseif !showtype inset ('FLAN','FBLI') then
			!showtext = 'F' + !this.objects[!objectshowindex].order.string()
		else
			!showtext = !order.string()	$*impossible
		endif
		!this.objects[!objectshowindex].isotext = !showtext + '/' + !bolttext
	endif
	return !considers
	$)



	$(
	define method .mergebolttexttoshowitem(!x is real, !bolttext is string, !indices is array, !names is array) is array
		!showitem = !this.objects[!x].showitem
		!relativemems = !this.objects[!x].relativemems

		!relaindex = !relativemems.findfirst(!showitem)

		!tempindex = !names.findfirst(!showitem)
		!objectshowindex = !indices[!tempindex]
		!showtype = type of $!showitem

		--!nextindex = !tempindex + 1
		--!preindex = !tempindex - 1
		!nextindex = !relaindex + 1
		!preindex = !relaindex - 1

		!considers = array()
		!considers.append(!tempindex)
		do !times from 1 to 2
			if !times eq 1 then
				!tempindex = !nextindex
			elseif !times eq 2 then
				!tempindex = !preindex
			endif

			!nextorpre = !relativemems[!tempindex]
			handle any
				skip
			endhandle
			!index = !names.findfirst(!nextorpre)

			!nextorpretype = type of $!nextorpre
			!objectindex = !indices[!index]

			if !showtype eq 'GASK' and !nextorpretype inset ('FLAN','FBLI') then
				!considers.append(!index)
				!this.objects[!objectindex].toshow = false
				!showtext = 'F' + !this.objects[!objectindex].order.string() + '/G' + !this.objects[!objectshowindex].order.string()
			elseif !nextorpretype eq 'GASK' and !showtype inset ('FLAN','FBLI') then
				!considers.append(!index)
				!this.objects[!objectindex].toshow = false
				!showtext = 'F' + !this.objects[!objectshowindex].order.string() + '/G' + !this.objects[!objectindex].order.string()
			elseif !times eq 2 then
				if !showtype eq 'GASK' then
					!showtext = 'G' + !this.objects[!objectshowindex].order.string()
				elseif !showtype inset ('FLAN','FBLI') then
					!showtext = 'F' + !this.objects[!objectshowindex].order.string()
				else
					!showtext = !order.string()	$*impossible
				endif
			else
				skip
			endif
			!this.objects[!objectshowindex].isotext = !showtext + '/' + !bolttext
			return !considers
		enddo
	$)


	$(
	---------old
	-----------------------materials  is not in a origin order
	-----------------------
	--define method .mergebolttexttoshowitem(!showitem is string, !bolttext is string, !indices is array, !names is array) is array

	!tempindex = !names.findfirst(!showitem)
	!objectshowindex = !indices[!tempindex]
	!showtype = type of $!showitem

	!nextindex = !tempindex + 1
	!preindex = !tempindex - 1

	!considers = array()
	!considers.append(!tempindex)
	do !times from 1 to 2
		if !times eq 1 then
			!index = !nextindex
		elseif !times eq 2 then
			!index = !preindex
		endif
		!nextorpre = !names[!index]
		handle any
			skip
		endhandle
		!nextorpretype = type of $!nextorpre
		!objectindex = !indices[!index]

		if !showtype eq 'GASK' and !nextorpretype inset ('FLAN','FBLI') then
			!considers.append(!index)
			!this.objects[!objectindex].toshow = false
			!showtext = 'F' + !this.objects[!objectindex].order.string() + '/G' + !this.objects[!objectshowindex].order.string()
		elseif !nextorpretype eq 'GASK' and !showtype inset ('FLAN','FBLI') then
			!considers.append(!index)
			!this.objects[!objectindex].toshow = false
			!showtext = 'F' + !this.objects[!objectshowindex].order.string() + '/G' + !this.objects[!objectindex].order.string()
		elseif !times eq 2 then
			if !showtype eq 'GASK' then
				!showtext = 'G' + !this.objects[!objectshowindex].order.string()
			elseif !showtype inset ('FLAN','FBLI') then
				!showtext = 'F' + !this.objects[!objectshowindex].order.string()
			else
				!showtext = !order.string()	$*impossible
			endif
		else
			skip
		endif
		!this.objects[!objectshowindex].isotext = !showtext + '/' + !bolttext
		return !considers
	enddo
	$)
endmethod

define method .draw()
	!this.addelenum = false
	if !this.isinstpipe.not() then
		--!this.addelenum = true	$*增加零部件序号
	endif

	!this.drawPforInst = false		$*仪表管也标P


	--!this.getcheight()

	-----------------------
	-----------------------202308231103
	!tempval = !this.od - 50
	!tempbili = !this.cheightbili * (1 - 0.5 * !tempval / (abs(!tempval) + 100))
	!this.cheight = int(!this.od * !tempbili)

	--!this.cheight = int(!this.od * !this.cheightBili)
	--$P SADF 1
	!this.changecheightauto()
	--handle any
	--	$p changecheightauto
	--	return
	--endhandle

	--q var !this.objects.size()
	--return

	--if !this.usepolarsystem then	$* in order to avoid the direction of first dim and second dim are different
	--	!this.setdimdir()
	--endif

	--$P ASDF 2
	if !this.usepolarsystem then
		!this.polarsystem.getmaindimdir()
		!this.polarsystem.ignoreline = !this.ignoreline
	endif

	!this.mergeshowtext()
	--handle any
	--	$p merge
	--	return
	--endhandle
	--$P ASDF 3
	!this.getelbolegdims()


--return
    --q var !this.objects
	do !index indices !this.objects

		!aaa = !this.objects[!index].objecttype()
		--$p $!index object $!aaa
		--if !this.objects[!index].objecttype() ne 'ISODIM' then
		--if !this.objects[!index].objecttype() ne 'ISOTAG' then
		--	break
		--	skip
		--endif

		--if !this.objects[!index].maindim.not() then
		--	skip
		--endif
		--!ot = !this.objects[!index].objecttype()
		--$p $!index    $!ot
		--q var !this.objects[!index]
		--clock read elapsed
		--$P $!INDEX $!aaa
		!this.drawoneobject(!index)
		--handle any
		--	$p $!index ERROR
		--	skip
		--endhandle
		--clock read elapsed
		--break

		--if !this.objects[!index].objecttype() eq 'ISOMATERIAL' then
		--	break
		--endif
		--handle any
		--	$p $!index
		--	q var !this.objects[!index]
		--endhandle
		--if !this.objects[!index].objecttype() eq 'ISOMATERIAL' and !this.objects[!index].order eq 2 then
		--	break
		--endif
	enddo
	!this.drawteeolet()
endmethod



define method .setdimdir()	$*useless
	if !this.twoormoredims then
		!dimnum = 2
	else
		!dimnum = 1
	endif


	!disarr = array()
	!disarr[1] = 0.1
	!disarr[2] = !this.line.length() - 0.1
	!disranges = array()
	!disranges.append(!disarr)

	!angleranges = array()

	!radiusarr = array()
	!radiusarr[1] = !this.od
	!radiusarr[2] = !this.od + !this.cheight * 1.2 * !dimnum
	!radiusranges = array()
	!radiusranges.append(!radiusarr)

	!needs = array()
	!needs.append(!disarr[2] - !disarr[1])
	!needs.append(30)
	!needs.append(!this.cheight)

	!bestdiss = array()
	!bestdirs = array()

	!bestradiuss = array()



	!result = !this.polarsystem.getBestPosAndOri(!disranges, !angleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, true, true)
	!dimpos = !result[1]
	!textori = !result[2]
	!this.dimdir = !this.line.near(!dimpos).direction(!dimpos)

endmethod


define method .draw(!type is string)
	--!this.getcheight()
	!this.cheight = int(!this.od * !this.cheightBili)

	!this.changecheightauto()

	do !index indices !this.objects
		if !this.objects[!index].objecttype() eq !type then
			!this.drawoneobject(!index)
		endif
	enddo
endmethod

define method .changeCheightAuto()
	if !this.changeCheightAuto then
		!mincheight = !this.cheight
		do !object values !this.objects
			if !object.objecttype() eq 'ISODIM' then
				!mincheight = min(!!getgoodcheight(!object.poss,!object.pipedir,0.7),!mincheight)
			endif
		enddo
		if !mincheight lt !this.cheight and !mincheight ne 0 then
			!this.cheight = nint(max(!this.cheight * !this.changeCheightAutoBili,!mincheight))
		endif
	endif
endmethod

define method .drawdim(!object is isodim,!dimtimes is real)
	--define asdfmethod .drawdim(!object is isodim,!dimtimes is real, !dimdir is direction)
    --q var !object
	!disarr = array()
	!disarr[1] = !!suidirdis(!this.polarsystem.pos,!this.pipedir,!object.poss[1]) + 0.1
	!disarr[2] = !!suidirdis(!this.polarsystem.pos,!this.pipedir,!object.poss.last()) - 0.1
	if abs(!disarr[2] - !disarr[1]) lt 1 then
		return
	endif
	!disranges = array()
    --q var !disarr
	!disranges.append(!disarr)



	!angleranges = array()

	$(
	--add dimdir
	if !this.dimdir.set() then
		!temparc = object arc(!this.pos,!this.polarsystem.ori,0,360,1000,true)
		!dimdirangle = !temparc.near(!this.pos.offset(!this.dimdir,1000))
		!anglearr = array()
		!anglearr.append(!dimdirangle - 15)
		!anglearr.append(!dimdirangle + 15)
		!angleranges.append(!anglearr)
	endif
	$)



	--$(
	!radiusarr = array()
	!radiusarr[1] = !object.od + !this.cheight * 1.2 * (!dimtimes - 1)
	!radiusarr[2] = !radiusarr[1] + !this.cheight
	--$)
	!radiusranges = array()
	!radiusranges.append(!radiusarr)	$*normally dont limit radius

	!needs = array()
	!needs.append(!disarr[2] - !disarr[1])
	!needs.append(30)
	!needs.append(!this.cheight)

	!bestdiss = array()
	!bestdirs = array()

	$(
	--add dimdir
	if !this.dimdir.set() then
		!bestdirs.append(!this.dimdir)
	endif
	q var !bestdirs
	$)



	!bestradiuss = array()
	if not(!this.twoormoredims and !dimtimes eq 1) then
		!this.dimOneMemSlope(!object.poss[1],!object.poss.last())
	endif

	!result = !this.polarsystem.getBestPosAndOri(!disranges, !angleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, true, true)
	--q var !result
    !dimpos = !result[1]
	!textori = !result[2]

	--if !this.dimdir.unset() then
	--	!this.dimdir = !textori.ydir()
	--endif

	---------------------------
	--!lindim = object lindim()
	--!lindim.polarsystem = !this.polarsystem
	--!lindim.lindim(!this.mbdstru.dimgro,!dimpos, !textori, !object.poss, !this.cheight,'Dimension','node:' + !this.branname,!this.changeCheightAuto,!this.sepSmallDim)
	--!this.polarsystem = !lindim.polarsystem

	!functiontext = '尺寸'
	!temparr = array()
	!temparr.append(!this.changeCheightAuto)
	!temparr.append(!this.changeCheightAutobili)
	!temparr.append(!this.sepSmallDim)
	!temparr.append(!this.plusstringcheightbili)

    --q var !object.maxslope.set()
    --q var !object
	if !object.maxslope.set() then	$*normal dim
        --$p 1
		!lindim = object lindim(!this.mbdstru.dimgro,!dimpos, !textori, !object.poss, !this.cheight,!functiontext,'node:' + !this.branname,!temparr,!this.objects)
	else	$*elbo isoleg dim
         --$p 2
		!fakeobjects = array()
		--!object.elboisolegadlongth = 100    $*test
		if !object.elboisolegadlongth.set() and !object.elboisolegadlongth ne 0 then
			!fakeobject = object isoadjustweld()
			!fakeobject.pos = !object.poss[1].midpoint(!object.poss.last())
			!fakeobject.adjustlen = !object.elboisolegadlongth
			!fakeobjects.append(!fakeobject)
		endif
		!lindim = object lindim(!this.mbdstru.dimgro,!dimpos, !textori, !object.poss, !this.cheight,!functiontext,'node:' + !this.branname,!temparr,!fakeobjects)
	endif

    --q var !lindim
	--!lindim = object lindim(!this.mbdstru.dimgro,!dimpos, !textori, !object.poss, !this.cheight,!functiontext,'node:' + !this.branname,!this.changeCheightAuto,!this.sepSmallDim)
	--!lindim = object lindim(!this.mbdstru.dimgro,!dimpos, !textori, !object.poss, !this.cheight,'Dimension','node:' + !this.branname,!this.changeCheightAuto,!this.sepSmallDim)
	!this.polarsystem.add(!lindim.createNames)


	--没必要，在draw方法里面已经计算过了，而且那样可以把前面的slope文字高度也设置好，这个位置不行
	--if !this.changeCheightAuto then
	--	!this.cheight = !lindim.cheight
	--endif

	if !lindim.plus then

		!this.plusAdjustLenInDim(!lindim,'调整焊附加长度')
		-----------------------
		-----------------------附加长度比较短，不会影响到流向的标注
	endif

	if not(!this.twoormoredims and !dimtimes eq 1) and !this.isinstpipe.not() then
		!this.drawflow(!dimpos,!object.poss, !this.cheight,!textori)
		if  !this.tspec.set() and !this.tspec.upcase() eq 'Y' then
			!this.drawtspec(!lindim)
		endif
	endif
endmethod

define method .drawtspec(!lindim is lindim)
	!lindims = !lindim.createNames
	!allpluss = !lindim.plusarrs
	do !dimname values !lindims
		var !dimposs coll all dimpos for $!dimname
		!poss = array()
		!diss = array()

		!pluss = array()

		--!allpluss = !plusarr[2]
		do !dimpos values !dimposs
			!pos = pos of $!dimpos wrt/*
			!poss.append(!pos)
			!pluss.append('')
		enddo

		do !y indices !allpluss
			if !allpluss[!y][1] eq !dimname then
				!pluss = !allpluss[!y][2]
				break
			endif
		enddo

		!lindimpos = pos of $!dimname wrt/*
		!ori = ori of $!dimname wrt/*
		!cheight = cheight of $!dimname

		!dir = !ori.xdir()
		--!dir = !poss[1].direction(!poss.last())
		!line = !lindimpos.line(!lindimpos.offset(!dir,1000))

		!moveydis = !cheight * 0.8
		do !x from 1 to !poss.size() - 1
			!plusstring = !pluss[!x]
			!pos1 = !line.near(!poss[!x])
			!pos2 = !line.near(!poss[!x + 1])
			!dis = !pos1.distance(!pos2)
			!string = !dis.string('D2').replace('.00','')
			!notindex = !string.match('.')
			if !notindex ne 0 then
				if !string.length() ge !notindex + 2 then
					if !string.substring(!notindex + 2,1) eq '0' then
						!string = !string.substring(1,!notindex + 1) & !string.substring(!notindex + 3)	  $*remove 0 when .x0
					endif
				endif
			endif
			----!textlen = !!mbdtextlen(!string) * !cheight * 0.75
			--!textlen = !!mbdtextlen(!string) * !cheight * 0.8
			!textlen = !!mbdtextlen(!string) * !cheight

			!midpoint = !pos1.midpoint(!pos2)
			!temppos1 = !midpoint.offset(!dir, - !textlen / 2).offset(!ori.ydir(),!moveydis)
			!temppos2 = !midpoint.offset(!dir, !textlen / 2).offset(!ori.ydir(),!moveydis)
			if !plusstring ne '' then
				--!temppos2 = !temppos2.offset(!dir,!!mbdtextlen(!plusstring) * !cheight * 0.8 * !this.plusstringcheightbili)
				!temppos2 = !temppos2.offset(!dir,!!mbdtextlen(!plusstring) * !cheight * !this.plusstringcheightbili)
			endif
			if !temppos1.distance(!pos1) ge !temppos2.distance(!pos1) then
				!temppos = !temppos1
				!temppos1 = !temppos2
				!temppos2 = !temppos
			endif


			!this.drawtspecline(!pos1.offset(!ori.ydir(),!moveydis),!temppos1,!cheight)
			!this.drawtspecline(!temppos2,!pos2.offset(!ori.ydir(),!moveydis),!cheight)


			--!midpoint = !pos1.midpoint(!pos2).offset(!ori.ydir(),!cheight * 0.25).offset(!ori.ydir(),!cheight * (1 - !this.plusstringcheightbili))
			--!startpos = !midpoint.offset(!dir,!textlen / 2)
			--!plusadjustweldtext = object aidtext(!this.mbdstru.aidgro,!startpos,!ori,!plusstring,!cheight * !this.plusstringcheightbili,'调整焊附加长度','node:' + !this.branname)
		enddo
	enddo
endmethod

define method .drawtspecline(!pos1 is position, !pos2 is position, !cheight is real)
	!dir = !pos1.direction(!pos2)
	!dis = !pos1.distance(!pos2)
	!onelinemaxlen = !cheight * 1.5

	!num = 3
	!onelen = !dis / !num
	if !onelen gt !onelinemaxlen then
		!onelen = !onelinemaxlen
		!num = nint(!dis / !onelen)
		!onelen = !dis / !num
	endif
	!linelen = !onelen * 2 / 3
	!blanklen = !onelen / 2

	--if !onelen lt !onelinemaxlen / 5 then
	--return
	--endif


	do !x from 1 to !num
		if !x eq 1 then
			!pos = !pos1.offset(!dir,!blanklen / 2)
		else
			!pos = !pos.offset(!dir,!onelen)
		endif
		!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos,!pos.offset(!dir,!linelen),'伴热','node:' + !this.branname)
	enddo
endmethod

define method .plusAdjustLenInDim(!lindim is lindim,!function is string)
	do !plusarr values !lindim.plusarrs
		!dimname = !plusarr[1]
		!pluss = !plusarr[2]		$*plusstring in every point


		var !dimposs coll all dimpos for $!dimname
		!poss = array()
		!diss = array()
		do !dimpos values !dimposs
			!pos = pos of $!dimpos wrt/*
			!poss.append(!pos)
			--!diss.append(!!suidirdis(!this.pos,!this.pipedir,!pos)
		enddo

		--!lindimpos = pos of $!lindim wrt/*
		!lindimpos = pos of $!dimname wrt/*


		!ori = ori of $!dimname wrt/*
		!cheight = cheight of $!dimname
		!xdir = !ori.xdir()
		!ydir = !ori.ydir()
		!line = !lindimpos.line(!lindimpos.offset(!xdir,1000))
		do !x from 1 to !poss.size() - 1
			!plusstring = !pluss[!x]
			if !plusstring ne '' then
				!pos1 = !line.near(!poss[!x])
				!pos2 = !line.near(!poss[!x + 1])

				if !function eq '调整焊附加长度' then
					--!mem1s = array()
					!mem1types = array()
					--!mem2s = array()
					!mem2types = array()
					do !mem values !this.mems
						if !mem eq 'Head' or !mem eq 'Tail' then
							skip
						endif
						!mempos = pos of $!mem wrt/*
						!memtype = type of $!mem wrt/*
						if !mempos.distance(!poss[!x]) lt 1 then
							--!mem1s.append(!mem)
							!mem1types.append(!memtype)
						endif
						if !mempos.distance(!poss[!x + 1]) lt 1 then
							--!mem2s.append(!mem)
							!mem2types.append(!memtype)
						endif
					enddo
					!mem1types.unique()
					!mem2types.unique()
					------------------------------------------------------支架定位不标注调整段
					if !mem1types.size() eq 1 and !mem1types[1] eq 'ATTA' then
						skip
					elseif !mem2types.size() eq 1 and !mem2types[1] eq 'ATTA' then
						skip
					endif
				endif
				!dis = !pos1.distance(!pos2)
				!string = !dis.string('D2').replace('.00','')
				!notindex = !string.match('.')
				if !notindex ne 0 then
					if !string.length() ge !notindex + 2 then
						if !string.substring(!notindex + 2,1) eq '0' then
							!string = !string.substring(1,!notindex + 1) & !string.substring(!notindex + 3)	  $*remove 0 when .x0
						endif
					endif
				endif
				----!textlen = !!mbdtextlen(!string) * !cheight * 0.75
				--!textlen = !!mbdtextlen(!string) * !cheight * 0.8
				!textlen = !!mbdtextlen(!string) * !cheight

				!midpoint = !pos1.midpoint(!pos2).offset(!ori.ydir(),!cheight * 0.25).offset(!ori.ydir(),!cheight * (1 - !this.plusstringcheightbili))
				!startpos = !midpoint.offset(!xdir,!textlen / 2)

				--!othermlabel = object mlabel(!this.mbdstru.dimgro,!startpos,!ori,!plusstring,!cheight * !this.plusstringcheightbili,false,'调整焊附加长度','','node:' + !this.branname)
				!plusadjustweldtext = object aidtext(!this.mbdstru.aidgro,!startpos,!ori,!plusstring,!cheight * !this.plusstringcheightbili,!function,'node:' + !this.branname)
			endif
		enddo
	enddo
endmethod

define method .drawflow(!dimpos is position, !inputposs is array ,!cheight is real ,!ori is orientation)
	!linedir = !ori.xdir()
	!line = !dimpos.line(!dimpos.offset(!this.pipedir,1000))
	do !x indices !inputposs
		!poss[!x] = !line.near(!inputposs[!x])
	enddo
	!newcheight = !!getgoodcheight(!poss,!ori.xdir(),0.7)
	if !newcheight lt !this.cheight and !newcheight ne 0 then
		--if !mincheight lt !this.cheight and !mincheight ne 0 then
		if !this.changeCheightAuto.set() and !this.changeCheightAuto then
			!cheight = max(!cheight * !this.changeCheightAutoBili,!newcheight)
		else
			return $*no space to do anything
		endif
	endif


	-----------------------
	-----------------------new way
	!diss = array()
	!xx = array()
	do !x from 1 to !poss.size() - 1
		!dis = !poss[!x].distance(!poss[!x + 1])
		!diss.append(!dis)
		!xx.append(!x)
	enddo

	!xx.reindex(!diss.sortedindices().invert())
	--q var !xx !diss
	!pos1 = !poss[!xx[1]]
	!pos2 = !poss[!xx[1] + 1]

	!dis = !pos1.distance(!pos2)
	!string = !dis.string('D2').replace('.00','')
	!notindex = !string.match('.')
	if !notindex ne 0 then
		if !string.length() ge !notindex + 2 then
			if !string.substring(!notindex + 2,1) eq '0' then
				!string = !string.substring(1,!notindex + 1) & !string.substring(!notindex + 3)	  $*remove 0 when .x0
			endif
		endif
	endif
	----!textlen = !!mbdtextlen(!string) * !cheight * 0.75
	--!textlen = !!mbdtextlen(!string) * !cheight * 0.8
	!textlen = !!mbdtextlen(!string) * !cheight

	!this.drawflow2(!pos1,!pos2,!cheight,!textlen,!ori)

	return

	-----------------------
	-----------------------old way
	do !x from 1 to !poss.size() - 1
		!dis = !poss[!x].distance(!poss[!x + 1])
		!string = !dis.string('D2').replace('.00','')
		!notindex = !string.match('.')
		if !notindex ne 0 then
			if !string.length() ge !notindex + 2 then
				if !string.substring(!notindex + 2,1) eq '0' then
					!string = !string.substring(1,!notindex + 1) & !string.substring(!notindex + 3)	  $*remove 0 when .x0
				endif
			endif
		endif
		----!textlen = !!mbdtextlen(!string) * !cheight * 0.75
		--!textlen = !!mbdtextlen(!string) * !cheight * 0.8
		!textlen = !!mbdtextlen(!string) * !cheight

		if (!dis - !textlen) / !cheight ge 10 then
			!this.drawflow2(!poss[!x],!poss[!x + 1],!cheight,!textlen,!ori)
		endif
	enddo
endmethod


define method .drawflow2(!pos1 is position, !pos2 is position, !cheight is real, !textlen is real, !ori is orientation)
	!midpoint = !pos1.midpoint(!pos2)
	!midpos1 = !midpoint.offset(!this.pipedir.opposite(),!textlen / 2)
	!midpos2 = !midpoint.offset(!this.pipedir,!textlen / 2)


	!tempmidpos = !this.line.startposition.midpoint(!this.line.endposition)
	if !pos1.distance(!pos2) / !cheight gt 20 then
		!this.drawflow3(!pos1,!midpos1,!cheight,!ori)
		!this.drawflow3(!midpos2,!pos2,!cheight,!ori)
	else
		-----------------------
		-----------------------only draw one arrow
		if !pos1.distance(!tempmidpos) le !pos2.distance(!tempmidpos)then
			!this.drawflow3(!pos1,!midpos1,!cheight,!ori)
		else
			!this.drawflow3(!midpos2,!pos2,!cheight,!ori)
		endif
	endif
endmethod

define method .drawflow3(!pos1 is position, !pos2 is position, !cheight is real, !ori is orientation)
	!point1 = !pos1.offset(!ori.ydir(),!cheight / 2)
	!point2 = !pos2.offset(!ori.ydir(),!cheight / 2)



	!dis = !point1.distance(!point2)
	if !dis lt 5 * !cheight then
		return
	else
		--!num = !dis / (5 * !cheight)
		--!num = !num.int()
		!num = 1
	endif

    --q  var !pos1 !pos2

	!midpoint = !point1.midpoint(!point2)
	!unitlen = !cheight * 3
	!dp1 = !midpoint.offset(!this.pipedir, - !unitlen / 2)
	!dp2 = !midpoint.offset(!this.pipedir, !unitlen / 2)

	!temppos = !dp2.offset(!this.pipedir, - 0.2 * !unitlen)
	!dp3 = !temppos.offset(!ori.ydir(), 0.12 * !unitlen)
	!dp4 = !temppos.offset(!ori.ydir(), - 0.12 * !unitlen)




	!aidline = object mbdaidline(!this.mbdstru.aidgro,!dp1,!dp2,'流向','node:' + !this.branname)
	--!this.polarsystem.add(!aidline.name)	$* no need to add since this line is inside of dim

	!aidline = object mbdaidline(!this.mbdstru.aidgro,!dp2,!dp3,'流向','node:' + !this.branname)

	!aidline = object mbdaidline(!this.mbdstru.aidgro,!dp2,!dp4,'流向','node:' + !this.branname)

    --modify by jyg 20241205解决双流向的问题
    !both = !this.branname.Dbref().flowdirection
    if !both eq 'BOTH' then
        !temppos = !dp1.offset(!this.pipedir,  0.2 * !unitlen)
        !dp5 = !temppos.offset(!ori.ydir().opposite(), 0.12 * !unitlen)
        !dp6 = !temppos.offset(!ori.ydir().opposite(), - 0.12 * !unitlen)
        !aidline = object mbdaidline(!this.mbdstru.aidgro,!dp1,!dp5,'流向','node:' + !this.branname)
        !aidline = object mbdaidline(!this.mbdstru.aidgro,!dp1,!dp6,'流向','node:' + !this.branname)
	endif

	$(
	if !num gt 10 then
		!num = int(!num / 4)
	elseif !num gt 5 then
		!num = int(!num / 2)
	elseif !num gt 3 then
		!num = int(!num / 1.5)
	else
		!num = 1
	endif



	!eachlen = !dis / !num
	do !x from 1 to !num
		!p1 = !point1.offset(!this.pipedir, (!x - 1) * !eachlen)
		!p2 = !p1.offset(!this.pipedir,!eachlen)
		!unitlen = !p1.distance(!p2) / 5
		!dp1 = !p1.offset(!this.pipedir, 1.5 * !unitlen)
		!dp2 = !p2.offset(!this.pipedir, - 1.5 * !unitlen)
		!temppos = !dp2.offset(!this.pipedir, - 0.25 * !unitlen)
		!dp3 = !temppos.offset(!ori.ydir(), 0.15 * !unitlen)
		!dp4 = !temppos.offset(!ori.ydir(), - 0.15 * !unitlen)


		!aidline = object mbdaidline(!this.mbdstru.aidgro,!dp1,!dp2,'流向','node:' + !this.branname)
		--!this.polarsystem.add(!aidline.name)	$* no need to add since this line is inside of dim

		!aidline = object mbdaidline(!this.mbdstru.aidgro,!dp2,!dp3,'流向','node:' + !this.branname)

		!aidline = object mbdaidline(!this.mbdstru.aidgro,!dp2,!dp4,'流向','node:' + !this.branname)
	enddo
	$)
endmethod




define method .dimOneMemSlope(!pos1 is position, !pos2 is position)
	!alldirs[1] = e
	!alldirs[2] = w
	!alldirs[3] = s
	!alldirs[4] = n
	!alldirs[5] = u
	!alldirs[6] = d
	!minangle = 100
	do !onedir values !alldirs
		!angle = !onedir.angle(!this.pipedir)
		if !angle lt !minangle then
			!gooddir = !onedir
			!minangle = !angle
		endif
	enddo

	if !minangle.tangent() gt !this.maxslope then
		var !volume volume $!this.branname
		!pos3 = !volume.before(' to ').position().wrt(world)
		!pos4 = !volume.after(' to ').position().wrt(world)
		!cenpos = !pos3.midpoint(!pos4)
		!this.dimslopedim(!pos1,!pos2,!cenpos)			$*if large than max slope , should consider it as a inclined pipe, intead of slope pipe
	endif
endmethod

define method .dimslopedim(!pos1 is position, !pos2 is position, !cenpos is position) is array
	!returnresult = array()
	if abs(!pos1.up - !pos2.up) gt 0.5 then
		if !pos1.up ge !pos2.up then
			!highPoint = !pos1
			!lowPoint = !pos2
		else
			!highPoint = !pos2
			!lowPoint = !pos1
		endif
		!projectedPoint1 = !highPoint
		!projectedPoint1.up = !lowPoint.up

		!projectedPoint2 = !lowPoint
		!projectedPoint2.up = !highPoint.up

		if !projectedpoint1.distance(!cenpos) ge !projectedpoint2.distance(!cenpos) then
			!pjpoint = !projectedPoint1
			!horipos = !lowpoint
			!vertpos = !highpoint
		else
			!pjpoint = !projectedPoint2
			!horipos = !highpoint
			!vertpos = !lowpoint
		endif

		!functiontext = '尺寸'
		!aidline = object mbdaidline(!this.mbdstru.aidgro,!pjPoint,!vertpos,!functiontext,'node:' + !this.branname)
		--!aidline = object mbdaidline(!this.mbdstru.aidgro,!pjPoint,!vertpos,'SkewDim','node:' + !this.branname)
		!this.polarsystem.add(!aidline.name)

		!this.isoposAidTEXT(!pjPoint,!vertPos,!functiontext, !cenpos)
		--!this.isoposAidTEXT(!pjPoint,!vertPos,'SkewDim', !cenpos)


		!dirlen = !this.dimslopedim(!pjPoint,!horipos,!cenpos)

		if !dirlen.set() then           $*画直角标
			!vertlen = !pjPoint.distance(!vertpos)
			!vertdir = !pjPoint.direction(!vertpos)
			!horidir = !dirlen[1]
			!horilen = !dirlen[2]
			!this.drawRightAngle(!pjPoint,!horidir,!vertdir,!horilen,!vertlen)
		endif
	else
		!pos1.up = !pos2.up $*有些可能存在0.5以内的误差
		!line1 = !pos1.line(!pos1.offset(e,1000))
		!line2 = !pos2.line(!pos2.offset(n,1000))
		!point1 = !line1.intersection(!line2)

		!line3 = !pos1.line(!pos1.offset(n,1000))
		!line4 = !pos2.line(!pos2.offset(e,1000))
		!point2 = !line3.intersection(!line4)

		if !point1.distance(!cenpos) ge !point2.distance(!cenpos) then
			!goodpoint = !point1
		else
			!goodpoint = !point2
		endif

		do !x from 1 to 2
			if !x eq 1 then
				!temppos = !pos1
			else
				!temppos = !pos2
			endif
			if !goodpoint.distance(!temppos) ge 1 then                      $*画水平方向1
				!functiontext = '尺寸'
				!aidline = object mbdaidline(!this.mbdstru.aidgro,!goodpoint,!temppos,!functiontext,'node:' + !this.branname)
				--!aidline = object mbdaidline(!this.mbdstru.aidgro,!goodpoint,!temppos,'SkewDim','node:' + !this.branname)

				!this.polarsystem.add(!aidline.name)


				!this.isoposAidTEXT(!goodpoint,!temppos,!functiontext, !cenpos)
				--!this.isoposAidTEXT(!goodpoint,!temppos,'SkewDim', !cenpos)
				!horidir = !goodpoint.direction(!temppos)
				!horilen = !goodpoint.distance(!temppos)
				if !x eq 1 then
					!returnresult.append(!horidir.opposite())
					-----------------------
					-----------------------when x is 1, horidir is from interpoint in horizotal plane to pjpoint
				else
					!returnresult.append(!horidir)
					-----------------------
					-----------------------when x is 2, horidir is from interpoint in horizotal plane to horipoint
				endif
				-----------------------
				-----------------------202308221642

				!returnresult.append(!horilen)
				if !x eq 1 then
					!horidir1 = !horidir
					!horilen1 = !horilen
				else
					!horidir2 = !horidir
					!horilen2 = !horilen
				endif
			endif
		enddo


		if defined(!horidir1) and defined(!horidir2) then           $*画直角标
			!this.drawRightAngle(!goodpoint,!horidir1,!horidir2,!horilen1,!horilen2)
		endif
	endif

	return !returnresult
endmethod

define method .drawrightangle(!pos is position, !dir1 is direction, !dir2 is direction, !len1 is real, !len2 is real)
	!rightanglelen = min(min(!len1,!len2) / 4,!this.cheight)
	!rightpoint = !pos.offset(!dir1,!rightanglelen).offset(!dir2,!rightanglelen)

	!functiontext = '尺寸'
	!aidline = object mbdaidline(!this.mbdstru.aidgro,!rightpoint,!rightpoint.offset(!dir1.opposite(),!rightanglelen),!functiontext,'node:' + !this.branname)
	--!aidline = object mbdaidline(!this.mbdstru.aidgro,!rightpoint,!rightpoint.offset(!dir1.opposite(),!rightanglelen),'SkewDim','node:' + !this.branname)
	!this.polarsystem.add(!aidline.name)
	!aidline = object mbdaidline(!this.mbdstru.aidgro,!rightpoint,!rightpoint.offset(!dir2.opposite(),!rightanglelen),!functiontext,'node:' + !this.branname)
	--!aidline = object mbdaidline(!this.mbdstru.aidgro,!rightpoint,!rightpoint.offset(!dir2.opposite(),!rightanglelen),'SkewDim','node:' + !this.branname)
	!this.polarsystem.add(!aidline.name)
endmethod

define method .isoposAidtext(!pos1 is position, !pos2 is position, !function is string, !cenpos is position)
	!midpoint = !pos1.midpoint(!pos2)
	!len = !pos1.distance(!pos2)
	if !len lt 0.5 then                     $*no need to mark
		return
	endif

	!text = !len.string('d0').upcase().before('MM').before('IN').before('.0')
	!dir = !pos1.direction(!pos2)
	handle any
		return
	endhandle

	--$(
	!eangle = !dir.angle(E)
	if !eangle lt 1 or !eangle gt 179 then
		!dirtext = 'X:'
	else
		!nangle = !dir.angle(N)
		if !nangle lt 1 or !nangle gt 179 then
			!dirtext = 'Y:'
		else
			!dirtext = 'Z:'
		endif
	endif
	!text = !dirtext + !text
	--$)
	!referencedirs = array()
	!referencedirs.append(!this.pipedir)
	if !this.branlookdirection.set() then
		!temppolarsystem = object polarsystem(!pos1,!pos2,!cenpos,0,!this.lookangle,!referencedirs,!this.branlookdirection,!this.isinstpipe,!this.prehoridir)		$* a temporary polarsystem, no need to add to real isoline
	else
		!temppolarsystem = object polarsystem(!pos1,!pos2,!cenpos,0,!this.lookangle,!referencedirs,!this.fromltor,!this.isinstpipe,!this.prehoridir)		$* a temporary polarsystem, no need to add to real isoline
	endif
	!temppolarsystem = !this.sethorishowdir(!temppolarsystem)

	!result = !temppolarsystem.getBestPosAndOri(!midpoint,!text,0,!this.cheight, false, false)
	--!result = !this.polarsystem.getBestPosAndOri(!midpoint,!text,0,!this.cheight, false, false)
	!textpos = !result[1]
	!ori = !result[2]

	!aidtext = object aidtext(!this.mbdstru.aidgro,!textpos,!ori,!text,!this.cheight,!function,'node:' + !this.branname)
	--!this.drawitems.append(!aidtext.name)
	--!this.polarsystem.add(!aidtext.name)  $*no need to add
endmethod

define method .sethorishowdir(!ps is polarsystem) is polarsystem
	!lookupangle = !this.lookangle
	!horidir = !this.polarsystem.horidir
	!dir = !ps.dir

	--!!5(!ps.dir,!this.polarsystem.horidir,!ps,!this.polarsystem,!this)
	!tempdir = !dir.orthogonal(!horidir)
	handle any
		!tempdir = d
	endhandle

	!horidir = !tempdir.orthogonal(!dir)

	!tempangle = !dir.angle(u)
	if !tempangle gt 10 and !tempangle lt 170 then
		!tempdir = !horidir.orthogonal(u)
		if !tempdir.angle(!dir) le 90 then
			!tempdir = !dir
		else
			!tempdir = !dir.opposite()
		endif

		!temppos = e 0 n 0 u 0
		!arc = object arc(!this.pos,object orientation('X is $!horidir and z is $!tempdir'),0,360,1000,true)
		!showdir = !arc.angledirection(!lookupangle)
	else
		!showdir = !horidir
	endif



	!ps.horidir = !horidir
	!ps.showdir = !showdir
	!ps.ori = x is $!showdir and z is $!dir
	return !ps
endmethod


define method .drawslope(!object is isoslope)
	!functiontext = '坡度'
	do !line values !object.lines
		!aidline = object mbdaidline(!this.mbdstru.aidgro,!line,!functiontext,'node:' + !this.branname)
		--!aidline = object mbdaidline(!this.mbdstru.aidgro,!line,'Slope','node:' + !this.branname)
		!this.polarsystem.add(!aidline.name)
	enddo

	if !object.ori.zdir().angle(!this.polarsystem.showdir) gt 90 then
		!temppos = !object.pos
		!object.pos = !object.lines[3].startposition
		!object.pos.up = !temppos.up
		!xdir = !object.ori.xdir().opposite()
		!ydir = !object.ori.ydir()
		!object.ori = x is $!xdir and y is $!ydir
	endif
	--!textlen = !!mbdtextlen(!object.text) * 0.7 * !this.cheight
	!textlen = !!mbdtextlen(!object.text) * !this.cheight
	if !textlen gt !object.lines[3].length() then
		!cheight =  !this.cheight * !object.lines[3].length() / !textlen
	else
		!cheight = !this.cheight
	endif

	!aidtext = object aidtext(!this.mbdstru.aidgro,!object.pos,!object.ori,!object.text,!cheight,!functiontext,'node:' + !this.branname)
	--!aidtext = object aidtext(!this.mbdstru.aidgro,!object.pos,!object.ori,!object.text,!this.cheight,'Slope','node:' + !this.branname)
	!this.polarsystem.add(!aidtext.name)
endmethod

define method .drawteeolet()
	!functiontext = '尺寸'
	do !mem values !this.mems
		!memtype = type of $!mem
		if !memtype inset ('TEE','OLET') then
			--!p3dir = p3 dir of $!mem wrt/*
			--!angle = !p3dir.angle(!this.pipedir)
			--if !angle lt 5 or !angle gt 175 then
			--	skip
			--endif
			if arrive of $!mem eq 3 or leave of $!mem eq 3 then
				skip
			endif

			!aod = aod of $!mem
			!pos1 = pos of $!mem wrt/*
			!pos2 = p3 pos of $!mem wrt/*
			if !pos1.distance(!pos2) lt 1 then
				skip
			endif
			--$p $!mem
			!temparr = !this.getlegteeoletoripos(!mem,!pos1,!pos2,!aod)
			!dimpos = !temparr[1]
			!ori = !temparr[2]

			$(
			!ldir = ldir of $!mem wrt/*
			!posmovedir = !ldir.orthogonal(!p3dir)
			if !posmovedir.angle(!this.polarsystem.showdir) gt 90 then
				!posmovedir = !posmovedir.opposite()
			endif

			!zdir = !posmovedir.orthogonal(!p3dir)

			!uangle = !zdir.angle(u)
			if !uangle gt 91 then
				!zdir = !zdir.opposite()
				!uangle = !zdir.angle(u)
			endif
			if !uangle gt 60 then
				if !zdir.angle(!ldir) lt 90 then
					!zdir = !zdir.opposite()
				endif
			endif

			!posmovedis = !aod * 0.6
			if !posmovedir.angle(u) lt 91 then
				!ydir = !posmovedir
			elseif !posmovedir.angle(u) gt 91 then
				!ydir = !posmovedir.opposite()
				!posmovedis = !posmovedis + !this.cheight
			endif
			!dimpos = !pos1.offset(!posmovedir,!posmovedis)
			!ori = y is $!ydir and z is $!zdir
			$)

			!temparr = array()
			!temparr.append(!this.changeCheightAuto)
			!temparr.append(!this.changeCheightAutobili)
			!temparr.append(!this.sepSmallDim)
			!temparr.append(!this.plusstringcheightbili)

			!poss = array()
			!poss.append(!pos1)
			!poss.append(!pos2)
			!lindim = object lindim(!this.mbdstru.dimgro,!dimpos, !ori, !poss, !this.cheight,!functiontext,'node:' + !this.branname,!temparr)
			!this.polarsystem.add(!lindim.createNames)
		endif
	enddo
endmethod

define method .getlegteeoletoripos(!mem is string,!pos1 is position,!pos2 is position,!aod is real) is array
	!p3dir = !pos1.direction(!pos2)
	!ldir = ldir of $!mem wrt/*
	!posmovedir = !ldir.orthogonal(!p3dir)
	if !posmovedir.angle(!this.polarsystem.showdir) gt 90 then
		!posmovedir = !posmovedir.opposite()
	endif

	!zdir = !posmovedir.orthogonal(!p3dir)

	!uangle = !zdir.angle(u)
	if !uangle gt 91 then
		!zdir = !zdir.opposite()
		!uangle = !zdir.angle(u)
	endif
	if !uangle gt 60 then
		if !zdir.angle(!ldir) lt 90 then
			!zdir = !zdir.opposite()
		endif
	endif

	!posmovedis = !aod * 0.6
	if !posmovedir.angle(u) lt 91 then
		!ydir = !posmovedir
	elseif !posmovedir.angle(u) gt 91 then
		!ydir = !posmovedir.opposite()
		!posmovedis = !posmovedis + !this.cheight
	endif
	!dimpos = !pos1.offset(!posmovedir,!posmovedis)
	!ori = y is $!ydir and z is $!zdir

	!result = array()
	!result.append(!dimpos)
	!result.append(!ori)
	return !result
endmethod

define method .drawleg(!object is isoleg)
--$p 1234
	if !object.elboname.set() then
		return
	endif
--$p asdfasdf
	!functiontext = '尺寸'
	!attapos = !object.attapos
	!atta = !object.name
	--!pipeaod = max(!object.outdia,!this.getpipeaod(!atta))

	!pos1 = !object.pos.offset(!object.ori.zdir(), - !object.height / 2)
	!pos2 = !object.pos.offset(!object.ori.zdir(),!object.height / 2)
--$p 333

	!temparr = !this.getlegteeoletoripos(!atta,!pos1,!pos2,!object.touchitemradius * 2)
	!dimpos = !temparr[1]
	!ori = !temparr[2]
--$p 444
	$(
	if !object.elboname.set() then
		if !pos1.distance(!object.weldpos) lt !pos2.distance(!object.weldpos) then
			!movedir = !pos1.direction(!object.weldpos)
		else
			!movedir = !pos2.direction(!object.weldpos)
		endif
		!movedis = !object.outdia / 2
		!pos1 = !pos1.offset(!movedir,!movedis)
		!pos2 = !pos2.offset(!movedir,!movedis)
	endif
	!axis = !pos1.line(!pos2)

	!zdir = ldir of $!atta wrt/*
	if !zdir.angle(u) gt 91 then
		!zdir = !zdir.opposite()
	endif

	!xdir = !pos1.direction(!pos2)
	!ori = x is $!xdir and z is $!zdir
	handle any
		!zdir = adir of $!atta wrt/*
		if !zdir.angle(u) gt 91 then
			!zdir = !zdir.opposite()
		endif
		!ori = x is $!xdir and z is $!zdir
	endhandle
	if !ori.ydir().angle(u) gt 91 then
		!xdir = !xdir.opposite()
		!ori = x is $!xdir and z is $!zdir
	endif

	--!dimpos = !pos1.offset(!ori.ydir(),!pipeaod * 0.6)
	!posmovedis = !object.touchitemradius * 1.2
	handle any
		if !object.elboname.set() then
			!posmovedis = !object.outdia * 0.6
		else
			!posmovedis = !pipeaod * 0.6
		endif
	endhandle

	!posmovedir = !ori.ydir()
	if !posmovedir.angle(!this.polarsystem.showdir) gt 90 then
		!posmovedir = !posmovedir.opposite()
		!posmovedis = !posmovedis + !this.cheight
	endif
	!dimpos = !pos1.offset(!posmovedir,!posmovedis)


	if !ori.ydir().angle(!this.polarsystem.showdir) lt 60 then
		!xdir = !ori.xdir().opposite()
		!ydir = !ori.ydir().opposite()
		!ori = x is $!xdir and y is $!ydir
		!dimpos = !dimpos.offset(!ydir.opposite(),!this.cheight)
	endif
	$)

	!temparr = array()
	!temparr.append(!this.changeCheightAuto)
	!temparr.append(!this.changeCheightAutobili)
	!temparr.append(!this.sepSmallDim)
	!temparr.append(!this.plusstringcheightbili)
	--!object.adlongth = 101
	!axis = !pos1.line(!pos2)

	if !axis.onprojected(!attapos).not() then
		--if !attapos.distance(!pos1) lt 1 or !attapos.distance(!pos2) lt 1 then
		!poss = array()
		!poss.append(!pos1)
		!poss.append(!pos2)
		!lindim = object lindim(!this.mbdstru.dimgro,!dimpos, !ori, !poss, !this.cheight,!functiontext,'node:' + !this.branname,!temparr)
		!this.polarsystem.add(!lindim.createNames)

		if !object.adlongth ne 0 then
			!lindim.plusarrs[1][1] = !lindim.createnames[1]
			!lindim.plusarrs[1][2][1] = ' +' & string(!object.adlongth)
			!this.plusAdjustLenInDim(!lindim,'支撑管附加长度')
			--!this.pluslegAdjustLen(!lindim)
		endif
	else
		!poss = array()
		!poss.append(!pos1)
		!poss.append(!attapos)
		!lindim1 = object lindim(!this.mbdstru.dimgro,!dimpos, !ori, !poss, !this.cheight,!functiontext,'node:' + !this.branname,!temparr)
		!this.polarsystem.add(!lindim1.createNames)
		!poss = array()
		!poss.append(!pos2)
		!poss.append(!attapos)
		!lindim2 = object lindim(!this.mbdstru.dimgro,!dimpos, !ori, !poss, !this.cheight,!functiontext,'node:' + !this.branname,!temparr)
		!this.polarsystem.add(!lindim2.createNames)

		if !object.adlongth ne 0 then
			if !pos1.distance(!attapos) ge !pos2.distance(!attapos) then
				!lindim1.plusarrs[1][1] = !lindim1.createnames[1]
				!lindim1.plusarrs[1][2][1] = ' +' & string(!object.adlongth)
				--!this.pluslegAdjustLen(!lindim1)
				!this.plusAdjustLenInDim(!lindim1,'支撑管附加长度')
			else
				!lindim2.plusarrs[1][1] = !lindim2.createnames[1]
				!lindim2.plusarrs[1][2][1] = ' +' & string(!object.adlongth)
				--!this.pluslegAdjustLen(!lindim2)
				!this.plusAdjustLenInDim(!lindim2,'支撑管附加长度')
			endif
		endif
	endif
endmethod


define method .getpipeAod(!atta is string) is real
	!aod = aod of $!atta
	handle any
		!aod = 0
	endhandle
	if !aod eq 0 then
		var !mode mode
		forward
		!aod = aod of pre tubi of $!atta
		handle any
			!aod = aod of next tubi of $!atta
			handle any
			endhandle
		endhandle
		$!mode
	endif
	return !aod
endmethod

define method .drawangle(!object is isombdangle)
	--!radiusaodbili = 0.7
	--!radius = !object.aod * !radiusaodbili

	!radius = !this.polarsystem.getgoodradius(!object,!this.cheight)
	--q var !radius
	--return
	!line1 = !object.anglepos.line(!object.anglepos.offset(!object.dir1,!radius + !this.cheight / 2))
	!line2 = !object.anglepos.line(!object.anglepos.offset(!object.dir2,!radius + !this.cheight / 2))
	!zdir = !object.dir1.orthogonal(!object.dir2)
	handle any
		return
	endhandle
	!ori = x is $!object.dir1 and z is $!zdir

	!angle = !object.dir1.angle(!object.dir2)
	!arc = object arc(!object.anglepos,!ori,0,!angle,!radius,true)

	!functiontext = '元件偏转角度'
	!aidline1 = object mbdaidline(!this.mbdstru.aidgro,!line1,!functiontext,'node:' + !this.branname)
	!aidline2 = object mbdaidline(!this.mbdstru.aidgro,!line2,!functiontext,'node:' + !this.branname)
	!aidarc = object aidarc(!this.mbdstru.aidgro,!arc,!functiontext,'node:' + !this.branname)
	!radiusdir = !object.dir1.bisect(!object.dir2)
	!offdir = !radiusdir.orthogonal(!zdir)

	if !zdir.angle(!this.polarsystem.showdir) lt 90 then
		!offdir = !offdir.opposite()
		!orizdir = !zdir
	else
		!orizdir = !zdir.opposite()
	endif

	--!textlen = !!mbdtextlen(!object.text) * !this.cheight * 0.6
	!textlen = !!mbdtextlen(!object.text) * !this.cheight
	!textpos = !object.anglepos.offset(!radiusdir,!radius + !this.cheight / 10).offset(!offdir,!textlen / 2)
	!orixdir = !offdir.opposite()
	!ori = x is $!orixdir and z is $!orizdir

	!temparr = !this.getgoodori(!ori,!textpos,!textlen)
	!ori = !temparr[1]
	!textpos = !temparr[2]
	$(
	if !ori.zdir().angle(d) lt 70 then
		!textpos = !textpos.offset(!orixdir,!textlen)
		!orixdir = !ori.xdir().opposite()
		!orizdir = !orizdir.opposite()
		!ori = x is $!orixdir and z is $!orizdir
	endif

	if !ori.ydir().angle(d) lt 70 then
		!textpos = !textpos.offset(!orixdir,!textlen).offset(!ori.ydir(),!this.cheight)
		!orixdir = !ori.xdir().opposite()
		!ori = x is $!orixdir and z is $!orizdir
	endif
	$)

	!aidtext = object aidtext(!this.mbdstru.aidgro,!textpos,!ori,!object.text,!this.cheight,!functiontext,'node:' + !this.branname)

	--!this.polarsystem.add(!aidline1.name)
	--!this.polarsystem.add(!aidline2.name)
	--!this.polarsystem.add(!aidarc.name)

	-----------------------
	-----------------------unecessary

	!this.polarsystem.add(!aidtext.name)

	!cheight = !this.cheight / 2
	do !times from 1 to 2
		if !times eq 1 then
			!ydir = !object.dir1
			!dirtext = !object.linetext1
		else
			!ydir = !object.dir2
			!dirtext = !object.linetext2
		endif
		!textlen = !dirtext.length() * 0.6 * !cheight

		!zdir = !ori.zdir()
		!tempori = y is $!ydir and z is $!zdir
		!xdir = !tempori.xdir()
		!dirtextpos = !object.anglepos.offset(!ydir,!radius + !this.cheight / 2 + !cheight / 10).offset(!xdir, - !textlen / 2)

		!temparr = !this.getgoodori(!tempori,!dirtextpos,!textlen)
		!tempori = !temparr[1]
		!dirtextpos = !temparr[2]
		!aidtext = object aidtext(!this.mbdstru.aidgro,!dirtextpos,!tempori,!dirtext,!cheight,!functiontext,'node:' + !this.branname)
		!this.polarsystem.add(!aidtext.name)
	enddo
endmethod

define method .getgoodori(!ori is orientation,!textpos is position,!textlen is real) is array
	!orixdir = !ori.xdir()
	!orizdir = !ori.zdir()
	if !ori.zdir().angle(d) lt 70 then
		!textpos = !textpos.offset(!orixdir,!textlen)
		!orixdir = !ori.xdir().opposite()
		!orizdir = !orizdir.opposite()
		!ori = x is $!orixdir and z is $!orizdir
	endif

	if !ori.ydir().angle(d) lt 70 then
		!textpos = !textpos.offset(!orixdir,!textlen).offset(!ori.ydir(),!this.cheight)
		!orixdir = !ori.xdir().opposite()
		!ori = x is $!orixdir and z is $!orizdir
	endif
	!result = array()
	!result[1] = !ori
	!result[2] = !textpos
	return !result
endmethod

define method .drawadjustweld(!object is isoadjustweld)
	!functiontext = '调整焊'

	!pos = !object.pos
	!dis = !!suidirdis(!this.pos,!this.pipedir,!pos)
	!disarr = array()
	!len = !object.aod / 3 + !object.aod * 3 / 4
	if !object.dirup then
		!disarr[1] = !dis - !len
		!disarr[2] = !dis
	else
		!disarr[1] = !dis
		!disarr[2] = !dis + !len
	endif

	!disranges = array()
	!disranges.append(!disarr)


	!angleranges = array()

	!radiusranges = array()

	!radiusarr = array()
	!radiusarr[1] = !this.od / 2 + !object.aod / 50
	!radiusarr[2] = !radiusarr[1] + !object.aod
	!radiusranges.append(!radiusarr)


	!needs = array()
	!needs.append(!len)

	!needs.append(30)

	!needs.append(!object.aod)


	!bestdiss = array()
	!bestdiss.append((!disarr[1] + !disarr[2]) / 2)
	!bestdirs = array()
	!bestradiuss = array()


	!result = !this.polarsystem.getBestPosAndOri(!disranges, !angleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, false, true)
	--!mlabelpos = !result[1]
	!textori = !result[2]

	if !object.dirup then
		!dir = !this.pipedir.opposite()
	else
		!dir = !this.pipedir
	endif
	--!mlabelpos = !mlabelpos.offset(!dir, !len / 2)

	!pos1 = !pos.offset(!textori.ydir(),!object.aod / 2)
	!pos2 = !pos1.offset(!dir, !object.aod / 3).offset(!textori.ydir(),!object.aod * 3 / 4)
	!lines = array()
	!lines.append(!pos1.line(!pos2))

	!pos3 = !pos2.offset(!dir,!object.aod * 3 / 4)
	!lines.append(!pos2.line(!pos3))

	!pos4 = !pos3.offset(!dir, - !object.aod * 3 / 20).offset(!textori.ydir(),!object.aod * 2 / 20)
	!pos5 = !pos3.offset(!dir, - !object.aod * 3 / 20).offset(!textori.ydir(), - !object.aod * 2 / 20)

	!lines.append(!pos3.line(!pos4))
	!lines.append(!pos3.line(!pos5))

	!names = array()
	do !x indices !lines
		!line = !lines[!x]
		!aidline = object mbdaidline(!this.mbdstru.aidgro,!line,!functiontext,'node:' + !this.branname)
		if !this.ignoreline and !x eq 1 then	$* lead line dont consider
			skip
		endif
		!names.append(!aidline.name)
	enddo

	!this.polarsystem.add(!names)
endmethod

define method .drawmaterial(!object is isomaterial)
    --q var !object
	if !object.toshow.not() then
		return
	endif

	!item = !object.name
	if type of $!item eq 'BEND' then
		-----------------------
		-----------------------no need to draw bend since tube at its two ends has been drawed
		return

		$(
		!bendangle = angle of $!item
		if !bendangle eq 90 then
			return
		else
			!object.isotext = !bendangle.string().replace('degree','°')
		endif
		$)
	endif
	if type of $!item eq 'ELBO' then
		------------------------------------------------------draw it in tag
		return
	endif
	!itemtype = !object.type


	--$(
	----no need any more since get all od in method addrealods()
	--addrealods is only for SW, so this step is still necessary
	if !itemtype ne 'TUBI' then
		!realod = !this.getMemRealOd(!item)
	else
		!realod = aod of $!object.name
		--!realod = !object.abore.real()
	endif
	--$)

	--!realod = !this.od

	!elenumtext = ''

	if !object.isotext.set() then
		!materialtext = !object.isotext
		if !this.addelenum then
			!elenumtext = !object.elenumtext
		endif
	else
        ----modify by jyg 20241113 显示汇总材料序号改为显示零部件材料序号
        if  !this.isinstpipe.not() then
            !materialtext = !object.specialnum
        else
            !materialtext = !object.order.string()
        endif

		if !itemtype eq 'ATTA' then
			return		$*show in tag
			!bp = 'S'
			--elseif !itemtype.match('BOLT') ne 0 then		$*has dealed in mergeshowtext
		elseif !itemtype eq 'BOLT' then
            --modify by jyg 20241121 不显示类型
			--!bp = 'B'
            !bp = ''
		elseif !itemtype eq 'GASK' then
            --modify by jyg 20241121 不显示类型
			--!bp = 'G'
            !bp = ''
		elseif !itemtype eq 'FLAN' or !itemtype eq 'FBLI' then
            --modify by jyg 20241121 不显示类型
			--!bp = 'F'
            !bp = ''
		else
			!bp = ''
		endif
		--elseif !itemtype eq 'VALV' then
        --Q VAR !bp  !materialtext
		!materialtext = !bp & !materialtext
		if !this.addelenum then
			!materialtext = !materialtext & '(' & !object.specialnum & ')'
		endif
	endif

	--if !materialtext eq '6' then

	--endif

	$(
	--has dealed in mergeshowtext
	if !itemtype.match('BOLT') ne 0 then
		--if !itemtype eq 'BOLT' then
		-----------------------
		-----------------------only one case, other cases Bxx would attaches to other object
		if !object.boltshowpos.set() then
			!itempos = !object.boltshowpos
		else
			!tempitem = !object.name
			!itempos = pos of $!tempitem wrt/*
		endif
	$)
	if !itemtype eq 'BOLT' then
		-----------------------
		-----------------------only one case, other cases Bxx would attaches to other object
		!itempos = !object.boltshowpos
	elseif !itemtype eq 'TUBI' then
		!realtype = type of $!item
		handle any
			!itempos = Itposition of $!item wrt/*
		elsehandle none
			if !realtype ne 'BEND' then
				!itempos = Itposition of $!item wrt/*
			else
				!itempos = pos of $!item wrt/*
			endif
		endhandle
	else
        --modify by jyg 20240925
        !ldir = ldir of $!item wrt/*
        !adir = adir of $!item wrt/*
        handle any
            !adir = !ldir.opposite()
        endhandle

		if !adir.angle(!ldir) gt 179 then
            --modify by jyg 20240925
            !lpos = lpos of $!item wrt/*
            !apos = apos of $!item wrt/*
            handle any
                !apos = !lpos
            endhandle

			!aline = !apos.line(!apos.offset(!adir,1000))
			!itempos = !apos.midpoint(!aline.near(!lpos))
		else
			!itempos = pos of $!item wrt/*
		endif
	endif

	!othertext = ''
	if !object.tubinum.unset() then
		--!textlen = !!mbdtextlen(!materialtext) * !this.cheight * 0.75
		!alltext = !materialtext
		!itemname = name of $!item
		if !itemname.substring(1,1) eq '/' and type of $!item ne 'ATTA' then
			return $*draw in tag
			--!othertext = !itemname.after('/')			$* it is for valv inst and so on
			!othertext = !object.desc.after('/')
		endif
	else
		--!textlen = !!mbdtextlen(!materialtext + '<' + !object.tubinum.string() + '>') * !this.cheight * 0.75
		--!alltext = !materialtext + '<' + !object.tubinum.string() + '>'


		if !this.isinstpipe.not() then
            --modify by jyg 20241113 调整为不显示管道号
			--!alltext = !materialtext + ' P' + !object.tubinum.string()	$*除所要求EM4、EM9统一
            !alltext = !materialtext
		else
			if !this.drawPforInst then
				!alltext = !materialtext + ' P' + !object.tubinum.string()
			else
			!alltext = !materialtext
			endif
		endif
        --q var !alltext
	endif
	if !othertext eq '' then
		----!textlen = !!mbdtextlen(!alltext) * !this.cheight * 0.75
		--!textlen = !!mbdtextlen(!alltext) * !this.cheight * 0.8
		!textlen = !!mbdtextlen(!alltext) * !this.cheight
	else
		----!textlen = max(!!mbdtextlen(!alltext),!!mbdtextlen(!othertext)) * !this.cheight * 0.75
		--!textlen = max(!!mbdtextlen(!alltext),!!mbdtextlen(!othertext)) * !this.cheight * 0.8
		!textlen = max(!!mbdtextlen(!alltext),!!mbdtextlen(!othertext)) * !this.cheight
	endif

	if !elenumtext ne '' then
		--!textlen = max(!textlen,!!mbdtextlen(!elenumtext) * !this.cheight * 0.8)
		!textlen = max(!textlen,!!mbdtextlen(!elenumtext) * !this.cheight)
	endif

	--------------
	--$(
	!bestdis = !!suidirdis(!this.pos,!this.pipedir,!itempos)
	!disarr = array()
	!disarr[1] = !bestdis - !textlen / 2
	!disarr[2] = !bestdis + !textlen / 2

	--if !othertext eq '' and !alltext.length() lt 3 then		$* if text is short, give it a movable space
	if !othertext eq '' and !elenumtext eq '' and !alltext.length() lt 3 then		$* if text is short, give it a movable space
		!disarr[1] = !disarr[1] - !textlen * 2
		!disarr[2] = !disarr[2] + !textlen * 2
	endif


	--!disarr = !this.getdisarr(!textlen,!bestdis,!item)	$*material no need to to this

	!disranges = array()
	!disranges.append(!disarr)

	$(
	if !othertext eq '' and !alltext.length() lt 3 then
		--$p $!alltext
		!disarr = array()
		!disarr[1] = !bestdis - 3 * !textlen / 2
		!disarr[2] = !bestdis - !textlen / 2
		!disranges.append(!disarr)


		!disarr = array()
		!disarr[1] = !bestdis + !textlen / 2
		!disarr[2] = !bestdis + !textlen * 1.5
		!disranges.append(!disarr)
	endif
	$)



	!angleranges = array()

	!radiusarr = array()
	--q var !realod !this.cheight
	!radiusarr[1] = !realod / 2 + !this.cheight * 0.5
	!radiusarr[2] = !radiusarr[1] + !this.cheight
	if !othertext ne '' then
		!radiusarr[2] = !radiusarr[2] + !this.cheight
	endif
	if !elenumtext ne '' then
		!radiusarr[2] = !radiusarr[2] + !this.cheight
	endif
	!radiusranges = array()
	!radiusranges.append(!radiusarr)

	!needs = array()
	!needs.append(!textlen)
	!needs.append(60)
	!textheight = !this.cheight
	if !othertext ne '' then
		!textheight = !textheight + !this.cheight
	endif
	if !elenumtext ne '' then
		!textheight = !textheight + !this.cheight
	endif
	!needs.append(!textheight)
	$(
	if !othertext eq '' then
		!needs.append(!this.cheight)
	else
		!needs.append( 2 * !this.cheight)
	endif
	$)

	!bestdiss = array()
	!bestdiss.append(!bestdis)


	!bestdirs = array()

	!itemtype = type of $!item
	handle any
	elsehandle none
		--$p $!itemtype $!weldtext
		if !itemtype inset('OLET','TEE') then
			do !x from 1 to 3
				!tempdir = p$!x dir of $!item
				!tempangle = !tempdir.angle(!this.pipedir)
				if !tempangle gt 10 and !tempangle lt 170 then
					if !itemtype eq 'TEE' then
						if arrive of $!item eq !x or leave of $!item eq !x then
							!tempdir = !tempdir.opposite()
						endif
					endif
					!bestdirs.append(!tempdir)
				endif
			enddo
			--q var !bestdirs
			$(
			-----------------------
			-----------------------avoid to overlap with connection information
			do !tx indices !radiusranges
				!radiusranges[!tx][1] = !radiusranges[!tx][1] + !this.cheight * 2
				!radiusranges[!tx][2] = !radiusranges[!tx][2] + !this.cheight * 2
			enddo
			$)
		endif
	endhandle
	$(
	!itemtype = type of $!item
	if !itemtype inset ('TEE','OLET') then
		!p3dir = p3 dir of $!item wrt/*
		!bestdirs.append(!p3dir)
	endif
	$)

	!bestradiuss = array()



	!result = !this.polarsystem.getBestPosAndOri(!disranges, !angleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, false, false)
	--$)
	--!result = !this.polarsystem.getBestPosAndOri(!itempos,!alltext,!realod,!this.cheight, false, false)
    --q var !this.polarsystem !result
	!mlabelpos = !result[1]
	!textori = !result[2]
	!mlabelpos = !mlabelpos.offset(!textori.xdir(), - !textlen / 2)	$*material no need to to this


	!functiontext = '材料'
	if !itemtype ne 'TUBI' and !itemtype ne 'FTUB' then
		if !itemtype eq 'TEE' or !this.isinstpipe then
			!temppos = pos of $!item wrt/*
		else
			!temppos = p3 pos of $!item wrt/*
			handle any
				!temppos = pos of $!item wrt/*
			elsehandle none
				!p3bore = p3 bore of $!item
				if !p3bore.unset() then
					!temppos = pos of $!item wrt/*
				endif
			endhandle
		endif
		--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,!temppos,'node:' + !this.branname)
		if !othertext eq '' and !elenumtext eq '' then
        --$p 1
        --q var !materialtext
			!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,!temppos,'node:' + !this.branname)
			if !materialtext eq '6' or !materialtext eq '9' then
				!sixninepos1 = !mlabelpos.offset(!textori.ydir(), - !this.cheight / 7)
				!sixninepos2 = !sixninepos1.offset(!textori.xdir(), !textlen * 2 / 3)
				!aidline = object mbdaidline(!this.mbdstru.aidgro,!sixninepos1,!sixninepos2,!functiontext,'node:' + !this.branname)
			endif
		elseif !othertext ne '' then
        --$p 2
        --q var !materialtext
			!othermlabelpos = !mlabelpos
			if !elenumtext ne '' then
				!mlabelpos = !mlabelpos.offset(!textori.ydir(),2 * !this.cheight)
			else
				!mlabelpos = !mlabelpos.offset(!textori.ydir(),!this.cheight)
			endif
			!dis1 = !this.line.distance(!mlabelpos)
			!dis2 = !this.line.distance(!othermlabelpos)
			if !dis1 le !dis2 then
				!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,!temppos,'node:' + !this.branname)
				!othermlabel = object mlabel(!this.mbdstru.dimgro,!othermlabelpos,!textori,!othertext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
			else
				!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
				!othermlabel = object mlabel(!this.mbdstru.dimgro,!othermlabelpos,!textori,!othertext,!this.cheight,false,!functiontext,!temppos,'node:' + !this.branname)
			endif
			if !elenumtext ne '' then
				!elenummlabelpos = !mlabelpos.offset(!textori.ydir(),!this.cheight)
				!elenummlabel = object mlabel(!this.mbdstru.dimgro,!elenummlabelpos,!textori,!elenumtext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
			endif
		else
        --$p 3
        --q var !materialtext
			!elenummlabelpos = !mlabelpos
			!mlabelpos = !mlabelpos.offset(!textori.ydir(),!this.cheight)

            !materialtext='1000'

			!dis1 = !this.line.distance(!mlabelpos)
			!dis2 = !this.line.distance(!elenummlabelpos)
			if !dis1 le !dis2 then
				!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,!temppos,'node:' + !this.branname)
				!elenummlabel = object mlabel(!this.mbdstru.dimgro,!elenummlabelpos,!textori,!elenumtext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
			else
				!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
				!elenummlabel = object mlabel(!this.mbdstru.dimgro,!elenummlabelpos,!textori,!elenumtext,!this.cheight,false,!functiontext,!temppos,'node:' + !this.branname)
			endif
		endif
	else
        --$p 4
        --q var !materialtext
        --!materialtext = '1000'
		if !this.line.distance(!mlabelpos) gt !this.od / 2 + !this.cheight * 2 then
			!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,!this.line.near(!mlabelpos),'node:' + !this.branname)
		else
			!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
			--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,'MaterialText','','node:' + !this.branname)
		endif
	endif

	!mlabels = array()
	!mlabels.append(!mlabel.name)
	if !othertext ne '' then
		!mlabels.append(!othermlabel.name)
	endif
	if !elenumtext ne '' then
		!mlabels.append(!elenummlabel.name)
	endif
	--!this.polarsystem.add(!mlabel.name)


	if !object.tubinum.set() then
		if !this.isinstpipe.not() or !this.drawPforInst then
			--if !this.isinstpipe.not() and !object.tubinum.set() then
			!cutmlabelpos = !mlabelpos.offset(!textori.xdir(),!materialtext.length() * !this.cheight * 2 / 3)
			--!cutpipetext = '<' & !object.tubinum & '>'

            --modifyg by jyg 20241113 不显示管段号
            if  !this.isinstpipe.not() then
                !cutpipetext = ' '
            else
                !cutpipetext = ' P' & !object.tubinum
            endif

            --q var !cutpipetext
			--!functiontext = '管段号'
			!functiontext = '直管段号'
			!mlabel = object mlabel(!this.mbdstru.dimgro,!cutmlabelpos,!textori,!cutpipetext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
			--!mlabel = object mlabel(!this.mbdstru.dimgro,!cutmlabelpos,!textori,!cutpipetext,!this.cheight,false,'PIPE SLOOP','','node:' + !this.branname)
			--!this.polarsystem.add(!mlabel.name)
			!mlabels.append(!mlabel.name)
		endif
	endif

	--if stext of $!mlabels[1] eq '5' then
	--endif
	!this.polarsystem.add(!mlabels)
	--if stext of $!mlabels[1] eq '5' then
	--endif

	!size = 1
	if !othertext ne '' then
		!size = !size + 1
	endif
	if !elenumtext ne '' then
		!size = !size + 1
	endif
	do !times from 1 to !size
		if !times eq 1 then
			!matelen = !!mbdtextlen(!materialtext) + 0.2
			!pos1 = !mlabelpos.offset(!textori.xdir(), - !this.cheight / 10).offset(!textori.ydir(), - !this.cheight / 10)
			--!pos2 = !pos1.offset(!textori.xdir(), !this.cheight * 7 * !matelen / 10)
			!pos2 = !pos1.offset(!textori.xdir(), !this.cheight * !matelen)
		elseif !elenumtext ne '' then
			!matelen = !!mbdtextlen(!elenumtext) + 0.2
			!pos1 = !elenummlabelpos.offset(!textori.xdir(), - !this.cheight / 10).offset(!textori.ydir(), - !this.cheight / 10)
			--!pos2 = !pos1.offset(!textori.xdir(), !this.cheight * 8 * !matelen / 10)
			!pos2 = !pos1.offset(!textori.xdir(), !this.cheight * !matelen)
		else
			!matelen = !!mbdtextlen(!othertext) + 0.2
			!pos1 = !othermlabelpos.offset(!textori.xdir(), - !this.cheight / 10).offset(!textori.ydir(), - !this.cheight / 10)
			--!pos2 = !pos1.offset(!textori.xdir(), !this.cheight * 8 * !matelen / 10)
			!pos2 = !pos1.offset(!textori.xdir(), !this.cheight * !matelen)
		endif

		!pos3 = !pos2.offset(!textori.ydir(), !this.cheight )
		!pos4 = !pos1.offset(!textori.ydir(), !this.cheight )

		!functiontext = '材料'
		!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos1,!pos2,!functiontext,'node:' + !this.branname)
		--!this.polarsystem.add(!aidline.name)
		!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos2,!pos3,!functiontext,'node:' + !this.branname)
		--!this.polarsystem.add(!aidline.name)
		!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos3,!pos4,!functiontext,'node:' + !this.branname)
		--!this.polarsystem.add(!aidline.name)
		!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos4,!pos1,!functiontext,'node:' + !this.branname)
		--!this.polarsystem.add(!aidline.name)
	enddo

	--if !materialtext eq '6' then

	--endif
endmethod


define method .drawweld(!object is isoweldtext)
	!item = !object.name
	!bestdir = !this.getbestdir(!item)
	!weldtext = !object.text
	!weldpos = !object.pos

	--Q VAR !weldtext !weldpos

	----!textlen = !!mbdtextlen(!weldtext) * !this.cheight * 0.75
	--!textlen = !!mbdtextlen(!weldtext) * !this.cheight * 0.8
	!textlen = !!mbdtextlen(!weldtext) * !this.cheight
	!bestdis = !!suidirdis(!this.pos,!this.pipedir,!weldpos)


	!disranges = !this.getdisarr(!textlen,!bestdis,!item)
	--q var !disranges[1]

	if !disranges.size() eq 1 and !weldtext.length() lt 3 then
		!disranges[1][1] = max( - !this.od / 3,!disranges[1][1] - !textlen * 2)
		!disranges[1][2] = min(!this.line.length() + !this.od / 3, !disranges[1][2] + !textlen * 2)
	endif
	--q var !disranges[1]


	!angleranges = array()

	!radiusarr = array()
	!radiusarr[1] = !this.od / 2 + !this.cheight * 0.5
	!radiusarr[2] = !radiusarr[1] + !this.cheight
	!radiusranges = array()
	!radiusranges.append(!radiusarr)

	!needs = array()
	!needs.append(!textlen)
	!needs.append(30)
	!needs.append(!this.cheight)

	!bestdiss = array()
	!bestdiss.append(!bestdis)
	!bestdirs = array()
	if !bestdir.set() then
		!bestdirs.append(!bestdir)
	elseif type of $!item eq 'ATTA' then		$*202309191549
		!attapos = pos of $!item wrt/*
		!bestdir = !attapos.direction(!weldpos)
		handle any
		elsehandle none
			!bestdirs.append(!bestdir)
		endhandle
	endif
	!bestradiuss = array()



	!result = !this.polarsystem.getBestPosAndOri(!disranges, !angleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, false, true)



	--!result = !this.polarsystem.getBestPosAndOri(!weldpos,!weldtext,!this.od,!this.cheight, false, true)
	!mlabelpos = !result[1]
	!textori = !result[2]

	--if !weldtext eq 'A2' then

	--endif

	!mlabelpos = !mlabelpos.offset(!textori.xdir(), - !textlen / 2)

	!functiontext = '焊点'
	if !weldpos.distance(!mlabelpos) gt !this.od / 2 + !this.cheight * 2 then
		!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!weldtext,!this.cheight,false,!functiontext,!weldpos,'node:' + !this.branname)
		--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!weldtext,!this.cheight,false,'WeldText',!weldpos,'node:' + !this.branname)
	else
		!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!weldtext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
		--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!weldtext,!this.cheight,false,'WeldText','','node:' + !this.branname)
	endif
	!this.polarsystem.add(!mlabel.name)
endmethod

define method .getdisarr(!textlen is real, !bestdis is real, !item is string) is array
	!side = false
	!itemtype = type of $!item
	handle any
	elsehandle none
		if !itemtype inset('OLET') then
			--if !itemtype inset('OLET','TEE','CROS') then
			!side = true
		endif
	endhandle
	!disarrs = array()
	if !side.not() or !textlen gt !this.od / 2 then
		!disarr = array()
		!disarr[1] = !bestdis - !textlen / 2
		!disarr[2] = !bestdis + !textlen / 2
		!disarrs.append(!disarr)
	else
		!arrive = arrive of $!item
		!leave = leave of $!item
		if !arrive ne 1 and !leave ne 1 then
			!bore = p1 bore of $!item wrt/*
		elseif !arrive ne 2 and !leave ne 2 then
			!bore = p2 bore of $!item wrt/*
		elseif !arrive ne 3 and !leave ne 3 then
			!bore = p3 bore of $!item wrt/*
		endif

        --modify by jyg 20241220
        if  !bore.unset() then
            !bore = object bore(0)
        endif

		!borereal = !bore.real()
		!disarr = array()
		!disarr[1] = !bestdis - !textlen - !borereal * 1.5
		!disarr[2] = !bestdis - !borereal * 1.5

		!disarrs.append(!disarr)


		!disarr = array()
		!disarr[1] = !bestdis + !borereal * 1.5
		!disarr[2] = !bestdis + !textlen + !borereal * 1.5
		!disarrs.append(!disarr)
	endif
	!disranges = array()
	do !disarr values !disarrs
		if !disarr[1] lt 0 then
			!plus = - !disarr[1] + !this.od / 4
		elseif !disarr[2] gt !this.line.length() - !this.od / 4 then
			!plus = !this.line.length() - !disarr[2] - !this.od / 4
		else
			!plus = 0
		endif

		!disarr[1] = !disarr[1] + !plus
		!disarr[2] = !disarr[2] + !plus
		!disranges.append(!disarr)
	enddo
    --q var !disranges[1]
	return !disranges
	--return !disarr
endmethod

define method .getbestdir(!item is string) is direction
	!bestdir = object direction()
	!itemtype = type of $!item
	handle any
	elsehandle none
		--$p $!itemtype $!weldtext
		if !itemtype inset('OLET','TEE') then
			do !x from 1 to 3
				!tempdir = p$!x dir of $!item
				!tempangle = !tempdir.angle(!this.pipedir)
				if !tempangle gt 10 and !tempangle lt 170 then
					!bestdir = !tempdir
					if !itemtype eq 'TEE' then
						if arrive of $!item eq !x or leave of $!item eq !x then
							!bestdir = !tempdir.opposite()
						endif
					endif

					$(
					!tempzdir = !this.polarsystem.showdir.orthogonal(!tempdir)
					!tempori = x is $!this.polarsystem.showdir and z is $!tempzdir
					!temppos = pos of $!item wrt/*
					!temparc = object arc(!temppos,!tempori,0,360,1000,true)
					!tempangle = !temparc.near(!temppos.offset(!tempdir,1000))
					if !tempangle le 90 then
						!tempangle = !tempangle + 15
					else
						!tempangle = !tempangle - 15
					endif
					!bestdir = !temparc.angledirection(!tempangle)
					$)

					break
				endif
			enddo
			--q var !bestdirs
		endif
	endhandle
	return !bestdir
endmethod

define method .findattaorder(!isotag is isotag) is real
    --q var !isotag !this.objects !this.objects[2] !this.objects[3] !this.objects[4]
	!name = !isotag.name
	do !index indices !this.objects
		if !this.objects[!index].objecttype() eq 'ISOMATERIAL' then
			--$p $!name $!this.objects[$!index].name
			if !this.objects[!index].name eq !name then
                --modify by jyg 20241113 显示汇总材料序号改为显示零部件材料序号
				--return !this.objects[!index].order
                if !this.isinstpipe.not() then
                    return !this.objects[!index].specialnum.real()
                else
                    return !this.objects[!index].order
                endif

			endif
		endif
	enddo
	--impossible
	!this.wronglines.append('Check the order in Bran for ' & !name)
	return 0	$* invoid to cause a ERROR
endmethod

define method .drawtag(!object is isotag)
    --q var !object.name  !object.infoarr
    --q var !object
	if !object.function eq 'cutpipe' then
		!cheight = !this.cheight * 2
	elseif !object.function eq '管道名称' then
		!cheight = !this.cheight * 3
	else
		!cheight = !this.cheight
	endif

	!item = !object.name
	!bestdir = !this.getbestdir(!item)
	--q var !bestdir
	!infoarr = !object.infoarr
	--if !object.function inset('AttaMaterialTag','ElboInformation','BendInformation') then

	!materialtogether = false
	!elementname = false
	if !infoarr[1].trim() eq '' or !object.function inset('AttaMaterialTag','ElboInformation') then	$*Bend has no material
        !order = !this.findattaorder(!object)
		!materialtogether = true
		if !infoarr[1].trim() ne '' then
			!infoarr.insert(1,'  ')
		else
			!elementname = true
		endif

		--do !x from 1 to !order.string().length() * 2 + 2
		--	!infoarr[1] = ' ' + !infoarr[1]
		--enddo
	endif
	!tagtype = !object.tagtype
	if !tagtype eq 'pos' then
		!pos = !object.pos
	else
		!pos = pos of $!item wrt/*
	endif

	--if !infoarr.size() gt 1 then

	--endif

	!maxlen = 0
	do !line values !infoarr $*获取最长的文本信息及长度
       --q var !line
		!linelen = !line.length()
		if !linelen gt !maxlen then
			!text = !line
			!maxlen = !linelen
		endif
	enddo
	--q var !infoarr
	!textlen = !!mbdtextlen(!text) * !cheight
	--!textlen = !!mbdtextlen(!text) * !cheight * 0.75
	----!textlen = !!mbdtextlen(!text) * !cheight * 0.8
    --q var !this.pos !this.pipedir !pos
	!bestdis = !!suidirdis(!this.pos,!this.pipedir,!pos)
    --q var !bestdis
	-----------------------
	-----------------------horizontal tube
    --q var !textlen
	if abs(!this.pipedir.angle(u) - 90) lt 60 then					$*hori
    --$p 1
        --q var !textlen !bestdis !item
		!disranges = !this.getdisarr(!textlen,!bestdis,!item)
        --q var !disranges
		--q var !textlen !this.line.length()
		--if !textlen gt 475 and !this.line.length() eq 216 then
		--	!disranges1 = !this.getdisarr(min(!textlen,!this.line.length()),!bestdis,!item)	$* 超过线的长度就没意义了

		--endif
		!angleranges = array()

		!radiusranges = array()
		!radiusarr = array()
		if !infoarr.size() eq 1 then
			if !object.function eq 'cutpipe' then
				!radiusarr[1] = !this.od / 2 + !cheight * 5
			elseif !object.function eq '管道名称' then
				!radiusarr[1] = !this.od / 2 + !cheight * 6
			else
				!radiusarr[1] = !this.od / 2 + !cheight * 2
			endif
			!radiusarr[2] = !radiusarr[1] + !cheight * !infoarr.size()
			!radiusranges.append(!radiusarr)
		else
			--if !infoarr.size() ne 1 then
			!radiusarr[1] = !this.od / 2 + !cheight * 2
			--!radiusarr[1] = !this.od / 2 + !cheight * 3
			!radiusarr[2] = !radiusarr[1] + !cheight * !infoarr.size()
			!radiusranges.append(!radiusarr)
		endif
		--$)

		!needs = array()
		!needs.append(!textlen)
		if !infoarr.size() ne 1 then
			!needs.append(60)
		else
			!needs.append(30)
		endif
		!needs.append(!cheight * !infoarr.size())



		!bestdiss = array()
		!bestdiss.append(!bestdis)
		!bestdirs = array()
		if !bestdir.set() then
			!bestdirs.append(!bestdir)
		endif

		!bestradiuss = array()

		--if !infoarr.size() neq 1 then
		--	return
		--endif


		--!radiusranges = array()
		!result = !this.polarsystem.getBestPosAndOri(!disranges, !angleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, false, true)
		!mlabelpos = !result[1]
		!textori = !result[2]

		--if !infoarr.size() gt 3 then

		--endif
		--if !infoarr.size() ne 1 then

		--endif

		!mlabelpos = !mlabelpos.offset(!textori.xdir(), - !textlen / 2)

		!tempdir = !this.line.near(!mlabelpos).direction(!mlabelpos)

		if !tempdir.angle(!textori.ydir()) lt 90 then
			!samedir = true
			!movedir = !tempdir
		else
			!samedir = false
			!movedir = !tempdir.opposite()
		endif

		!size = !infoarr.size()
		!textposs = array()
		do !x indices !infoarr
			!textpos = !mlabelpos.offset(!movedir,!cheight * (!size - !x ))
			--!textpos = !mlabelpos.offset(!movedir,!cheight * 1.2 * (!size - !x ))
			!textposs.append(!textpos)
		enddo
	else	$*vert
    --$p 2
		-----------------------
		-----------------------vertical tube
		!disranges = !this.getdisarr(!infoarr.size() * !cheight,!bestdis,!item)


		!angleranges = array()

		!radiusranges = array()
		!radiusarr = array()
		if !infoarr.size() eq 1 then
			if !object.function eq '管道名称' then
				!radiusarr[1] = !this.od / 2 + !cheight * 2
			elseif !object.function eq 'cutpipe' then
				!radiusarr[1] = !this.od / 2 + !cheight * 1.5
			else
				!radiusarr[1] = !this.od / 2 + !cheight * 0.5
			endif
			--!radiusarr[1] = !this.od / 2 + !cheight * 0.5
			!radiusarr[2] = !radiusarr[1] + !textlen.value()
			--!radiusarr[2] = !radiusarr[1] + !cheight * !infoarr.size()
			!radiusranges.append(!radiusarr)
		else
			--if !infoarr.size() ne 1 then
			!radiusarr[1] = !this.od / 2 + !cheight * 2
			!radiusarr[2] = !radiusarr[1] +  !textlen.value()
			--!radiusarr[2] = !radiusarr[1] + !cheight * !infoarr.size()
			!radiusranges.append(!radiusarr)
		endif
		$(
		!radiusarr = array()
		!radiusarr[1] = !this.od / 2 + !cheight * 0.5
		!radiusarr[2] = !radiusarr[1] + !textlen
		!radiusranges = array()
		!radiusranges.append(!radiusarr)
		$)

		!needs = array()
		!needs.append(!infoarr.size() * !cheight)
		if !infoarr.size() ne 1 then
			!needs.append(60)
		else
			!needs.append(30)
		endif
		!needs.append(!textlen)

		!bestdiss = array()
		!bestdiss.append(!bestdis)
		!bestdirs = array()
		if !bestdir.set() then
			!bestdirs.append(!bestdir)
		endif

		!bestradiuss = array()



		--!result = !this.polarsystem.getBestPosAndOri(!disranges, !angleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, false, false)
		----mlabel has leadline but no need to consider it,even no need to add in polarsystem
		!result = !this.polarsystem.getBestPosAndOri(!disranges, !angleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, false, true)
		!mlabelpos = !result[1]
		!textori = !result[2]

		--if !infoarr.size() gt 3 then

		--endif


		!movedis = !infoarr.size() * !cheight
		--		* 1.2
		if !this.pipedir.angle(U) lt 90 then
			!movedir = !this.pipedir.opposite()
			--!mlabelpos = !mlabelpos.offset(!this.pipedir, !movedis / 2)
		else
			!movedir = !this.pipedir
			--!mlabelpos = !mlabelpos.offset(!this.pipedir, - !movedis / 2)
		endif
		!mlabelpos = !mlabelpos.offset(!movedir, - !movedis / 2)



		!tempangle = !textori.ydir().orthogonal(!this.polarsystem.showdir).angle(u)
		handle any
			--!tempshowdir = !this.polarsystem.showdir.orthogonal(u)
			--!tempangle = !textori.ydir().orthogonal(!tempshowdir).angle(u)
			--q var !infoarr

			!tempangle = !textori.ydir().angle(!this.polarsystem.showdir)
			--q var !tempangle
			!temptempdir = !this.polarsystem.showdir.orthogonal(u)
			if !temptempdir.angle(!textori.zdir()) lt 90 then
				!tempangle = 180 - !tempangle
			endif
		endhandle

		if !tempangle lt 90 then
			!mlabelpos = !mlabelpos.offset(!textori.ydir(), !textlen)
		endif


		!ydir = !movedir.opposite()
		!zdir = !textori.zdir()
		!textori = y is $!ydir and z is $!zdir


		!mlabelpos = !mlabelpos.offset(!movedir,!cheight * 0.7)
		!textposs = array()
        --q var !infoarr
		do !x indices !infoarr
			--!textpos = !mlabelpos.offset(!movedir,!cheight * 1.2 * (!x - 1))
			!textpos = !mlabelpos.offset(!movedir,!cheight * (!x - 1))
			!textposs.append(!textpos)
		enddo

	endif



	!xdir = !textori.xdir()
	!mindis = 10000000
	do !x indices !infoarr
		!textpos = !textposs[!x]



		$(
		!dis1 = !textpos.distance(!pos)
		!textlen = !!mbdtextlen(!infoarr[!x]) * !cheight * 0.75
		!dis2 = !textpos.offset(!xdir,!textlen).distance(!pos)

		if !dis1 lt !mindis then
			!goodx = !x
			!mindis = !dis1
		endif
		if !dis2 lt !mindis then
			!goodx = !x
			!mindis = !dis2
		endif
		$)

		!textlen = !!mbdtextlen(!infoarr[!x]) * !cheight
		--!textlen = !!mbdtextlen(!infoarr[!x]) * !cheight * 0.75
		--!textlen = !!mbdtextlen(!infoarr[!x]) * !cheight * 0.8
		!templine = !textpos.line(!textpos.offset(!xdir,!textlen))
        --Q VAR !templine !pos
		!dis = !templine.distance(!pos)
		if !dis lt !mindis then
			!goodx = !x
			!mindis = !dis
		endif
	enddo

	!functiontext = !this.gettagfunction(!object)
    --q var !functiontext
	!names = array()
	--if !object.function eq 'cutpipe' then
	--	!cheight = !this.cheight * 2
	--else
	--	!cheight = !this.cheight
	--endif
    --q var !infoarr
	do !x indices !infoarr
		!line = !infoarr[!x]
        --Q VAR !line
        --$p 100
		!textpos = !textposs[!x]
        --q var !infoarr !textpos !x
		if !x ne 1 or !materialtogether.not() then
			--if !x ne 1 or !infoarr[1].trim() ne '' then	$*make sure the first line is not for material order number
			if !x eq !goodx then
				if !tagtype eq 'pos' then
                    --q var !infoarr
                    --q var !textposs
                    --q var !x
					!mlabel = object mlabel(!this.mbdstru.dimgro,!textpos,!textori,!line,!cheight,false,!functiontext,!pos,'node:' + !this.branname)
				else
					!mlabel = object mlabel(!this.mbdstru.dimgro,!textpos,!textori,!line,!cheight,false,!functiontext,!item,'node:' + !this.branname)
				endif
			else
				!mlabel = object mlabel(!this.mbdstru.dimgro,!textpos,!textori,!line,!cheight,false,!functiontext,'','node:' + !this.branname)
			endif
			!names.append(!mlabel.name)
		endif

		if !x eq 1 and !materialtogether then
			--if !x eq 1 and (!infoarr[1].trim() eq '' or !object.function inset('AttaMaterialTag','ElboInformation')) then	$*Bend has no material
			--if !x eq 1 and !object.function eq 'AttaMaterialTag' then
            --q var !infoarr
			if !goodx eq 1 then
				if !tagtype eq 'pos' then
					!name = !this.drawattamaterial(!order.string(),!textpos,!textori,!pos)
				else
					!name = !this.drawattamaterial(!order.string(),!textpos,!textori,!item)
				endif
			else
				!name = !this.drawattamaterial(!order.string(),!textpos,!textori,'')
			endif
			--if !infoarr[1].trim() eq '' then
			!names.append(!name)
			--endif
		endif
		if !x eq 2 and !elementname then
			!this.drawframe(!line,!textpos,!textori,'位号')
		endif
	enddo
	!this.polarsystem.add(!names)

endmethod

define method .drawattamaterial(!materialtext is string,!mlabelpos is position,!textori is orientation,!item is any) is string
	!functiontext = '材料'

	!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,!item,'node:' + !this.branname)
	$(
	if !this.line.distance(!mlabelpos) gt !this.od / 2 + !this.cheight * 2 then
		--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,!this.line.near(!mlabelpos),'node:' + !this.branname)
		!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,!this.line.near(!mlabelpos),'node:' + !this.branname)
	else
		!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
		--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
		--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,'MaterialText','','node:' + !this.branname)
	endif
	!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!textori,!materialtext,!this.cheight,false,!functiontext,'','node:' + !this.branname)
	--!this.polarsystem.add(!mlabel.name)	$*the position of atta material is considered at tag
	$)
	--!functiontext = 'MaterialTextFrame'
	!functiontext = '材料'
	!this.drawframe(!materialtext,!mlabelpos,!textori,!functiontext)
	return !mlabel.name

	$(
	!matelen = !!mbdtextlen(!materialtext)
	!pos1 = !mlabelpos.offset(!textori.xdir(), - !this.cheight / 10).offset(!textori.ydir(), - !this.cheight / 10)
	!pos2 = !pos1.offset(!textori.xdir(), !this.cheight * 7 * !matelen / 10)


	!pos3 = !pos2.offset(!textori.ydir(), !this.cheight )
	!pos4 = !pos1.offset(!textori.ydir(), !this.cheight )

	!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos1,!pos2,'MaterialTextFrame','node:' + !this.branname)
	!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos2,!pos3,'MaterialTextFrame','node:' + !this.branname)
	!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos3,!pos4,'MaterialTextFrame','node:' + !this.branname)
	!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos4,!pos1,'MaterialTextFrame','node:' + !this.branname)
	$)
endmethod

define method .drawframe(!text is string,!mlabelpos is position,!textori is orientation,!functiontext is string)
	--!matelen = !!mbdtextlen(!text)
	----!textlen = !!mbdtextlen(!text) * !this.cheight * 0.8 + 0.2 * !this.cheight
	--!textlen = !!mbdtextlen(!text) * !this.cheight * 0.75
	!textlen = !!mbdtextlen(!text) * !this.cheight

	!pos1 = !mlabelpos.offset(!textori.xdir(), - !this.cheight / 10).offset(!textori.ydir(), - !this.cheight / 10)
	--!pos2 = !pos1.offset(!textori.xdir(), !this.cheight * 7 * !matelen / 10)
	!pos2 = !pos1.offset(!textori.xdir(), !textlen + !this.cheight / 5)


	!pos3 = !pos2.offset(!textori.ydir(), !this.cheight )
	!pos4 = !pos1.offset(!textori.ydir(), !this.cheight )

	!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos1,!pos2,!functiontext,'node:' + !this.branname)
	!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos2,!pos3,!functiontext,'node:' + !this.branname)
	!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos3,!pos4,!functiontext,'node:' + !this.branname)
	!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos4,!pos1,!functiontext,'node:' + !this.branname)
endmethod

define method .gettagfunction(!object is any) is string
	if !object.function eq 'ConnectionTag' then
		!functiontext = '连接信息'
	elseif !object.function eq 'AttaTag' then
		!functiontext = 'ATTA信息'
	elseif !object.function eq 'AttaMaterialTag' then
		!functiontext = '附件材料信息'
	elseif !object.function eq 'ElevationTag' then
		!functiontext = '标高'
		--elseif !object.function eq 'BendAngle' then
		--	!functiontext = '弯管角度'
		--elseif !object.function eq 'BendRadius' then
		--	!functiontext = '弯曲半径'
	elseif !object.function eq 'BendInformation' then
		!functiontext = '弯管信息'
		--elseif !object.function eq 'ElboAngle' then
		--	!functiontext = '弯头角度'
	elseif !object.function eq 'ElboInformation' then
		!functiontext = '弯头信息'
	elseif !object.function eq 'cutpipe' then
		!functiontext = '管段'
	elseif !object.function eq 'ElementName' then
		!functiontext = '位号'
	else
		!functiontext = !object.function
	endif

	return !functiontext
endmethod

define method .drawOneObjectNew(!objectindex is real)
	!object = !this.objects[!objectIndex]
    --q var !object
	!otype = !object.objecttype()

	--if !otype ne 'ISOWELDTEXT' then
	--return
	--endif
	--q var !otype
	if !otype eq 'ISODIM' then
		if !object.poss[1].distance(!object.poss.last()) lt 1 then	$*avoid the dim is bad
			return
		endif
        --q var !object.mainDim !this.twoormoredims
		if !object.mainDim then                $* main dim
			if !this.twoormoredims then
				!this.drawdim(!object,2)
				--!this.drawdim(!object,2,!this.dimdir)
			else
				!this.drawdim(!object,1)
				--!this.drawdim(!object,1,!this.dimdir)
			endif
			--!this.dimdir = !object.dimdir
		else
			--return
			!this.drawdim(!object,1)
			--!this.drawdim(!object,1,!this.dimdir)
		endif
	elseif !otype eq 'ISOSLOPE' then
		!this.drawslope(!object)
	elseif !otype eq 'ISOMATERIAL' then
		!this.drawmaterial(!object)
	elseif !otype eq 'ISOWELDTEXT' then
		!this.drawweld(!object)
	elseif !otype eq 'ISOTAG' then
		!this.drawtag(!object)
	elseif !otype eq 'ISOADJUSTWELD' then
		!this.drawadjustweld(!object)
	elseif !otype eq 'ISOMBDANGLE' then
		!this.drawangle(!object)
	elseif !otype eq 'ISOLEG' then	$* only normal isoleg, elboisoleg have been changed to isodim
		!this.drawleg(!object)
	endif
endmethod

define method .drawOneObject(!objectIndex is real)						$*old 202305221627
	if !this.usepolarsystem then
    --$p 1
    --q var !objectindex
		!this.drawoneobjectnew(!objectindex)
	else
		!object = !this.objects[!objectIndex]
		!otype = !object.objecttype()


		if !otype eq 'ISODIM' then
			!objectDir = !!isofindIsouseddir(!this.usedDirs,'ISODIM').dir
			handle any
				!objectDir = object direction()
			endhandle
		else
			!objectDir = !!isofindIsouseddir(!this.usedDirs,!objectIndex.string()).dir
			handle any
				!objectDir = object direction()
			endhandle
		endif
		--if !otype ne 'ISODIM' then
		--return
		--endif



		--$p $!objectindex   $!objectdir
        --$p 2
        --q var !otype
		if !otype eq 'ISODIM' then
			!object.changecheightauto = !this.changecheightauto
			!object.sepSmallDim = !this.sepSmallDim
			if !object.mainDim then                $* main dim
				!this.dimdir = !objectDir

				if !this.dimdir.unset() then
					!minMax = !this.getminMax(!object)
					--$(
					!cutlen = min(!object.od / 2 + 1,!object.poss[1].distance(!object.poss.last()) / 10) $*可以缩短占用空间
					!minmax[1] = !minmax[1] + !cutlen
					!minmax[2] = !minmax[2] - !cutlen
					--$)



					!useddirs = !this.getusedDirs(!minmax[1],!minmax[2])

					$(
					if !this.useGoodDirs then
						!object.draw(!handledirs,!this.dimdirs,!this.chardirs,!this.mbdstru,!this.cheight,2,!this.usedDirs)
						--!object.draw(!handledirs,!this.dimdirs,!this.chardirs,!this.dimgro,!this.dimslopelineGro,!this.dimslopeTextGro,!this.cheight,2,!this.usedDirs)
					else
					$)
					!object.draw(!usedDirs,!this.mbdstru,!this.cheight,2,!this.usedDirs)
					--!object.draw(!handledirs,!this.dimgro,!this.dimslopelineGro,!this.dimslopeTextGro,!this.cheight,2,!this.usedDirs)
					!this.dimdirs = !object.dimdirs
					!this.chardirs = !object.chardirs
					--endif
					!this.usedDirs = !object.usedDirs
					!this.dimdir = !object.dimdir





				else
					--$p $!this.dimdir   1
					$(
					if !this.useGoodDirs then
						!object.draw(!this.dimdir,!this.dimdirs,!this.chardirs,!this.mbdstru,!this.cheight,2,!this.usedDirs)
						--!object.draw(!this.dimdir,!this.dimdirs,!this.chardirs,!this.dimgro,!this.dimslopelineGro,!this.dimslopeTextGro,!this.cheight,2,!this.usedDirs)
					else
					$)
					!object.draw(!this.dimdir,!this.mbdstru,!this.cheight,2,!this.usedDirs)
					--!object.draw(!this.dimdir,!this.dimgro,!this.dimslopelineGro,!this.dimslopeTextGro,!this.cheight,2,!this.usedDirs)
					!this.dimdirs = !object.dimdirs
					!this.chardirs = !object.chardirs



					--endif
					--$p $!object.dimdir  2
				endif
				if !this.changeCheightAuto then
					!this.cheight = !object.cheight		$* only main dim decide the cheight of ISOline
				endif
			else
				!object.drawSub(!this.dimdir,!this.dimdirs,!this.chardirs,!this.mbdstru,!this.cheight,1)
				--!object.drawSub(!this.dimdir,!this.dimdirs,!this.chardirs,!this.dimgro,!this.dimslopelineGro,!this.dimslopeTextGro,!this.cheight,1)
			endif
		elseif !otype eq 'ISOSLOPE' then
			do !line values !object.lines
				--!!isocreateaidline(!this.dimslopelineGro,!line.startposition,!line.endposition)
				--function 'Slope'
				!functiontext = '坡度'
				!aidline = object mbdaidline(!this.mbdstru.aidgro,!line,!functiontext,'node:' + !this.branname)
				--!aidline = object mbdaidline(!this.mbdstru.aidgro,!line,'Slope','node:' + !this.branname)
			enddo

			!aidtext = object aidtext(!this.mbdstru.aidgro,!object.pos,!object.ori,!object.text,!this.cheight,'坡度','node:' + !this.branname)
			--!aidtext = object aidtext(!this.mbdstru.aidgro,!object.pos,!object.ori,!object.text,!this.cheight,'Slope','node:' + !this.branname)

			$(
			!this.dimslopetextGro
			new aidtext
			function 'Slope'
			Position $!object.pos
			Orientation $!object.ori
			Cheight $!this.cheight
			Stext '$!object.text'
			$)

			if !object.ori.xdir().angle(!this.pipedir) lt 90 then
				!mindis = !this.pos.distance(!object.pos)
				!maxdis = !mindis + !object.text.length() * !this.cheight
			else
				!maxdis = !this.pos.distance(!object.pos)
				!mindis = !maxdis - !object.text.length() * !this.cheight
			endif

			if !objectDir.unset() then
				!isoUsedDir = object isoUsedDir(!objectindex.string(),!object.ori.ydir(),!mindis,!maxdis,'Slope')
				!this.usedDirs.append(!isousedDir)
			endif
		elseif !otype eq 'ISOMATERIAL' then
			!item = !object.name
			!itemtype = !object.type
			if !itemtype ne 'TUBI' then
				!realod = !this.getMemRealOd(!item)
			else
				!realod = !object.abore.real()
			endif

			if !object.isotext.set() then
				!materialtext = !object.isotext
			else
				!materialtext = !object.order.string()
				if !itemtype eq 'ATTA' then
					!bp = 'S'
				elseif !itemtype eq 'BOLT' then
					!bp = 'B'
				elseif !itemtype eq 'GASK' then
					!bp = 'G'
				elseif !itemtype eq 'FLAN' or !itemtype eq 'FBLI' then
					!bp = 'F'
				else
					!bp = ''
				endif
				--elseif !itemtype eq 'VALV' then
				!materialtext = !bp + !materialtext
			endif

			if !itemtype eq 'BOLT' then
				if !object.boltshowpos.set() then
					!itempos = !object.boltshowpos
				else
					!tempitem = !object.name
					!itempos = pos of $!tempitem wrt/*
				endif
			elseif type of $!item eq 'TUBI' then
				!itempos = Itposition of $!item wrt/*
			else
				!itempos = pos of $!item wrt/*
			endif
			!plusdis = 0

			if !object.tubinum.unset() then
				!textlen = !!mbdtextlen(!materialtext) * !this.cheight
				--!textlen = !!mbdtextlen(!materialtext) * !this.cheight * 0.75
				----!textlen = !materialtext.length() * !this.cheight * 0.75
			else
				!textlen = !!mbdtextlen(!materialtext + '<' + !object.tubinum.string() + '>') * !this.cheight
				--!textlen = !!mbdtextlen(!materialtext + '<' + !object.tubinum.string() + '>') * !this.cheight * 0.75
				----!textlen = (!materialtext.length() + !object.tubinum.string().length() + 2) * !this.cheight * 0.75
			endif



			$(
			if !textlen gt 2 then
				!textlen = (!textlen - 2) * 1 + 2
			endif
			!textlen = !textlen * !this.cheight * 0.75
			$)

			if !objectDir.unset() then
				!dis = !this.pos.distance(!itempos)
				--!mindis = !dis - !this.cheight * 0.75
				--!maxdis = !dis + !this.cheight * 0.75



				!mindis = !dis - !textlen / 2
				!maxdis = !dis + !textlen / 2


				!adir = adir of $!item wrt/*
				!ldir = ldir of $!item wrt/*

				if !adir.angle(!ldir) lt 179 then
					!plusdis = !realod / 4 * !this.cheightbili		$*202304181551
					--!plusdis = 0
				endif
				!usedDirs = !this.getusedDirs(!mindis,!maxdis)

				!isoori = object isoori(!this.pipedir,!this.dimdirs,!this.chardirs,!usedDirs,30)
			else
				!isoori = object isoori(!this.dimdirs,!this.chardirs)
				!isoori.pipedir = !this.pipedir
				!isoori.dimdir = !objectDir
				!isoori.minangle = 30
				!isoori.getori()
			endif

			!mlabelpos = !itempos.offset(!isoori.dimdir,!realod / 2 + !plusdis + !this.cheight * 0.5).offset(!isoori.ori.Xdir(), - !textlen / 2)
			if !itemtype ne 'TUBI' and !itemtype ne 'FTUB' then
				!temppos = p3 pos of $!item wrt/*
				handle any
					!temppos = pos of $!item wrt/*
				elsehandle none
					!p3bore = p3 bore of $!item
					if !p3bore.unset() then
						!temppos = pos of $!item wrt/*
					endif
				endhandle
				!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!isoori.ori,!materialtext,!this.cheight,false,'材料',!temppos,'node:' + !this.branname)
				--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!isoori.ori,!materialtext,!this.cheight,false,'MaterialText',!temppos,'node:' + !this.branname)
			else
				!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!isoori.ori,!materialtext,!this.cheight,false,'材料','','node:' + !this.branname)
				--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!isoori.ori,!materialtext,!this.cheight,false,'MaterialText','','node:' + !this.branname)
			endif
			--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!isoori.ori,!materialtext,!this.cheight,false,'MaterialText','','node:' + !this.branname)
			if !object.tubinum.set() then
				!cutmlabelpos = !mlabelpos.offset(!isoori.ori.xdir(),!materialtext.length() * !this.cheight * 2 / 3)
				!cutpipetext = '<' & !object.tubinum & '>'
				--!mlabel = object mlabel(!this.mbdstru.dimgro,!cutmlabelpos,!isoori.ori,!cutpipetext,!this.cheight,false,'PIPE SLOOP','','node:' + !this.branname)
				!mlabel = object mlabel(!this.mbdstru.dimgro,!cutmlabelpos,!isoori.ori,!cutpipetext,!this.cheight,false,'管段号','','node:' + !this.branname)
				--!cutpipetextLength = !cutpipetext.length()
			else
				--!cutpipetextLength = 0
			endif



			!pos1 = !mlabelpos.offset(!isoori.pipedir, - !this.cheight / 10).offset(!isoori.dimdir, - !this.cheight / 10)

			!matelen = !!mbdtextlen(!materialtext)
			$(
			!matelen = !materialtext.length()
			if !matelen gt 2 then
				!matelen = (!matelen - 2) * 0.75 + 2 * 1.1					$* for Fx/Gx/Bxx
			elseif !matelen eq 2 then
				!matelen = !matelen * 1.05									$* for(Gx)
			endif
			$)
			!pos2 = !pos1.offset(!isoori.pipedir, !this.cheight * !matelen)
			--!pos2 = !pos1.offset(!isoori.pipedir, !this.cheight * 7 * !matelen / 10)
			----!pos2 = !pos1.offset(!isoori.pipedir, !this.cheight * 7 * !materialtext.length() / 10)
			----!pos2 = !pos1.offset(!isoori.pipedir,!textlen)

			!pos3 = !pos2.offset(!isoori.dimdir, !this.cheight )
			!pos4 = !pos1.offset(!isoori.dimdir, !this.cheight )

			!functiontext = '材料'
			!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos1,!pos2,!functiontext,'node:' + !this.branname)
			!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos2,!pos3,!functiontext,'node:' + !this.branname)
			!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos3,!pos4,!functiontext,'node:' + !this.branname)
			!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos4,!pos1,!functiontext,'node:' + !this.branname)


			if !objectDir.unset() then
				--!maxdis = !mindis + !this.cheight * 7 * (!materialtext.length() + !cutpipetextLength) / 10
				!isoUsedDir = object isoUsedDir(!objectindex.string(),!isoori.dimdir,!mindis,!maxdis,'MaterialText')
				!this.usedDirs.append(!isousedDir)
			endif

			$(
		elseif !otype eq 'ISOMATERIALTEXT' then
			!item = !object.name
			!itemtype = type of $!item
			if !itemtype ne 'TUBI' then
				!realod = !this.getMemRealOd(!item)
			else
				!realod = !this.od
			endif
			!materialtext = !object.text
			if type of $!item eq 'TUBI' then
				!itempos = Itposition of $!item wrt/*
			else
				!itempos = pos of $!item wrt/*
			endif
			!plusdis = 0

			if !objectDir.unset() then
				!dis = !this.pos.distance(!itempos)
				!mindis = !dis - !this.cheight * 0.75
				!maxdis = !dis + !this.cheight * 0.75


				!adir = adir of $!item wrt/*
				!ldir = ldir of $!item wrt/*

				if !adir.angle(!ldir) lt 179 then
					--!plusdis = !this.od / 4
					!plusdis = !realod / 4

				endif

				!handledirs = !this.gethandledirs(!mindis,!maxdis)

				!isoori = object isoori(!this.pipedir,!this.dimdirs,!this.chardirs,!handledirs,60)

			else
				!isoori = object isoori(!this.dimdirs,!this.chardirs)
				!isoori.pipedir = !this.pipedir
				!isoori.dimdir = !objectDir
				!isoori.minangle = 60
				!isoori.getori()
			endif


			!mlabelpos = !itempos.offset(!isoori.dimdir,!realod / 2 + !plusdis + !this.cheight * 0.5)




			!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!isoori.ori,!materialtext,!this.cheight,false,'MaterialText','','node:' + !this.branname)


			if !object.tubinum.set() then
				!cutmlabelpos = !mlabelpos.offset(!isoori.ori.xdir(),!materialtext.length() * !this.cheight * 2 / 3)
				!cutpipetext = '<' & !object.tubinum & '>'
				!mlabel = object mlabel(!this.mbdstru.dimgro,!cutmlabelpos,!isoori.ori,!cutpipetext,!this.cheight,false,'PIPE SLOOP','','node:' + !this.branname)
			endif





			!pos1 = !mlabelpos.offset(!isoori.pipedir, - !this.cheight / 10).offset(!isoori.dimdir, - !this.cheight / 10)

			!pos2 = !pos1.offset(!isoori.pipedir, !this.cheight * 7 * !materialtext.length() / 10)

			!pos3 = !pos2.offset(!isoori.dimdir, !this.cheight )
			!pos4 = !pos1.offset(!isoori.dimdir, !this.cheight )

			!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos1,!pos2,'MaterialTextFrame','node:' + !this.branname)
			!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos2,!pos3,'MaterialTextFrame','node:' + !this.branname)
			!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos3,!pos4,'MaterialTextFrame','node:' + !this.branname)
			!aidline = object mbdaidline(!this.mbdstru.aidgro,!pos4,!pos1,'MaterialTextFrame','node:' + !this.branname)


			if !objectDir.unset() then
				!isoUsedDir = object isoUsedDir(!objectindex.string(),!isoori.dimdir,!mindis,!maxdis,'MaterialText')
				!this.usedDirs.append(!isousedDir)
			endif
			$)
		elseif !otype eq 'ISOWELDTEXT' then
			!item = !object.name
			!weldtext = !object.text
			!weldpos = !object.pos

			!newway = false

			if !objectDir.unset() then
				!dis = !this.pos.distance(!weldpos)
				!mindis = !dis - !this.cheight * 0.75
				!maxdis = !dis + !this.cheight * 0.75
				if !newway.not() then
					!usedDirs = !this.getusedDirs(!mindis,!maxdis)
				else
					!useddirs = array()																		$*202305121600 remove all useddirs
				endif
				!isoori = object isoori(!this.pipedir,!this.dimdirs,!this.chardirs,!usedDirs,90)
			else
				!isoori = object isoori(!this.dimdirs,!this.chardirs)
				!isoori.pipedir = !this.pipedir
				!isoori.dimdir = !objectDir
				!isoori.minangle = 30
				!isoori.getori()
			endif

			if !newway.not() then
				!newori = !this.tagori(!isoori.dimdir)
				!Textpos = !weldpos.offset(!isoori.dimdir,!this.od / 2 + !this.cheight * 4)
				--!Textpos = !weldpos.offset(!isoori.dimdir,!this.od / 2 + !this.cheight * 2)		$*202305121606	this looks like other type mlabels
				--!mlabel = object mlabel(!this.mbdstru.dimgro,!Textpos,!newori,!weldtext,!this.cheight,false,'WeldText',!weldpos,'node:' + !this.branname)
				!mlabel = object mlabel(!this.mbdstru.dimgro,!Textpos,!newori,!weldtext,!this.cheight,false,'焊点',!weldpos,'node:' + !this.branname)
			else
				--202305121556 s
				!newori = !isoori.ori
				!Textpos = !weldpos.offset(!isoori.dimdir,!this.od / 2 + !this.cheight * 0.5)
				--!mlabel = object mlabel(!this.mbdstru.dimgro,!Textpos,!newori,!weldtext,!this.cheight,false,'WeldText','','node:' + !this.branname)
				--!mlabel = object mlabel(!this.mbdstru.dimgro,!Textpos,!newori,!weldtext,!this.cheight,false,'WeldText',!weldpos,'node:' + !this.branname)
				!mlabel = object mlabel(!this.mbdstru.dimgro,!Textpos,!newori,!weldtext,!this.cheight,false,'焊点',!weldpos,'node:' + !this.branname)
				--202305121556 e
			endif


			if !objectDir.unset() then
				!isoUsedDir = object isoUsedDir(!objectindex.string(),!isoori.dimdir,!mindis,!maxdis,'WeldText')
				!this.usedDirs.append(!isousedDir)
			endif
		elseif !otype eq 'ISOTAG' then
			!item = !object.name

			!infoarr = !object.infoarr
			--if !item ne 'Head' and !item ne 'Tail' and !infoarr.size() ne 1 then
			--    return
			--endif
			!tagtype = !object.tagtype
			if !tagtype eq 'pos' then
				!pos = !object.pos
			else
				!pos = pos of $!item wrt/*
			endif



			if !objectDir.unset() then
				!dis = !this.pos.distance(!pos)
				if !this.pipedir.angle(u) gt 120 then
					!mindis = !dis
					!maxdis = !dis + !this.cheight * !infoarr.size()
				else
					!mindis = !dis - !this.cheight * !infoarr.size()
					!maxdis = !dis
				endif

				!mindis = !mindis - !this.cheight * 0.5         $*与相邻的拉开距离
				!maxdis = !maxdis + !this.cheight * 0.5         $*与相邻的拉开距离

				!usedDirs = !this.getusedDirs(!mindis,!maxdis)
				!isoori = object isoori(!this.pipedir,!this.dimdirs,!this.chardirs,!usedDirs,30)
			else
				!isoori = object isoori(!this.dimdirs,!this.chardirs)
				!isoori.pipedir = !this.pipedir
				!isoori.dimdir = !objectDir
				!isoori.minangle = 30
				!isoori.getori()
			endif
			!newori = !this.tagori(!isoori.dimdir)

			if !this.pipedir.angle(u) gt 120 then
				!movedir = !newori.ydir().opposite()
			else
				!movedir = !newori.ydir()
				!infoarr.invert()
			endif

			if !infoarr.size() gt 1 then
				!Textpos = !pos.offset(!isoori.dimdir,!this.od / 2 + !this.cheight * !this.seconddimtimes * 3)
			else
				!Textpos = !pos.offset(!isoori.dimdir,!this.od / 2 + !this.cheight * !this.seconddimtimes * 2)
			endif

			$(
			if !tagtype eq 'pos' then
				$!this.posMlabelGro
			else
				$!this.refMlabelGro
			endif
			$)

			--!xdir = !isoori.dimdir
			--!newori = x is $!xdir and z is $!isoori.chardir

			do !x indices !infoarr
				!line = !infoarr[!x]
				--do !line values !infoarr
				--new mlabel
				if !object.name eq 'Head' then
					!headpos = !textpos.offset(!this.pipedir, !this.od / 3)
					--pos $!headpos
					!mlabelpos = !headpos
				elseif !object.name eq 'Tail' then
					!tailpos = !textpos.offset(!this.pipedir, - !this.od / 3)
					--pos $!tailpos
					!mlabelpos = !tailpos
				else
					--pos $!Textpos
					!mlabelpos = !textpos
				endif
				--!textpos = !textpos.offset(!isoori.pipedir,!this.cheight * 1.2)
				!textpos = !textpos.offset(!movedir,!this.cheight * 1.2)
				--function 'Tag'
				--q var !object.function
				--function '$!object.function'

				--stext '$!line'
				--cheight $!this.cheight

				--ori $!isoori.ori
				--ori $!newori
				!functiontext = !this.gettagfunction(!object)
				if !x eq 1 then
					if !tagtype eq 'pos' then
						--new dimpos pos $!pos
						!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!newori,!line,!this.cheight,false,!functiontext,!pos,'node:' + !this.branname)
						--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!newori,!line,!this.cheight,false,!object.function,!pos,'node:' + !this.branname)
					else
						--new dimppt posref $!item
						!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!newori,!line,!this.cheight,false,!functiontext,!item,'node:' + !this.branname)
						--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!newori,!line,!this.cheight,false,!object.function,!item,'node:' + !this.branname)
					endif
				else
					!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!newori,!line,!this.cheight,false,!functiontext,'','node:' + !this.branname)
					--!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!newori,!line,!this.cheight,false,!object.function,'','node:' + !this.branname)
				endif
			enddo

			if !objectDir.unset() then
				!isoUsedDir = object isoUsedDir(!objectindex.string(),!isoori.dimdir,!mindis,!maxdis,'Tag')
				!this.usedDirs.append(!isousedDir)
			endif
		endif
	endif
endmethod

define method .getMemRealOd(!inputitem is any) is real
	!apos = apos of $!inputitem wrt/*
	handle any
		!apos = pos of $!inputitem
		!lpos = !apos
	elsehandle none
		!lpos = lpos of $!inputitem wrt/*
	endhandle
	if !apos.distance(!lpos) lt !this.od / 2 then
		!prenum = 0
		!item = !inputitem
		do !x from 1 to 5
			!item = !!getpremem(!item)
			if !item eq '' then
				break
			else
				!premem = !item
				!prenum = !x
				if type of $!item eq 'FLAN' or type of $!item eq 'FBLI' then
					break
				else
					!apos = apos of $!item wrt/*
					handle any
						break
					endhandle
					!lpos = lpos of $!item wrt/*
					if !apos.distance(!lpos) gt !this.od then
						break
					endif
				endif
			endif
		enddo

		!nextnum = 0
		!item = !inputitem
		do !x from 1 to 5
			!item = !!getnextmem(!item)
			if !item eq '' then
				break
			else
				!nextmem = !item
				!nextnum = !x
				if type of $!item eq 'FLAN' or type of $!item eq 'FBLI' then
					break
				else
					!apos = apos of $!item wrt/*
					handle any
						break
					endhandle
					!lpos = lpos of $!item wrt/*
					if !apos.distance(!lpos) gt !this.od then
						break
					endif
				endif
			endif
		enddo




		if defined(!premem) and undefined(!nextmem) then
			!item = !premem
		elseif undefined(!premem) and defined(!nextmem) then
			!item = !nextmem
		elseif defined(!premem) and defined(!nextmem) then
			if type of $!premem eq 'FLAN' or type of $!premem eq 'FBLI' then
				!item = !premem
			elseif type of $!nextmem eq 'FLAN' or type of $!nextmem eq 'FBLI' then
				!item = !nextmem
			elseif !prenum le !nextnum then
				!item = !premem
			else
				!item = !nextmem
			endif
		else
			!item.delete()
		endif

	endif


	if undefined(!item) then
		!item = !inputitem
	endif

	$(
	--$p $!item
	if type of $!inputitem eq 'GASK' then
		!item = !!getpremem(!inputitem)
		if !item eq '' then
			!item = !!getnextmem(!inputitem)
			if !item eq '' then
				return !this.od
			endif
		endif
	else
		!item = !inputitem
	endif
	$)

	return max(!this.od,!!getPipeMaxDia(!item))

	$(
	--202305101130
	!gmse = name of gmref of catref of $!item
	handle any
		return !this.od
	endhandle
	var !lcyls coll all (lcyl scto scyl sdsh) for $!gmse

	!maxdim = !this.od
	do !x indices !lcyls
		!cyl = !lcyls[!x]
		!tuflag = tuflag of $!cyl
		handle any
		elsehandle none
			if !tuflag.not() then
				skip
			endif
		endhandle

		!level = level of $!cyl
		if !level[1] gt 6 or !level[2] lt 6 then
			skip
		endif

		--!obst = obstruction of $!cyl
		--if !obst ne 2 and !obst ne 0 then
		--	skip
		--endif

		!pdia = pdia of $!cyl
		--q var !pdia
		--!!evalCata(!item,!pdia)
		!onedim = !!evalCata(!item,!pdia)
		--$p $!onedim
		if !onedim gt !maxdim then

			!maxdim = !onedim
			--!goodcyli = !lcyls[!x]
		endif
	enddo
	--$p $!item $!maxdim

	return !maxdim
	$)
endmethod


define method .tagori(!dimdir is direction) is orientation
	!tempdir = !dimdir.orthogonal(u)
	handle any
		!xdir = !this.pipedir.orthogonal(u)
	elsehandle none
		!xdir = !tempdir.orthogonal(u).opposite()
	endhandle

	!ori = x is $!xdir and z is u
	return !ori
endmethod

define method .getusedDirs(!mindis is real, !maxdis is real) is array
	!tempIsoUsedDirs = array()
	--!handledirs = array()
	--!handleangles = array()
	do !usedDir values !this.usedDirs
		if !usedDir.mindis ge !maxdis or !usedDir.maxdis lt !mindis then
			skip
		else
			if !useddir.dir.set() then
				!tempIsoUsedDirs.append(!usedDir)
				--!handledirs.append(!usedDir.dir)
				--!handleangles.append(!usedDir.angle)
			endif
		endif
	enddo
	return !tempIsoUsedDirs
	--!result = array()
	--!result.append(!handledirs)
	--!result.append(!handleangles)
	--return !result
	--return !handledirs
endmethod

define method .getminMax(!object is any) is array
	!pos1 = !object.poss[1]
	handle any
		return
	endhandle
	!pos2 = !object.poss.last()
	!mindis = !pos1.distance(!this.pos)
	!dir = !this.pos.direction(!pos1)
	handle any
	elsehandle none
		if !dir.angle(!this.pipedir) gt 90 then
			!mindis = - !mindis
		endif
	endhandle

	!maxdis = !pos2.distance(!this.pos)
	!dir = !this.pos.direction(!pos2)
	handle any
	elsehandle none
		if !dir.angle(!this.pipedir) gt 90 then
			!maxdis = - !maxdis
		endif
	endhandle
	!result[1] = !mindis
	!result[2] = !maxdis
	return !result
endmethod
