$*把列表里管道单条信息删除
-----------------------------------------------------------------------------------
define method .RemoveCE()
	!arrIndex = !this.list.val
	!arrTemp = !this.list.dtext
	!arrTempRtext = !this.list.rtext
	do !val values !arrIndex
		!this.brandatas[!val].delete()
		!arrTemp[!val].delete()
		!arrTempRtext[!val].delete()
	enddo
	!this.brandatas.compress()
	!arrTemp.compress()
	!this.list.dtext = !arrTemp
	!arrTempRtext.compress()
	!this.list.rtext = !arrTempRtext

	!this.setfunctionlist()
endmethod

