define method .markpipeform()
	!!updatembdfiles()
	!!setmbdfmt()
	!!setmbdformtitle(!this)
	handle any
		q var !!error
	endhandle
	if !!checkmbdproject().not() then
		--!formname = !this.fullname()
		--hide $!formname
		!this.AddItem.active = false
		!this.remItem.active = false
		!this.clearlist.active = false
		!this.drawAll.active = false
		!!alert.warning('此项目尚不能使用MBD')
	endif
--q var !this.cancelcall
	--!this.okcall = '!this.okform()'
	!this.cancelcall = '!this.cancelform()'	$*close uses cancelcall, and the value maybe change before this method, hide work,but use recovering first
	--!this.quitcall = '!this.quitform()'	$*close uses quitcall, but the value has changed before run this method,hide does not work
	--!this.killingcall = '!this.hideform()'	$*close would not use killingcall


	--!this.functionlist.setheadings('Function')
	--!this.useGoodDirs = true
	--!this.useGoodDirs = false
	$(
	!Materialattarr = split('order/序号,desc/材料描述,ns/类型,quantity/数量,itemcode/Item code,weight/重量,rev/版本',',')
	!BranAttarr = split('Duty/系统,Pspec/管道等级,RCCM/RCCM,CLEAN/清洁度,TEMP/温度,ISPEC/保温,POWERCAL/力学计算,DRAW/图号',',')
	!cutpipelengtharr = split('tubinum/PIECE NO,quantity/CUT LENGTH,ns/DN,remark/REMARK',',')

	!this.materialAtts = array()
	!this.materialAttShow = array()
	do !string values !materialattarr
		!this.materialAtts.append(!string.part(1,'/'))
		!this.materialAttShow.append(!string.part(2,'/'))
	enddo

	!this.branAtts = array()
	!this.branAttShow = array()
	do !string values !branattarr
		!this.branAtts.append(!string.part(1,'/'))
		!this.branAttShow.append(!string.part(2,'/'))
	enddo

	!this.cutpipelengthAtts = array()
	!this.cutpipelengthAttShow = array()
	do !string values !cutpipelengtharr
		!this.cutpipelengthAtts.append(!string.part(1,'/'))
		!this.cutpipelengthattShow.append(!string.part(2,'/'))
	enddo
	$)
	------set MaterialAtts MaterialAttShow suppAtts suppAttShow cutpipelengthAtts cutpipelengthAttShow
	!result = !!getattlist('bran')
	do !x indices !result[1]
		!com = '!this.' + !result[2][!x] + ' = !result[1][!x]'
		$!com
	enddo

	!this.recoversetting()
	!!getmbdmaterialdata('PIPE')
endmethod


$(
define method .okform()
	$p OK
	q var !!markpipeform.generatejson.val
	HIDE !!markpipeform
endmethod
define method .quitform()
	$p QUIT
	--q var !!markpipeform.generatejson.val
	--!this.recoversetting()
	q var !!markpipeform.generatejson.val

	HIDE !!markpipeform
	show !!markpipeform
	HIDE !!markpipeform
	q var !!markpipeform.generatejson.val
	--q var !!markpipeform.generatejson.val
	--show !!markpipeform
	--q var !!markpipeform.generatejson.val
endmethod
$)
define method .cancelform()
	--$p asdfasdf
	--$p CANCEL
	--q var !!markpipeform.generatejson.val

	!this.recoversetting()

	--q var !!markpipeform.generatejson.val

	HIDE !!markpipeform
	--show !!markpipeform
	--HIDE !!markpipeform
endmethod

define method .getjsonarray() is array
	!result = !this.brandatas[1].getjsonarray()


	handle any
		!result = array()
	endhandle
	return !result
endmethod

define method .instoreset(!refresh is boolean)
	--HIDE !!markpipeform
	--SHOW !!markpipeform
	!this.settotplant()
	!result = array()
	--!strings = split('cheightbili jsonmerge')
	--!strings = split('cheightbili autocheight sepSmallDim ignoreline considerprenextdir lookangle enhancered colcombobox autocheightbili plusstringcheightbili generatejson filepath')
	!strings = !this.instoreStrings
	do !string values !strings
		!com = '!this.' + !string + '.refresh()'
		--$P $!COM
		$!com

		--$(
		!com = '!dtext = !this.' + !string + '.dtext'
		$!com
		handle any
			!com = '!val = !this.' + !string + '.val.string()'
		elsehandle none
			!com = '!val = !this.' + !string + '.displaytext()'
		endhandle
		--$)

		--if !string eq 'enhancered' or !string eq 'filepath' then
		--	!com = '!val = !this.' + !string + '.val.string()'
		--else
		--	!com = '!val = !this.' + !string + '.displaytext()'
		--endif
		$!com
		--q var !com !val
		!line = !string & ':' & !val
		!result.append(!line)
	enddo
	--q var !!markpipeform.generatejson.val
	--q var !result
	!path = !!pml.getpathname(!this.name().lowcase() + '.pmlfrm').before(!this.name().lowcase() + '.pmlfrm') + 'setting\markpipeformSetting.txt'
	--!path = !!pml.getpathname('markpipeform.pmlfrm').before('markpipeform.pmlfrm') + 'markpipeformSetting.txt'
	!file = object file(!path)
	!file.writefile('overwrite',!result)


	!this.refreshdata(!refresh)
	--!this.mark('ALL')
	!this.red()
endmethod

define method .refreshdata(!refresh is boolean)
	if !refresh.not() then
		return
	endif
	!brannames = array()
	do !x indices !this.brandatas
		!brannames.append(!this.brandatas[!x].branname)
	enddo

	!this.clearlist()
	do !branname values !brannames
		$!branname
		!this.addonece()
	enddo
endmethod

define method .recoversetting()
	!path = !!pml.getpathname(!this.name().lowcase() + '.pmlfrm').before(!this.name().lowcase() + '.pmlfrm') + 'setting\markpipeformSetting.txt'
	--!path = !!pml.getpathname('markpipeform.pmlfrm').before('markpipeform.pmlfrm') + 'markpipeformSetting.txt'
	!file = object file(!path)
	!lines = !file.readfile()
	handle any
		return
	elsehandle none
	--q var !lines
		do !line values !lines
			!name = !line.before(':')
			!val = !line.after(':')

			!com = '!dtext = !this.' + !name + '.dtext'
			$!com
			handle any
			--if !name eq 'enhancered' or !name eq 'filepath' then
				!com = '!this.' + !name + '.val = ' & !val
			elsehandle none
				!com = '!this.' + !name + '.select(|dtext|,|' + !val + '|)'
			endhandle
			--q var !com
			$!com
			handle any
				!com = '!this.' + !name + '.val = |' &!val & '|'
				$!com
				handle any
				endhandle
			endhandle
		enddo
	endhandle
	!this.settotplant()
endmethod

define method .settotplant()
	return
	if !this.generatejson.selection('dtext').boolean() then
		!this.ToTplant.active = true
	else
		!this.ToTplant.active = false
	endif
endmethod

define method .inputpath()
    !string = !this.filepath.val.trim()
	if !string eq '' then
		!this.filepath.val = 'D:\'
        golabel /end
	endif
    !folder = object file(!string)
    if !folder.exists().not() then
        !ans = !!alert.confirm('路径不存在,是否新建？')
        if !ans ne 'YES' then
            !this.filepath.val = 'D:\'
            golabel /end
        else
            syscom |mkdir $!folder|
        endif
    endif
    if !string.substring(-1,1) ne '/' and !string.substring(-1,1) ne '\' then
        !string = !string + '\'
    endif
    !this.filepath.val = !string

    label /end
    !this.instoreset(false)
endmethod



define method .selectbran()
	!bran = !this.list.selection()
	!BA = !bran[1].PART(1,'	')
	$!BA
	add ce auto ce
	handle any
	endhandle
	!errors = !this.setOtherList()
	!this.writeerror(!errors)
endmethod

define method .setOtherList() is array
	!val = !this.getJsonIndex() $*获取最小交付单元name序号，管道属性列表下标值
	if !val eq 0 then
		return
	endif
	!errors = array()
	!this.setlist2(!val)
	handle any
		!errors.appendarray(!this.brandatas[!val].wronglines)
	endhandle
	!this.setlist3(!val)
	handle any
		!errors.appendarray(!this.brandatas[!val].wronglines)
	endhandle
	!this.setlist4(!val)
	handle any
		!errors.appendarray(!this.brandatas[!val].wronglines)
	endhandle
	!this.setlist5(!val)
	handle any
		!errors.appendarray(!this.brandatas[!val].wronglines)
	endhandle
	!this.setlist6(!val)
	handle any
		!errors.appendarray(!this.brandatas[!val].wronglines)
	endhandle
	!this.setlist7(!val)
	handle any
		!errors.appendarray(!this.brandatas[!val].wronglines)
	endhandle
	!this.setzyjclist(!val)
	handle any
		!errors.appendarray(!this.brandatas[!val].wronglines)
	endhandle

	!errors.appendarray(!this.brandatas[!val].wronglines)
	!errors.unique()
	--q var !errors
	return !errors
endmethod


define method .setred()
	!this.instoreset(false)
	!this.red()
endmethod
define method .red()
    --$p 1111111111111
	!vals = !this.list.val
	if !vals.unset() then
		!vals = !this.list.dtext.indices()
	endif

	!col = !this.colcombobox.displaytext()
	do !val values !vals
		!mbdstru = !this.brandatas[!val].mbdstru.mbdstru
		-----------------------
		-----------------------sometimes only part of mbdstru are enhanced when unenhance are not used
		unenhance $!mbdstru
		handle any
		elsehandle none
			if !this.enhancered.val then
				--enhance $!mbdstru col red
				--enhance $!mbdstru col blue
				enhance $!mbdstru col $!col
			endif
		endhandle
	enddo
endmethod

define method .setlist2(!val is real)
    --$p asdfasf
	!this.list2.setheadings(!this.materialAttShow)
	!rows = !this.brandatas[!val].sumMaterials(!this.materialAttS)
    --q var !rows[1]
	!newrows = array()
	do !x indices !rows
		do !y indices !rows[!x]
			!newrows[!x][!y] = !rows[!x][!y].string()					$* to string
		enddo
	enddo
	!this.list2.setrows(!newrows)
endmethod

define method .setlist3(!val is real)
	!maxnum = 16
	!arrs = !this.brandatas[!val].getweldlist()
	!rows = array()
	do !arr values !arrs
		!temparr = array()
		do !x indices !arr
			!temparr.append(!arr[!x])
			if !x / !maxnum eq int(!x / !maxnum) then
				!rows.append(!temparr)
				!temparr = array()
			elseif !x eq !arr.size() then
				!rows.append(!temparr)
			endif
		enddo
	enddo

	do !x indices !rows
		do !y from 1 to !maxnum - !rows[!x].size()
			!rows[!x].append('')
		enddo
	enddo

	do !x indices !rows
		if !rows[!x][1].matchwild('M*') then
            --modify by jyg 20240902
			!rows[!x].insert(1,'现场焊缝号/RCC-M')
		else
            --modify by jyg 20240902
			!rows[!x].insert(1,'工厂焊缝号/RCC-M')
		endif
	enddo
    --Q VAR !rows[1]
	!this.list3.setrows(!rows)
endmethod

define method .setlist4(!val is real)
	!this.list4.setheadings(!this.elematerialAttShow)
    --q var !this.list4
    --q var !this.brandatas[!val].branmems
    --q var !this.elematerialAttS
    --q var !this.brandatas[!val]
    --$P 1
	!rows = !this.brandatas[!val].getspecialMaterials(!this.elematerialAttS)
    --$P 2
    --q var !rows
	!newrows = array()
	do !x indices !rows
		do !y indices !rows[!x]
            !newrows[!x][!y] = !rows[!x][!y].string()					$* to string
		enddo
	enddo
	!this.list4.setrows(!newrows)
endmethod
define method .selectmaterial()
	!vals = !this.list4.val
    --q var !vals
	if !vals.set() then
		!branindex = !this.getJsonIndex()
		!materials = !this.brandatas[!branindex].materials
		!specialnums = array()
		!mems = array()
		do !x indices !materials
            --q var !materials[!x].specialnum !materials[!x].name
			!specialnums.append(!materials[!x].specialnum)
			!mems.append(!materials[!x].name)
		enddo
		!dtext = !this.list4.dtext

		!items = array()
		do !val values !vals
			!row = !dtext[!val]
			!specialnum = !row.split('	')[1]
			!index = !specialnums.findfirst(!specialnum)
			!items.append(!mems[!index])
		enddo
		--unenhance all
		--do !item values !items
		--	enhance $!item col red
		--enddo

		$!items[1]
		unenhance all
		--enhance ce col red
		enhance $!items[1] col blue

		--$p $!items[1]
		$(
		--!branname = !this.brandatas[!branindex].branname
		--enhance $!branname translucency 80
		do !mem values !mems

			if !items.findfirst(!mem).unset() then
				--enhance $!mem translucency 80
				unenhance $!mem
			else
				--$p $!mem
				--enhance $!mem translucency 0
				--unenhance $!mem
				enhance $!mem col red
			endif
		enddo
		$)
	endif
endmethod
