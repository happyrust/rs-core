define method .ClearList()
	!this.brandatas.clear()
	!this.list.clear()
	!this.list2.clear()
	!this.list3.clear()
	!this.list4.clear()
	!this.list5.clear()

	!this.setfunctionlist()
endmethod

define method .setfunctionlist()
	!strus = array()
	do !x indices !this.brandatas
		!strus.append(!this.brandatas[!x].mbdstru.mbdstru)
	enddo
	!result = !!getstrudata(!strus)
	!this.functionlist.dtext = !result[1]
	!this.functiondata = !result
endmethod

define method .dealfunction(!type is string)
	--!!setmbdfmt()
	!functions = !this.functionlist.selection('dtext')
	if !functions.unset() then
		!functions = !this.functionlist.dtext
	endif
	do !function values !functions
		!index = !this.functiondata[1].findfirst(!function)
		do !item values !this.functiondata[2][!index]
			if !type eq 'add' then
				add only $!item
			else
				remove only $!item
			endif
		enddo
	enddo
	!this.red()
endmethod

define method .checkfilepath() is boolean
	if !this.generatejson.selection('dtext').boolean() then
		if !this.filepath.val ne '' then
			!file = object file(!this.filepath.val)
			if !file.exists().not() then
				!!alert.warning('如果需要生成文件，请在setting设置好存储文件夹')
				return false
			else
				return true
			endif
		else
			!!alert.warning('如果需要生成文件，请在setting设置好存储文件夹')
			return false
		endif
	else
		return true
	endif
endmethod

define method .drawall()
--.Mark(!type is string)
--clock init
	!type = 'ALL'
	$P
	if !this.checkfilepath().not() then
		return
	endif
	--!!setmbdfmt()
	!errors = array()
	do !x indices !this.brandatas
		--!this.brandatas[!x].cheight = !this.opSearch.selection('dtext').real()
		!this.brandatas[!x].cheightbili = !this.cheightbili.selection('dtext').real()
		!this.brandatas[!x].changecheightauto = !this.autocheight.selection('dtext').boolean()
		!bilistring = !this.autocheightbili.selection('dtext')
		if !bilistring eq '无限制' then
			!this.brandatas[!x].changecheightautobili = 0
		else
			!this.brandatas[!x].changecheightautobili =	!bilistring.real()
		endif
		!this.brandatas[!x].plusstringcheightbili = !this.plusstringcheightbili.selection('dtext').real()
		!this.brandatas[!x].sepSmallDim = !this.sepSmallDim.selection('dtext').boolean()
		!this.brandatas[!x].ignoreline = !this.ignoreline.selection('dtext').boolean()

		!this.brandatas[!x].generatejson = !this.generatejson.selection('dtext').boolean()
		!this.brandatas[!x].filepath = !this.filepath.val.trim()
	enddo
	!size = !this.brandatas.size()
	if !type eq 'ALL' then
		--!clearmaxsize = 5
		!clearmaxsize = 2
		if !this.brandatas.size() ge !clearmaxsize then
			!clearcontent = true
		else
			!clearcontent = false
		endif
		do !x indices !this.brandatas
			$p $!this.brandatas[$!x].branname
			!tempboolean = !this.brandatas[!x].draw()
			handle any
				q var !!error
				!errors.append('$!this.brandatas[$!x].branname failed to draw')
				!errors.appendarray(!!geterrorinfo())
			elsehandle none
				--if !tempboolean.not() then

				if !this.brandatas[!x].wronglines.set() then
					!errors.appendarray(!this.brandatas[!x].wronglines)
				endif
				if !clearcontent then
					!this.brandatas[!x].clearcontent()
				endif
			endhandle


			!percent = nint(100 * !x / !size)
			!!fmsys.setProgress(!percent)
		enddo
	else
		do !x indices !this.brandatas
			$p $!this.brandatas[$!x].branname
			!this.brandatas[!x].draw(!type)
			handle any
				q var !!error
				!errors.append('$!this.brandatas[$!x].branname failed to draw')
				!errors.appendarray(!!geterrorinfo())
			endhandle


			!percent = nint(100 * !x / !size)
			!!fmsys.setProgress(!percent)
		enddo
	endif
	--if !type eq 'ISOMATERIALTEXT' then
	--    !this.setOtherList()
	--endif
	!this.setfunctionlist()


	!this.writeerror(!errors)

	!!fmsys.setProgress(0)

	!this.red()
--clock read elapsed
endmethod


define method .markClear()
	if (!!alert.confirm('Delete DIM and AID of branch in list') eq 'YES' ) then
		do !x indices !this.brandatas
			!this.brandatas[!x].deletestru()
			--q var !this.brandatas[!x].branname

			--it it necessary to rebuilt isobran again? 202306271118, in this case, when brans are many, the speed is very slow
			--!this.brandatas[!x] = object isobran(!this.brandatas[!x].branname,!this.minslope,!this.maxslope)
		enddo
		!this.setfunctionlist()
	endif
endmethod

