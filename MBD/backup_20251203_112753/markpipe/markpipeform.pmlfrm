$*往列表里添加管道信息
----------------------------------------------
define method .addlist()
	!!updatembdfiles()

	--!arr = !!mbdlist.list.dtext
	!list = object LISTINTERFACE()
	!arr = !list.getCurrentListAsStrings()
	handle any
		$p 请先设置列表
		return
	endhandle
	if !arr.unset() then
		$p 请先设置列表
		return
	endif
	do !item values !arr
		$!item
		!this.addonece()
	enddo
endmethod
define method .AddCE()
	!!updatembdfiles()
	!this.addonece()
endmethod

define method .addonece()
	bran
	handle any
		var !brans coll all bran for ce
		if !brans.set() then
			var !names eval name for all from !brans
		else
			!struname = name of stru	$*aid things
			handle any
			elsehandle none
				if !struname.matchwild('*-MBD') then
					!branname = !struname.before('-MBD')
					!type = type of $!branname
					handle any
					elsehandle none
						if !type eq 'BRAN' then
							!names[1] = !branname
						endif
					endhandle
				endif
			endhandle
			if undefined(!names) then
				return error 1 'Select bran pls'
			endif
		endif
	elsehandle none
		!names[1] = name
	endhandle
	!dtext = !this.list.dtext
	!Rtext = !this.list.Rtext

	!considerprenextdir = !this.considerprenextdir.selection('dtext').boolean()
	!lookangle = !this.lookangle.selection('dtext').real()

	!headings = !this.branAttShow
	!headings.insert(1,'Bran')
	!this.list.setheadings(!headings)



	!errors = array()

	!size = !names.size()
	!x = 0
	do !name values !names
		$p $!name
		!x = !x + 1


		if !rtext.findfirst(!name).unset() then
			--q var !this.opSearch.val
			--q var !this.opSearch.selection('dtext').real()
			!isobran = object isobran(!name,!this.minslope,!this.maxslope,!considerprenextdir,!lookangle,'EM4')
			handle any
				--!errors.append(!name + ' Failed to get isobran of this bran')
				q var !!error
				!errors.append(!name + ' 未得到ISOBRAN')
				!errors.appendarray(!!geterrorinfo())
				skip
			--elsehandle none
			--q var !isobran.wronglines
				--if !isobran.wronglines.set() then
				--$p asdfasdf1234
				--	!errors.appendarray(!isobran.wronglines)
				--endif
			endhandle
			--!isobran = object isobran(!name,!this.minslope,!this.maxslope,!this.textori.displaytext().boolean(),!this.dimdirs,!this.chardirs,!this.opSearch.selection('dtext').real())
			!this.brandatas.append(!isobran)

			--q var !this.branAtts
			!rowarr = !isobran.getBranAttArr(!this.branAtts)
			handle any
				!errors.append(!name + ' Failed to get attribution list of this bran')
				!errors.appendarray(!!geterrorinfo())
				skip
			endhandle
			!oneline = !isobran.branname
			do !string values !rowarr
                --q var !string
				!oneline = !oneline + '	' + !string.string()
			enddo
			!Rtext.append(!name)
			!Dtext.append(!oneline)
			!mbdstru = !isobran.mbdstru
		else
			!mbdstru = object mbdstru(!name)
		endif
		!mbdstru.addstru()


		$(
		!stru = !name + '-DIMAIDSTRU'
		add $!stru
		handle any
			var !branref ref of $!name
			!stru2 = '/' + !branref.replace('=','_').replace('/','_') + '-DIMAIDSTRU'
			add $!stru2
			handle any
			endhandle
		endhandle
		$)
		add $!name

		!percent = nint(100 * !x / !size)
		!!fmsys.setProgress(!percent)
	enddo
	!lastname = !names.last()
	auto $!lastname

	--q var !dtext !rtext

	!this.list.dtext = !dtext
	!this.list.Rtext = !Rtext

	!wronglines = !this.setOtherList()
	!errors.appendarray(!wronglines)
	!errors.unique()


	!this.setfunctionlist()

	!this.red()

	!this.writeerror(!errors)
	!!fmsys.setProgress(0)
endmethod

define method .writeerror(!errors is array)
	if !errors.set() then
		!dt = object datetime()
		!errors.insert(1,!dt.string())
		!errors.insert(1,'')
		!path = !!pml.getpathname(!this.name().lowcase() + '.pmlfrm').before(!this.name().lowcase() + '.pmlfrm') + 'error.txt'
		!file = object file(!path)
		!lines = !file.readfile(100000)
		handle any
			!lines = array()
			!file.writefile('overwrite',!lines)
		endhandle
		$(
		if !lines.size() gt 10000 then
			!lines = !lines.from(!lines.size() - 1000)
			!lines.appendarray(!errors)
			!file.writefile('overwrite',!lines)
		else
			!file.writefile('append',!errors)
		endif
		$)

		if !lines.size() gt 10000 then
			!lines = !lines.from(9000)
		endif

		!lines.insertarray(1,!errors)
		!file.writefile('overwrite',!lines)
		syscom 'start $!file &'
	endif
endmethod

