kill !!totplantform
setup form !!totplantform dialog
	title |选择文件夹上传至Tplant|
	!tagwidth = 12
	!textwidth = 20
	text .foldertext |文件夹: | at x 0 ymin  tagwidth $!tagwidth width $!textwidth scroll 100 is string
	path down
	text .httptext |Tplant地址: |  tagwidth $!tagwidth width $!textwidth scroll 100 is string
	text .usernametext |Tplant用户名: |  tagwidth $!tagwidth width $!textwidth scroll 100 is string
	text .passwordtext |Tplant密码: |  tagwidth $!tagwidth width $!textwidth scroll 100 noecho is string
	text .projecttext |Tplant项目名: |  tagwidth $!tagwidth width $!textwidth scroll 100 is string
	text .atttext |Tplant属性: |  tagwidth $!tagwidth width $!textwidth scroll 100 is string
	text .modeltext |Tplant模型服务: |  tagwidth $!tagwidth width $!textwidth scroll 100 is string

	button .choosefolder |选择文件夹| call |!this.choosefolder()|  at xmin + 6 ymax + 1 width 8
	button .update '开始上传' call |!this.update()| at xmax + 3 ymin  width 8
exit
define method .totplantform()
	!this.foldertext.val = 'D:\MBD\EM4PIPE'
	!this.httptext.val = 'http://10.30.200.43'
	!this.usernametext.val = 'ccc'
	!this.passwordtext.val = 'Admin123#'
	!this.projecttext.val = '示例项目'
	!this.atttext.val = 'PDMS-长属性名 (type)'
	!this.modeltext.val = 'MBD-EM4PIPE'
endmethod

define method .update()
	if !this.foldertext.val.trim() eq '' or !this.httptext.val.trim() eq '' or !this.usernametext.val.trim() eq '' or !this.passwordtext.val.trim() eq '' or !this.projecttext.val.trim() eq '' or !this.modeltext.val.trim() eq ''  then
		!!alert.warning('检查输入数据')
		return
	endif

	!aa = object updatefiles(!this.foldertext.val.trim(),!this.httptext.val.trim(),!this.usernametext.val.trim(),!this.passwordtext.val.trim(),!this.projecttext.val.trim(),!this.atttext.val.trim(),!this.modeltext.val.trim())
endmethod

define method .choosefolder()
	import 'PMLFileBrowser'
	Handle Any
	Endhandle
	var !banner banner
	if !banner.matchwild('*PDMS*') then
		using namespace 'Aveva.PDMS.Presentation'
	else
		using namespace 'Aveva.Core.Presentation'
	endif
	!browser = object pmlfolderbrowser()
	!browser.show('Choose Folder',true)	$*true代表有新建文件夹选项
	!path = !browser.selectedpath()
	if !path eq '' then
		return
	else
		!this.foldertext.val = !path
	endif
endmethod
w