--Method:
--Public method:
--markinstEquiForm()															$*

--Private method:
--addce()   																$* add ce into list
--addCeObject() is boolean  												$* try to add civil item as object markcivil
--addequi() is boolean  													$* add equi as object markequi
--addRoom() is boolean  													$* try to add room item as object civilroom
--changeCheight(!gadget is gadget, !string is string)   					$* modify cheight of mlabel
--chooseItem()  															$* enhance choosed item col red
--clearlist()   															$* clear all
--dealfunction(!type is string) 											$* add or rem function mlabel or lindim
--deleteall()   															$* delete all malbel dim
--draw(!drawtype is string) 												$* draw all or malbel or dim
--drawAll() 																$* draw everything
--drawDim() 																$* draw dim
--drawMlabel()  															$* draw mlabel
--drawType(!inputtype is string)											$* draw all or malbel or dim. it is replaced by draw
--enhance() 																$* enhance all items in list col red
--instore(!result is array,!filename is string,!path is string) 			$* instore json
--instoreset()  															$* save setting
--Json()																	$* save json file
--merge(!arr is array) is string											$* merge arr to string
--moveto()  																$* move mlabel 1
--moveto2(!aa is any)   													$* move mlabel 2
--pickcon() 																$* choose civil manually
--recoverCheight()  														$* recovery cheight of mlabel
--recoversetting()  														$* recovery setting
--remsel()  																$* rem selection in list
--remSelObject(!item is string) 											$* rem item from input
--setCivilcheight(!civil is markcivil)  									$* set cheight for input civil object
--setEquiCheight(!equi is markequi) 										$* set cheight for equi
--setfunctionlist() 														$* get dtext of function list
--setpos()  																$* set position to make dimension manually 1
--setpos2(!aa is any)   													$* set position to make dimension manually 2
--setRoomCheight(!room is civilRoom)										$* set cheight for room


kill !!markinstEquiForm
setup form !!markinstEquiForm resize
	title '仪表设备'
	!framePos = 'at x0 y0 width 20 height 8'
	member .instoreStrings is array
	frame .Tabset TABSET 'tabset' at x0.3 y0.15 width 35 anchor all
		frame .tab1 | 设备列表 | $!framePos

			list .list '设备属性' call|!this.chooseItem()| AT X1 Y0 anchor l + t + b  MULTIPLE Width 69 LEN 15
			--list.list 'Equi, Civil and Room' call|!this.chooseItem()| height 12 width 20
			--list.list 'Equi' call|!this.chooseItem()| height 12 width 20
			button .AddItem '添加CE' call|!this.addCe()| AT x 1  ymax + 0.5   anchor l + b width 5
			path right
			Button .Addlist '添加List' anchor l + b tooltip |Add 列表|  width 5  callback '!this.Addlist()'
			button .remItem '移除CE' call|!this.remsel()|   anchor l + b width 6
			button .clearlist '清除' call|!this.clearlist()|   anchor l + b width 4
			button .drawAll '标注' call|!this.drawall()|   anchor l + b width 4

			combobox .colcombobox '' tagwidth 0  at xmax + 1 ymin anchor l + b call|!this.instoreset()| width 3
			!this.colcombobox.dtext = split('blue red green yellow grey')
			!this.colcombobox.select('dtext','blue')
			!this.instoreStrings.append('colcombobox')

			toggle .enhancered '颜色' at xmax + 0.1 ymin anchor l + b tagwidth 4 callback|!this.setred()|
			!this.instoreStrings.append('enhancered')


			button .pickcon '手动选择墙体/楼板' call|!this.pickcon()| at xmax + 0.1  anchor l + b width 13
			button .setpos '手动设置定位点' call|!this.setpos()| at xmax + 0.3  anchor l + b width 12
            button .AddInfo '手动加信息' at xmin.setpos ymax.setpos + 0.3  anchor l + b callback |!this.AddInfo()| width 8
			--button .alljson '生成JSON' at xmax + 0.5 ymin anchor l + b callback |!this.json()| width 8
			--button .ToTplant '上传至Tplant' callback |!this.totplant()| at xmax + 0.3  anchor l + b width 8

			----button .enhanceCol '物项变红色' call |!this.enhance()| at xmax.list + 0.5 ymax + 1 width 8
			----at xmax + 2 ymin
			----!this.enhancecol.background = 2
			----button .unenhance '恢复颜色' call |unenhance all| width 8


			list .functionlist '类别' AT Xmax.list + 1 Y0 anchor t + b + l + r MULTIPLE Width 12 LEN 14
			path right
			button .remfunction '隐藏' call |!this.dealfunction('rem')| at xmin + 1 ymax + 0.1 anchor b width 4
			button .addfunction '显示' call |!this.dealfunction('add')| at xmax + 1 ymin anchor b width 4
			button .deleteDim '删除全部' call|!this.deleteall()|  at xmin.remfunction ymax + 0.2 anchor b width 10
			member .functiondata is array
		exit
		frame .tab6 | 图纸属性 | $!framePos
			!tempfile = object file(!!commonpath() + 'framedrawingatt.txt')
			!lines = !tempfile.readfile()
			do !line values !lines
				if !line.trim().trim('	') ne '' then
					$!line
				endif
			enddo
		exit

		frame .tab7 | 校审 | $!framePos
			!tempfile = object file(!!commonpath() + 'frameproofreading.txt')
			!lines = !tempfile.readfile()
			do !line values !lines
				if !line.trim().trim('	') ne '' then
					$!line
				endif
			enddo
		exit
		frame .tab2 | 设置 | $!framePos

			!comboboxlen = 14
			combobox .textoffsetdis '文字浮出实体距离' tagwidth $!comboboxlen call |!this.instoreset()| at x 1 y 0.5 width 4
			!this.textoffsetdis.dtext = split('0 1 5 10 20 30 50 100')
			!this.textoffsetdis.select('dtext','5')
			!this.instoreStrings.append('textoffsetdis')
			path down

			combobox .dimcheight '尺寸标注文字高度' tagwidth $!comboboxlen call |!this.instoreset()|  width 4
			!this.dimcheight.dtext = split('20 50 70 100 120 150 200 300 350 400')
			!this.dimcheight.select('dtext','70')
			!this.instoreStrings.append('dimcheight')

			combobox .Civilcheight '墙体/楼板文字高度' tagwidth $!comboboxlen call |!this.instoreset()|  width 4
			!this.Civilcheight.dtext = split('100 120 150 200 300 350 400')
			!this.Civilcheight.select('dtext','350')
			!this.instoreStrings.append('Civilcheight')

			combobox .Roomcheight '房间文字高度' tagwidth $!comboboxlen call |!this.instoreset()| width 4
			!this.Roomcheight.dtext = split('70 100 120 150 200 300 350 400')
			!this.Roomcheight.select('dtext','350')
			!this.instoreStrings.append('Roomcheight')

			combobox .elThickCheight '标高/厚度文字高度' tagwidth $!comboboxlen call |!this.instoreset()|  width 4
			!this.elThickCheight.dtext = split('20 50 70 100 120 150 200 300 350 400')
			!this.elThickCheight.select('dtext','70')
			!this.instoreStrings.append('elThickCheight')

			combobox .equicheight '设备文字高度' tagwidth $!comboboxlen call |!this.instoreset()| width 4
			!this.equicheight.dtext = split('20 50 70 100 120 150 200 300 350 400')
			!this.equicheight.select('dtext','350')
			!this.instoreStrings.append('equicheight')




			combobox .waytogetwall '获取周围墙体方式' tagwidth $!comboboxlen call |!this.instoreset()|  at x 30 y 0.5 width 4
			!this.waytogetwall.dtext = split('手动 自动')
			!this.waytogetwall.select('dtext','自动')
			!this.instoreStrings.append('waytogetwall')

			combobox .indrawlist '视图内获取墙体' call |!this.instoreset()| tagwidth $!comboboxlen width 4
			!this.indrawlist.dtext = split('False True')
			!this.indrawlist.select('dtext','False')
			!this.instoreStrings.append('indrawlist')


			combobox .generatejson '标注后生成文件' tagwidth $!comboboxlen call|!this.instoreset()| width 4
			!this.generatejson.dtext = split('True False')
			!this.generatejson.select('dtext','False')
			!this.instoreStrings.append('generatejson')

			text .filepath '存储文件夹' tagwidth 12 call|!this.inputpath()| width 20 scroll 100 is string
			!this.filepath.val = 'D:\'
			!this.instoreStrings.append('filepath')

		exit
		--$(
		frame .tab3 | 文字位置和大小 | $!framePos
			--text .currentcheight '当前文字高度' tagwidth 10 width 3
			--path right
			$(
			combo .changecheight '重新设置字体高度为' tagwidth 15 call |!this.changeCheight(| width 3
			!this.changecheight.dtext = split('20 50 70 100 120 150 200 300 350 400 500 800 1000')
			!this.changeCheight.select('dtext','70')

			path right
			button .recovercheight '返回' call |!this.recovercheight()| width 5

			button .moveto '标签移动至鼠标点击位置' call |!this.moveto()| at x 0 ymax + 3 width 20
			$)

			combo .changecheight '所选文字高度' tagwidth 10 call |!this.changeCheight(| at x 1 y 0.5 width 3
			!this.changecheight.dtext = split('20 50 70 100 120 150 200 300 350 400 500 800 1000')
			!this.changeCheight.select('dtext','70')

			path down
			vdis 0.7
			button .recovercheight '还原文字高度' call |!this.recovercheight()|  width 15

			button .moveto '定位标签位置' call |!this.moveto()|  width 15

			combobox .autoupdatejson '改动后自动更新JSON' tagwidth 15 call|!this.instoreset()| at xmax + 8 y 0.5 width 4
			!this.autoupdatejson.dtext = split('True False')
			!this.autoupdatejson.select('dtext','False')
			!this.instoreStrings.append('autoupdatejson')

		exit
		frame .versioninfo | 版本信息 | $!framePos
			textpane .versioncontext   anchor T + R + L + B width 37 height 15
			!session = current session
			if !session.login ne 'pdms-bj-c103-03' then
				!this.versioncontext.setEditable(false)
			else
				button.updateversion 'Update' call '!!writembdversion(!this)' width 8 at xmax - 10 ymax - 1 anchor R + B
			endif
		exit
		--$)

	exit
	--member .civils is array

	--member .rooms is array

	member .equidatas is array

	member .oldCheights is array

	member .equiAtts is array
	member .equiAttShow is array
exit
define method .markinstEquiForm()
	!!updatembdfiles()
	!!setmbdfmt()
	!!setmbdformtitle(!this)
	handle any
		q var !!error
	endhandle
	if !!checkmbdproject().not() then
		--!formname = !this.fullname()
		--hide $!formname
		!this.AddItem.active = false
		!this.remItem.active = false
		!this.clearlist.active = false
		!this.drawAll.active = false
		!!alert.warning('此项目尚不能使用MBD')
	endif
	!this.cancelcall = '!this.cancelform()'
	!this.recoversetting()

	!result = !!getattlist('instequi')
	do !x indices !result[1]
		!com = '!this.' + !result[2][!x] + ' = !result[1][!x]'
		$!com
	enddo
endmethod

define method .cancelform()
	!this.recoversetting()
	HIDE !!markinstEquiForm
endmethod

define method .getjsonarray() is array
	!result = !this.equidatas[1].getjsonarray()
	handle any
		!result = array()
	endhandle
	return !result
endmethod

define method .instoreset()	$*save setting
	!this.settotplant()
	!result = array()
	!strings = !this.instoreStrings
	do !string values !strings
		!com = '!this.' + !string + '.refresh()'
		$!com

		!com = '!dtext = !this.' + !string + '.dtext'
		$!com
		handle any
			!com = '!val = !this.' + !string + '.val.string()'
		elsehandle none
			!com = '!val = !this.' + !string + '.displaytext()'
		endhandle

		$!com
		!line = !string & ':' & !val
		!result.append(!line)
	enddo
	!path = !!pml.getpathname(!this.name().lowcase() + '.pmlfrm').before(!this.name().lowcase() + '.pmlfrm') + 'setting\markinstequiSetting.txt'
	!file = object file(!path)
	!file.writefile('overwrite',!result)
	!this.red()
endmethod

define method .setred()
	!this.instoreset()
	!this.red()
endmethod
define method .red()
	!vals = !this.list.val
	if !vals.unset() then
		!vals = !this.list.dtext.indices()
	endif

	!col = !this.colcombobox.displaytext()
	do !val values !vals
		!name = !this.list.rtext[!val]
		do !x indices !this.equidatas
			if !this.equidatas[!x].equiname eq !name then
				!object = !this.equidatas[!x]
				golabel /objectok
			endif
		enddo

		$(
		do !x indices !this.civils
			if !this.civils[!x].name eq !name then
				!object = !this.civils[!x]
				golabel /objectok
			endif
		enddo

		do !x indices !this.rooms
			if !this.rooms[!x].name eq !name then
				!object = !this.rooms[!x]
				golabel /objectok
			endif
		enddo
		$)

		label /objectok
		!mbdstru = !object.mbdstru.mbdstru
		-----------------------
		-----------------------sometimes only part of mbdstru are enhanced when unenhance are not used
		unenhance $!mbdstru
		handle any
		elsehandle none
			if !this.enhancered.val then
				--enhance $!mbdstru col red
				--enhance $!mbdstru col blue
				enhance $!mbdstru col $!col
			endif
		endhandle
	enddo
endmethod

define method .recoversetting()	$*recovery setting
	!path = !!pml.getpathname(!this.name().lowcase() + '.pmlfrm').before(!this.name().lowcase() + '.pmlfrm') + 'setting\markInstEquiSetting.txt'
	!file = object file(!path)
	!lines = !file.readfile()
	handle any
		return
	elsehandle none
		do !line values !lines
			!name = !line.before(':')
			!val = !line.after(':')

			!com = '!dtext = !this.' + !name + '.dtext'
			$!com
			handle any
				!com = '!this.' + !name + '.val = ' & !val
			elsehandle none
				!com = '!this.' + !name + '.select(|dtext|,|' + !val + '|)'
			endhandle
			$!com
			handle any
				!com = '!this.' + !name + '.val = |' &!val & '|'
				$!com
				handle any
				endhandle
			endhandle
		enddo
	endhandle
	!this.settotplant()
endmethod


define method .settotplant()
	return
	if !this.generatejson.selection('dtext').boolean() then
		!this.ToTplant.active = true
	else
		!this.ToTplant.active = false
	endif
endmethod

define method .inputpath()
	!string = !this.filepath.val.trim()
	if !string eq '' then
		!this.filepath.val = 'D:\'
		golabel /end
	endif
	!folder = object file(!string)
	if !folder.exists().not() then
		!ans = !!alert.confirm('路径不存在,是否新建？')
		if !ans ne 'YES' then
			!this.filepath.val = 'D:\'
			golabel /end
		else
			syscom |mkdir $!folder|
		endif
	endif
	if !string.substring(-1,1) ne '/' and !string.substring(-1,1) ne '\' then
		!string = !string + '\'
	endif
	!this.filepath.val = !string

	label /end
	!this.instoreset()
endmethod

define method .changeCheight(!gadget is gadget, !string is string)	$*modify cheight of mlabel
	--$p $!string
	if !this.checkfilepath().not() then
		return
	endif
	if !string ne 'SELECT' then
		return
	endif
	!sel = object selection()
	!sel.getcurrent()
	!arr = !sel.getselection()
	!cheight = !this.changecheight.displaytext().real()
	!this.oldcheights = array()
	--q var !arr

	--!vals = !this.setequisfilepath(!arr)
	!newarr = array()
	do !one values !arr
		!onetype = type of $!one
		--$p $!onetype
		if !onetype ne 'LINDIM' and !onetype ne 'MLABEL' then
			skip
		endif
		!function = function of $!one
		--if !function.upcase() inset ('CIVIL','CIVIL MEM','EL THICK','ROOM','EQUI') then

			!this.oldcheights.append(!one.string() + ' ' + !one.cheight.string())
			!one.cheight = !cheight
		--endif

		!newarr.append(!one)
	enddo
	--q var !vals
	if !this.autoupdatejson.displaytext().boolean() then
		!this.updatejson(!newarr)
	endif
	--!this.updatefile(!vals)
endmethod

define method .updatejson(!arr is array)
	!vals = array()
	do !mlabel values !arr
		!nodename = desc of $!mlabel
		!equiname = !nodename.after(':')
		!val = !this.list.rtext.findfirst(!equiname)
		!vals.append(!val)
	enddo

	!vals.unique()
	do !val values !vals
		if !val.set() then
			!this.equidatas[!val].generatejson = !this.generatejson.displaytext().boolean()
			!this.equidatas[!val].filepath = !this.filepath.displaytext()
			!this.equidatas[!val].generatejsonattrvm()
		endif
	enddo
endmethod

$(
define method .updatefile(!vals is array)
	!vals.unique()
	do !val values !vals
		!this.equidatas[!val].generatejsonattrvm()
	enddo
endmethod

define method .setequisfilepath(!arr is array) is array
	!vals = array()
	do !mlabel values !arr
		!nodename = desc of $!mlabel
		!equiname = !nodename.after(':')
		!val = !this.list.rtext.findfirst(!equiname)
		!vals.append(!val)
	enddo

	!vals.unique()
	do !val values !vals
		if !val.set() then
			!this.equidatas[!val].generatejson = !this.generatejson.displaytext().boolean()
			!this.equidatas[!val].filepath = !this.filepath.displaytext()
		endif
	enddo
	return !vals
endmethod
$)

define method .moveto()	$*move mlabel 1
	if !this.checkfilepath().not() then
		return
	endif
	!a = object edgpacket()
	!a.defineposition('Pick one point')
	!a.action = '!!markinstEquiForm.moveto2(!this.return) !!edgcntrl.escape()'
	!!edgcntrl.add(!a)
endmethod

define method .moveto2(!aa is any) $*move mlabel 2
	--q var !aa
	!mlabel = name of mlabel
	handle any
		return
	endhandle

	!pickitem = !aa[1].item
	!pickpos = !aa[1].position


	!ori = ori of mlabel wrt/*
	handle any
		!!alert.message('Choose Mlabel')
	endhandle
	!pos = pos of mlabel wrt/*

	!picktype = type of $!pickitem
	if !picktype inset ('WALL','GWALL','STWALL','FLOOR') then
		!plane = object plane(!pos,!ori)
		!newpos = !plane.near(!pickpos)
	else
		!newpos = !pickpos
	endif

	$(
	!newpos = !plane.near(!pickpos)
	if !pickpos.distance(!newpos) gt 100 then
		!ans = !!alert.confirm('Sure to move?')
		if !ans ne 'YES' then
			return
		endif
	endif
	$)



	$(
	!nodename = desc of $!mlabel
	!equiname = !nodename.after(':')
	!val = !this.list.rtext.findfirst(!equiname)
	if !val.set() then
		!this.equidatas[!val].generatejson = !this.generatejson.displaytext().boolean()
		!this.equidatas[!val].filepath = !this.filepath.displaytext()
		!this.equidatas[!val].movemlabel(!mlabel,!newpos,!this.textoffsetdis.displaytext().real())
	endif
	$)



	--$(
	$!mlabel
	var !dimposs coll all dimpos for ce
	!dimpos = pos of $!dimposs[1] wrt/*
	handle any
	endhandle
	pos $!newpos
	$!dimposs[1]
	handle any
	elsehandle none
		pos $!dimpos
	endhandle

	$(
	!picktype = type of $!pickitem
	if !picktype inset ('WALL','GWALL','STWALL','FLOOR')
		!offsetdis = !this.textoffsetdis.displaytext().real()
		--!ans = !!alert.confirm('是否向外移动' + !offsetdis.string() + 'mm')
		--if !ans eq 'YES' then
			!newpos = !newpos.offset(!ori.zdir(),!offsetdis)
			pos $!newpos
			$!dimposs[1]
			handle any
			elsehandle none
				pos $!dimpos
			endhandle
		--endif
	endif
	$)


	if !this.autoupdatejson.displaytext().boolean() then
		!arr = array()
		!arr.append(!mlabel)
		!this.updatejson(!arr)
	endif
	--$)
endmethod

define method .setpos()	$*set position to make dimension manually 1
	if !this.checkfilepath().not() then
		return
	endif

	!val = !this.getJsonIndex()
	if !val eq 0 then
		$p 请先添加设备
		return
	endif

	$!this.equidatas[$!val].equiname

	$(
	!equiname = name of equi
	handle any
		if !this.list.dtext.size() eq 1 then
			!equiname = !this.list.dtext[1]
			$!equiname
		else
			!!alert.warning('Choose Equi')
			return
		endif
	endhandle
	!find = false
	do !equi values !this.equidatas
		if !equi.equiname eq !equiname then
			!find = true
			break
		endif
	enddo
	if !find.not() then
		!!alert.warning('CE is not in list')
		return
	endif

	--show !!edgnewpositioning
	--!!edgnewpositioning.pick(1)
	--!!edgnewpositioning.picktype(4)
	--hide !!edgnewpositioning
	--return
	$)

	!a = object edgpacket()
	!a.defineposition('Pick one point')
	!a.action = '!!markinstEquiForm.setpos2(!this.return) !!edgcntrl.escape()'
	!!edgcntrl.add(!a)
endmethod

define method .setpos2(!aa is any)	$*set position to make dimension manually 2
	!pickpos = !aa[1].position.wrt(world)
	--q var !pickpos
	!equiname = name of equi
	do !equi values !this.equidatas
		if !equi.equiname eq !equiname then
			!this.setequifilepath(!equi)


			------------------------------------------------------new way
			!equi.pos = !pickpos
			!this.setequifilepath(!equi)
			!this.setEquiCheight(!equi)
			!equi.draw()
			skip

			!equi.mbdlocation.pos = !pickpos

			!equi.mbdlocation.getdimdata()
			!equi.mbdlocation.repairdim()
			skip

			!equi.pos = !pickpos
			!equi.nswall = object markcivil()
			!equi.ewwall = object markcivil()
			!equi.floor = object markcivil()
			--$p safdsaf

			!drawlindim = !equi.mbdstru.checktype('LINDIM')
			!drawmlabel = !equi.mbdstru.checktype('MLABEL')
			--q var !drarlindim !drawmlabel
			--if !drawlindim and !drawmlabel then
				!equi.draw()
			--else
			--	if !drawlindim then
			--		!equi.drawdim()
			--	elseif !drawmlabel then
			--		!equi.drawmlabel()
			--	endif
			--endif
			break
		endif
	enddo

	!this.setfunctionlist()
	!this.red()
endmethod

define method .pickcon()	$* choose civil manually
--q var !this.list.rtext
	if !this.checkfilepath().not() then
		return
	endif

	!val = !this.getJsonIndex()
	if !val eq 0 then
		$p 请先添加设备
		return
	endif
	!this.setequifilepath(!this.equidatas[!val])
	--!name = name of id@
	!this.setEquiCheight(!this.equidatas[!val])

	--!this.equidatas[!val].pickcon(!name)
	!this.equidatas[!val].pickcon()
	!this.setfunctionlist()
	!this.red()

	$(
	!equiname = name of equi
	handle any
		if !this.list.dtext.size() eq 1 then
			!equiname = !this.list.rtext[1]
		else
			!!alert.warning('Choose Equi')
			return
		endif
	endhandle

	!name = name of id@
	do !equi values !this.equidatas
		if !equi.equiname eq !equiname then
			!this.setequifilepath(!equi)
			!equi.pickcon(!name)
			break
		endif
	enddo

	!this.setfunctionlist()
	!this.red()
	$)
endmethod

define method .setfunctionlist()	$*get dtext of function list
	!strus = array()
	do !x indices !this.equidatas
		!strus.append(!this.equidatas[!x].mbdstru.mbdstru)
	enddo
	--do !x indices !this.civils
	--	!strus.append(!this.civils[!x].mbdstru.mbdstru)
	--enddo
	--do !x indices !this.rooms
	--	!strus.append(!this.rooms[!x].mbdstru.mbdstru)
	--enddo
	!result = !!getstrudata(!strus)
	!this.functionlist.dtext = !result[1]
	!this.functiondata = !result
endmethod

define method .dealfunction(!type is string)	$* add or rem function mlabel or lindim
	--!!setmbdfmt()
	!functions = !this.functionlist.selection('dtext')
	if !functions.unset() then
		!functions = !this.functionlist.dtext
	endif
	do !function values !functions
		!index = !this.functiondata[1].findfirst(!function)
		do !item values !this.functiondata[2][!index]
			if !type eq 'add' then
				add only $!item
			else
				remove only $!item
			endif
		enddo
	enddo
	!this.red()
endmethod

define method .checkfilepath() is boolean
	if !this.generatejson.selection('dtext').boolean() then
		if !this.filepath.val ne '' then
			!file = object file(!this.filepath.val)
			if !file.exists().not() then
				return false
			else
				return true
			endif
		else
			return false
		endif
	else
		return true
	endif
endmethod

define method .recoverCheight()	$*recovery cheight of mlabel
	if !this.checkfilepath().not() then
		return
	endif

	--!arr = array()
	--do !line values !this.oldcheights
	--	!arr.append(!line.split()[1])
	--enddo
	--!vals = !this.setequisfilepath(!arr)
	!newarr = array()
	do !line values !this.oldcheights
		!arr = !line.split()
		$!arr[1]
		!newarr.append(!arr[1])
		!dbref = object dbref(!arr[1])
		!dbref.cheight = !arr[2].real()
		handle any
			if !dbref.badref() then
				$p $!arr[1] does not exists
			else
				$p $!arr[1] cant be set back
			endif
			skip
		endhandle
	enddo
	if !this.autoupdatejson.displaytext().boolean() then
		!this.updatejson(!newarr)
	endif
	--!this.updatefile(!vals)
endmethod

define method .chooseItem()	$*enhance choosed item col red
	!item = !this.list.selection('rtext')[1]
	handle any
		return
	endhandle
	unenhance all
	$!item
	handle any
	elsehandle none
		--enhance $!item col red
	endhandle
	--q var !this.list.val
	!vals = !this.list.val
	!val = !vals[1]
	handle any
		!val = 1
	endhandle
	!equi = !this.equidatas[!val]
	handle any
	elsehandle none
		if !item eq !equi.equiname then
			!arr = array()
			!arr.append(!item)
			!arr.append(!equi.nswall.name)
			handle any
			endhandle
			!arr.append(!equi.ewwall.name)
			handle any
			endhandle
			!arr.append(!equi.floor.name)
			handle any
			endhandle
			--q var !arr
			do !aa values !arr
				add $!aa
				handle any
				endhandle
			enddo
		endif
	endhandle
	!this.setOtherList()
	!this.red()
endmethod

define method .getJsonIndex() is real
	!vals = !this.list.val
	!val = !vals[1]
	handle any
		if !this.list.dtext.size() eq 1 then
			!val = 1
		else
			--$p Choose One bran
			return 0
		endif
	endhandle
	return !val
endmethod

define method .setOtherList()
	!val = !this.getJsonIndex()
	if !val eq 0 then
		return
	endif

	!this.setlist6(!val)
	!this.setlist7(!val)
endmethod

define method .setlist6(!val is real)
	--!this.equidatas[!val].getdrawinfo()
	!object = !this.equidatas[!val]

	!tempfile = object file(!!commonpath() + 'functionsetdrawinfo.txt')
	!lines = !tempfile.readfile()
	do !line values !lines
		if !line.trim().trim('	') ne '' then
			$!line
		endif
	enddo
endmethod

define method .setlist7(!val is real)
	!object = !this.equidatas[!val]

	!tempfile = object file(!!commonpath() + 'functionsetproofreading.txt')
	!lines = !tempfile.readfile()
	do !line values !lines
		if !line.trim().trim('	') ne '' then
			$!line
		endif
	enddo
endmethod

define method .addCeObject() is boolean	$*try to add civil item as object markcivil
	var !cons coll all (FLOOR WALL GWALL STWALL) for ce
	if !cons.unset() then
		!cons = array()
		!types = split('FLOOR WALL GWALL STWALL')
		do !type values !types
			!name = name of $!type
			handle any
			elsehandle none
				$!name
				!cons.append(!name)
				break
			endhandle
		enddo
	endif
	if !cons.unset() then
		return false
	endif
	do !con values !cons
		!conname = name of $!con
		!find = false
		do !civil values !this.civils
			if !civil.name eq !conname then
				!find = true
				break
			endif
		enddo
		if !find.not() then
			!markcivil = object markcivil(!con)
			if !markcivil.name.set() then
				!this.civils.append(!markcivil)
				!markcivil.mbdstru.addstru()
			endif
		endif
	enddo
	return true
endmethod

define method .addRoom() is boolean	$* try to add room item as object civilroom
	var !frmws coll all frmw for ce
	if !frmws.unset() then
		!frmwname = name of frmw
		handle any
			return false
		endhandle
		!goodfrmw = !frmwname
		!frmws = array()
		!frmws.append(!frmwname)
	endif

	if !frmws.unset() then
		return false
	endif
	!find = false
	do !frmw values !frmws
		!room = object civilroom(!frmw)
		if !room.name.set() then
			!find = true
			!this.rooms.append(!room)
			--!markroom.mbdstru.addstru()
			!room.mbdstru.addstru()
		endif
	enddo
	if !find then
		if defined(!goodfrmw) then
			$!goodfrmw
		endif
	endif
	return true
endmethod

define method .addequi() is boolean	$* add equi as object markequi
	!rtext = !this.list.rtext
	var !equis coll all equi for ce
	if !equis.unset() then
		!equiname = name of equi
		handle any
			return false
		endhandle

		!goodequi = !equiname
		!equis = array()
		!equis.append(!equiname)
	endif

	if !equis.unset() then
		return false
	endif
	!find = false
	do !equi values !equis

		if !rtext.findfirst(!equi).set() then
			skip
		endif

		!markequi = object markequi(!equi,'EM9')
		if !markequi.equiname.set() then
			!find = true
			!this.equidatas.append(!markequi)
			!markequi.mbdstru.addstru()
		endif
	enddo
	if !find then
		if defined(!goodequi) then
			$!goodequi
			return true
		endif
	endif
	return false
endmethod

define method .clearlist()	$* clear all
	!this.list.dtext = array()
	--!this.civils  = array()
	--!this.rooms = array()
	!this.equidatas = array()

	!this.setfunctionlist()
endmethod

define method .remSelObject(!item is string)	$* rem item from input
	--var !cons coll all (FLOOR WALL GWALL STWALL) for $!item
	$(
	--old
	if !cons.unset() then
		!cons = array()
		!types = split('FLOOR WALL GWALL STWALL')
		do !type values !types
			!name = name of $!type
			handle any
			elsehandle none
				!cons.append(!name)
				break
			endhandle
		enddo
	endif
	$)


	$(
	do !name values !cons
		do !x indices !this.civils
			!markcivil = !this.civils[!x]
			if !markcivil.name eq !name then
				!this.civils[!x].delete()
				break
			endif
		enddo
	enddo


	var !frmws coll all frmw for $!item
	do !frmw values !frmws
		!frmwname = name of $!frmw
		do !x indices !this.rooms
			if !this.rooms[!x].name eq !frmwname then
				!this.rooms[!x].delete()
				break
			endif
		enddo
	enddo
	$)

	var !equis coll all equi for $!item
	do !equi values !equis
		!equiname = name of $!equi
		do !x indices !this.equidatas
			if !this.equidatas[!x].equiname eq !equiname then
				!this.equidatas[!x].delete()
				break
			endif
		enddo
	enddo
endmethod
define method .addlist()
	!!updatembdfiles()
	--!arr = !!mbdlist.list.dtext

	!list = object LISTINTERFACE()
	!arr = !list.getCurrentListAsStrings()
	handle any
		$p 请先设置列表
		return
	endhandle
	if !arr.unset() then
		$p 请先设置列表
		return
	endif
	do !item values !arr
		$!item
		!this.addonece()
	enddo
endmethod
define method .AddCE()
	!!updatembdfiles()
	!this.addonece()
endmethod

define method .addonece()
	equi
	handle any
		var !equis coll all equi for ce
		if !equis.set() then
			var !names eval name for all from !equis
		else
			!struname = name of stru	$*aid things
			handle any
			elsehandle none
				if !struname.matchwild('*-MBD') then
					!equiname = !struname.before('-MBD')
					--if !equiname.substring(1,2) eq '/_' then
					--	!equiname = !equiname.replace('/_','=').replace('_','/')
					--endif

					!type = type of $!equiname
					handle any
					elsehandle none
						if !type eq 'EQUI' then
							!names[1] = !equiname
						endif
					endhandle
				endif
			endhandle
			if undefined(!names) then
				return error 1 'Select equi pls'
			endif
		endif
	elsehandle none
		!names[1] = name
	endhandle
	!dtext = !this.list.dtext
	!Rtext = !this.list.Rtext

	!headings = !this.equiAttShow
	!this.list.setheadings(!headings)

	!errors = array()
	!size = !names.size()
	!x = 0
	do !name values !names
		$p $!name
		!x = !x + 1

		if !rtext.findfirst(!name).unset() then
			!markequi = object markequi(!name,'EM9')
			handle any
				--!errors.append(!name + ' Failed to get markequi of this equi')
				q var !!error
				!errors.append(!name + ' 未得到markequi')
				!errors.appendarray(!!geterrorinfo())
				skip
			endhandle

			--!markequi = object markequi(!name,!this.minslope,!this.maxslope,!this.textori.displaytext().boolean(),!this.dimdirs,!this.chardirs,!this.opSearch.selection('dtext').real())
			!this.equidatas.append(!markequi)

			!rowarr = !markequi.getequiAttArr(!this.equiAtts)
			handle any
				!errors.append(!name + ' Failed to get attribution list of this equi')
				!errors.appendarray(!!geterrorinfo())
				skip
			endhandle
			!oneline = ''
			do !string values !rowarr
				if !oneline ne '' then
					!oneline = !oneline + '	' + !string.string()
				else
					!oneline = !string.string()
				endif
			enddo
			!Rtext.append(!name)
			!Dtext.append(!oneline)
			!mbdstru = !markequi.mbdstru
		else
			!mbdstru = object mbdstru(!name)
		endif
		!mbdstru.addstru()


		add $!name

		!percent = nint(100 * !x / !size)
		!!fmsys.setProgress(!percent)
	enddo
	!lastname = !names.last()
	--auto $!lastname			$* not available for equipment

	--q var !dtext !rtext

	!this.list.dtext = !dtext
	!this.list.Rtext = !Rtext

	!this.setfunctionlist()

	!this.setotherlist()

	!this.red()

	!this.writeerror(!errors)
	!!fmsys.setProgress(0)
endmethod

$(
define method .addce()	$* add ce into list

	--!civilresult = !this.addceobject()
	--!roomresult = !this.addroom()
	!equiresult = !this.addequi()
	--if !civilresult.not() and !roomresult.not() and !equiresult.not() then
	if !equiresult.not() then
		--if !this.addCeObject().not() then
		--if !this.addRoom.not() then
		!!alert.warning('Choose Civil or Room or equi element please')
		return
		--endif
	else
		!name = name
		add $!name
	endif


	!dtext = !this.list.dtext
	!Rtext = !this.list.rtext

	!headings = !this.equiAttShow

	!this.list.setheadings(!headings)
	!rowarr = !this.equidatas.last().getequiAttArr(!this.equiAtts)
	handle any
		!errors.append(!name + ' Failed to get attribution list of this equi')
		!errors.appendarray(!!geterrorinfo())
		skip
	endhandle
	!oneline = ''
	--!name
	do !string values !rowarr
		if !oneline ne '' then
			!oneline = !oneline + '	' + !string.string()
		else
			!oneline = !string.string()
		endif
	enddo
	--q var !oneline
	!Rtext.append(!name)
	!Dtext.append(!oneline)


	--!dtext.append(!name)
	--!dtext.unique()

	!this.list.dtext = !dtext
	!this.list.rtext = !rtext

	!this.list.val = !rtext.findfirst(!name)
	!this.chooseItem()

	!this.setfunctionlist()
	!this.red()
endmethod
$)

define method .writeerror(!errors is array)
	if !errors.set() then
		!dt = object datetime()
		!errors.insert(1,!dt.string())
		!errors.insert(1,'')
		!path = !!pml.getpathname(!this.name().lowcase() + '.pmlfrm').before(!this.name().lowcase() + '.pmlfrm') + 'equierror.txt'
		!file = object file(!path)
		!lines = !file.readfile(100000)
		handle any
			!lines = array()
			!file.writefile('overwrite',!lines)
		endhandle

		$(
		if !lines.size() gt 10000 then
			!lines = !lines.from(!lines.size() - 1000)
			!lines.appendarray(!errors)
			!file.writefile('overwrite',!lines)
		else
			!file.writefile('append',!errors)
		endif
		$)

		if !lines.size() gt 10000 then
			!lines = !lines.from(9000)
		endif

		!lines.insertarray(1,!errors)
		!file.writefile('overwrite',!lines)

		syscom 'start $!file &'
	endif
endmethod

define method .remsel()	$* rem selection in list
	!name = !this.list.selection('Dtext')
	!dtext = !this.list.dtext
	!val = !this.list.val
	if !val ne 0 then
		!dtext[!val].delete()
		!dtext.compress()
	endif
	!this.list.dtext = !dtext

	!this.remSelObject(!name)

	!this.setfunctionlist()
endmethod

$(
define method .enhance()	$* enhance all items in list col red
	unenhance all
	do !name values !this.list.dtext
		enhance $!name col red
	enddo
endmethod
$)

$(
define method .addabakt()
	!cnames = array()
	do !civil values !this.civils
		if !civil.type eq 'FLOOR' then
			!cname = name of cfloor of $!civil.name
		else
			!cname = name of cwall of $!civil.name
		endif
		!cnames.append(!cname)
	enddo

	!addnames = array()
	do !owner values !cnames
		!parts = !owner.split('-')
		!abparts = !parts
		!abparts[!abparts.size() - 1] = 'AB'
		!abname = !this.merge(!abparts)

		!akparts = !parts
		!akparts[!akparts.size() - 1] = 'AK'
		!akname = !this.merge(!akparts)

		!tparts = !parts
		!tparts[!tparts.size() - 1] = 'T'
		!tname = !this.merge(!tparts)

		!addnames.append(!abname)
		!addnames.append(!akname)
		!addnames.append(!tname)
	enddo
	!addnames.unique()
	do !name values !addnames
		add $!name
		handle any
		endhandle
	enddo
endmethod
$)

$(
define method .merge(!arr is array) is string	$*merge arr to string
	!string = !arr[1]
	do !x from 2 to !arr.size()
		!string = !string + '-' + !arr[!x]
	enddo
	return !string
endmethod
$)

define method .draw(!drawtype is string)	$*draw all or malbel or dim
	!objects = array()
	--!objects = !this.civils
	--!objects.append(!this.rooms)
	!objects.append(!this.equidatas)
	do !object values !objects
		!otype = !object.objecttype()
		!com = '!this.set' + !otype + 'Cheight(!object)'
		$!com
		if !drawtype.upcase() eq 'ALL' then
			!object.draw()
		elseif !drawtype.upcase() eq 'MLABEL' then
			!object.drawMlabel()
		elseif !drawtype.upcase() eq 'DIM' then
			!object.drawDim()
		endif
	enddo
endmethod


-----------------------------------------------------------------is replaced by draw    202303151407 s
define method .drawType(!inputtype is string)	$* draw all or malbel or dim. it is replaced by draw
	!type = !inputtype.upcase()
	if !type eq '' then
		!type = 'ALL'
	endif

	$(
	do !civil values !this.civils
		!this.setCivilcheight(!civil)
		if !type eq 'ALL' then
			!civil.draw()
		elseif !type eq 'MLABEL' then
			!civil.drawMlabel()
		elseif !type eq 'DIM' then
			!civil.drawDim()
		endif
	enddo
	do !room values !this.rooms
		!this.setROOMCheight(!Room)
		if !type eq 'ALL' then
			!room.draw()
		elseif !type eq 'MLABEL' then
			!room.drawMlabel()
		elseif !type eq 'DIM' then
			!room.drawDim()
		endif
	enddo
	$)

	do !equi values !this.equidatas
		!this.setequifilepath(!equi)
		!this.setequiCheight(!equi)
		if !type eq 'ALL' then
			!equi.draw()
		elseif !type eq 'MLABEL' then
			!equi.drawMlabel()
		elseif !type eq 'DIM' then
			!equi.drawDim()
		endif
	enddo

	$(
	--cant get update data
	!objects = !this.civils
	!objects.appendarray(!this.rooms)
	!objects.appendarray(!this.equidatas)
	do !object values !objects
		if !type eq 'ALL' then
			!object.draw()
		elseif !type eq 'MLABEL' then
			!object.drawMlabel()
		elseif !type eq 'DIM' then
			!object.drawDim()
		endif
	enddo
	$)
endmethod

define method .drawAll()	$* draw everything
	if !this.checkfilepath().not() then
		return
	endif
	--!!setmbdfmt()
	!clearcontent = false

	--!this.drawtype('ALL')
	!size = !this.equidatas.size()
	!errors = array()
	!x = 0
	$p
	do !equi values !this.equidatas
		!equiname = !equi.equiname
        --q var !equi
		$p $!equiname
		!x = !x + 1
		!this.setequifilepath(!equi)
		!this.setequiCheight(!equi)
		--!tempboolean = !equi.draw()
		!equi.draw()
		handle any
			q var !!error
			!errors.append('$!equi.equiname failed to draw')
			!errors.appendarray(!!geterrorinfo())
		elsehandle none
			--if !tempboolean.not() then
			--	!errors.appendarray(!equi.wronglines)
			--endif
			if !clearcontent then
				!this.equidatas[!x].clearcontent()
			endif
		endhandle

		!percent = nint(100 * !x / !size)
		!!fmsys.setProgress(!percent)
	enddo

	!this.setfunctionlist()
	!this.red()

	!this.writeerror(!errors)
	!!fmsys.setProgress(0)
endmethod

$(
define method .drawMlabel()	$*draw mlabel
	!this.drawtype('MLABEL')
endmethod

define method .drawDim()	$* draw dim
	!this.drawtype('DIM')
endmethod
$)
-----------------------------------------------------------------------is replaced by draw    202303151407 e

$(
define method .changeline()
	do !civil values !this.civils
		!civil.ChangeLine()
	enddo
endmethod

define method .setMlabelLine()
	if !this.allLine.tag.upcase() eq '所有带引线' then
		do !civil values !this.civils
			!civil.setMlabelLine(true)
		enddo
		!this.allLine.tag = '所有无引线'
	else
		do !civil values !this.civils
			!civil.setMlabelLine(false)
		enddo
		!this.allLine.tag = '所有带引线'
	endif
endmethod
$)

define method .deleteall()	$*delete all malbel dim
	!objects = array()
	--!objects = !this.civils
	--!objects.appendarray(!this.rooms)
	!objects.appendarray(!this.equidatas)

	$(
	do !equi values !this.equidatas

		if !equi.nswall.set() then
			!objects.append(!equi.nswall)
		endif
		if !equi.ewwall.set() then
			!objects.append(!equi.ewwall)
		endif
		if !equi.floor.set() then
			!objects.append(!equi.floor)
		endif
	enddo
	$)

	do !object values !objects
		!object.deleteDimAndMlabel()
	enddo

	!this.setfunctionlist()
endmethod

define method .setCivilcheight(!civil is markcivil)	$*set cheight for input civil object
	!civil.textoffsetdis = !this.textoffsetdis.displaytext().real()
	!civil.civilCheight = !this.civilCheight.displaytext().real()
	!civil.roomCheight = !this.roomCheight.displaytext().real()
	!civil.elThickCheight = !this.elThickCheight.displaytext().real()
	--!civil.apdpCheight = !this.apdpCheight.displaytext().real()
	--!civil.openingCheight = !this.openingCheight.displaytext().real()
	!civil.dimCheight = !this.dimCheight.displaytext().real()

	--!civil.vertDim = !this.vertDim.selection('dtext').boolean()
	--!civil.markThickAfterName = !this.wallThickAfterName.selection('dtext').boolean()
	--!civil.mat = !this.mat.selection('dtext').boolean()
	--!civil.secondcon = !this.secondcon.selection('dtext').boolean()
	--!civil.openingpos = !this.openingpos.selection('dtext').boolean()
endmethod

define method .setRoomCheight(!room is civilRoom)	$* set cheight for room
	!room.textoffsetdis = !this.textoffsetdis.displaytext().real()
	!room.roomCheight = !this.roomCheight.displaytext().real()
endmethod

define method .setEquiCheight(!equi is markequi) $* set cheight for equi

	$(
	if !this.waytogetwall.displaytext() eq '手动' then
		!equi.autoGetCon = false
	else
		!equi.autoGetCon = true
	endif
	if !this.inDrawList.displaytext() eq 'False' then
		!equi.inDrawList = false
	else
		!equi.inDrawList = true
	endif
	$)

	!equi.dimCheight = !this.dimCheight.displaytext().real()
	!equi.textoffsetdis = !this.textoffsetdis.displaytext().real()
	!equi.equiCheight = !this.equiCheight.displaytext().real()
endmethod

define method .setEquifilepath(!equi is markequi) $* set filepath for equi
	!equi.generatejson = !this.generatejson.displaytext().boolean()
	!equi.filepath = !this.filepath.displaytext()
endmethod

define method .generatefiles() is array
	if !this.checkfilepath().not() then
		return
	endif
	!filepath = !this.filepath.displaytext().trim()
	!resultpaths = array()
	do !equi values !this.equidatas
		!equi.generatejson = true
		!equi.filepath = !filepath
		!paths = !equi.generatejsonattrvm()
		!resultpaths.appendarray(!paths)
	enddo
	return !resultpaths
endmethod

define method .Json()	$* save json file
	if !this.generatefiles().set() then
		!filepath = !this.filepath.displaytext().trim()
		!folder = object file(!filepath)
		Syscom 'start $!folder &'
	else
		$p No Files generated
	endif
	return

	if !this.checkfilepath().not() then
		return
	endif
	!filepath = !this.filepath.displaytext().trim()
	do !equi values !this.equidatas
		!equi.generatejson = true
		!equi.filepath = !filepath
		!equi.generatejsonattrvm()
	enddo
	!folder = object file(!filepath)
	Syscom 'start $!folder &'
return
	import 'PMLFileBrowser'
	Handle Any
	Endhandle
	var !banner banner
	if !banner.matchwild('*PDMS*') then
		using namespace 'Aveva.PDMS.Presentation'
	else
		using namespace 'Aveva.Core.Presentation'
	endif
	!browser = object pmlfolderbrowser()
	!browser.show('Choose Folder',true)	$*true代表有新建文件夹选项
	!path = !browser.selectedpath()
	if !path eq '' then
		return
	endif


	!objects = !this.equidatas
	--!objects.appendarray(!this.civils)
	--!objects.appendarray(!this.rooms)

	do !object values !objects
		--!json = object json(!object.mbdstru.mbdstru)
		--!lines = !json.getpackjson()
		--!lines = !object.getjsondata()
		!lines = !object.getjsondata(!this.equiAtts ,!this.equiAttShow )

		!filename = !object.equiname.replace('=','_').replace('/','_').replace('\','_')
		!this.instore(!lines,!filename,!path)
	enddo

	!folder = object file(!path)
	Syscom 'start $!folder &'
endmethod

define method .toTplant()		$* for test
	if !this.checkfilepath().not() then
		return
	endif
	!filepath = !this.filepath.displaytext().trim()
	do !equi values !this.equidatas
		!equi.generatejson = true
		!equi.filepath = !filepath
		!equi.totplant()
	enddo
	!folder = object file(!filepath)
	Syscom 'start $!folder &'
return


	!vals = !this.list.dtext.indices()
	if !vals.unset() then
		return
	endif

	!items = array()
	do !val values !vals
		!items.append(!this.equidatas[!val].equiname)
	enddo
	!a = !!jsontotplant(!items,'','','','','','','em9equi')
endmethod

define method .instore(!result is array,!filename is string,!path is string)	$*instore json
	!goodpath = !path
	if !goodpath.matchwild('*\').not() or !goodpath.matchwild('*/').not() then
		!goodpath = !goodpath + '\'
	endif
	!file = object file(!goodpath + !filename + '.json')
	!file.writefile('overwrite',!result)
endmethod

define method .AddInfo()
    pml reload form !!Addinfoform
    !!CurrentForm = !!markinstEquiForm
    show !!Addinfoform
endmethod
o