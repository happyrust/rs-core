kill !!mbd
setup form !!mbd  resize
	title 'MBD'
	path right
    button .em4pipe 'EM4管道' tooltip|EM4管道| call |!this.showtype('em4pipe')| width 8
	!this.em4pipe.background = 272
    button .em4support 'EM4支架' tooltip|EM4支架| call |!this.showtype('em4supp')| width 10
	!this.em4support.background = 272
	button .em9pipe 'EM9管道' tooltip|EM9管道| call |!this.showtype('em9pipe')| width 8
	!this.em9pipe.background = 298
    button .em9pipesupport 'EM9管道支架' tooltip|EM9管道支架| call |!this.showtype('em9pipesupp')| width 10
	!this.em9pipesupport.background = 298
	button .em9instsupport 'EM9仪表支架' tooltip|EM9仪表支架| call |!this.showtype('em9supp')| width 10
	!this.em9instsupport.background = 298
    button .civil '土建结构' tooltip|土建结构| call |!this.showtype('civil')| width 8
	!this.civil.background = 329
	button .arch '建筑' tooltip|建筑| call |!this.showtype('arch')| width 8
	!this.arch.background = 329
    button .equi '设备定位' tooltip|设备| call |!this.showtype('equi')| width 8
	!this.equi.background = 294
    button .HVAC 'EM5' tooltip|暖通| call |!this.showtype('HVAC')| width 8
	!this.hvac.background = 77
    button .ELEC 'EM8' tooltip|电气| call |!this.showtype('ELEC')| width 8
	!this.elec.background = 147
	button .clearInputdata 'Clear Data' tooltip|清除MBD输入材料数据| call |!this.clearmbdinputdata()| width 8
	!this.clearinputdata.background = 5
exit
define method .mbd()

endmethod

define method .showtype(!inputtype is string)
	!type = !inputtype.upcase()
    if !type eq 'EM4PIPE' then
        show !!markpipeform
    elseif !type eq 'EM4SUPP' then
        show !!marksuppform
    elseif !type eq 'EM9PIPE' then
        show !!markinstpipeform
	elseif !type eq 'EM9PIPESUPP' then
        show !!markinstpipesuppform
    elseif !type eq 'EM9SUPP' then
        show !!markinstsuppform
	elseif !type eq 'CIVIL' then
        show !!markCivilForm
	elseif !type eq 'ARCH' then
        show !!markArchForm
	elseif !type eq 'EQUI' then
        show !!markequiform
	elseif !type eq 'HVAC' then
		show !!markHvac
		handle any
			show !!EverythingHvacDimmAid
		endhandle
	elseif !type eq 'ELEC' then
		show !!markElec
		handle any
			show !!EverythingMLCTDimmAid
		endhandle
    endif
endmethod

define method .clearmbdinputdata()
	!!mbdmaterialdata.delete()
	handle any
	endhandle
endmethod

