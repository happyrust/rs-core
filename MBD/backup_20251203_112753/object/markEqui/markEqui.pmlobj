--getdimdata()  															$* get wall floor
--getconindir(!dir is direction, !contype is string,!extenddis is real,!preextenddis is real ,!maxdis is real, !usedcons is array) is boolean   	$* get wall floor in one direction
--pickCon() 																$* pick concrete 1
--pickcon(!item is any) 													$* pick concrete 2
--addcivil(!nearpoint is position, !profiledir is direction, !mindis is real, !civil is markcivil,!force is boolean)	$* add one concrete
--checkreplace(!nearpoint is position, !neardis is real, !dir is direction, !civil is markcivil, !minangle is real, !mindis is real, !newdir is direction) is boolean   	$* check if replace civil in one direction
--getJsonData() is array													$* get json
--getProofreadingJson() is array											$* get proofreading for json
--getDrawingInfoJson() is array 											$* get drawing info for json
--draw()																	$* draw all
--drawdimandmlabel()														$*
--red() 																	$*
--drawdim() 																$* draw dim
--addConInfo(!con is markcivil) 											$* add mlabel of concrete
--drawMlabel()  															$* draw mlabel
--deleteDimAndMlabel() is boolean   										$* delete dim and mlabel
--deleteDim() is boolean													$* delete dim
--deleteMlabel() is boolean 												$* delete mlabel
