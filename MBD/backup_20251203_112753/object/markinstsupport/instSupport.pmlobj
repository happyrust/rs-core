define object instSupport

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 1:basic information
	member .inputRef is string

	member .suppName is string
	member .struName is string
	member .restName is string

	member .function is string		$*function from atta

	------------------------------------------------------for inst supp
	member .standard is string
	member .nodename is string

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 2: for draw
	member .mbdstru is mbdstru
	member .cheight is real
	member .cheightbili is real
	member .changecheightauto is boolean	$*change cheight automatically
	member .sepSmallDim is boolean			$*separate dim in order to change the position when necessary
	member .ignoreline is boolean			$*donot consider line element in polarsystem
	member .changecheightautobili is real


	member .pipeattas is array		$*element is pipeatta
	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 3:for recognising
	member .toleranceDis is real	$* can be changed
	member .toleranceAngle is real
	member .paneThick is real
	member .maxsctndis is real

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 4:new way to instore parts of support
	member .parttypes is array				$* instore all type of object for support
	member .parttypeindices is array		$* instore indices of object in partobjects
	member .partobjects is array			$* instore all object for each one component of support
	member .partconnections is array		$* instore relationship of part

	member .textindexs is array				$* instore mlabel information(text and object index)


	member .dirObject is suiLookDirections	$*best directions of looking view

	-----------------------------------------------------------------------------------Step 7:materials
	member .materials is array
	member .weldobjects is array			$* array of suppweldtext
	member .welddone is boolean				$* indicate if check the weld

	-----------------------------------------------------------------------------------Step 8:draw planes
	member .planeSystem is planeSystem
	member .generatejson is boolean
	member .filepath is string
	member .drawtype is string
    member .textMater is boolean

	--for modelatt drawing and proofreading
	!tempstrings = split('membermodelatt memberdrawinginfo memberproofreading')
	do !string values !tempstrings
		!tempfile = object file(!!commonpath() + !string + '.txt')
		!lines = !tempfile.readfile()
		do !line values !lines
			if !line.trim().trim('	') ne '' then
				$!line
			endif
		enddo
	enddo
endobject
define method .instSupport(!item is any)
	!cename = name of $!item
	do
		!ownertype = type of owner of $!cename
		if !ownertype eq 'SITE' then
		--q var !cename
			if !cename.match('RACK') ne 0 then
				!drawtype = 'INSTSUPP'
			else
				!drawtype = 'INSTPIPESUPP'
			endif
			break
		else
			!cename = name of owner of $!cename
		endif
	enddo
	!this.instsupport(!item,!drawtype)
endmethod
define method .instSupport(!item is any,!drawtype is string) $*initial method
	!this.drawtype = !drawtype.trim().upcase()
	var !ref ref of $!item
	handle any
		!tryname = !item & '/STRU'
		var !ref ref of $!tryname
		handle any
			!tryname = !item & '/REST'
			var !ref ref of $!tryname
			handle any
				return
			endhandle
		endhandle
	endhandle
	!this.welddone = false
	!this.inputRef = !ref
	!this.getName()				$* get supp stru rest name and mbdstru
	!this.getatts()
	!this.toleranceDis = 50
	!this.toleranceAngle = 1
	!this.cheight = 10						$* need to set
	!this.cheightbili = 0.2
	!this.paneThick = 30				$*


	!this.parttypes = split('CLAMP POINT BEAM PANE PANES BOLT TUBE APDP CONNECT WELD CONCRETE OTHER')
	do !x indices !this.parttypes
		!this.parttypeindices[!x] = array()
	enddo
	$(
	if !this.getLineData().not() then
		return
	endif
	!this.getCenPos()

	!this.getmaterial()
	!this.getwelds()
	$)
endmethod

--define method .getspecialnum() $*it supposed to get nbbm
--	!this.specialnum = 'xxxxxxxxxxxx'
--endmethod


define method .getsuppAttArr(!suppAtts is array) is array $*public 	return array of attribution of support
	!row = array()
	do !x indices !suppatts
		!att = !suppAtts[!x]
		!com = |!row[!x] = !this.| + !att
		$!com
		handle any
			!rows[!x] = ''
			$p No suppatt: $!att for supp $!this.suppname
		endhandle
	enddo
	return !row
endmethod

define method .getatts() $*get atts of support
	!name = !this.suppname
	!!setattvalue(!this,!name,split('function/:ZD_ZJGN,drawnum/:zd_nbbm,standard/function',','))
	!!setattvalue(!this,!name,split('room/:room_no,tssm/:zd_tssm,wjbm/:zd_wjbm,nbbm/:zd_nbbm,status/:zd_status,rev/:zd_rev',','))

    --modify by jyg 20240822 add
    --Q VAR !this.drawtype
    if  !this.drawtype eq 'INSTSUPP' then
        !this.standard = :ZD_BZBM of $!this.suppname
    endif

    --modify by jyg 20240731
    !this.rev = :ZD_Rev of $!this.suppname
	--!this.rev = 'A' $*4月30日前
	!this.getdrawinfo()
	!!setproofreadinginfo(!this,name)
endmethod

define method .getdrawinfo()
	if !this.drawgroup.unset() then
		if !this.drawtype eq 'INSTSUPP' then
			!this.drawmajor = '仪表支架'
		else
			!this.drawmajor = '仪表管支架'
		endif
		!this.drawname = '支架三维制作图'

		!!getdrawinginfo(!this)
	endif
endmethod

define method .addtoview() $*public 	add pipe and support to view
	add $!this.suppname
	handle any
	endhandle
	add $!this.struname
	handle any
	endhandle
	add $!this.restname
	handle any
	endhandle

	!types = split('CLAMP POINT')
	--!types = split('CLAMP POINT CONCRETE APDP')
	do !type values !types
		!index = !this.parttypes.findfirst(!type)
		--$p $!type $!index
		if !index.set() then
			!indices = !this.parttypeindices[!index]
			do !index values !indices
				--$p $!index
				do !mem values !this.partobjects[!index].mems
					add $!mem
				enddo
			enddo
		endif
	enddo
endmethod

define method .getluglegmaterial() is array
	!materials = array()
	do !pipeatta values !this.pipeattas
		do !attaobject values !pipeatta.attaobjects
			if !attaobject.onpad.not() and !attaobject.objecttype() ne 'ISOPAD' then
				!onematerial = object suppmaterial(!attaobject)
				!materials.append(!onematerial)
			endif
		enddo
	enddo
	return !materials
endmethod

define method .getmaterial() $*get material of support
	if !this.materials.unset() then
    --$p 1
		!this.getparts()

		!materials = array()
		--q var !this.partobjects
		do !object values !this.partobjects
            --q var !object
			!matarr = !this.getmaterialfrompart(!object)
            --q var !matarr[1]
			!materials.appendarray(!matarr)
		enddo

		--!materials.appendarray(!this.getluglegmaterial())	$*all atta belong to pipe according to new rule
        --$p 11
		--q var !materials
		!this.materials = !materials
		!this.setMaterialSpecialNumber()
	endif
endmethod


define method .getmaterialfrompart(!object is any) is array $*get array of material from one part object
	!result = array()
	!ot = !object.objecttype()
	if !ot inset ('SUPPAPDP','SUPPCONCRETE','SUPPPOINT') then
		return !result
	endif
	--$p 22
	--q var !ot
	do !mem values !object.mems
		if !ot eq 'SUPPPANES' then
            --q var !mem !object.len
			!material = object instsuppmaterial(!mem,!object.len)
		else
			!material = object instsuppmaterial(!mem,1)
		endif
		!result.append(!material)

	enddo

	return !result
endmethod

define method .setMaterialSpecialNumber() $*set component number
	--!specialstring = !this.specialnum
	!specialstring = !this.drawnum
	!num = 0
	do !index indices !this.materials
		!num = !num + 1
		!this.materials[!index].specialnum = !num.string()
		--!tempnum = !num / 1000
		--!addstring = !tempnum.string('d3').after('.')
		--!this.materials[!index].specialnum = !specialstring + '_' + !addstring
	enddo
endmethod

define method .getSpecialMaterials(!atts is array) is array $*public 	get component materials
	!this.getmaterial()

    --modify by jyg 20240730
    !this.settemprev()
    handle any
    endhandle

    !indexs = array()
    !rowarrs = array()

    --modify by jyg 20240904
    !SuppType = !this.SUPPNAME.Dbref().:ZD_BZBM.Before(',')
    --Q VAR !SuppType
    --q var !this.SUPPNAME
    if  not !SuppType.empty() then
        !rev = !this.REV
        if  !rev.empty() or !rev eq 'A' then
            !CurrRev = 'a'
        elseif !rev eq 'A+' or !rev eq 'B' then
            !CurrRev = 'b'
        else
            !CurrRev = !rev.lowcase()
        endif
        !rowarrs = !!GetSuppData(!this.SUPPNAME,!SuppType,!CurrRev)
        if  !rowarrs.empty() then
            $p  ------------------------------------
            $p  清单不包含该物项，已从模型中提取信息，
            $p  如需准确的数据信息，请补充支吊架数据清单。
            $p  ------------------------------------
            !this.textMater = true
        else
            !this.textMater = false
        endif
    else
        !this.textMater = true  $*判断是否标记序号
    endif
    --Q VAR !rowarrs
    --$P 1111
    if  !rowarrs.empty() then
        do !suppmaterial values !this.materials
            if !suppmaterial.specialnum.match('_') ne 0 then
                !indexs.append(!suppmaterial.specialnum.after('_').real())
            else
                !indexs.append(!suppmaterial.specialnum.real())
            endif
            !rowarr = array()
            do !x indices !atts
                !att = !atts[!x]
                if !att eq 'order' then
                    !com = '!rowarr[!x] = !suppmaterial.specialnum'
                else
                    !com = '!rowarr[!x] = !suppmaterial.' + !att
                endif
                --!com = '!rowarr[!x] = !suppmaterial.' + !att
                $!com
                handle any
                    !rowarr[!x] = ''
                    $p No att: $!att in Material object
                endhandle
            enddo
            !rowarrs.append(!rowarr)
        enddo
        !indices = !indexs.sortedindices()
        !rowarrs.reindex(!indices)
        --q var !rowarrs[1]
    endif

	return !rowarrs
endmethod

define method .settemprev()
	!path = !!tempmodrev.path.val
	handle any
		pml reload form !!tempmodrev
		!path = !!tempmodrev.path.val
        handle any
            return
        endhandle
	endhandle

	!file = object file(!path & !this.suppname & 'rev.txt')
	if !file.exists() then
		!lines = !file.readfile()
		if !lines.size() ne !this.materials.size() then
			!!alert.warning('日志数据与现模型材料对不上。请重新标注')
			!ans = !!alert.confirm('为了避免当前错误日志数据的影响，建议删除日志数据，是否删除?')
			if !ans eq 'YES' then
				!file.deletefile()
			endif
			return
		endif

		!nums = array()
		!revs = array()
		do !line values !lines
			!arr = !line.split()
			!nums.append(!arr[1].real())
			!revs.append(!arr[2])
		enddo
		!indices = !nums.sortedindices()
		!revs.reindex(!indices)
		!nums.reindex(!indices)

		do !isomaterial values !this.materials
            --q var !isomaterial
			if !isomaterial.specialnum.match('_') ne 0 then
				!snum = !isomaterial.specialnum.after('_').real()
			else
				!snum = !isomaterial.specialnum.real()
			endif

			!index = !nums.findfirst(!snum)
			if !index.set() then
				!isomaterial.rev = !revs[!index]
			endif
		enddo
	endif
endmethod



define method .sumMaterials(!inputatts is array) is array $*public 	get sum materials
	if !inputatts.unset() then
		!atts = !inputatts
		--!atts = split('编号 品名 型号 材料牌号 材料标准 规格标准 尺寸 制造形式 RCC-M 质保等级 单位 单重 单重单位 备注 数量 重量')
		!atts = split('itemcode desc ns material materialstandard specstandard size generateStyle rccm qualitylevel unit perWeight weightUnit remark quantity weight')
	else
		!atts = !inputatts
	endif
	!rowarrs = array()
	!quantityindex = !atts.findfirst('quantity')
	!weightindex = !atts.findfirst('weight')

	!itemcodes = array()
	!order = 0

	!this.getmaterial()
    --q var !this.materials
    --modify by jyg 20240904
    !SuppType = !this.SUPPNAME.Dbref().:ZD_BZBM.Before(',')
    if  not !SuppType.empty() then
        !CurrRev = 'merge'
        !rowarrs = !!GetSuppData(!this.SUPPNAME,!SuppType,!CurrRev)
    endif
    --Q VAR !rowarrs
    if  !rowarrs.empty() then
        do !suppmaterial values !this.materials
            !uniquecode = !suppmaterial.itemcode

            !index = !itemcodes.findfirst(!uniquecode)
            --!index = !itemcodes.findfirst(!suppmaterial.spref)
            if !index.unset() then
                !order = !order + 1
                !suppmaterial.order = !order
                !itemcodes.append(!uniquecode)
                !rowarr = array()
                do !x indices !atts
                    !att = !atts[!x]
                    !com = '!rowarr[!x] = !suppmaterial.' + !att
                    $!com
                    handle any
                        !rowarr[!x] = ''
                        $p No att: $!att in Material object
                    endhandle
                enddo
                !rowarrs.append(!rowarr)
            else
                !suppmaterial.order = !index
                if !quantityindex.set() and !weightindex.set() then
                    !rowarrs[!index][!quantityindex] = !rowarrs[!index][!quantityindex] + !suppmaterial.quantity
                    !rowarrs[!index][!weightindex] = !rowarrs[!index][!weightindex]  +  !suppmaterial.weight
                endif
            endif
        enddo
    endif
    --q var !rowarrs
	return !rowarrs
endmethod


define method .getwelds() $*get weld of support, but this method has to be modified
	if !this.welddone then
		return
	endif
	!this.getparts()
	!welds = array()

	!weldPoss = array()
	!weldShops = array()
	!weldmems = array()
	do !connection values !this.partconnections
		!object1 = !this.partobjects[!connection.index1]
		!object2 = !this.partobjects[!connection.index2]

		!ot1 = !object1.objecttype()
		!ot2 = !object2.objecttype()
		if !ot1 eq 'SUPPBOLT' or !ot2 eq 'SUPPBOLT' then
			!object1.delete()
			!object2.delete()
			skip
			--elseif !ot1 eq 'SUPPCLAMP' and
		endif

		!mems1 = !object1.mems
		!mems2 = !object2.mems
		if !mems1.size() gt 1 then
			do !x from 1 to !mems1.size() - 1
				do !y from !x + 1 to !mems1.size()
					--!welds.appendarray(!this.getweldbetweenmems(!mems1[!x],!mems1[!y],!object1))
					!possarr = !this.getweldbetweenmems(!mems1[!x],!mems1[!y],!object1)
					do !pos values !possarr
						!weldposs.append(!pos)
						!weldshops.append(false)
						!weldmems.append(!mems1[!x])
					enddo
				enddo
			enddo
		endif

		if !mems2.size() gt 1 then
			do !x from 1 to !mems2.size() - 1
				do !y from !x + 1 to !mems2.size()
					--!welds.appendarray(!this.getweldbetweenmems(!mems2[!x],!mems2[!y],!object1))
					!possarr = !this.getweldbetweenmems(!mems1[!x],!mems1[!y],!object1)
					do !pos values !possarr
						!weldposs.append(!pos)
						!weldshops.append(false)
						!weldmems.append(!mems2[!x])
					enddo
				enddo
			enddo
		endif

		do !mem1 values !mems1
			do !mem2 values !mems2
				!weldposs.append(!connection.connpos1)
				!weldshops.append(false)
				!weldmems.append(!mem1)
				--!welds.append(!connection.position)

				--!welds.appendarray(!this.getweldbetweenmems(!mem1,!mem2,!connection))
			enddo
		enddo

		!object1.delete()
		!object2.delete()
	enddo


	$(
	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 9:old
	var !boxs coll all box with (type of owner eq 'SCTN') for $!this.struname
	!weldPoss = array()
	!weldShops = array()
	!weldmems = array()

	do !box values !boxs
		!boxpos = pos of $!box wrt/*
		!weldposs.append(!boxpos)
		!shop = :shop of $!box
		!weldshops.append(!shop)
		!weldmems.append(!box)
	enddo
	$)

	do !x indices !weldposs

		if !weldshops[!x].not() then
			!text = 'M' & !x
		else
			!text = 'A' & !x
		endif
		!suppWeldText = object suppWeldText(!weldmems[!x],!weldposs[!x],!text,'FW')
		!this.weldobjects.append(!suppWeldText)
	enddo
	!this.welddone = true
endmethod

define method .getweldlist() is array $*public, return array of list of weld, this method has to be modified
	if !this.welddone.not() then
		!this.getwelds()
	endif
	--q var !this.weldobjects
	--$p asdfasdf

	!fieldwelds = array()
	!shopwelds = array()
	do !weldobject values !this.weldobjects
		!weldtext = !weldobject.text
		if !weldtext.matchwild('M*') then
			!fieldwelds.append(!weldtext)
		else
			!shopwelds.append(!weldtext)
		endif
	enddo
	!result = array()
	!result.append(!fieldwelds)
	!result.append(!shopwelds)
	return !result
endmethod


define method .getweldbetweenmems(!mem1 is string, !mem2 is string,!object is any) is array $*check if there is any weld between two partobjects, if yes, return array of points
	!type1 = type of $!mem1
	!type2 = type of $!mem2
	!ot = !object.objecttype()
	!result = array()
	if !ot eq 'SUPPBEAM' then
		!beamdir = !object.axis.direction()
		!plane = !object.profile.plane()
		!pane1 = object supppane(!mem1)
		!pane2 = object supppane(!mem2)
		do !edge1 values !pane1.edges()
			!tempangle1 = !edge1.direction().angle(!beamdir)
			if !tempangle1 lt 45 or !tempangle1 gt 135 then
				skip
			endif
			!point1 = !edge1.startposition.midpoint(!edge1.endposition)
			do !edge2 values !pane2.edges()
				!tempangle2 = !edge2.direction().angle(!beamdir)
				if !tempangle2 lt 45 or !tempangle2 gt 135 then
					skip
				endif
				!point2 = !edge1.startposition.midpoint(!edge1.endposition)
				!tempdis = !plane.near(!point1).distance(!plane.near(!point2))
				if !tempdis lt !pane1.thick and !tempdis lt !pane2.thick then
					!result.append(!plane.near(!point1))
				endif
			enddo
		enddo
	endif
	return !result
endmethod

define method .getparts() $*get all part of support, and put them into partobjects, and get connections between them with mechanic method
	if !this.partobjects.set() then
		return
	endif

	$(
	--inorder to draw according to types
	ATTA			TUBE
	ATTA			CLAMP
	ATTA			POINT
	SCTN/GENSEC	beam
	SCTN/GENSEC	pane
	SCTN/GENSEC	panes
	Fitting		pane
	--fitting		bolt
	--fixing		pane
	pjoi			bolt
	PANE			beam
	PANE			pane
	PANE			AP/DP
	hangmem		connect things
	weld
	concrete
	$)
	--$p atta
	!this.addattatopartobjects()
	--$p self
	!this.addselfToPartobjects()
	--$p concrete
	!this.addconcreteToPartobjects()
	--$p Got components
	--$p panesctn

	!this.dealMechanics()

endmethod


define method .dealMechanics() $*计算他们接触情况
    --q var !this.partobjects
	do !x from 1 to !this.partobjects.size() - 1
		do !y from !x + 1 to !this.partobjects.size()
            --$p 22
			!this.checkconnection(!x,!y,true)
		enddo
	enddo

	!this.assignConnections()
	--!this.dealdisconnect()

	!this.checkdisconnect()
endmethod

define method .dealdisconnect() $*maybe some pane or atta are not considered, but they are useful, normally they are dealed in assignconnections

endmethod

define method .checkdisconnect() $*check if any part of support does not connect to other part
    --q var !this.partobjects
	do !x indices !this.partobjects
		!ot = !this.partobjects[!x].objecttype()
        --q var !ot
		if !ot eq 'SUPPCLAMP' or !ot eq 'SUPPPOINT' then
			skip
		endif
		if !this.partobjects[!x].connections.unset() and !this.partobjects[!x].upstream.unset() and !this.partobjects[!x].downstream.unset() then
			!arr = !this.partobjects[!x].mems
			do !one values !arr
				$p $!one does not connect to this support
			enddo
			$(
		elseif !this.partobjects[!x].connections.set() then
			!arr = !this.partobjects[!x].mems
			do !one values !arr
				$p upstream and downstream not set for $!one
			enddo
			$)
		endif
	enddo
endmethod

define method .getconnpos(!connectionindex is real,!partindex is real) is position

	!connection = !this.partconnections[!connectionindex]
	if !connection.index1 eq !partindex then
		!temppos = !connection.connpos1
	else
		!temppos = !connection.connpos2
	endif
	return !temppos
endmethod

define method .assignConnections() $*assign connection data in each part object
    --q var !this.partconnections[1]
    --$p 456321
	do !x indices !this.partconnections
        --$p 123abc
		!connection = !this.partconnections[!x]
		!this.partobjects[!connection.index1].connections.append(!x)
		!this.partobjects[!connection.index2].connections.append(!x)
	enddo
	return
	--------------------------------------
	--------------------------------------Step 1:get okindices halfindices noneindices according to their upstream and downstream are set or not
	do !x indices !this.partconnections
		!connection = !this.partconnections[!x]
		--$p $!x
		if !connection.upstream1.unset() then
			!this.partobjects[!connection.index1].connections.append(!x)
			!this.partobjects[!connection.index2].connections.append(!x)
		elseif !connection.upstream1 then
			!this.partobjects[!connection.index1].downstream.append(!x)
			!this.partobjects[!connection.index2].upstream.append(!x)
		else
			!this.partobjects[!connection.index1].upstream.append(!x)
			!this.partobjects[!connection.index2].downstream.append(!x)
		endif
	enddo


	!okindices = array()
	!halfindices = array()
	!noneindices = array()
	do !x indices !this.partobjects
		if !this.partobjects[!x].connections.unset() then
			!okindices.append(!x)
		else
			if !this.partobjects[!x].upstream.set() or !this.partobjects[!x].downstream.set() then
				!halfindices.append(!x)
			else
				!noneindices.append(!x)
			endif
		endif
	enddo



	--------------------------------------
	--------------------------------------Step 2:set concrection upstream and downstream acoording to the link
	do !halftimes from 1 to !this.partobjects.size()

		do !index indices !halfindices
			!x = !halfindices[!index]
			!object = !this.partobjects[!x]
			!ot = !object.objecttype()

			if !ot eq 'SUPPBOLT' then
				if !object.upstream.set() then
					!uppos = !object.pos.offset(e,1000000)
					!downpos = !object.pos
				else
					!uppos = !object.pos
					!downpos = !object.pos.offset(e,1000000)
				endif
			elseif !ot inset ('SUPPCONNECT','SUPPBEAM','SUPPTUBE') then
				if !ot eq 'SUPPCONNECT' then
					!uppos = !object.poss[1]
					!downpos = !object.poss.last()
				elseif !ot inset ('SUPPBEAM','SUPPTUBE') then
					!uppos = !object.pos1
					!downpos = !object.pos2
				endif

				if !object.upstream.set() then
					!temppos = !this.getconnpos(!object.upstream[1],!index)
					if !temppos.distance(!uppos) gt !temppos.distance(!downpos) then
						!temppos = !uppos
						!uppos = !downpos
						!downpos = !temppos
					endif
				else
					!temppos = !this.getconnpos(!object.downstream[1],!index)
					if !temppos.distance(!downpos) gt !temppos.distance(!uppos) then
						!temppos = !uppos
						!uppos = !downpos
						!downpos = !temppos
					endif
				endif
			elseif !ot eq 'SUPPPANE' then
				!profile = !object.profile
				!poss = array()
				!poss.append(!profile.position.offset(!profile.orientation.zdir(),!object.thick / 2))
				!poss.append(!profile.position.offset(!profile.orientation.zdir(), - !object.thick / 2))

				if !object.upstream.set() then
					!temppos = !this.getconnpos(!object.upstream[1],!index)
				else
					!temppos = !this.getconnpos(!object.downstream[1],!index)
				endif
				--q var !temppos
				if !!posinprofile(!temppos,!profile) and !temppos.distance(!profile.plane()) lt !object.thick / 2 then
					if !temppos.distance(!poss[1]) le !temppos.distance(!poss[2]) then
						!minpos = !poss[1]
						!maxpos = !poss[2]
					else
						!minpos = !poss[2]
						!maxpos = !poss[1]
					endif
				else
					!poss = array()
					do !edge values !profile.edges()
						!poss.append(!edge.startposition.midpoint(!edge.endposition))
					enddo
					!mindis = 1000000
					!maxdis = -1
					do !pos values !poss
						!dis = !pos.distance(!temppos)
						if !dis lt !mindis then
							!minpos = !pos
							!mindis = !dis
						endif
						if !dis gt !maxdis then
							!maxpos = !pos
							!maxdis = !dis
						endif
					enddo
				endif

				if !object.upstream.set() then
					!uppos = !minpos
					!downpos = !maxpos
				else
					!uppos = !maxpos
					!downpos = !minpos
				endif
			elseif !ot eq 'SUPPPANES' then
				!poss = array()
				do !profile values !object.profiles
					!poss.append(!profile.position)
				enddo
				if !object.upstream.set() then
					!temppos = !this.getconnpos(!object.upstream[1],!index)
				else
					!temppos = !this.getconnpos(!object.downstream[1],!index)
				endif

				!mindis = 1000000
				!maxdis = -1
				do !pos values !poss
					!dis = !pos.distance(!temppos)
					if !dis lt !mindis then
						!minpos = !pos
						!mindis = !dis
					endif
					if !dis gt !maxdis then
						!maxpos = !pos
						!maxdis = !dis
					endif
				enddo
				if !object.upstream.set() then
					!uppos = !minpos
					!downpos = !maxpos
				else
					!uppos = !maxpos
					!downpos = !minpos
				endif
			endif

			--------------------------------------
			--------------------------------------Step 1:got uppos and downpos for each half object


			do !cx values !object.connections
				!cxpos = !this.partconnections[!cx].connpos1
				if !cxpos.distance(!uppos) le !cxpos.distance(!downpos) then	$* upstream
					!upstream = false
				else
					!upstream = true
				endif
				-----------------------------------------------------------------------------------
				-----------------------------------------------------------------------------------Step 1:set upstream1 and upstream2 of connection
				if !this.partconnections[!cx].index1 eq !x then
					!this.partconnections[!cx].upstream1 = !upstream
					!this.partconnections[!cx].upstream2 = !upstream.not()
				else
					!this.partconnections[!cx].upstream1 = !upstream.not()
					!this.partconnections[!cx].upstream2 = !upstream
				endif



				-----------------------------------------------------------------------------------
				-----------------------------------------------------------------------------------Step 2:set downstram and upstream of object index1 and index2

				!connection = !this.partconnections[!cx]

				if !connection.upstream1 then
					!this.partobjects[!connection.index1].downstream.append(!cx)
					!this.partobjects[!connection.index2].upstream.append(!cx)
				else
					!this.partobjects[!connection.index1].upstream.append(!cx)
					!this.partobjects[!connection.index2].downstream.append(!cx)
				endif

				!findx = !this.partobjects[!connection.index1].connections.findfirst(!cx)
				!this.partobjects[!connection.index1].connections[!findx].delete()

				!findx = !this.partobjects[!connection.index2].connections.findfirst(!cx)
				!this.partobjects[!connection.index2].connections[!findx].delete()

				!noneindex = !noneindices.findfirst(!connection.index1)
				if !noneindex.set() then

					!noneindices[!noneindex].delete()
					if !this.partobjects[!connection.index1].connections.unset() then
						!okindices.append(!connection.index1)
					endif
				endif

				!noneindex = !noneindices.findfirst(!connection.index2)
				if !noneindex.set() then
					!noneindices[!noneindex].delete()
					if !this.partobjects[!connection.index2].connections.unset() then
						!okindices.append(!connection.index2)
					endif
				endif
			enddo
			!okindices.append(!x)
			!halfindices[!index].delete()
			!object.delete()
		enddo
		if !halfindices.unset() then
			break
		endif
	enddo

	$(
	do !object values !this.partobjects
		!aposs = array()
		!lposs = array()
		do !x values !object.upstream
			!aposs.append(!this.partconnections[!x].position)
		enddo
		do !x values !object.downstream
			!lposs.append(!this.partconnections[!x].position)
		enddo
	enddo
	$)
endmethod


define method .posonbeam(!inputposorline is any,!beam is suppbeam,!inputdir is direction) is array
	!result = array()
	!tolerance = 2
	!dir = !inputdir
	if !inputposorline.objecttype() eq 'POSITION' then
		!pos = !inputposorline
	else
		!pos = !inputposorline.intersection(!beam.axis)
		handle any
			golabel /end
		elsehandle none
			if !inputposorline.onprojected(!pos).not() then
				golabel /end
			endif
		endhandle
		if !dir.unset() then
			!dir = !inputposorline.direction()
		endif
	endif


	--if !dir.set() then
	--	!tempangle = !dir.angle(!beam.axis.direction())
	--	if !tempangle lt 15 and !tempangle gt 165 then
	--		golabel /end
	--	endif
	--endif

	!plane1 = !beam.profile.plane()
	!planezdir = !beam.drnend
	!planeori = z is $!planezdir
	!plane2 = object plane(!beam.pos2,!planeori)

	!templine = !pos.line(!pos.offset(!beam.axis.direction(),1000))
	!temppoint1 = !templine.intersection(!plane1)
	!temppoint2 = !templine.intersection(!plane2)
	!templine = !temppoint1.line(!temppoint2)
	if !templine.onprojected(!pos).not() then
		golabel /end
	endif
	if !!posinprofile(!temppoint1,!beam.profile) then
		--if !beam.profile.iswithout(!temppoint1).not() then
		!edges = !beam.profile.edges()

		!mindis = 100000
		do !edge values !edges
			if !edge.onprojected(!temppoint1) then
				!dis = !edge.distance(!temppoint1)
				if !dis lt !mindis then
					!mindis = !dis
					!goodedge = !edge
				endif
			endif
		enddo
	else
		!edges = !beam.profile.edges()
		do !edge values !edges
			if !edge.onprojected(!temppoint1) and !edge.distance(!temppoint1) lt !tolerance then
				!goodedge = !edge
				break
			endif
		enddo
		if undefined(!goodedge) then
			golabel /end
		endif
	endif



	!zdir = !goodedge.direction().orthogonal(!beam.axis.direction())
	!tempori = z is $!zdir
	!plane = object plane(!goodedge.startposition,!tempori)
	if !dir.set() then
		!templine = !pos.line(!pos.offset(!dir,1000))
		!returnpos = !templine.intersection(!plane)
		handle any
			golabel /end
		endhandle
	else
		!returnpos = !plane.near(!pos)
	endif
	!returndir = !beam.pos1.direction(!plane.near(!beam.pos1))
	handle any
		!returndir = !beam.pos2.direction(!beam.pos1)
	endhandle
	!result[1] = !returnpos
	!result[2] = !returndir
	label /end
	return !result
endmethod

define method .posontube(!inputposorline is any,!tube is supptube,!inputdir is direction) is array
	!result = array()
	!tolerance = 2
	!dir = !inputdir
	if !inputposorline.objecttype() eq 'POSITION' then
		!pos = !inputposorline
	else
		!pos = !inputposorline.intersection(!tube.axis)
		handle any
			golabel /end
		elsehandle none
			if !inputposorline.onprojected(!pos).not() then
				golabel /end
			endif
		endhandle
		if !dir.unset() then
			!dir = !inputposorline.direction()
		endif
	endif

	!templine = !tube.axis
	!templine = !templine.extendstart(!tolerance).extendend(!tolerance)
	--handle any

	--!templine = !templine.extendstart(!tolerance).extendend(!tolerance)
	--endhandle
	if !templine.onprojected(!pos).not() then
		golabel /end
	endif
	if !tube.axis.distance(!pos) gt !tube.outdia / 2 + !tolerance then
		golabel /end
	endif

	if !dir.set() then
		!angle = !dir.angle(!tube.axis.direction())
		if !angle lt 5 or !angle gt 175 then
			if !pos.distance(!tube.pos1) le !pos.distance(!tube.pos2) then
				!plane = object plane(!tube.pos1,!tube.ori)
				!returndir = !tube.ori.zdir().opposite()
			else
				!plane = object plane(!tube.pos2,!tube.ori)
				!returndir = !tube.ori.zdir()
			endif
			!returnpos = !plane.near(!pos)
		else
			!tempdir = dir.orthogonal(!tube.axis.direction())
			!returndir = !tube.axis.direction().orthogonal(!tempdir)
			!returnpos = !tube.axis.near(!pos).offset(!returndir,!tube.outdia / 2)
		endif
	else
		!returndir = !tube.axis.near(!pos).direction(!pos)
		handle any
			!returnpos = !pos
		elsehandle none
			!returnpos = !tube.axis.near(!pos).offset(!returndir,!tube.outdia / 2)
		endhandle
	endif

	!result[1] = !returnpos
	!result[2] = !returndir
	label /end
	return !result
endmethod


--------------------------------------
--------------------------------------Step 4:for supppane supppanes
define method .posonOnepane(!inputposorline is any,!profile is profile,!inputdir is direction,!thick is real) is array
	!result = array()
	!tolerance = 2
	if !inputposorline.objecttype() eq 'POSITION' then
		!pos = !inputposorline
	else
		!pos = !inputposorline.intersection(!profile.plane())
		handle any
			golabel /end
		elsehandle none
			if !inputposorline.onprojected(!pos).not() then
				golabel /end
			endif
		endhandle
	endif
	!dir = !inputdir


	if !dir.set() then
		!tempangle = !dir.angle(!profile.orientation.zdir())
		if !tempangle gt 75 and !tempangle lt 105 then
			golabel /end
		endif
	endif

	!nearpos = !profile.plane().near(!pos)

	if !!posinprofile(!nearpos,!profile) and !nearpos.distance(!pos) lt (!thick / 2 + !tolerance) then
		--if !profile.iswithout(!nearpos).not() and !nearpos.distance(!pos) lt (!thick / 2 + !tolerance) then
		!tempdir = !nearpos.direction(!pos)
		handle any
			!tempdir = !profile.orientation.zdir()
			if !dir.set() then
				if !tempdir.angle(!dir) lt 90 then
					!tempdir = !tempdir.opposite()
				endif
			endif
		endhandle
		!returnpos = !nearpos.offset(!tempdir,!thick / 2)
		!result[1] = !returnpos
		!result[2] = !tempdir
	endif

	label /end
	return !result
endmethod

define method .posonOnepanes(!inputposorline is any,!panes is supppanes,!inputdir is direction) is array
	!profiles = !panes.profiles
	!thick = !panes.thick
	do !profileindex indices !profiles
		!profile = !profiles[!profileindex]
		!temparr = !this.posonOnepane(!inputposorline,!profile,!inputdir,!thick)
		if !temparr.set() then
			!temparr.append(!profileindex)
			return !temparr
		endif
	enddo
	!arr = array()
	return !arr
endmethod

--------------------------------------
--------------------------------------Step 5:for suppapdp suppconcrete
define method .posonprofile(!inputposorline is any,!profile is profile,!inputdir is direction) is array
	--define method .posonprofile(!inputposorline is any,!profile is profile,!inputdir is direction,!another is position) is array
	!result = array()
	!tolerance = 2
	!dir = !inputdir
	if !inputposorline.objecttype() eq 'POSITION' then
		!pos = !inputposorline
	else
		!pos = !inputposorline.intersection(!profile.plane())
		handle any
			golabel /end
		elsehandle none
			if !inputposorline.onprojected(!pos).not() then
				golabel /end
			endif
		endhandle
		if !dir.unset() then
			!dir = !inputposorline.direction()
		endif
	endif


	!planezdir = !profile.orientation.zdir()
	if !dir.set() then
		!tempangle = !dir.angle(!planezdir)
		if !tempangle gt 70 and !tempangle lt 110 then
			golabel /end
		endif
	endif

	!plane = !profile.plane()
	!nearpos = !plane.near(!pos)

	if !!posinprofile(!nearpos,!profile) and !nearpos.distance(!pos) lt !tolerance then
		--if !profile.iswithin(!nearpos) and !nearpos.distance(!pos) lt !tolerance then
		!returnpos = !nearpos
		!returndir = !planezdir
		!result[1] = !returnpos
		!result[2] = !planezdir
	endif

	label /end
	return !result
endmethod
define method .posonarcconcrete(!inputposorline is any,!markcivil is markcivil,!inputdir is direction) is array
	!result = array()
	!tolerance = 2
	!dir = !inputdir
	if !inputposorline.objecttype() eq 'POSITION' then
		!pos = !inputposorline
	else
		!pos = !inputposorline.intersection(!profile)
		handle any
			golabel /end
		elsehandle none
			if !inputposorline.onprojected(!pos).not() then
				golabel /end
			endif
		endhandle
		if !dir.unset() then
			!dir = !inputposorline.direction()
		endif
	endif


	do !index indices !markcivil.arcs
		!arc = !markcivil.arcs[!index]
		!nearpos = !arc.angleposition(!arc.near(!pos1))

		!tempheight = !!suidirdis(!arc.position,!arc.orientation.zdir(),!pos1)
		!nearpos = !nearpos.offset(!arc.orientation.zdir(),tempheight)
		if !arc.onprojected(!nearpos) and !tempheight lt !markcivil.height and !pos1.distance(!nearpos) lt !tolerance then
			!returnpartnum = !index
			!returnpos = !nearpos
			!returndir = !arc.angledirection(!arc.near(!pos1))
			if !dir.set() then
				if !returndir.angle(!dir) lt 90 then
					!returndir = !returndir.opposite()
				endif
			endif
			!result[1] = !returnpos
			!result[2] = !returndir
			!result[3] = !returnpartnum
		endif
	enddo

	return !result
endmethod


define method .getpanesixpointdirs(!object1 is supppane) is array
	!points = array()
	!dirs = array()

	!dir = !object1.profile.orientation.zdir()
	!dirs.append(!dir)
	!points.append(!object1.profile.position.offset(!dir,!object1.thick / 2))

	!dir1 = !object1.profile.orientation.zdir().opposite()
	!dirs.append(!dir1)
	!points.append(!object1.profile.position.offset(!dir1,!object1.thick / 2))




	!edges = !object1.profile.edges()
	!edgesize = !edges.size()
	do !times indices !edges
		!pos1 = !edges[!times].startposition.midpoint(!edges[!times].endposition)
		!dir1 = !object1.profile.position.direction(!pos1)
		!points.append(!pos1)
		!dirs.append(!dir1)
	enddo

	!result = array()
	!result.append(!points)
	!result.append(!dirs)
	return !result
endmethod

define method .getpanesEdgespointdirs(!object1 is supppanes) is array
	!points = array()
	!dirs = array()
	!partnums = array()


	do !profiletimes indices !object1.profiles
		!partnum1 = !profiletimes

		!profile = !object1.profiles[!profiletimes]
		!edges = !profile.edges()
		!edgesize = !edges.size()
		do !times indices !edges
			!pos1 = !edges[!times].startposition.midpoint(!edges[!times].endposition)
			!dir1 = !profile.position.direction(!pos1)
			!points.append(!pos1)
			!dirs.append(!dir1)
			!partnums.append(!partnum1)
		enddo
	enddo

	!dels = array()
	!pointssize = !points.size()
	do !x from 1 to !pointssize - 1
		if !dels.findfirst(!x).set() then
			skip
		endif
		do !y from !x + 1 to !pointssize
			if !dels.findfirst(!x).set() then
				skip
			endif
			if !points[!x].distance(!points[!y]) lt !object1.thick then
				!dels.append(!x)
				!dels.append(!y)
			endif
		enddo
	enddo
	!dels.unique()

	do !x values !dels
		!points[!x].delete()
		!dirs[!x].delete()
		!partnums[!x].delete()
	enddo

	!points.compress()
	!dirs.compress()
	!partnums.compress()

	!result = array()
	!result.append(!points)
	!result.append(!dirs)
	!result.append(!partnums)
	return !result
endmethod

define method .getpanessurfacepoints(!panes is supppanes) is array
	!poss = array()
	!dirs = array()
	!partnums = array()
	do !x indices !panes.profiles
		!profile = !panes.profiles[!x]
		!dir = !profile.orientation.zdir()
		!dirs.append(!dir)
		!poss.append(!profile.position.offset(!dir,!panes.thick / 2))
		!partnums.append(!x)
		!dir = !dir.opposite()
		!dirs.append(!dir)
		!poss.append(!profile.position.offset(!profile.orientation.zdir(), - !panes.thick / 2))
		!partnums.append(!x)
	enddo

	!result = array()
	!result.append(!poss)
	!result.append(!dirs)
	!result.append(!partnums)
	return !result
endmethod

define method .getpanesallpoints(!panes is supppanes) is array
	!arr1 = !this.getpanessurfacepoints(!panes)
	!arr2 = !this.getpanesEdgespointdirs(!panes)

	!result = array()
	if !arr1.set() or !arr2.set()then
		if !arr1.set() then
			!result = !arr1
			if !arr2.set() then
				!result[1].appendarray(!arr2[1])
				!result[2].appendarray(!arr2[2])
				!result[3].appendarray(!arr2[3])
			endif
		else
			!result = !arr2
		endif
	endif
	return !result
endmethod

define method .checkClampConnection(!x is real,!y is real)
--$p 1616
	!object1 = !this.partobjects[!x]
	!object2 = !this.partobjects[!y]
	!ot2 = !object2.objecttype()

	!tolerance = 2

	!connection = object suppconnection()
	!connection.index1 = !x
	!connection.index2 = !y

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 1:CLAMP
	!dir1 = object direction()
	if !object1.lpos.set() then
		!pos1 = !object1.lpos
		if type of $!object1.mems[1] ne 'ATTA' then
			!dir1 = !object1.ldir
			!connection.conndir1 = !dir1
		endif
	else
		!pos1 = !object1.apos
	endif
	!connection.connpos1 = !pos1
	!connection.upstream1 = true
	!connection.upstream2 = false
	--CLAMP POINT BEAM PANE PANES BOLT TUBE APDP CONNECT CONCRETE
	if !ot2 eq 'SUPPBOLT' then
		if !dir1.set() then
			!tempangle = !dir1.angle(!object2.axis.direction())
			if !tempangle gt 70 and !tempangle lt 110 then
				return
			endif
		endif

		if !pos1.distance(!object2.apos) lt !tolerance then
			!connection.connpos2 = !object2.apos
			!connection.conndir2 = !object2.dir.opposite()
			golabel /end
		endif
	elseif !ot2 eq 'SUPPCONNECT' then
		do !times from 1 to 2
			if !times eq 1 then
				!connection.connpos2 = !object2.poss[1]
				!connection.conndir2 = !object2.lines[1].direction().opposite()
			else
				!connection.connpos2 = !object2.poss.last()
				!connection.conndir2 = !object2.lines.last().direction()
			endif
			if !pos1.distance(!connection.connpos2) lt !tolerance then
				if !dir1.set() then
					!tempangle = !dir1.angle(!object2.lines[1].direction())
					if !tempangle gt 70 and !tempangle lt 110 then
						return
					endif
				endif

				golabel /end
			endif
		enddo
	elseif !ot2 eq 'SUPPBEAM' then
		!beamarr = !this.posonbeam(!pos1,!object2,!dir1)
		if !beamarr.set() then
			!connection.connpos2 = !beampos[1]
			!connection.conndir2 = !beampos[2]
			golabel /end
		endif
	elseif !ot2 eq 'SUPPPANE' then
		!temparr = !this.posonOnepane(!pos1,!object2.profile,!dir1,!object2.thick)
		if !temparr.set() then
			!connection.connpos2 = !temparr[1]
			!connection.conndir2 = !temparr[2]
			golabel /end
		endif
	elseif !ot2 eq 'SUPPPANES' then
		do !profileindex indices !object2.profiles
			!profile = !object2.profiles[!profileindex]
			!temparr = !this.posonOnepane(!pos1,!profile,!dir1,!object2.thick)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				!connection.partnum2 = !profileindex
				golabel /end
			endif
		enddo
	elseif !ot2 eq 'SUPPTUBE' then
		!temparr = !this.posontube(!pos1,!object2,!dir1)
		if !temparr.set() then
			!connection.connpos2 = !temparr[1]
			!connection.conndir2 = !temparr[2]
			golabel /end
		endif
	elseif !ot2 eq 'SUPPAPDP' then
		--!temparr = !this.posonprofile(!pos1,!object2.profile,!dir1,!object1.apos)
		!temparr = !this.posonprofile(!pos1,!object2.profile,!dir1)
		if !temparr.set() then
			!connection.connpos2 = !temparr[1]
			!connection.conndir2 = !temparr[2]
			!connection.upstream1 = true
			!connection.upstream2 = false
			golabel /end
		endif
	elseif !ot2 eq 'SUPPCONCRETE' then
		!connection.upstream1 = true
		!connection.upstream2 = false
		if !object2.markcivil.profiles.set() then
			do !profileindex indices !object2.markcivil.profiles
				!profile = !object2.markcivil.profiles[!profileindex]
				--!temparr = !this.posonprofile(!pos1,!profile,!dir1,!object1.apos)
				!temparr = !this.posonprofile(!pos1,!profile,!dir1)
				if !temparr.set() then
					!connection.connpos2 = !temparr[1]
					!connection.conndir2 = !temparr[2]
					!connection.partnum2 = !profileindex

					golabel /end
				endif
			enddo
		else
			!temparr = !this.posonarcconcrete(!pos1,!object2.markcivil,!dir1)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				!connection.partnum2 = !temparr[3]
			endif
		endif
	endif
	return

	label /end
	!this.partconnections.append(!connection)
endmethod


define method .checkBOLTConnection(!x is real,!y is real)
--$p 66
	!object1 = !this.partobjects[!x]
	!object2 = !this.partobjects[!y]
	!ot2 = !object2.objecttype()

	!tolerance = 2

	!connection = object suppconnection()
	!connection.index1 = !x
	!connection.index2 = !y

	!boltline = !object1.axis
	!dir1 = !boltline.direction()
	!connection.conndir1 = !dir1

	--$p $!x $!y

	--CLAMP POINT BEAM PANE PANES BOLT TUBE APDP CONNECT CONCRETE
	if !ot2 eq 'SUPPCLAMP' then
		!this.checkconnection(!y,!x,false)
		return
	elseif !ot2 eq 'SUPPCONNECT' then
		do !line values !object2.lines
			if !line.distance(!boltline) lt !tolerance then
				!tempangle = !line.direction().angle(!boltline.direction())
				if !tempangle gt 85 and !tempangle lt 95 then	$* bolt must be vertical
					!interpos = !boltline.intersection(!line)
					if !line.onprojected(!interpos) and !boltline.onprojected(!interpos) then
						!connection.connpos1 = !interpos
						!interpos2 = !line.intersection(!boltline)
						!connection.connpos2 = !interpos2
						!connection.conndir2 = !interpos2.direction(!interpos)
						handle any
							!connection.conndir2 = !connection.conndir1.opposite()
						endhandle
						golabel /end
					endif
				endif
			endif
		enddo
	elseif !ot2 eq 'SUPPBEAM' or !ot2 eq 'SUPPPANE' or !ot2 eq 'SUPPPANES' or !ot2 eq 'SUPPTUBE' then
		if !ot2 eq 'SUPPBEAM' then
			if !object2.axis.distance(!boltline) lt !tolerance then
				!tempangle = !object2.axis.direction().angle(!boltline.direction())
				if !tempangle gt 85 and !tempangle lt 95 then
					!interpos = !boltline.intersection(!object2.axis)
				else
					return
				endif
			else
				return
			endif
			!emptydir = object direction()
			!temparr = !this.posonbeam(!interpos,!object2,!emptydir)
		elseif !ot2 eq 'SUPPPANE' then
			!temparr = !this.posonOnepane(!boltline,!object2.profile,!dir1,!object2.thick)
		elseif !ot2 eq 'SUPPPANES' then
			do !profileindex indices !object2.profiles
				!profile = !object2.profiles[!profileindex]
				!temparr = !this.posonOnepane(!boltline,!profile,!dir1,!object2.thick)
				if !temparr.set() then
				--$p asdfasdf
					!interpos = !temparr[1].offset(!temparr[2], - !object2.thick)
					!connection.partnum2 = !profileindex
					break
				endif
			enddo
		elseif !ot2 eq 'SUITUBE' then
			!temparr = !this.posontube(!boltline,!object2,!boltline.direction())
			!interpos = !boltline.intersection(!object2.axis)
		endif


		if !temparr.set() then
			!firstpos = !temparr[1]
			!secondpos = !firstpos.offset(!firstpos.direction(!interpos),!firstpos.distance(!interpos))
			handle any

				!connection.connpos1 = !firstpos

				!connection.connpos2 = !firstpos

				!connection.conndir2 = !object1.dir.opposite()
			elsehandle none
				if !secondpos.distance(!object1.apos) lt !firstpos.distance(!object1.lpos) then
					!temppos = !firstpos
					!firstpos = !secondpos
					!secondpos = !temppos
				endif
				!connection.connpos1 = !firstpos
				!connection.connpos12 = !secondpos
				!connection.connpos2 = !firstpos
				!connection.connpos22 = !secondpos

				--!connection.conndir1 = !firstpos.direction(!secondpos)
				!connection.conndir2 = !secondpos.direction(!firstpos)
			endhandle
			golabel /end
		endif
	elseif !ot2 eq 'SUPPAPDP' then
		--!temparr = !this.posonprofile(!boltline,!object2.profile,!boltline.direction(),!object1.apos)
		!temparr = !this.posonprofile(!boltline,!object2.profile,!boltline.direction())
		if !temparr.set() then
			!connection.upstream1 = true
			!connection.upstream2 = false
			!connection.connpos1 = !temparr[1]
			!connection.connpos2 = !temparr[1]
			--!connection.conndir1 = !temparr[2].opposite()
			!connection.conndir2 = !temparr[2]
			golabel /end
		endif
	elseif !ot2 eq 'SUPPCONCRETE' then
		if !object2.markcivil.profiles.set() then
			do !profileindex indices !object2.markcivil.profiles
				!profile = !object2.markcivil.profiles[!profileindex]
				--!temparr = !this.posonprofile(!boltline,!profile,!boltline.direction(),!object1.apos)
				!temparr = !this.posonprofile(!boltline,!profile,!boltline.direction())
				if !temparr.set() then
					!connection.upstream1 = true
					!connection.upstream2 = false
					!connection.connpos1 = !temparr[1]
					!connection.connpos2 = !temparr[1]
					--!connection.conndir1 = !temparr[2].opposite()
					!connection.conndir2 = !temparr[2]
					golabel /end
				endif
			enddo
		else
			!emptydir = object direction()
			!temparr = !this.posonarcconcrete(!boltline,!object2.markcivil,!emptydir)
			if !temparr.set() then
				!connection.upstream1 = true
				!connection.upstream2 = false
				!connection.connpos1 = !temparr[1]
				!connection.connpos2 = !temparr[1]
				--!connection.conndir1 = !temparr[2].opposite()
				!connection.conndir2 = !temparr[2]
				golabel /end
			endif
		endif
	endif
	return


	label /end
	!this.partconnections.append(!connection)
endmethod

define method .checkConnectConnection(!x is real,!y is real)
--$p 77
	!object1 = !this.partobjects[!x]
	!object2 = !this.partobjects[!y]
	!ot2 = !object2.objecttype()

	!tolerance = 2

	!connection = object suppconnection()
	!connection.index1 = !x
	!connection.index2 = !y

	--CLAMP POINT BEAM PANE PANES BOLT TUBE APDP CONNECT CONCRETE
	if !ot2 inset ('CLAMP','SUPPBOLT') then
		!this.checkconnection(!y,!x,false)
		return
	endif

	do !times from 1 to 2
		if !times eq 1 then
			!pos1 = !object1.poss[1]
			!pos2 = !object1.poss.last()
			!dir1 = !object1.lines[1].direction().opposite()
			--handle any

			--	!dir1 = !object1.lines[1].direction().opposite()
			--endhandle
		else
			!pos1 = !object1.poss.last()
			!pos2 = !object1.poss[1]
			!dir1 = !object1.lines.last().direction()
		endif
		!connection.connpos1 = !pos1
		!connection.conndir1 = !dir1

		if !ot2 eq 'SUPPCONNECT' then
			if !pos1.distance(!object2.poss[1]) lt !tolerance then

				!tempangle = !dir1.angle(!object2.lines[1].direction())
				if !tempangle gt 70 and !tempangle lt 110 then
					skip
				endif

				!connection.connpos2 = !object2.poss[1]
				!connection.conndir2 = !object2.lines[1].direction().opposite()

				golabel /end
			elseif !pos1.distance(!object2.poss.last()) lt !tolerance then
				!tempangle = !dir1.angle(!object2.lines.last().direction())
				if !tempangle gt 70 and !tempangle lt 110 then
					skip
				endif
				!connection.connpos2 = !object2.poss.last()
				!connection.conndir2 = !object2.lines.last().direction()
				golabel /end
			endif
		elseif !ot2 eq 'SUPPBEAM' then
			!temparr = !this.posonbeam(!pos1,!object2,!dir1)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
			endif
		elseif !ot2 eq 'SUPPPANE' then
			!temparr = !this.posonOnepane(!pos1,!object2.profile,!dir1,!object2.thick)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				golabel /end
			endif
		elseif !ot2 eq 'SUPPPANES' then
			do !profileindex indices !object2.profiles
				!profile = !object2.profiles[!profileindex]
				!temparr = !this.posonOnepane(!pos1,!profile,!dir1,!object2.thick)
				if !temparr.set() then
					!connection.connpos2 = !temparr[1]
					!connection.conndir2 = !temparr[2]
					golabel /end
				endif
			enddo
		elseif !ot2 eq 'SUPPTUBE' then
			!temparr = !this.posontube(!pos1,!object2,!dir1)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				golabel /end
			endif
		elseif !ot2 eq 'SUPPAPDP' then
			--!temparr = !this.posonprofile(!pos1,!object2.profile,!dir1,!pos2)
			!temparr = !this.posonprofile(!pos1,!object2.profile,!dir1)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				!connection.upstream1 = true
				!connection.upstream2 = false
				golabel /end
			endif
		elseif !ot2 eq 'SUPPCONCRETE' then
			!connection.upstream1 = true
			!connection.upstream2 = false
			if !object2.markcivil.profiles.set() then
				do !index index !object2.markcivil.profiles
					!profile = !object2.markcivil.profiles[!index]
					--!temparr = !this.posonprofile(!pos1,!profile,!dir1,!pos2)
					!temparr = !this.posonprofile(!pos1,!profile,!dir1)
					if !temparr.set() then
						!connection.connpos2 = !temparr[1]
						!connection.conndir2 = !temparr[2]
						!connection.partnum2 = !index
						golabel /end
					endif
				enddo
			else
				!temparr = !this.posonarcconcrete(!pos1,!object2.markcivil,!dir1)
				if !temparr.set() then
					!connection.connpos2 = !temparr[1]
					!connection.conndir2 = !temparr[2]
					!connection.partnum2 = !temparr[3]
					golabel /end
				endif
			endif
		endif
	enddo
	return

	label /end
	!this.partconnections.append(!connection)
endmethod

define method .checkBeamConnection(!x is real,!y is real)
--$p 88
	!object1 = !this.partobjects[!x]
	!object2 = !this.partobjects[!y]
	!ot2 = !object2.objecttype()

	!tolerance = 2

	!connection = object suppconnection()
	!connection.index1 = !x
	!connection.index2 = !y
	--CLAMP POINT BEAM PANE PANES BOLT TUBE APDP CONNECT CONCRETE
	if !ot2 inset ('CLAMP','SUPPBOLT','SUPPCONNECT') then
		!this.checkconnection(!y,!x,false)
		return
	endif

	if !ot2 inset ('SUPPBEAM','SUPPPANE','SUPPPANES') then
		!this.checkobjectsconnection(!x,!y)
		return
	endif

	do !times from 1 to 2
		if !times eq 1 then
			!pos1 = !object1.pos1
			!dir1 = !object1.axis.direction().opposite()
		else
			!pos1 = !object1.pos2
			!dir1 = !object1.axis.direction()
		endif
		!connection.connpos1 = !pos1
		!connection.conndir1 = !dir1

		if !ot2 eq 'SUPPBEAM' then
			!temparr = !this.posonbeam(!pos1,!object2,!dir1)
			if !temparr.set() then	$*end of beam1 on beam2
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				golabel /end
			endif


			if !times eq 2 then
				--$* check if end of beam2 on beam1
				do !times2 from 1 to 2
					if !times2 eq 1 then
						!temparr = !this.posonbeam(!object2.pos1,!object1,!object2.axis.direction().opposite())
					else
						!temparr = !this.posonbeam(!object2.pos2,!object1,!object2.axis.direction())
					endif
					if !temparr.set() then	$*end of beam1 on beam2
						!connection.connpos2 = !temparr[1]
						!connection.conndir2 = !temparr[2]
						golabel /end
					endif
				enddo


				--$*mid part touch mid part
				!point1 = !object1.axis.intersection(!object2.axis)
				!point2 = !object2.axis.intersection(!object1.axis)
				if !point1.distance(!point2) gt 1 then
					!interline = !point1.line(!point2)
					!edges = !object1.profile.edges()

					do !edge values !edges
						!temppos = !interline.intersection(!edge)
						handle any
						elsehandle none
							if !interline.onprojected(!temppos) and !edge.onprojected(!temppos) then
								!tempdir = !temppos.direction(!point2)
								handle any
									!tempdir = !point1.direction(!temppos)
								endhandle
								!temparr = !this.posonbeam(!temppos,!object2,!tempdir)
								!connection.connpos2 = !temparr[1]
								!connection.conndir2 = !temparr[2]
								golabel /end
							endif
						endhandle
					enddo
				endif
			endif
		elseif !ot2 eq 'SUPPPANE' then
			!this.checkobjectsconnection(!x,!y)
			--!this.checkbeampane(!x,!y)
			return
			$(
			!temparr = !this.posonOnepane(!pos1,!object2.profile,!dir1,!object2.thick)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				golabel /end
			endif
			$)

		elseif !ot2 eq 'SUPPPANES' then
			!this.checkobjectsconnection(!x,!y)
			--!this.checkbeampanes(!x,!y)
			return
			$(
			do !profileindex indices !object2.profiles
				!profile = !object2.profiles[!profileindex]
				!temparr = !this.posonOnepane(!pos1,!profile,!dir1,!object2.thick)
				if !temparr.set() then
					!connection.connpos2 = !temparr[1]
					!connection.conndir2 = !temparr[2]
					golabel /end
				endif
			enddo
			$)
		elseif !ot2 eq 'SUPPTUBE' then
			!temparr = !this.posontube(!pos1,!object2,!dir1)
			if !temparr.set() then	$*end of beam1 at tube
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				golabel /end
			endif

			if !times eq 2 then
				do !times2 from 1 to 2
					if !times2 eq 1 then
						!temparr = !this.posonbeam(!object2.pos1,!object1,!object2.axis.direction().opposite())
					else
						!temparr = !this.posonbeam(!object2.pos2,!object1,!object2.axis.direction())
					endif
					if !temparr.set() then	$*end of beam1 on beam2
						!connection.connpos1 = !temparr[1]
						!connection.conndir2 = !temparr[2].opposite()

						!connection.connpos2 = !temparr[1]
						!connection.conndir2 = !temparr[2]
						golabel /end
					endif
				enddo


				--$*mid part touch mid part
				!point1 = !object1.axis.intersection(!object2.axis)
				!point2 = !object2.axis.intersection(!object1.axis)
				if !point1.distance(!point2) gt 1 then
					!interline = !point1.line(!point2)
					!interpoint = !point2.offset(!point2.direction(!point1),!object2.outdia / 2)

					!tempdir = !interpoint.direction(!point1)
					handle any
						!tempdir = !point2.direction(!interpoint)
					endhandle

					!temparr = !this.posontube(!interpoint,!object2,!tempdir)
					if !temparr.set() then
						!connection.connpos1 = !temparr[1]
						!connection.conndir2 = !temparr[2].opposite()

						!connection.connpos2 = !temparr[1]
						!connection.conndir2 = !temparr[2]

						golabel /end
					endif
				endif
			endif
		elseif !ot2 eq 'SUPPAPDP' then
			!temparr = !this.posonprofile(!pos1,!object2.profile,!dir1)
			--!temparr = !this.posonprofile(!pos1,!object2.profile,!dir1,!pos2)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				!connection.upstream1 = true
				!connection.upstream2 = false
				golabel /end
			endif
		elseif !ot2 eq 'SUPPCONCRETE' then
			!connection.upstream1 = true
			!connection.upstream2 = false
			if !object2.markcivil.profiles.set() then
				do !index index !object2.markcivil.profiles
					!profile = !object2.markcivil.profiles[!index]
					--!temparr = !this.posonprofile(!pos1,!profile,!dir1,!pos2)
					!temparr = !this.posonprofile(!pos1,!profile,!dir1)
					if !temparr.set() then
						!connection.connpos2 = !temparr[1]
						!connection.conndir2 = !temparr[2]
						!connection.partnum2 = !index
						golabel /end
					endif
				enddo
			else
				!temparr = !this.posonarcconcrete(!pos1,!object2.markcivil,!dir1)
				if !temparr.set() then
					!connection.connpos2 = !temparr[1]
					!connection.conndir2 = !temparr[2]
					!connection.partnum2 = !temparr[3]
					golabel /end
				endif
			endif
		endif
	enddo
	return

	label /end
	!this.partconnections.append(!connection)
endmethod

define method .getprofilesfromobject(!object is any) is array
	!profiles = array()
	if !object.objecttype() eq 'SUPPBEAM' then
		!beam = !object
		!temparr = !beam.poss
		!temparr.appendarray(!beam.endposs)
		!midpoint = !!getcenpoint(!temparr)
		--!midpoint = !beam.pos1.midpoint(!beam.pos2)
		!allposs = array()
		!allposs.append(!beam.poss)
		!allposs.append(!beam.endposs)

		!size = !beam.poss.size()
		do !x indices !beam.poss
			!poss = array()
			!poss[1] = !beam.poss[!x]
			if !x eq !size then
				!poss[2] = !beam.poss[1]
				!poss[3] = !beam.endposs[1]
			else
				!poss[2] = !beam.poss[!x + 1]
				!poss[3] = !beam.endposs[!x + 1]
			endif
			!poss[4] = !beam.endposs[!x]
			!allposs.append(!poss)
		enddo

		do !poss values !allposs
			!cenpoint = !!getcenpoint(!poss)
			!tempdir = !midpoint.direction(!cenpoint)

			!ori = !!getoriwithpoints(!poss)
			if !ori.zdir().angle(!tempdir) gt 90 then
				!zdir = !ori.zdir().opposite()
				!ori = z is $!zdir
			endif
			!profile = object profile(!cenpoint,!ori,!poss)
			!profile.close()
			!profiles.append(!profile)
		enddo
	elseif !object.objecttype() eq 'SUPPPANE' then
		!pane = !object

        --modify by jyg 20240905
        if !pane.profile.unset() then
            return !profiles
        endif

		!zdir = !pane.profile.orientation.zdir()

		do !x from 1 to 2
			!profile = !pane.profile
			if !x eq 1 then
				!cenpoint = !profile.position.offset(!zdir,!pane.thick / 2)
			else
				!cenpoint = !profile.position.offset(!zdir, - !pane.thick / 2)
			endif
			!zdir = !profile.position.direction(!cenpoint)
			!ori = z is $!zdir

			!profile = !pane.profile
			!profile.position = !cenpoint

			!profile = object profile(!cenpoint,!ori,!profile.edges())
			!profiles.append(!profile)
		enddo


		!edges1 = !profiles[1].edges()
		!edges2 = !profiles[2].edges()
		do !x indices !edges1
			!poss = array()
			!poss.append(!edges1[!x].startposition)
			!poss.append(!edges1[!x].endposition)
			!poss.append(!edges2[!x].endposition)
			!poss.append(!edges2[!x].startposition)
			!cenpoint = !!getcenpoint(!poss)
			!zdir = !pane.profile.position.direction(!cenpoint)
			!ori = z is $!zdir
			!profile = object profile(!cenpoint,!ori,!poss)
			!profile.close()
			!profiles.append(!profile)
		enddo
	elseif !object.objecttype() eq 'SUPPPANES' then
		!panes = !object
		!allposs = !panes.poss
		!size = !allposs.size()

		do !x indices !allposs
			!poss = array()
			!poss.append(!allposs[!x])
			if !x ne !size then
				!poss.append(!allposs[!x + 1])
			else
				!poss.append(!allposs[1])
			endif
			!poss.append(!poss[2].offset(!panes.dir,!panes.height))
			!poss.append(!poss[1].offset(!panes.dir,!panes.height))

			!cenpoint = !!getcenpoint(!poss)
			!xdir = !poss[1].direction(!poss[2])
			!ydir = !panes.dir.opposite()
			!ori = x is $!xdir and y is $!ydir
			!profile = object profile(!cenpoint,!ori,!poss)
			!profile.close()
			!profiles.append(!profile)
		enddo
	elseif !object.objecttype() eq 'SUPPAPDP' then
		!profiles.append(!object.profile)
	elseif !object.objecttype() eq 'SUPPCONCRETE' then
		!volume = !this.getvolume()

		!cenpoint = !volume.from.midpoint(!volume.to)

		!markcivil = !object.markcivil
		if !markcivil.profiles.set() then
			if !cenpoint.distance(!markcivil.profiles[1].plane()) lt !cenpoint.distance(!markcivil.profiles[2].plane()) then
				!profiles.append(!markcivil.profiles[1])
			else
				!profiles.append(!markcivil.profiles[2])
			endif
		else
			!arcs = !markcivil.arcs
			!cenline = !arcs[1].position.line(!arcs[1].position.offset(!arcs[1].orientation.zdir(),1000))
			!nearpoint = !cenline.near(!cenpoint)
			!arcs[1].position = !nearpoint
			!arcs[2].position = !nearpoint

			!point1 = !arcs[1].angleposition(!arcs[1].near(!cenpoint))
			!point2 = !arcs[2].angleposition(!arcs[2].near(!cenpoint))

			if !cenpoint.distance(!point1) lt !cenpoint.distance(!point2) then
				!position = !point1
			else
				!position = !point2
			endif

			!zdir = !position.direction(!cenpoint)
			!xdir = !zdir.orthogonal(u).opposite()
			!ori = x is $!xdir and z is $!zdir
			!ydir = !ori.ydir()

			!poss = array()
			!poss.append(!position.offset(!xdir, -10000).offset(!ydir,10000))
			!poss.append(!position.offset(!xdir, 10000).offset(!ydir,10000))
			!poss.append(!position.offset(!xdir, 10000).offset(!ydir, -10000))
			!poss.append(!position.offset(!xdir, -10000).offset(!ydir, -10000))

			!profile = object profile(!position,!ori,!poss)
			!profile.close()
			!profiles.append(!profile)
		endif
	endif
	return !profiles
endmethod

define method .checktouchprofiles(!profile1 is profile, !profile2 is profile) is position
	!result = object position()
	!tolerance = 50
	!zdir1 = !profile1.orientation.zdir()
	!zdir2 = !profile2.orientation.zdir()
	if !zdir1.angle(!zdir2) lt 179 then
		return !result
	endif
	if !profile1.position.distance(!profile2.plane()) gt !tolerance then
		return !result
	endif

	!profiles = !profile1.intersect(!profile2)
	handle any
		!tempprofile = !profile2
		!tempedges = !profile2.edges()
		!plane = !profile1.plane()
		!cenpoint = !plane.near(!profile2.position)
		do !x indices !tempedges
			if !tempedges[!x].objecttype() eq 'ARC' then	$* edge of floor
				!line = !tempedges[!x].angleposition(!tempedges[!x].startangle).line(!tempedges[!x].angleposition(!tempedges[!x].endangle))
				!tempedges[!x].delete()
				!tempedges[!x] = !line.projected(!plane)
			else
				!tempedges[!x] = !tempedges[!x].projected(!plane)
			endif
		enddo
		!zdir = !profile1.orientation.zdir().opposite()
		!ori = z is $!zdir
		!tempprofile = object profile(!cenpoint,!ori,!tempedges)
		!tempprofile.close()
        --q var !profile1 !tempprofile
		!profiles = !profile1.intersect(!tempprofile)
        handle any
            --modify by jyg 20240905
            return !result
        endhandle
		--return !result
	endhandle
	if !profiles.set() then
		!profile = !profiles[1]
	else
		return !result
	endif



	!points = !!getpointsofprofile(!profile)
	!cenpoint = !!getcenpoint(!points)

	return !cenpoint
endmethod

define method .checkobjectsconnection(!xx is real, !yy is real) is boolean
--$p 1010
	!result = false
	!object1 = !this.partobjects[!xx]
	!object2 = !this.partobjects[!yy]

	!ot1 = !object1.objecttype()
	!ot2 = !object2.objecttype()

	!connection = object suppconnection()
	!connection.index1 = !xx
	!connection.index2 = !yy

	!profiles1 = !this.getprofilesfromobject(!object1)
	!profiles2 = !this.getprofilesfromobject(!object2)

	do !profile1 values !profiles1
		do !profile2 values !profiles2
			!pos1 = !this.checktouchprofiles(!profile1,!profile2)
			if !pos1.set() then
				!pos2 = !profile2.plane().near(!pos1)
				!connection.connpos1 = !pos1
				!connection.conndir1 = !profile1.orientation.zdir()
				!connection.connpos2 = !pos2
				!connection.conndir2 = !profile2.orientation.zdir()


				if !ot1 eq 'PANES' then
					!connection.partnum1 = !this.getpartnum(!object1,!pos1)
				endif

				if !ot2 eq 'PANES' then
					!connection.partnum2 = !this.getpartnum(!object2,!pos2,!profile2.orientation.zdir())
				endif
				!this.partconnections.append(!connection)

				!result = true
				if !ot1 ne 'PANES' and !ot2 ne 'PANES' then
					return !result
				endif
			endif
		enddo
	enddo

	return !result
endmethod

define method .getpartnum(!panes is supppanes,!pos is position, !dir is direction) is real
	do !x indices !profiles
		!zdir = !profiles[!x].orientation.zdir()
		!angle = !zdir.angle(!dir)
		if !angle gt 1 and !angle lt 179 then
			skip
		endif

		if !pos.distance(!profiles[!x].near(!pos) gt 1 then
			skip
		endif

		if !!posinprofile(!pos,!profiles[!x]).not() then
			skip
		endif

		return !x
	enddo
endmethod

define method .checkbeampane(!xx is real, !yy is real) is boolean
--$p 1111
	!beam = !this.partobjects[!xx]
	!pane = !this.partobjects[!yy]

	!connection = object suppconnection()
	!connection.index1 = !xx
	!connection.index2 = !yy

	do !times from 1 to 2
		if !times eq 1 then
			!pos1 = !beam.pos1
			!dir1 = !beam.axis.direction().opposite()
		else
			!pos1 = !beam.pos2
			!dir1 = !beam.axis.direction()
		endif
		!connection.connpos1 = !pos1
		!connection.conndir1 = !dir1
		!temparr = !this.posonOnepane(!pos1,!pane.profile,!dir1,!pane.thick)
		if !temparr.set() then
			!connection.connpos2 = !temparr[1]
			!connection.conndir2 = !temparr[2]
			golabel /end
		endif
	enddo

	!panelines = !pane.profile.edges()

	!size = !beam.poss.size()
	do !x indices !beam.poss
		!beamlines = array()
		!pos1 = !beam.poss[!x]
		if !x eq !size then
			!pos2 = !beam.poss[1]
			!pos3 = !beam.endposs[1]
		else
			!pos2 = !beam.poss[!x + 1]
			!pos3 = !beam.edposs[!x + 1]
		endif
		!pos4 = !beam.endposs[!x]
		--if !xx eq 2 and !yy eq 8 then

		--endif
		if !pos1.distance(!pane.profile.plane()) gt !pane.thick or !pos2.distance(!pane.profile.plane()) gt !pane.thick then
			skip
		endif

		!beamlines.append(!pos1.line(!pos2))
		!beamlines.append(!pos2.line(!pos3))
		!beamlines.append(!pos3.line(!pos4))
		!beamlines.append(!pos4.line(!pos1))

		--if !xx eq 2 and !yy eq 8 then

		--endif
		!points = array()
		do !beamline values !beamlines
			do !paneline values !panelines
				!interpoint = !beamline.intersection(!paneline)
				handle any
					skip
				endhandle
				if !beamline.onprojected(!interpoint) and !paneline.onprojected(!interpoint) then
					!points.append(!interpoint)
				endif
			enddo
		enddo


		if !points.size() ge 4 then
			!dir = !pane.profile.orientation.zdir()

			!cenpoint = !!getcenpoint(!points)
			!tempdir = !cenpoint.direction(!pane.profile.position)
			if !tempdir.angle(!dir) lt 90 then
				!dir1 = !dir
			else
				!dir1 = !dir.opposite()
			endif

			!connection.connpos1 = !cenpoint
			!connection.conndir1 = !dir1

			!dir2 = !dir1.opposite()
			!connection.connpos2 = !pane.profile.plane().near(!cenpoint).offset(!dir2,!pane.thick / 2)
			!connection.conndir2 = !dir2
			golabel /end
		endif
	enddo

	return false

	label /end
	!this.partconnections.append(!connection)
	return true
endmethod

define method .checkbeampanes(!xx is real, !yy is real) is boolean
--$p 1212
	!beam = !this.partobjects[!xx]
	!panes = !this.partobjects[!yy]

	!connection = object suppconnection()
	!connection.index1 = !xx
	!connection.index2 = !yy

	do !times from 1 to 2
		if !times eq 1 then
			!pos1 = !beam.pos1
			!dir1 = !beam.axis.direction().opposite()
		else
			!pos1 = !beam.pos2
			!dir1 = !beam.axis.direction()
		endif
		!connection.connpos1 = !pos1
		!connection.conndir1 = !dir1

		do !profileindex indices !panes.profiles
			!profile = !panes.profiles[!profileindex]
			!temparr = !this.posonOnepane(!pos1,!profile,!dir1,!panes.thick)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				!connection.partnum2 = !profileindex
				golabel /end
			endif
		enddo
	enddo

	do !profileindex indices !panes.profiles
		!profile = !panes.profiles[!profileindex]
		!panelines = !profile.edges()

		!size = !beam.poss.size()
		do !x indices !beam.poss
			!beamlines = array()
			!pos1 = !beam.poss[!x]
			if !x eq !size then
				!pos2 = !beam.poss[1]
				!pos3 = !beam.endposs[1]
			else
				!pos2 = !beam.poss[!x + 1]
				!pos3 = !beam.endposs[!x + 1]
			endif
			!pos4 = !beam.endposs[!x]

			if !pos1.distance(!profile.plane()) gt !panes.thick or !pos2.distance(!profile.plane()) gt !panes.thick then
				skip
			endif

			!beamlines.append(!pos1.line(!pos2))
			!beamlines.append(!pos2.line(!pos3))
			!beamlines.append(!pos3.line(!pos4))
			!beamlines.append(!pos4.line(!pos1))

			!points = array()
			do !beamline values !beamlines
				do !paneline values !panelines
					!interpoint = !beamline.intersection(!paneline)
					handle any
						skip
					endhandle
					if !beamline.onprojected(!interpoint) and !paneline.onprojected(!interpoint) then
						!points.append(!interpoint)
					endif
				enddo
			enddo


			if !points.size() ge 4 then
				!dir = !profile.orientation.zdir()

				!cenpoint = !!getcenpoint(!points)
				!tempdir = !cenpoint.direction(!profile.position)
				if !tempdir.angle(!dir) lt 90 then
					!dir1 = !dir
				else
					!dir1 = !dir.opposite()
				endif

				!connection.connpos1 = !cenpoint
				!connection.conndir1 = !dir1

				!dir2 = !dir1.opposite()
				!connection.connpos2 = !profile.plane().near(!cenpoint).offset(!dir2,!panes.thick / 2)
				!connection.conndir2 = !dir2
				!connection.partnum2 = !profileindex
				golabel /end
			endif
		enddo
	enddo
	return false

	label /end
	!this.partconnections.append(!connection)
	return true
endmethod

define method .checkPaneConnection(!x is real,!y is real)
--$p 1313
	!object1 = !this.partobjects[!x]
	!object2 = !this.partobjects[!y]
	!ot2 = !object2.objecttype()

	!tolerance = 2

	!connection = object suppconnection()
	!connection.index1 = !x
	!connection.index2 = !y
	--CLAMP POINT BEAM PANE PANES BOLT TUBE APDP CONNECT CONCRETE
	if !ot2 inset ('CLAMP','SUPPBOLT','SUPPCONNECT','SUPPBEAM','SUPPTUBE') then
		!this.checkconnection(!y,!x,false)
		return
	endif
	!pointdirs = !this.getpanesixpointdirs(!object1)

	if !ot2 eq 'SUPPAPDP' or !ot2 eq 'SUPPCONCRETE' then
		do !times from 1 to 2
			!pos1 = !pointdirs[1][!times]
			!dir1 = !pointdirs[2][!times]
			!connection.connpos1 = !pos1
			!connection.conndir1 = !dir1

			if !ot2 eq 'SUPPAPDP' then
				--!temparr = !this.posonprofile(!pos1,!object2.profile,!dir1,!pos2)
				!temparr = !this.posonprofile(!pos1,!object2.profile,!dir1)
				if !temparr.set() then
					!connection.connpos2 = !temparr[1]
					!connection.conndir2 = !temparr[2]
					!connection.upstream1 = true
					!connection.upstream2 = false
					golabel /end
				endif
			elseif !ot2 eq 'SUPPCONCRETE' then
				!connection.upstream1 = true
				!connection.upstream2 = false
				if !object2.markcivil.profiles.set() then
					do !index index !object2.markcivil.profiles
						!profile = !object2.markcivil.profiles[!index]
						--!temparr = !this.posonprofile(!pos1,!profile,!dir1,!pos2)
						!temparr = !this.posonprofile(!pos1,!profile,!dir1)
						if !temparr.set() then
							!connection.connpos2 = !temparr[1]
							!connection.conndir2 = !temparr[2]
							!connection.partnum2 = !index
							golabel /end
						endif
					enddo
				else
					!temparr = !this.posonarcconcrete(!pos1,!object2.markcivil,!dir1)
					if !temparr.set() then
						!connection.connpos2 = !temparr[1]
						!connection.conndir2 = !temparr[2]
						!connection.partnum2 = !temparr[3]
						golabel /end
					endif
				endif
			endif
		enddo
	else
		do !times indices !pointdirs[1]
			!pos1 = !pointdirs[1][!times]
			!dir1 = !pointdirs[2][!times]
			!connection.connpos1 = !pos1
			!connection.conndir1 = !dir1

			if !ot2 eq 'SUPPPANE' then
				!this.checkobjectsconnection(!x,!y)
				return

				!temparr = !this.posonOnepane(!pos1,!object2.profile,!dir1,!object2.thick)
				if !temparr.set() then
					!connection.connpos2 = !temparr[1]
					!connection.conndir2 = !temparr[2]
					golabel /end
				endif

				if !times eq !pointdirs[1].size() then
					!pointdirs2 = !this.getpanesixpointdirs(!object2)
					do !times2 from 3 to !pointdirs2[1].size()
						!temparr = !this.posonOnepane(!pointdirs2[1][!times2],!object1.profile,!pointdirs2[2][!times2],!object1.thick)
						if !temparr.set() then
							!connection.connpos2 = !temparr[1]
							!connection.conndir2 = !temparr[2]
							golabel /end
						endif
					enddo
				endif

			elseif !ot2 eq 'SUPPPANES' then
				!this.checkobjectsconnection(!x,!y)
				return


				do !profileindex indices !object2.profiles
					!profile = !object2.profiles[!profileindex]
					!temparr = !this.posonOnepane(!pos1,!profile,!dir1,!object2.thick)
					if !temparr.set() then
						!connection.connpos2 = !temparr[1]
						!connection.conndir2 = !temparr[2]
						!connection.partnum2 = !profileindex
						golabel /end
					endif
				enddo
				if !times eq !pointdirs[1].size() then
					!pointdirs2 = !this.getPanesedgespointdirs(!object2)
					do !times2 indices !pointdirs2[1]
						!temparr = !this.posonOnepane(!pointdirs2[1][!times2],!object1.profile,!pointdirs2[2][!times2],!object1.thick)
						if !temparr.set() then
							!connection.connpos2 = !temparr[1]
							!connection.conndir2 = !temparr[2]
							!connection.partnum2 = !temparr[3]
							golabel /end
						endif
					enddo
				endif
			endif
		enddo
	endif
	return

	label /end
	!this.partconnections.append(!connection)
endmethod

define method .checkPanesConnection(!x is real,!y is real)
--$p 1414
	!object1 = !this.partobjects[!x]
	!object2 = !this.partobjects[!y]
	!ot2 = !object2.objecttype()

	!tolerance = 2

	!connection = object suppconnection()
	!connection.index1 = !x
	!connection.index2 = !y
	--CLAMP POINT BEAM PANE PANES BOLT TUBE APDP CONNECT CONCRETE
	if !ot2 inset ('CLAMP','SUPPBOLT','SUPPCONNECT','SUPPBEAM','SUPPTUBE','SUPPPANE') then
		!this.checkconnection(!y,!x,false)
		return
	endif





	!pointdirparts1 = !this.getpanesallpoints(!object1)
	if !ot2 eq 'SUPPPANES' then
		do !xx indices !pointdirparts1
			!temparr = !this.posonpanes(!pointdirparts1[1][!xx],!object2,!pointdirparts1[2][!xx])
			if !temparr.set() then
				!connection.connpos1 = !pointdirparts1[1][!xx]
				!connection.conndir1 = !pointdirparts1[2][!xx]
				!connection.partnum1 = !pointdirparts1[3][!xx]

				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				!connection.partnum2 = !temparr[3]
				golabel /end
			endif
		enddo

		!pointdirparts1 = !this.getpanesallpoints(!object2)

		do !xx indices !pointdirparts1
			!temparr = !this.posonpanes(!pointdirparts1[1][!xx],!object1,!pointdirparts1[2][!xx])
			if !temparr.set() then
				!connection.connpos1 = !pointdirparts1[1][!xx]
				!connection.conndir1 = !pointdirparts1[2][!xx]
				!connection.partnum1 = !pointdirparts1[3][!xx]

				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				!connection.partnum2 = !temparr[3]
				golabel /end
			endif
		enddo
	elseif !ot2 eq 'SUPPAPDP' then
		do !xx indices !pointdirparts1
			!temparr = !this.posonprofile(!pointdirparts1[1][!xx],!object2.profile,!pointdirparts1[2][!xx])
			if !temparr.set() then
				!connection.connpos1 = !pointdirparts1[1][!xx]
				!connection.conndir1 = !pointdirparts1[2][!xx]
				!connection.partnum1 = !pointdirparts1[3][!xx]

				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				!connection.upstream1 = true
				!connection.upstream2 = false
				golabel /end
			endif
		enddo
	elseif !ot2 eq 'SUPPCONCRETE' then
		!connection.upstream1 = true
		!connection.upstream2 = false
		do !xx indices !pointdirparts1
			!pos1 = !pointdirparts1[1][!xx]
			!dir1 = !pointdirparts1[2][!xx]
			!connection.partnum1 = !pointdirparts1[3][!xx]


			if !object2.markcivil.profiles.set() then
				do !index index !object2.markcivil.profiles
					!profile = !object2.markcivil.profiles[!index]
					--!temparr = !this.posonprofile(!pos1,!profile,!dir1,!pos2)
					!temparr = !this.posonprofile(!pos1,!profile,!dir1)
					if !temparr.set() then
						!connection.connpos2 = !temparr[1]
						!connection.conndir2 = !temparr[2]
						!connection.partnum2 = !index
						golabel /end
					endif
				enddo
			else
				!temparr = !this.posonarcconcrete(!pos1,!object2.markcivil,!dir1)
				if !temparr.set() then
					!connection.connpos2 = !temparr[1]
					!connection.conndir2 = !temparr[2]
					!connection.partnum2 = !temparr[3]
					golabel /end
				endif
			endif
		enddo
	endif
	return

	label /end
	!this.partconnections.append(!connection)
endmethod


define method .checkTubeConnection(!x is real,!y is real)
--$p 1515
	!object1 = !this.partobjects[!x]
	!object2 = !this.partobjects[!y]
	!ot2 = !object2.objecttype()

	!tolerance = 2

	!connection = object suppconnection()
	!connection.index1 = !x
	!connection.index2 = !y

	--CLAMP POINT BEAM PANE PANES BOLT TUBE APDP CONNECT CONCRETE
	if !ot2 inset ('CLAMP','SUPPBOLT','SUPPCONNECT','SUPPBEAM') then
		!this.checkconnection(!y,!x,false)
		return
	endif
	--!dir1 = !object1.axis.direction()
	do !times from 1 to 2
		if !times eq 1 then
			!pos1 = !object1.pos1
			!dir1 = !object1.axis.direction().opposite()
		else
			!pos1 = !object1.pos2
			!dir1 = !object1.axis.direction()
		endif
		!connection.connpos1 = !pos1
		!connection.conndir1 = !dir1


		if !ot2 eq 'SUPPPANE' then
			!temparr = !this.posonOnepane(!pos1,!object2.profile,!dir1,!object2.thick)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				golabel /end
			endif
		elseif !ot2 eq 'SUPPPANES' then
			!temparr = !this.posonOnepanes(!pos1,!object2,!dir1)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				golabel /end
			endif
		elseif !ot2 eq 'SUPPTUBE' then
			!temparr = !this.posontube(!pos1,!object2,!dir1)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				golabel /end
			endif
		elseif !ot2 eq 'SUPPAPDP' then
			!temparr = !this.posonprofile(!pos1,!object2.profile,!dir1)
			if !temparr.set() then
				!connection.connpos2 = !temparr[1]
				!connection.conndir2 = !temparr[2]
				!connection.upstream1 = true
				!connection.upstream2 = false
				golabel /end
			endif
		elseif !ot2 eq 'SUPPCONCRETE' then
			!connection.upstream1 = true
			!connection.upstream2 = false
			if !object2.markcivil.profiles.set() then
				do !index index !object2.markcivil.profiles
					!profile = !object2.markcivil.profiles[!index]
					--!temparr = !this.posonprofile(!pos1,!profile,!dir1,!pos2)
					!temparr = !this.posonprofile(!pos1,!profile,!dir1)
					if !temparr.set() then
						!connection.connpos2 = !temparr[1]
						!connection.conndir2 = !temparr[2]
						!connection.partnum2 = !index
						golabel /end
					endif
				enddo
			else
				!temparr = !this.posonarcconcrete(!pos1,!object2.markcivil,!dir1)
				if !temparr.set() then
					!connection.connpos2 = !temparr[1]
					!connection.conndir2 = !temparr[2]
					!connection.partnum2 = !temparr[3]
					golabel /end
				endif
			endif
		endif
	enddo
	return
	label /end
	!this.partconnections.append(!connection)
endmethod

define method .checkconnection(!x is real, !y is real, !reverse is boolean) $*check if two items are connected, if yes, add connection data into this partconnections
	!object1 = !this.partobjects[!x]
	!object2 = !this.partobjects[!y]
	!ot1 = !object1.objecttype()
	!ot2 = !object2.objecttype()

	--$p $!x $!y
	if !this.volumeclash(!x,!y).not() then
		return
	endif



	!profiletypes = split('SUPPBEAM SUPPPANE SUPPPANES SUPPAPDP SUPPCONCRETE')
	if !profiletypes.findfirst(!ot1).set() and !profiletypes.findfirst(!ot2).set() then
		!this.checkobjectsconnection(!x,!y)
	else
	--$p $!x $!y
		if !ot1 eq 'SUPPCLAMP' then
			!this.checkclampconnection(!x,!y)
		elseif !ot1 eq 'SUPPBOLT' then
			!this.checkBOLTconnection(!x,!y)
		elseif !ot1 eq 'SUPPCONNECT' then
			!this.checkConnectconnection(!x,!y)
		elseif !ot1 eq 'SUPPBEAM' then
			!this.checkBeamconnection(!x,!y)
		elseif !ot1 eq 'SUPPPANE' then
			!this.checkPaneconnection(!x,!y)
		elseif !ot1 eq 'SUPPPANES' then
			!this.checkPanesconnection(!x,!y)
		elseif !ot1 eq 'SUPPTUBE' then
			!this.checkTubeConnection(!x,!y)
		elseif !ot1 inset ('SUPPAPDP','SUPPCONCRETE') then
			if !reverse then
				!this.checkconnection(!y,!x,false)
				return
			endif
		endif
	endif

	return
endmethod

define method .volumeclash(!x is real,!y is real) is boolean
	!arr1 = !this.getenu(!this.partobjects[!x].mems)
	!arr2 = !this.getenu(!this.partobjects[!y].mems)
	--if !x eq 2 and !y eq 8 then

	--endif
	if !arr1[1] gt !arr2[4] or !arr1[4] lt !arr2[1] or $
		!arr1[2] gt !arr2[5] or !arr1[5] lt !arr2[2] or $
		!arr1[3] gt !arr2[6] or !arr1[6] lt !arr2[3] then
		return false
	endif
	--if !x eq 2 and !y eq 8 then
	--	$p $!x $!y true
	--endif
	return true
endmethod

define method .getenu(!mems is array) is array
    --q var !mems
	do !mem values !mems
		!volume = object volume(object dbref(!mem))
		!from = !volume.from
		!to = !volume.to

		if undefined(!e1) then
			!e1 = !from.east
			!n1 = !from.north
			!u1 = !from.up

			!e2 = !to.east
			!n2 = !to.north
			!u2 = !to.up
		else
			!e1 = min(!e1,!from.east)
			!n1 = min(!n1,!from.north)
			!u1 = min(!u1,!from.up)

			!e2 = max(!e2,!to.east)
			!n2 = max(!n2,!to.north)
			!u2 = max(!u2,!to.up)
		endif
	enddo
	!tolerance = 5
	!result = array()
	!result.append(!e1 - !tolerance)
	!result.append(!n1 - !tolerance)
	!result.append(!u1 - !tolerance)
	!result.append(!e2 + !tolerance)
	!result.append(!n2 + !tolerance)
	!result.append(!u2 + !tolerance)
	$(
	!result.append(!e1)
	!result.append(!n1)
	!result.append(!u1)
	!result.append(!e2)
	!result.append(!n2)
	!result.append(!u2)
	$)
	return !result
endmethod

$(
define method .gettypeobjects(!type is string) is array
	!index = !this.parttypes.findfirst(!type.upcase())
	return !this.parttypeindices[!index]
endmethod
$)

define method .addattatopartobjects() $*add atta to partobjects
	--!tempstring = !this.suppName + '*'
	--var !attas coll all atta with(matchwild(name,!tempstring))

	var !hangs coll all hang for $!this.restname
	handle any
		!hangs = array()
	endhandle
	!allattas = array()
	do !lnki values !hangs
		var !atta ref of href of $!hang
		handle any
			skip
		elsehandle none
			!allattas.append(!atta)
		endhandle
	enddo



	--------------------------------------
	--------------------------------------Step 1:for atta of leg lug pad
	!brans = array()
	do !atta values !allattas
		!onebran = name of bran of $!atta
		!brans.append(!onebran)
	enddo
	!brans.unique()

	!tempstring = !this.suppName + '*'
	!branattas = array()
	do !bran values !brans
		var !allattas coll all atta with(matchwild(name,!tempstring)) for $!onebran
	enddo

	!pointattas = array()
	do !attas values !branattas
		!pipeatta = object pipeatta(!attas,'supp')
		--!this.pipeattas.append(!pipeatta)					$* all atta belong to pipe according to new rule
		!pointattas.appendarray(!pipeatta.pointattas)
	enddo


	--------------------------------------
	--------------------------------------Step 2:add tube atta as supptube
	do !pipeatta values !this.pipeattas
		do !attaobject values !pipeatta.attaobjects
			if !attaobject.objecttype() eq 'ISOLEG' then
				!object = object supptube(!attaobject)
				!this.partobjects.append(!object)
				!index = !this.parttypes.findfirst('TUBE')
				!this.parttypeindices[!index].append(!this.partobjects.maxindex())
			endif
		enddo
	enddo

	--------------------------------------
	--------------------------------------Step 3:add point  as supppoint
	do !pointatta values !pointattas
		!this.dealparttype(!pointatta,'POINT')
	enddo
	--q var !this.dealparttype


	$(
	!considerattas = array()

	do !atta values !allattas
		if !considerattas.findfirst(!atta).set() then
			skip
		endif
		--------------------------------------
		--------------------------------------Step 1:get data of all atta with suppname from bran of curren atta, it
		!temparr = !this.getattadatas(!atta)	$* it is data of all atta from bran of current atta, instead of one atta
		!attas = !temparr[3]
		!attadatas = !temparr[1]
		!attaclass = !temparr[2]
		!otherattas = !temparr[4]

		do !atta values !otherattas
			!this.dealparttype(!atta,'POINT')
		enddo
		!considerattas.appendarray(!attas)

		do !oneattaclass values !attaclass
			!this.dealattaparttype(!oneattaclass,!attadatas)
		enddo
	enddo
	$)
endmethod

define method .dealattaparttype(!attaclass is array, !inputattadatas is array) $*put attadata into partobjects
	!attadatas = array()
	do !index values !attaclass
		!attadatas.append(!inputattadatas[!index])
	enddo

	!ot = !attadatas[1].objecttype()
	if !ot eq 'ISOPAD' then
		!type = 'PAD'
	elseif  !ot eq 'ISOLUG' then
		!type = 'LUG'
	elseif  !ot eq 'ISOLEG' then
		!type = 'TUBE'
	endif
	!index = !this.parttypes.findfirst(!type)
	!com = '!object = object supp' & !type & '(!attadatas)'
	$!com
	!this.partobjects.append(!object)
	!this.parttypeindices[!index].append(!this.partobjects.maxindex())
endmethod



$(
define method .getattadatas(!atta is string) is array $*get attadata from bran which is relevant to suppport
	!a = object isobran()
	!tempstring = '*' + !this.suppName + '*'
	var !mems coll all atta with(matchwild(name,!tempstring)) for bran of $!atta
	--var !mems coll all atta with(matchwild(name,'*' & !this.suppname & '*')) for bran of $!atta
	--------------------------------------
	--------------------------------------Step 1:got attas with suppname from bran

	!pointattas = array()
	!otherattas = array()

	!padvolumes = array()
	!attadatas = array()
	do !mem values !mems
		!attadata = !a.getattageo(!mem)
		--q var !attadata
		--------------------------------------
		--------------------------------------Step 1:if atta is point, add into pointattas, or if it is pad/lug/leg, then add into otherattas
		if !attadata.set() then
			!otherattas.append(!mem)
			!attadatas.appendarray(!attadata)

			--------------------------------------
			--------------------------------------Step 1:if atta is pad, get array of padvolume, in order to identify group for attas
			if !attadata[1].objecttype() eq 'ISOPAD' then
				!ob = !attadata[1]
				!padline = !ob.attapos.offset(!ob.ori.zdir(),!ob.height / 2).line(!ob.pos.offset(!ob.ori.zdir(), - !ob.height / 2))

				!exists = false
				do !x indices !padvolumes
					if !padline.startposition.distance(!padvolumes[!x][1].startposition) lt 1 and !padline.endposition.distance(!padvolumes[!x][1].endposition) lt 1 $
						and abs(!ob.routside - !padvolumes[!x][2]) lt 1 then
						!exists = true
						break
					endif
				enddo
				if !exists.not() then
					!onearr = array()
					!onearr[1] = !padline
					!onearr[2] = !ob.routside

					!padvolumes.append(!onearr)
				endif
			endif
		else
			!pointattas.append(!mem)
		endif
	enddo


	--------------------------------------
	--------------------------------------Step 2:check if lug/leg is on pad
	!onpadattas = array()
	!onpadnums = array()

	!attaPadNums = array()
	do !x indices !attadatas
		if !attadatas[!x].objecttype() inset ('ISOLUG','ISOLEG') then
			!atta = !attadatas[!x].name
			!tempindex = !onpadattas.findfirst(!atta)
			if !tempindex.set() then
				!attaPadNums[!x] = !onpadnums[!tempindex]
				!onpad = true
			else
				--!attapos = pos of $!atta wrt/*
				!attapos = !attadatas[!x].attapos
				!onpad = false
				do !padindex indices !padvolumes
					!padvolume = !padvolumes[!padindex]
					if !padvolume[1].onprojected(!attapos) and !padvolume[1].distance(!attapos) lt !padvolume[2] then
						!onpadattas.append(!atta)
						!onpadnums.append(!padindex)

						!onpad = true
						!attaPadNums[!x] = !padindex
						break
					endif
				enddo
			endif
			!attadatas[!x].onpad = !onpad
		endif
	enddo

	--------------------------------------
	--------------------------------------Step 3:start to identify group
	!padposs = array()
	!padangles = array()
	!padheights = array()
	!padradius = array()
	!paditemcodes = array()
	!padindices = array()


	-----------------------
	-----------------------no need to check onpad, since radius is checked
	!lugposs = array()
	--!lugPadNums = array()
	!lugangles = array()
	!lugheights = array()
	!lugradius = array()
	!lugitemcodes = array()
	!lugindices = array()


	!legposs = array()
	--!legPadNums = array()	$* not sure about leg if padnum is needed
	!legheights = array()
	!legdias = array()
	!legitemcodes = array()
	!legonpads = array()
	!legindices = array()


	do !index indices !attadatas
		--------------------------------------
		--------------------------------------Step 1:check attsdata one by one, , it means they sould be in one group that their some attributes are some
		--------------------------------------
		--------------------------------------Step 2:if some of them are in one group, put them into one element(array) of indices, like padindices/lugindices/legindices
		--$P INDEX $!INDEX
		--!attadata = !attadatas[!index]
		--do !attadata values !attadatas
		if !attadatas[!index].objecttype() eq 'ISOPAD' then
			!pos = !attadatas[!index].attapos
			!angle = !attadatas[!index].angle
			!height = !attadatas[!index].height
			!radius = !attadatas[!index].rinside
			!itemcode = !attadatas[!index].itemcode

			!find = false
			do !x indices !padposs
				if !paditemcodes[!x] eq !itemcode and !padposs[!x].distance(!pos) lt 1 and abs(!padangles[!x] - !angle) lt 0.1 and abs(!padheights[!x] - !height) lt 0.1 and abs(!padradius[!x] - !radius) lt 0.1 then
					!padindices[!x].append(!index)
					!find = true
					break
				endif
			enddo
			if !find.not() then
				!padposs.append(!pos)
				!padangles.append(!angle)
				!padheights.append(!height)
				!padradius.append(!radius)
				!paditemcodes.append(!itemcode)

				!temparr = array()
				!temparr.append(!index)
				!padindices.append(!temparr)
			endif
		elseif !attadatas[!index].objecttype() eq 'ISOLUG' then
			!pos = !attadatas[!index].attapos
			--!onpadnum =
			!angle = !attadatas[!index].angle
			!height = !attadatas[!index].height
			!radius = !attadatas[!index].rinside
			!itemcode = !attadatas[!index].itemcode

			--!padnum = !attaPadNums[!index]
			--handle any
			--	!padnum = 0
			--endhandle

			!find = false
			do !x indices !lugposs
				if !lugitemcodes[!x] eq !itemcode and !lugposs[!x].distance(!pos) lt 1 and abs(!lugangles[!x] - !angle) lt 0.1 and abs(!lugheights[!x] - !height) lt 0.1 and abs(!lugradius[!x] - !radius) lt 0.1 then
					--if !lugitemcodes[!x] eq !itemcode and (!lugposs[!x].distance(!pos) lt 1 or (!padnum eq ne 0 and !padnum eq !lugpadnums[!x])) and abs(!lugangles[!x] - !angle) lt 0.1 and abs(!lugheights[!x] - !height) lt 0.1 and abs(!lugradius[!x] - !radius) lt 0.1 then
					!lugindices[!x].append(!index)
					!find = true
					break
				endif
			enddo
			if !find.not() then
				!lugposs.append(!pos)
				!lugangles.append(!angle)
				!lugheights.append(!height)
				!lugradius.append(!radius)
				!lugitemcodes.append(!itemcode)
				--!lugpadnums.append(!padnum)


				!temparr = array()
				!temparr.append(!index)
				!lugindices.append(!temparr)
			endif
		elseif !attadatas[!index].objecttype() eq 'ISOLEG' then
			!pos = !attadatas[!index].attapos
			!height = !attadatas[!index].height
			!dia = !attadatas[!index].india
			!onpad = !attadatas[!index].onpad
			!itemcode = !attadatas[!index].itemcode

			--!padnum = !attaPadNums[!index]
			--handle any
			--	!padnum = 0
			--endhandle

			!find = false
			do !x indices !legposs
				if !legitemcodes[!x] eq !itemcode and !legposs[!x].distance(!pos) lt 1 and abs(!legheights[!x] - !height) lt 0.1 and abs(!legdias[!x] - !dia) lt 0.1 and !legonpads[!x ] eq !onpad then
					--if !legitemcodes[!x] eq !itemcode and (!legposs[!x].distance(!pos) lt 1 or (!padnum eq ne 0 and !padnum eq !legpadnums[!x])) and abs(!legheights[!x] - !height) lt 0.1 and abs(!legdias[!x] - !dia) lt 0.1 and !legonpads[!x ] eq !onpad then
					!legindices[!x].append(!index)
					!find = true
					break
				endif
			enddo
			if !find.not() then
				!legposs.append(!pos)
				!legheights.append(!height)
				!legdias.append(!dia)
				!legonpads.append(!onpad)
				!legitemcodes.append(!itemcode)
				--!legpadnums.append(!padnum)

				!temparr = array()
				!temparr.append(!index)
				!legindices.append(!temparr)
			endif
		endif
	enddo


	--------------------------------------
	--------------------------------------Step 4:each element in padindices/legindices generate a element of attaclass
	!attaClass = array()
	if !padindices.set() then
		!attaclass.appendarray(!padindices)
	endif
	if !legindices.set() then
		!attaclass.appendarray(!legindices)
	endif

	--------------------------------------
	--------------------------------------Step 5:check if two element in lugindices should in one group
	if !lugindices.set() then
		--------------------------------------
		--------------------------------------Step 1:if two element in lugindices are on one pad, these two element generate one group attaclass
		!padnums = array()
		!groupnums = array()
		do !x indices !lugindices
			!padnum = !attapadnums[!lugindices[!x][1]]
			handle any
			elsehandle none
				!tempindex = !padnums.findfirst(!padnum)
				if !tempindex.unset() then
					!padnums.append(!padnum)
					!groupnums[!padnums.size()] = array()
					!groupnums[!padnums.size()].append(!x)
				else
					!groupnums[!tempindex].append(!x)
				endif
			endhandle
		enddo


		-----------------------
		-----------------------merge groups with same pad number
		!consideredIndices = array()
		do !x indices !padnums
			if !groupnums[!x].size() ge 2 then
				do !y from 2 to !groupnums[!x].size()
					!lugindices[!groupnums[!x][1]].appendarray(!lugindices[!groupnums[!x][!y]])
					!lugindices[!groupnums[!x][!y]].delete()
					!consideredIndices.append(!groupnums[!x][1])
				enddo
			endif
		enddo

		!indices = !lugindices.indices()
		!difindices = !indices.difference(!consideredIndices)
		-----------------------
		-----------------------difindices is indices of rest groups which without same pad number with other groups



		--------------------------------------
		--------------------------------------Step 2:if there are some lugs not sure they are in one group or not with other lugs
		--------------------------------------
		--------------------------------------Step 3:use dir,bore and distance to identify
		-----------------------
		-----------------------get dir bore and line for each group
		!lines = array()
		!bores = array()
		!poss = array()
		!dirs = array()

		!tolerancetimes = 2.5
		do !index values !difindices
			!object = !attadatas[!lugindices[!index][1]]
			!attapos = !object.attapos
			!atta = !object.name

			--!bore = abore of pre tubi of $!atta
			--!dn = !bore.real().value()
			--!dir = dir of pre tubi of $!atta
			!temparr = !a.getattatube(!atta)
			!dn = !temparr[1]
			!dir = !temparr[2]
			!line = !attapos.offset(!dir, !tolerancetimes * !dn).line(!attapos.offset(!dir, - !tolerancetimes * !dn))
			!lines.append(!line)
			!bores.append(!dn)
			!poss.append(!attapos)
			!dirs.append(!dir)
		enddo


		--------------------------------------
		--------------------------------------Step 4:find group with same dir bore and distance is near than tolerance distance
		!groups = array()
		do !x from 1 to !difindices.size() - 1
			if !groups.findfirst(!x).set() then
				skip
			endif
			do !y from !x + 1 to !difindices.size()
				if !groups.findfirst(!y).set() then
					skip
				endif
				if !bores[!x] eq !bores[!y] and abs(!dirs[!x].angle(!dirs[!y]) - 90) gt 89.9 and !lines[!x].distance(!poss[!y]) lt !bores[!x] / 3 and !lines[!x].onprojected(!poss[!y]) then
					!groups.append(!x)
					!groups.append(!y)
					break
				endif
			enddo
		enddo

		-----------------------
		-----------------------merge groups
		do !x from 1 to !groups.size() by 2
			!lugindices[!difindices[!groups[!x]]].appendarray(!lugindices[!difindices[!groups[!x + 1]]])
			!lugindices[!difindices[!groups[!x + 1]]].delete()
		enddo

		--------------------------------------
		--------------------------------------Step 5:consider each one ofrest lug as one group
		--------------------------------------
		--------------------------------------Step 6:generate attaclass for each group
		!lugindices.compress()
		!attaclass.appendarray(!lugindices)
	endif

	--------------------------------------
	--------------------------------------Step 6:return result: attadatas contains data for each atta,attaclass is group of indices of atta
	--------------------------------------
	--------------------------------------Step 7:otherattas: all atta with geo, pointattas: all atta without geo
	!result = array()
	!result.append(!attadatas)
	!result.append(!attaclass)
	!result.append(!otherattas)
	!result.append(!pointattas)
	return !result
endmethod
$)

define method .addconcreteToPartobjects() $*add concrete to partobject
	!lnkis = array()
	var !lnkis append coll all lnki for $!this.suppname
	handle any
		var !lnkis append coll all lnki for $!this.struname
		handle any
		endhandle
		var !lnkis append coll all lnki for $!this.restname
		handle any
		endhandle
	endhandle
	do !lnki values !lnkis
		!lref = name of lref of $!lnki
		handle any
			skip
		elsehandle none
			!temptype = type of $!lref
			if !temptype inset ('WALL','GWALL','STWALL','FLOOR') then
				!this.dealparttype(!lref,'CONCRETE')
			endif
		endhandle
	enddo
endmethod

define method .addselfToPartobjects() $*add part of support to partobjects
	var !all coll all for $!this.suppname
	do !x indices !all
		!spref = name of spref of $!all[$!x]
		handle any
			if type of $!all[$!x] ne 'PANE' then
				!all[!x].delete()
			endif
		elsehandle none
			skip
		endhandle
	enddo
	!all.compress()
    --q var !all
	do !one values !all
		!onetype = type of $!one
		--$p $!onetype
        --q var !onetype
        --$p 4569
		if !onetype eq 'SCTN' or !onetype eq 'GENSEC' then
			!dtxr = dtxr of $!one
			handle any
				!dtxr = ''
			endhandle
			if !dtxr.match('钢板') ne 0 or !dtxr.match('扁钢') ne 0 then
				if !this.getpanenum(!one) gt 1 then
					!this.dealparttype(!one,'PANES')
				else
					!this.dealparttype(!one,'PANE')
				endif
				$(
				!mems = !this.getvalidmems(!one)
				var !spves coll all spve for $!mems[1]
				if !spves.size() ge 6 then
					!this.dealparttype(!one,'PANES')
				else
					if !mems.size() gt 1 then
						skip								$*---------------to deal
					endif
					!this.dealparttype(!one,'PANE')
				endif
				$)
			else
				!this.dealparttype(!one,'BEAM')
			endif
		elseif !onetype eq 'PANE' then
			!this.dealparttype(!one,'PANE')
		elseif !onetype eq 'FITTING' or !onetype eq 'FITT' then
			!this.dealparttype(!one,'PANE')
		elseif !onetype eq 'FIXING' then
			!this.dealparttype(!one,'PANE')
		elseif !onetype eq 'PJOI' then
			!this.dealparttype(!one,'BOLT')
		else
            --$p ggg
			if type of owner of $!one eq 'HANG' then
				if type of $!one eq 'PCLA' then
                    !dtxr = dtxr of $!one
					handle any
						!dtxr = ''
					endhandle
                    --modify by jyg 20250226 解决pcla类型的钢板没有标注尺寸信息的问题
                    --q var !dtxr
                    if  !dtxr.match('R') ne 0 then
                        --解决R63类型板hele类型有标注\pacla类型没有标注的问题,用于计算标注尺寸
                        var !partcate name of cate of catref of $!one
                        if  !partcate inset ('/PHB-CATE-RC','/PHB-CATE-RI')then
                            !this.dealparttype(!one,'PANES')
                        else
                            !this.dealparttype(!one,'PANE')
                        endif
                    else
                        !this.dealparttype(!one,'CLAMP')
                    endif
				else
                    --$p 147
					!dtxr = dtxr of $!one
					handle any
						!dtxr = ''
					endhandle
					--q var !dtxr
					if !dtxr.match('螺') ne 0 then
						!this.dealparttype(!one,'BOLT')
					else
						--!dtxr = dtxr of $!one
						if !dtxr.match('钢板') ne 0 or !dtxr.match('扁钢') ne 0 then
                            --$p 147
							if !this.getpanenum(!one) gt 1 then
                            --$p 222
								!this.dealparttype(!one,'PANES')
							else
								!this.dealparttype(!one,'PANE')
							endif
                        elseif !dtxr.match('R') ne 0 then  $* modify by jyg 20240829
                            --q var !this.getpanenum(!one)
							if !this.getpanenum(!one) gt 1 then
								!this.dealparttype(!one,'PANES')
							else
								!this.dealparttype(!one,'PANE')
							endif

						else
                            --$p 88
                            --q var !one
							!temparr = !this.gettypenumber(!one)
                            --q var !temparr[1] !temparr[2]
							if !temparr[1].size() ne 1 then
                            --$p 112
								!this.dealparttype(!one,'MORETHANONE')
							else
								!apos = apos of $!one wrt/*
								!lpos = lpos of $!one wrt/*
								if !apos.distance(!lpos) lt 1 then
									!this.dealparttype(!one,'POINT')
								else
									!this.dealparttype(!one,'CONNECT')
								endif
							endif
						endif
					endif
				endif
			else
				!this.dealparttype(!one,'OTHER')
			endif
		endif
	enddo
endmethod

define method .getpanenum(!one is any) is real
	!panenum = 0
	!mems = !this.getvalidmems(!one)
	do !mem values !mems
		if type of $!mem eq 'SPRO' then
			var !spves coll all spve for $!mem
			!num = int((!spves.size() - 2) / 2)
			!panenum = !panenum + !num
		elseif type of $!mem eq 'SBOX' then
			!panenum = !panenum + 1
		endif
	enddo
	return !panenum
endmethod

define method .gettypenumber(!one is any) is array
	!types = array()
	!numbers = array()
	!mems = !this.getvalidmems(!one)
	do !mem values !mems
		!panenum = 0
		!panesnum = 0
		!tubenum = 0
		--!sextnum = 0
		!type = type of $!mem
		if !type eq 'SPRO' then
			var !spves coll all spve for $!mem
			!num = int((!spves.size() - 2) / 2)
			!panesnum = 1
		elseif !type eq 'SBOX' then
			!panenum = 1
		elseif !type eq 'SCYL' then
			!tubenum = 1
		--elseif !type eq 'SEXT' then
		--	!sextnum = 1
		endif

		if !panenum ne 0 then
			!index = !types.findfirst('PANE')
			if !index.unset() then
				!types.append('PANE')
				!numbers.append(!panenum)
			else
				!numbers[!index] = !numbers[!index] + !panenum
			endif
		endif
		if !panesnum ne 0 then
			!index = !types.findfirst('PANES')
			if !index.unset() then
				!types.append('PANES')
				!numbers.append(!panesnum)
			else
				!numbers[!index] = !numbers[!index] + !panesnum
			endif
		endif

		if !tubenum ne 0 then
			!index = !types.findfirst('TUBE')
			if !index.unset() then
				!types.append('TUBE')
				!numbers.append(!tubenum)
			else
				!numbers[!index] = !numbers[!index] + !tubenum
			endif
		endif

		$(
		if !sextnum ne 0 then
			!index = !types.findfirst('SEXT')
			if !index.unset() then
				!types.append('SEXT')
				!numbers.append(!SEXTnum)
			else
				!numbers[!index] = !numbers[!index] + !SEXTnum
			endif
		endif
		$)
	enddo
	!result = array()
	!result[1] = !types
	!result[2] = !numbers
	return !result
endmethod

define method .dealparttype(!item is string, !type is string ) $*add item according type into partobjects
--$p 11
--q var !item !type
	if !type eq 'MORETHANONE' then
		!mems = !this.getvalidmems(!item)
		do !mem values !mems
			!memtype = type of $!mem
			!memstring = !mem.string()
            --q var !memtype
			if !memtype eq 'SBOX' then
			--q var !item !memstring
				!object = object supppane(!item,!memstring)
				!index = !this.parttypes.findfirst('PANE')
			elseif !memtype eq 'SPRO' then
				!object = object supppanes(!item,!memstring)
				!index = !this.parttypes.findfirst('PANES')
			elseif !memtype eq 'SCYL' or !memtype eq 'LCYL' then
				!object = object supptube(!item,!memstring)
				!index = !this.parttypes.findfirst('TUBE')
			elseif !memtype eq 'SEXT' then
				!object = object supppane(!item,!memstring)
				!index = !this.parttypes.findfirst('PANE')
			else
				--$p $!memtype $!mem
				skip
			endif

			!this.partobjects.append(!object)
			!this.parttypeindices[!index].append(!this.partobjects.maxindex())
			!object.delete()
		enddo
	else
	--if !type eq 'CONCRETE' then

	--endif
        --$p 33
		!index = !this.parttypes.findfirst(!type)
		!com = '!object = object supp' & !type & '(!item)'
		--q var !com
		$!com
		handle any
			$p $!item cant be got as $!type
		elsehandle none
            --q var !object
            --$p 66
			!this.partobjects.append(!object)
			--q var !object !this.partobjects !this.parttypes !type
            --q var !this.partobjects.maxindex()
			!this.parttypeindices[!index].append(!this.partobjects.maxindex())
		endhandle
	endif
endmethod


define method .getvalidmems(!item is any) is array $*get good items from catref
	!mems = mem of gmref of catref of $!item
	handle any
		!mems = mem of gstref of catref of $!item
		handle any
			!mems = array()
			return !mems
		endhandle
	endhandle
    --q var !mems
	do !x indices !mems
		if !this.checkvalid(!mems[!x]).not()  then
			!mems[!x].delete()
		endif
	enddo
	!mems.compress()
    --q var !mems
	return !mems
endmethod

define method .checkvalid(!mem is any) is boolean $*check if cata element is valid
	!tuflag = tuflag of $!mem
	handle any
	elsehandle none
		if !tuflag.not() then
			return false
		endif
	endhandle

	!level = level of $!mem
	if !level[1] gt 6 or !level[2] lt 6 then
		return false
	endif

	!obst = obstruction of $!mem
	if !obst ne 2 and !obst ne 0 then
		return false
	endif
	return true
endmethod


define method .getLineData() is boolean $*old way to get geo data of support to draw
	!this.clear()
	if !this.mbdstru.mbdstru.unset() then
		return false
	endif


	--get dim lines and add object (pane panesctn hang sctn leg) into line
	!this.getDirObjectAndLines()


	--put intersection point between lines into line
	!this.addInterPointToLine()



	--put atta point which is near line
	!this.addATTApointToLine()
	--$p asdf

	--q var !this.restattapoints
	if !this.restattapoints.set() then
		--add rest atta, and generate new line
		!this.addrestattapoints()
	endif


	!this.reGetMaxDiss()

	return true
endmethod


define method .getvolume() is volume

--q var !this.suppname !this.struname !this.restname
$(
	!volume = object volume(object dbref(!this.suppname))
	handle any
		!volume = object volume(object dbref(!this.struname))
		handle any
			!volume = object volume(object dbref(!this.restname))
			handle any
			endhandle
		endhandle
	endhandle

	!toobig = 10000
	if (!volume.to.east - !volume.from.east gt !toobig or !volume.to.north - !volume.from.north gt !toobig or !volume.to.up - !volume.from.up gt !toobig) or $
	(!volume.from.east le 0 and !volume.to.east gt 0 and !volume.from.north le 0 and !volume.to.north gt 0 and !volume.from.up le 0 and !volume.to.up gt 0) then
	$)
		var !items coll all frmw mem for $!this.suppname
		var !items append coll all hang mem for $!this.suppname
		!volume = object volume()
		!volume.from = e 100000000 n 100000000 u 100000000
		!volume.to = e -100000000 n -100000000 u -100000000
		do !item values !items
            !itemType = type of $!item
            --modify by jyg 20240829
            if !itemType inset ('LNKS','LNKI')then
                skip
            endif
            if  !itemType inset('SCTN')then
                !itemSpref = spref of $!item
                if !itemSpref.unset() then
                    skip
                endif
            endif
            --
			!onevolume = object volume(object dbref(!item))
			!volume.from.east = min(!volume.from.east,!onevolume.from.east)
			!volume.from.north = min(!volume.from.north,!onevolume.from.north)
			!volume.from.up = min(!volume.from.up,!onevolume.from.up)

			!volume.to.east = max(!volume.to.east,!onevolume.to.east)
			!volume.to.north = max(!volume.to.north,!onevolume.to.north)
			!volume.to.up = max(!volume.to.up,!onevolume.to.up)
		enddo
	--endif

	return !volume
endmethod
define method .getcheight()
	!maxdis = 0
	do !object values !this.partobjects
		if !object.objecttype() eq 'SUPPBEAM' then
			!maxdis = max(!maxdis,!object.poss[1].distance(!object.poss[2]))
			!maxdis = max(!maxdis,!object.poss[3].distance(!object.poss[2]))
		elseif !object.objecttype() eq 'SUPPTUBE' then
			!maxdis = max(!maxdis,!object.outdia)
		endif
	enddo
	if !maxdis ne 0 then
		!this.cheight = !maxdis * !this.cheightbili
	else
		!volume = !this.getvolume()
		!this.cheight = !this.cheightbili * !volume.from.distance(!volume.to) * 0.1
	endif
endmethod

define method .draw() $*draw dim and mlabel
	clock init
	!this.getcheight()
	--------------------------------------
	--------------------------------------Step 1:new way
	if !this.mbdstru.deletedim().not() or !this.mbdstru.deleteaid().not() then
		!!alert.warning('No right to delete element')
		return
	endif
	if !this.mbdstru.todim().not() or !this.mbdstru.toaid().not() then
		!!alert.warning('No right to create element')
		return
	endif
	if !this.partobjects.unset() then
		!this.getparts()
	endif
	!this.gettextindexs()
	--q var !this.drawtype
	if !this.drawtype eq 'INSTSUPP' then
		!locationpos = !this.getlocationposition()
		!mbdlocation = object mbdlocation(!locationpos,!this.suppname)
		!lookdir = !mbdlocation.getlookdir()
	else
		!lookdir = object direction()
	endif
    --q var  !this.partobjects[1].Profile.Draw(1,2,3) !this.partconnections !this.textindexs !this.cheight !lookdir
	!this.planeSystem = object planesystem(!this.partobjects,!this.partconnections,!this.textindexs,!this.cheight,!lookdir)
    --q var !this.planeSystem

	!shapes = !this.planesystem.realShapes

	!dimlines = !this.planeSystem.dimlines

	!horiori = z is u
    --q var !this.planeSystem.dirobject.cenpoint !horiori
	!horiplane = object plane(!this.planeSystem.dirobject.cenpoint,!horiori)
    handle any
        --modify by jyg 20240829
    endhandle
	!horilookdir = !this.planesystem.dirobject.threeddir.projected(!horiplane)
	handle any
	endhandle
    --q var !dimlines
	do !x indices !dimlines
		!dimline = !dimlines[!x]
        --q var !dimline
        --!dimline.axis.Draw(1,2,3)
		do !shape values !shapes
			if !shape.dimlineindex eq !x then
				!poss = !shape.poss
				!ori = !shape.planeori
				!ydir = !ori.ydir()

				!tempangle = !ydir.angle(u)
				if !tempangle gt 85 and defined(!horilookdir) then	$*几乎水平的要考虑视角
					if !ydir.angle(!horilookdir) gt 90 then
						!ydir = !ydir.opposite()
					endif
				endif
				--if !ydir.angle(!this.planesystem.dirobject.threeddir) gt 90 then
				--	!ydir = !ydir.opposite()
				--endif
				!zdir = !ori.zdir().opposite()

				if !zdir.angle(u) gt 91 then
					!zdir = !zdir.opposite()

					!tempposs = array()
					!tempposs[1] = !poss[2]
					!tempposs[2] = !poss[1]
					!tempposs[3] = !poss[4]
					!tempposs[4] = !poss[3]

					!poss = !tempposs
				endif

				!ori = y is $!ydir and z is $!zdir
				break
			endif
		enddo

		!tempdir = !poss[1].direction(!poss[4])

		!move = false
		if !move then
			if !tempdir.angle(!ydir) lt 90 then
				!dimpos = !poss[4].offset(!tempdir.opposite(),!this.cheight * 1.5 * 1.25)
			else
				!dimpos = !poss[4].offset(!ydir,!this.cheight * 1.5 * 0.25)
			endif
		else
			if !tempdir.angle(!ydir) lt 90 then
				!dimpos = !poss[4].offset(!tempdir.opposite(),!this.cheight * 1.5)
			else
				!dimpos = !poss[4]
			endif
		endif




		if !dimline.class eq 1 then
			!functiontext = '一级尺寸'
		elseif !dimline.class eq 2 then
			!functiontext = '二级尺寸'
		elseif !dimline.class eq 3 then
			!functiontext = '三级尺寸'
		elseif !dimline.class eq 4 then
			!functiontext = '四级尺寸'
		elseif !dimline.class eq 5 then
			!functiontext = '定位尺寸'
		endif


		--!this.sepSmallDim = true
		--!this.changeCheightAuto = false
		--!this.cheight = 5
		!temparr = array()
		!temparr.append(!this.changecheightauto)
		!temparr.append(!this.changecheightautobili)
		!temparr.append(!this.sepSmallDim)

		--!lindim = object lindim(!this.mbdstru.dimgro,!dimpos, !ori, !dimline.poss, !this.cheight,!functiontext,'node:' + !this.nodename,!this.changeCheightAuto,!this.sepSmallDim)

        !lindim = object lindim(!this.mbdstru.dimgro,!dimpos, !ori, !dimline.poss, !this.cheight,!functiontext,'node:' + !this.nodename,!temparr)
	enddo

    --modify by jyg 20250227 处理dimlines为空时，没有标注信息的情况
    if  !dimlines.unset() then
        do  !partone values !this.partobjects
            if  !partone.objecttype() eq 'SUPPPANE' then
                !partname = !partone.mems[1]
                !cenpos = !partname.dbref().pos.wrt( world )
                var !partcate name of cate of catref of $!partname
                if  !partcate eq '/PHB-CATE-RA'then
                    !partEdges = !partone.Profile.Edges()
                    !functiontext = '一级尺寸'
                    !partori = !partone.Profile.ORIENTATION
                    !xdir = !partori.xdir()
                    !ydir = !partori.ydir()
                    !zdir = !partori.zdir()
                    !temparr = array()
                    !temparr.append(!this.changecheightauto)
                    !temparr.append(!this.changecheightautobili)
                    !temparr.append(!this.sepSmallDim)


                    !pos1 = !partEdges[1].StartPosition
                    !pos2 = !partEdges[1].EndPosition
                    !dimpos = array()
                    !dimpos.append(!pos1)
                    !dimpos.append(!pos2)
                    !midpos = !pos1.midpoint(!pos2)
                    !xdir = !partori.xdir()
                    !midpos = !midpos.Offset(!ydir,!this.cheight * 2)
                    !ori = x is $!xdir and z is $!zdir
                    !lindim = object lindim(!this.mbdstru.dimgro,!midpos,!ori,!dimpos,!this.cheight,!functiontext,'node:' + !this.nodename,!temparr)

                    !pos1 = !partEdges[2].StartPosition
                    !pos2 = !partEdges[2].EndPosition
                    !dimpos = array()
                    !dimpos.append(!pos1)
                    !dimpos.append(!pos2)
                    !midpos = !pos1.midpoint(!pos2)
                    !xdir = !partori.xdir().opposite()
                    !midpos = !midpos.Offset(!xdir,!this.cheight)
                    !ori = y is $!xdir and z is $!zdir
                    !lindim = object lindim(!this.mbdstru.dimgro,!midpos,!ori,!dimpos,!this.cheight,!functiontext,'node:' + !this.nodename,!temparr)
                endif
            endif
        enddo
    endif





	if !this.drawtype eq 'INSTSUPP' then
		--!locationpos = !this.getlocationposition()
		--!mbdlocation = object mbdlocation(!locationpos,!this.suppname)
        --q var !mbdlocation
        --jyg注释 标注墙面信息方法
		!mbdlocation.draw(!this.cheight,0,true,false,false,false)
	endif

	--!functiontext = '材料'
	!textindexs = !this.textindexs
    --q var !textindexs
	do !x indices !textindexs
		!textindex = !textindexs[!x]
        --q var !textindex
		!functiontext = !textindex[3]
		--if !textindex[2].objecttype() eq 'REAL' then
		--	!functiontext = '材料'
		--else
		--	!functiontext = '焊缝'
		--endif
		!find = false
        --q var !shapes[1]
		do !shape values !shapes
			if !shape.mlabelindex eq !x then
				!poss = !shape.poss
				!ori = !shape.planeori
				!ydir = !ori.ydir()

				$(
				if !ydir.angle(u) gt 95 then
					!ydir = !ydir.opposite()
					!temppos = !poss[1]
					!poss[1] = !poss[4]
					!poss[4] = !temppos

					!temppos = !poss[3]
					!poss[3] = !poss[2]
					!poss[2] = !temppos
				endif
				!zdir = !ori.zdir().opposite()

				!temppos = !poss[1]
				!poss[1] = !poss[2]
				!poss[2] = !temppos

				!temppos = !poss[3]
				!poss[3] = !poss[4]
				!poss[4] = !temppos

				!ori = y is $!ydir and z is $!zdir
				$)
				--$(
				!tempangle = !ydir.angle(u)
				if !tempangle gt 85 and defined(!horilookdir) then	$*几乎水平的要考虑视角
					if !ydir.angle(!horilookdir) gt 90 then
						!ydir = !ydir.opposite()
						!tempposs = array()
						!tempposs[1] = !poss[3]
						!tempposs[2] = !poss[4]
						!tempposs[3] = !poss[1]
						!tempposs[4] = !poss[2]

						!poss = !tempposs
					endif
				endif

				!zdir = !ori.zdir()
				!ori = y is $!ydir and z is $!zdir
				--$)

				!linepos = !shape.mlabellinepos

				!find = true
				break
			endif
		enddo
        --q var !find
		if !find then
			!frame = false

			!mlabelpos = !poss[1].offset(!ori.xdir(),!this.cheight * 0.5).offset(!ori.ydir(),!this.cheight * 1)
			--!!3l(!mlabelpos,!poss,!ori,!textindex[1])
            --modify by jyg  20240904
            --q var !this.textMater
            if  !this.textMater then
            --$p 123
                !mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!ori,!textindex[1],!this.cheight,!frame,!functiontext,!linepos,'node:' + !this.nodename)
            endif
        endif

	enddo

	--!this.drawpadlugleg()

	--q var !this.partobjects[4]
    --do  !partobject values !this.partobjects
    --    q var !partobject.mems !partobject
    --enddo
    --modify by jyg 20250224 增加仪表架标注坐标功能
    var !allSctn coll all sctn for $!<this.struName>
    if  !allSctn.size() gt 0 and !this.drawtype eq 'INSTSUPP' then
        !intoDo = false
        !intoDo2 = false
        do  !sctn values !allSctn
            !cutlen = cutl of $!sctn
            if  !cutlen.value() eq 0 then
                !intoDo = true
                break
            else
                !intoDo2 = true
            endif
        enddo
        --标记墙装安装版的坐标信息
        if  !intoDo then
            !textoffsetdis = 5
            do  !partobject values !this.partobjects
                if  not !partobject.objecttype() inset ('SUPPPANES','SUPPPANE') then
                    skip
                endif
                --q var !partobject.objecttype()
                if  !partobject.objecttype() eq 'SUPPPANE' then
                    !partname = !partobject.mems[1]
                    var !partcate name of cate of catref of $!partname
                    if  !partcate eq '/PHB-CATE-RA'then
                        !tempdir = !partname.dbref().ldir.wrt( world )
                        !cenpos = !partname.dbref().pos.wrt( world )
                        !cenori = z is $!tempdir
                    elseif  !partcate inset ('/PHB-CATE-RI','/PHB-CATE-RC')then
                        !partOri = !partname.dbref().ori.wrt( world )
                        !tempdir =  !partOri.xdir()
                        var !partp3 p3pos of $!partname wrt /*
                        var !partp4 p4pos of $!partname wrt /*
                        !cenpos = !partp3.position().midpoint(!partp4.position())
                    else
                        skip
                    endif
                else
                    --$P 123
                    !partname = !partobject.name
                    var !partcate name of cate of catref of $!partname

                    if  !partcate inset ('/PHB-CATE-RI','/PHB-CATE-RC')then
                        !partOri = !partname.dbref().ori.wrt( world )
                        !tempdir =  !partOri.xdir()
                        var !partp3 p3pos of $!partname wrt /*
                        var !partp4 p4pos of $!partname wrt /*
                        !cenpos = !partp3.position().midpoint(!partp4.position())
                    else
                        --处理普通安装板
                        !tempdir = !partname.dbref().ldir.wrt( world )
                        !cenpos = !partname.dbref().pos.wrt( world )
                        !cenori = z is $!tempdir
                        var !partvol vol  $!partname
                        !pos1 = !partvol.Before('to')
                        !pos2 = !partvol.After('to')
                        !partPos1 = !pos1.position().wrt( world )
                        !partPos2 = !pos2.position().wrt( world )
                        --pin1 at $!partPos1
                        --pin2 at $!partPos2
                        !plane1 = object plane(!partPos1,!cenori)
                        !plane2 = object plane(!partPos2,!cenori)
                        !nearPos1 = !plane1.Near(!cenpos)
                        !nearPos2 = !plane2.Near(!cenpos)
                        !dist1 = !nearPos1.distance(!cenpos)
                        !dist2 = !nearPos2.distance(!cenpos)
                        if  !dist1 le !dist2 then
                            !cenpos = !nearPos2
                        else
                            !cenpos = !nearPos1
                        endif
                    endif
                endif
                --pin3 at $!cenpos
                !newcenpos = !cenpos
                !partDtxr = !partname.dbref().dtxr.part(1,',')
                handle any
                    !partDtxr = '  '
                endhandle
                var !volume volume $!partname
                !up = !volume.after(' to ').position().up + !textOffSetDis
                !cenpos.up = !up

                !movedir = !tempdir.opposite()
                !volume1 = !volume.before(' to ').position()
                !volume2 = !volume.after(' to ').position()
                !volume1.up = !volume2.up
                --pin1 at $!volume1
                --pin2 at $!volume2
                !movedis =  3 * !this.cheight
                --q var !tempdir
                !ori = y is $!tempdir and z is u

                !length = !partDtxr.length() * !this.cheight
                !cenpos = !cenpos.offset(!ori.xdir(), - !length / 4)

                !this.mbdstru.todim()
                !owner = name
                !cenpos = !cenpos.offset(!movedir,!movedis)
                !desc = 'node:' + !this.nodename
                !equiname = !partDtxr
                --pin1 at $!newcenpos
                --q var !newcenpos
                --$p 123
                !mlabel = object mlabel(!owner,!cenpos,!ori,!equiname,!this.cheight,false,'位号',!newcenpos,!desc)
                --$p 789
                !xpos = !newcenpos.east
                !ypos = !newcenpos.north
                !zpos = !newcenpos.up
                if !xpos gt 0 then
                    !xstring = 'X +' + !xpos.string('D1').before('mm').before('.0')
                else
                    !xstring = 'X ' + !xpos.string('D1').before('mm').before('.0')
                endif
                if !ypos gt 0 then
                    !ystring = 'Y +' + !ypos.string('D1').before('mm').before('.0')
                else
                    !ystring = 'Y ' + !ypos.string('D1').before('mm').before('.0')
                endif

                if !zpos gt 0 then
                    !zstring = 'PE +' + !zpos.string('D1').before('mm').before('.0')
                else
                    !zstring = 'PE ' + !zpos.string('D1').before('mm').before('.0')
                endif
                !mlabelpos = !cenpos.offset(!movedir, 1.2 * !this.cheight)
                !mlabel = object mlabel(!owner,!mlabelpos,!ori,!xstring,!this.cheight,false,'坐标信息','',!desc)
                !mlabelpos = !mlabelpos.offset(!movedir, 1.2 * !this.cheight)
                !mlabel = object mlabel(!owner,!mlabelpos,!ori,!Ystring,!this.cheight,false,'坐标信息','',!desc)
                !mlabelpos = !mlabelpos.offset(!movedir, 1.2 * !this.cheight)
                !mlabel = object mlabel(!owner,!mlabelpos,!ori,!Zstring,!this.cheight,false,'坐标信息','',!desc)
            enddo
        endif

        --标记就地安装仪表支架底板的坐标信息
        if  !intoDo2 then
            !textoffsetdis = 10
            !partLog = array()
            --q var !this.partobjects
            do  !partobject values !this.partobjects
                if not !partobject.objecttype() inset ('SUPPPANE','SUPPPANES') then
                    skip
                endif
                !partname = !partobject.mems[1]
                --q var !partname
                !partDtxr1 = !partname.dbref().dtxr
                handle any
                    !partDtxr1 = '  '
                endhandle

                !ori = !partobject.mems[1].dbref().ori.wrt( world )

                if  !partDtxr1.Matchwild('*液位控制器墙装支架*') then
                    !oriYdir = !ori.zdir()
                elseif  !partDtxr1.Matchwild('*凸面对焊法兰*') then
                    !oriYdir = !ori.zdir()
                else
                    !oriYdir = !ori.ydir()
                endif

                if  !oriYdir.angle(U) inset(0,180) then
                    if  !partDtxr1.Matchwild('*液位控制器墙装支架*') then
                        !partMidPos = pos of $!partname wrt/*      $*物项中心点坐标
                        !cenpos =  !partMidPos.Offset(!ori.xdir().opposite(),20)     $*标签起点坐标
                    elseif  !partDtxr1.Matchwild('*凸面对焊法兰*') then
                        !partMidPos = pos of $!partname wrt/*      $*物项中心点坐标
                        !cenpos =  !partMidPos.Offset(!ori.xdir().opposite(),20)     $*标签起点坐标
                    else
                        var !partvol vol  $!partname
                        !pos1 = !partvol.Before('to')
                        !pos2 = !partvol.After('to')
                        !partPos1 = !pos1.position().wrt( world )
                        !partPos2 = !pos2.position().wrt( world )
                        !partMidPos = !partPos1.midpoint(!partPos2)
                        if  !partPos1.up gt !partPos2.up then
                            !partMidPos.up =  !partPos2.up
                            !cenpos = !partPos1
                        else
                            !partMidPos.up =  !partPos1.up
                            !cenpos = !partPos2
                        endif
                    endif

                    --q var !partMidPos
                    !partDtxr = !partobject.mems[1].dbref().dtxr.part(1,',')
                    handle any
                        !partDtxr = '  '
                    endhandle
                    !length = !partDtxr.length() * !this.cheight
                    !cenpos = !cenpos.offset(U, !length )
                    !cenpos.up = !cenpos.up + !textOffSetDis

                    !this.mbdstru.todim()
                    !owner = name
                    !desc = 'node:' + !this.nodename
                    !equiname = !partDtxr

                    if  !partDtxr1.Matchwild('*液位控制器墙装支架*') then
                        !ydir = !ori.ydir()
                        !ori = y is u and z is $!ydir
                    elseif  !partDtxr1.Matchwild('*凸面对焊法兰*') then
                        !ydir = !ori.ydir()
                        !ori = y is u and z is $!ydir
                    else
                        !ori = y is u
                    endif
                    --pin1 at $!partMidPos
                    --q var !partMidPos
                    !mlabel = object mlabel(!owner,!cenpos,!ori,!equiname,!this.cheight,false,'位号',!partMidPos,!desc)

                    !xpos = !partMidPos.east
                    !ypos = !partMidPos.north
                    !zpos = !partMidPos.up
                    if !xpos gt 0 then
                        !xstring = 'X +' + !xpos.string('D1').before('mm').before('.0')
                    else
                        !xstring = 'X ' + !xpos.string('D1').before('mm').before('.0')
                    endif
                    if !ypos gt 0 then
                        !ystring = 'Y +' + !ypos.string('D1').before('mm').before('.0')
                    else
                        !ystring = 'Y ' + !ypos.string('D1').before('mm').before('.0')
                    endif

                    if !zpos gt 0 then
                        !zstring = 'PE +' + !zpos.string('D1').before('mm').before('.0')
                    else
                        !zstring = 'PE ' + !zpos.string('D1').before('mm').before('.0')
                    endif
                    !mlabelpos = !cenpos.offset(d, 1.2 * !this.cheight)
                    !mlabel = object mlabel(!owner,!mlabelpos,!ori,!xstring,!this.cheight,false,'坐标信息','',!desc)
                    !mlabelpos = !mlabelpos.offset(d, 1.2 * !this.cheight)
                    !mlabel = object mlabel(!owner,!mlabelpos,!ori,!Ystring,!this.cheight,false,'坐标信息','',!desc)
                    !mlabelpos = !mlabelpos.offset(d, 1.2 * !this.cheight)
                    !mlabel = object mlabel(!owner,!mlabelpos,!ori,!Zstring,!this.cheight,false,'坐标信息','',!desc)
                endif
            enddo
        endif
    endif
	!this.mbdstru.tostru()
	--enhance ce col blue
	$!this.struname

	if !this.generatejson then
		!this.generatejsonattrvm()
	endif
	clock read elapsed
	return

	$(
	--------------------------------------
	--------------------------------------Step 2:old way
	!this.cheight = !this.maxsctndis * !this.cheightbili
	if !this.mbdstru.deletedim().not() or !this.mbdstru.deleteaid().not() then
		!!alert.warning('No right to delete element')
		return
	endif
	if !this.mbdstru.todim().not() or !this.mbdstru.toaid().not() then
		!!alert.warning('No right to create element')
		return
	endif

	if !this.dirobject.unset() then
		!this.dirobject = object suilookdirections(!this.partobjects)
	endif


	!this.partobjects.evaluate(object block('!this.drawOneObject(!evalindex)'))
	$)
endmethod

define method .getlocationposition() is position
	!poss = array()
    --Q VAR !this.partobjects[1]
    --q var !this.partobjects
    --$p 123
	do !object values !this.partobjects
		!poss.appendarray(!this.getitemposs(!object))
	enddo
	return !!getcenpoint(!poss)
	--return !this.planesystem.dirobject.cenpoint
endmethod

define method .getitemposs(!item is any) is array
	!poss = array()
	!type = type of $!item
	handle any
		!type = !item.objecttype()
		handle any
			$p $!item has no type
			return !poss
		endhandle
	endhandle

    --modify by jyg 20240905
    if  !item.unset() then
        return !poss
    endif

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 1:object as (supppoint supppanes)
	if !type eq 'SUPPAPDP' then
		!poss.append(!item.pos)
	elseif !type eq 'SUPPBEAM' then
		!poss.append(!item.pos1)
		!poss.append(!item.pos2)
	elseif !type eq 'SUPPBOLT' then
		!poss.append(!item.apos)
		!poss.append(!item.lpos)
	elseif !type eq 'SUPPCLAMP' then
		!poss.append(!item.apos)
		if !item.lpos.set() then
			!poss.append(!item.lpos)
		endif
	elseif !type eq 'SUPPCONCRETE' then
		--$p $!type was not considered
	elseif !type eq 'SUPPCONNECT' then
		!poss.appendarray(!item.poss)
	elseif !type eq 'SUPPPANE' then
        --q var !item.profile
		!poss.appendarray(!this.getitemposs(!item.profile))
	elseif !type eq 'SUPPPANES' then
		do !profile values !item.profiles
			!poss.appendarray(!this.getitemposs(!profile))
		enddo
	elseif !type eq 'PROFILE' then
		!edges = !item.edges()
		do !edge values !edges
			!poss.appendarray(!this.getitemposs(!edge))
		enddo
	elseif !type eq 'SUPPPOINT' then
		!poss.append(!item.pos)
	elseif !type eq 'SUPPTUBE' then
		if abs(!item.pos1.distance(!item.pos2) - 2000) gt 0.1 then		$*supptube is pipe when length of it is 2000
			!poss.append(!item.pos1)
			!poss.append(!item.pos2)
		endif

		-----------------------------------------------------------------------------------
		-----------------------------------------------------------------------------------Step 2:component
	elseif !type eq 'SCTN' then
		!spos = posstart of $!item wrt/*
		!epos = posend of $!item wrt/*
		!poss.append(!spos)
		!poss.append(!epos)
	elseif !type eq 'GENSEC' then
		var !poinsps coll all poinsp for $!item
		!spos = pos of $!poinsps[1] wrt/*
		!lastp = !poinsps.last()
		!epos = pos of $!lastp wrt/*
		!poss.append(!spos)
		!poss.append(!epos)
	elseif !type eq 'HELE' then
		!spos = p1 pos of $!item wrt/*
		!epos = p2 pos of $!item wrt/*
		!poss.append(!spos)
		!poss.append(!epos)
	elseif !type eq 'PANE' or !type eq 'FLOOR' then
		var !ploos coll all ploo for $!item
		do !ploo values !ploos
			!poss.appendarray(!this.getitemposs(!ploo))
		enddo
	elseif !type eq 'PLOO' then
		!pro = object profile($!item)
		!pro.close()
		!poss.appendarray(!this.getitemposs(!pro))
	elseif !type eq 'LINE' then
		!poss.append(!item.startposition)
		!poss.append(!item.endposition)
	elseif !type eq 'ARC' then
		!poss.append(!item.position)
		!poss.append(!item.angleposition(!item.startangle))
		!poss.append(!item.angleposition(!item.endangle))
	else
		--$p $!type was not considered           suilookdirections
	endif
	return !poss
endmethod

define method .drawpadlugleg()
	do !pipeatta values !this.pipeattas
		do !tag values !pipeatta.tags
			!name = !tag.name
			do !oneobject values !pipeatta.attaobjects
				if !oneobject.name eq !name then
					!object = !oneobject
					break
				endif
			enddo

			if !object.objecttype() inset ('ISOLUG','ISOPAD') then
				!p3dir = !object.dir
			else
				!p3dir = !object.attapos.direction(!object.pos)
			endif
			if !object.objecttype() inset ('ISOPAD','ISOLUG') then
				!pos = !object.pos.offset(!object.dir,!object.routside)
			else
				!pos = !object.pos
			endif
			!infoarr = !tag.infoarr

			!mlabelpos = !pos.offset(!p3dir,!this.cheight * 2)
			if !object.objecttype() eq 'ISOPAD' then
				!function = '护板'
			elseif !object.objecttype() eq 'ISOLUG' then
				!function = '挡块'
			elseif !object.objecttype() eq 'ISOLEG' then
				!function = '支腿'
			endif

			if !object.objecttype() ne 'ISOLUG' then
				!tempdir = ldir of $!object.name
				!aod = aod of $!object.name
				if !aod eq 0 then
					!aod = !pos.distance(!object.attapos)
				endif
				!mlabelpos = !mlabelpos.offset(!tempdir,!aod / 2)
			endif

			!tempangle = !p3dir.angle(u)
			if !tempangle lt 30 or !tempangle gt 150 then
				do !dir values !this.dirObject.lookDirs
					!angle = !dir.angle(u)
					if !angle gt 45 and !angle lt 135 then
						!gooddir = !dir
						break
					endif
				enddo
				!xdir = !gooddir.orthogonal(u)
				!ori = x is $!xdir and y is u

				!dir = !xdir.bisect(u)
			else
				!tempdir = !p3dir.orthogonal(u)
				!dir = !p3dir.bisect(u)
				!ori = z is $!tempdir and y is u
			endif
			!mlabelpos = !mlabelpos.offset(!ori.ydir(),!this.cheight)
			!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!ori,!infoarr[1],!this.cheight,false,!function,!pos,'node:' + !this.nodename)
			!mlabelpos = !mlabelpos.offset(!ori.ydir(), - !this.cheight)
			!mlabel = object mlabel(!this.mbdstru.dimgro,!mlabelpos,!ori,!infoarr[2],!this.cheight,false,'标高',!pos,'node:' + !this.nodename)




			!object.delete()
		enddo
	enddo
endmethod

define method .getjsonarray() is array
	if !this.drawtype eq 'INSTSUPP' then
		!result = !this.getjsondata(!!markinstsuppform.materialAttS, !!markinstsuppform.materialAttShow,!!markinstsuppform.elematerialAttS, !!markinstsuppform.elematerialAttShow, !!markinstsuppform.suppAtts ,!!markinstsuppform.suppAttShow)
	else
		!result = !this.getjsondata(!!markinstpipesuppform.materialAttS, !!markinstpipesuppform.materialAttShow,!!markinstpipesuppform.elematerialAttS, !!markinstpipesuppform.elematerialAttShow, !!markinstpipesuppform.suppAtts ,!!markinstpipesuppform.suppAttShow)
	endif
	return !result
endmethod

define method .generatejsonattrvm() is array
	!filepaths = array()
	!filepath = !this.filepath
	!folder = object file(!filepath)
	if !folder.exists().not() then
		$p 存储路径不对 $!filepath
		return !filepaths
	endif
	!filename = !!getmbdfilename(!this.suppName)
	--!filename = !this.suppName.replace('=','_').replace('/','_').replace('\','_')

	--q var !this.drawtype
	!result = !this.getjsonarray()
	if !this.drawtype eq 'INSTSUPP' then

        --q var !!markinstsuppform.suppAtts !!markinstsuppform.suppAttShow
		--!result = !this.getjsondata(!!markinstsuppform.materialAttS, !!markinstsuppform.materialAttShow, !!markinstsuppform.suppAtts ,!!markinstsuppform.suppAttShow)
		!!markinstsuppform.instore(!result,!filename,!filepath)
	else
		--!result = !this.getjsondata(!!markinstpipesuppform.materialAttS, !!markinstpipesuppform.materialAttShow, !!markinstpipesuppform.suppAtts ,!!markinstpipesuppform.suppAttShow)
		!!markinstpipesuppform.instore(!result,!filename,!filepath)
	endif


	!newitems = array()
	!remitems = array()
	!newitems.append(!this.suppName)
	--!!getrvm(!newitems,!remitems,'D:\' & !filename & '.rvm')
	--!!getatt(!newitems,!remitems,'D:\' & !filename & '.att')

	!!getrvm(!newitems,!remitems,!filepath & !filename & '.rvm')
	!!getatt(!newitems,!remitems,!filepath & !filename & '.att')
	!!gettxt(!newitems,!filepath & !filename & '.txt')


	!filepaths.append(!filepath & !filename & '.json')
	!filepaths.append(!filepath & !filename & '.rvm')
	!filepaths.append(!filepath & !filename & '.att')
	!filepaths.append(!filepath & !filename & '.txt')
	return !filepaths
endmethod

define method .totplant()
	!filepaths = !this.generatejsonattrvm()
	!up = object updatefiles(!filepaths,'MBD-' & !this.drawtype)
endmethod

define method .deletestru() $*delete dim and mlabel
	!this.mbdstru.deletestru()
