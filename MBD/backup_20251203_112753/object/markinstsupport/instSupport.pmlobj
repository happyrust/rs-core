define method .getJsonData(!materialAttS is array, !materialAttShow is array, !elematerialAttS is array, !elematerialAttShow is array, !suppAtts is array ,!suppAttShow is array) is array $*public, return array of json data
	!jsonmem = object jsonmem()

	!jsonmem.node = !this.nodename
	--!jsonmem.code = !this.nodename

    --modify by jyg 20240923
    !jsonmem.refno = !this.nodename.Dbref().ref.string()

	!nbbm = :zd_nbbm of $!this.suppname
	handle any
		!jsonmem.code = !this.nodename
	elsehandle none
		if !nbbm.unset() or !nbbm eq '' then
			!jsonmem.code = !this.nodename
		else
			!jsonmem.code = !nbbm
		endif
	endhandle
	!jsonmem.rev = !this.rev

	if !this.drawtype eq 'INSTSUPP' then
		!jsonmem.type = 'EM9INSTSUPP'
	else
        --modify by jyg 20240912
		--!jsonmem.type = 'EM9INSTPIPESUPP'
        !jsonmem.type = 'EM9PIPESUPP'
	endif

     --modify by jyg 20250218 添加项目号
	var !E3DProject  pro num
    !jsonmem.E3DProject = !E3DProject

	--!jsonmem.type = 'SUPP'
	!jsonmem.content = !this.getDimJson()
	!jsonmem.material = !this.materialsJson(!materialAttS, !materialAttShow,!this.nodename)
	!jsonmem.separateMaterial = !this.specialmaterialsJson(!elematerialAttS, !elematerialAttShow,!this.nodename)
	!jsonmem.suppatt = !this.suppAttJson(!suppAtts, !suppAttShow,!this.nodename)
	!jsonmem.weld = !this.weldJson(!this.nodename)

	!jsonmem.drawingInfo = !this.getDrawingInfoJson(!this.nodename)
	!jsonmem.proofreading = !this.getproofreadingjson(!this.nodename)
	return !jsonmem.getjsontext()
endmethod

define method .getnodenameforsupp() $*get node name of support
	!tryname = name of $!this.suppname
	handle any
		!tryname = name of $!this.struname
		handle any
			!tryname = name of $!this.restname
		endhandle
	endhandle

	!this.nodename = !tryname
endmethod

define method .getDimJson() is array $*get json data for dim and mlabel
	!json = object json(!this.mbdstru.mbdstru)
	return !json.getJson()
endmethod

define method .materialsJson(!materialAttS is array, !materialAttShow is array, !tryname is string) is array $*get json data of materials
	!result = array()
	!materials = !this.sumMaterials(!materialAttS)
    --q var !this.materials[1] !this.materials[2]
    --q var !materials[2]  !materials[3]
	do !y indices !materials
		!rowarr = !materials[!y]
		!onearr = array()
		!onearr.append(|{|)
		do !x indices !rowarr
			!onearr.append(|"| + !materialAttShow[!x] + |": "| + !rowarr[!x].string().replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
			handle any
				!onearr.append(|"| + !materialAttShow[!x] + |": "| + '' + |",|)
			endhandle
			if !x eq !rowarr.size() then
				!onearr[!onearr.size()] = !onearr[!onearr.size()].substring(1,!onearr[!onearr.size()].length() - 1)
			endif
		enddo

		!onearr.insert(2,|"type":"suppMaterial",|)
		!onearr.insert(2,|"nodeNames":["| + !tryname + |"],|)


		!onearr.append(|},|)
		!result.appendarray(!onearr)
	enddo
	return !result
endmethod

define method .specialmaterialsJson(!materialAttS is array, !materialAttShow is array, !tryname is string ) is array $*get json data of component materials
	!result = array()
	!materials = !this.getspecialMaterials(!materialAttS)
    --q var !this.materials[1]  !this.materials[2]
    --q var !materials
    --q var !tryname

	do !y indices !materials
		!rowarr = !materials[!y]
        --q var !rowarr
		!onearr = array()
		!onearr.append(|{|)
		do !x indices !rowarr
			!onearr.append(|"| + !materialAttShow[!x] + |": "| + !rowarr[!x].string().replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
			handle any
				!onearr.append(|"| + !materialAttShow[!x] + |": "| + '' + |",|)
			endhandle
			if !x eq !rowarr.size() then
				!onearr[!onearr.size()] = !onearr[!onearr.size()].substring(1,!onearr[!onearr.size()].length() - 1)
			endif
		enddo

		!onearr.insert(2,|"type":"suppSpecialMaterial",|)
		!onearr.insert(2,|"nodeNames":["| + !tryname + |"],|)

        !onearr.insert(2,|"refno特殊说明":["| + |"],|)
        if  !this.materials.size() eq !materials.size() then
            !onearr.insert(2,|"refno":["| + !this.materials[!y].name.dbref().ref.string() + |"],|)
        else
            !onearr.insert(2,|"refno":["| + !tryname.dbref().ref.string() + |"],|)
        endif
		!onearr.append(|},|)
		!result.appendarray(!onearr)
	enddo
	return !result
endmethod


define method .suppAttJson(!suppAtts is array, !suppAttShow is array, !tryname is string ) is array $*get json data of attribution
	--!suppatts[1].delete() $*no need suppname
	--!suppAttShow[1].delete() $*no need suppname
	--!suppatts.compress()
	--!suppattshow.compress()
	--q var !suppAtts !suppAttShow
	!rowarr = !this.getsuppAttArr(!suppAtts)
	!rowarr.compress()
	!row = array()
	!row.append(|{|)
	do !x indices !rowarr
		!row.append(|"| + !suppAttShow[!x] + |": "| + !rowarr[!x].string().replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
		handle any
			!row.append(|"| + !suppAttShow[!x] + |": "| + '' + |",|)
		endhandle
		if !x eq !rowarr.size() then
			!row[!row.size()] = !row[!row.size()].substring(1,!row[!row.size()].length() - 1)
		endif
	enddo
	--!row.append(|}|)
	!row.append(|},|)

	!row.insert(2,|"type":"suppAttribution",|)
	!row.insert(2,|"nodeNames":["| + !tryname + |"],|)
	return !row
endmethod

define method .weldJson(!tryname is string) is array $*get json data of weld
	!maxnum = 16
	!arrs = !this.getweldlist()
	!rows = array()
	do !arr values !arrs
		!temparr = array()
		do !x indices !arr
			!temparr.append(!arr[!x])
			if !x / !maxnum eq int(!x / !maxnum) then
				!rows.append(!temparr)
				!temparr = array()
			elseif !x eq !arr.size() then
				!rows.append(!temparr)
			endif
		enddo
	enddo

	!resultarr = array()
	do !welds values !rows
		!result = array()
		!result.append(|{|)
		!result.append(|"weldText":[|)
		do !x indices !welds
			if !x ne !welds.size() then
				!result.append(|"| + !welds[!x] + |",|)
			else
				!result.append(|"| + !welds[!x] + |"|)
			endif
		enddo
		!result.append(|]|)
		!result.append(|},|)

		!result.insert(2,|"type":"suppWeld",|)
		!result.insert(2,|"nodeNames":["| + !tryname + |"],|)

		!resultarr.appendarray(!result)
	enddo
	return !resultarr
endmethod

define method .getProofreadingJson(!tryname is string) is array $*get json data of proofreading
	!row = !!getProofreadingJson(!this,!tryname)
	return !row
endmethod


define method .getDrawingInfoJson(!tryname is string) is array $*get json data of drawing
	!row = !!getdrawinginfojson(!this,!tryname)
	return !row
endmethod
