define object instSuppMaterial
    member .name is string
	member .spref is string
    member .type is string

	member .uniquecode is string

	member .order is real   				$*序号
	member .specialnum is string			$*分项序号

	----------from excel table s
	member .itemcode is string				$*编号
    member .desc is string   				$*品名
    member .ns is string   					$*型号
	member .material is string 				$*材料牌号
	member .materialstandard is string 		$*材料标准
	member .specstandard is string 			$*规格标准
	member .size is string					$*尺寸
	member .generateStyle is string			$*制造形式
	member .rccm is string					$*RCC-M
	member .qualitylevel is string			$*质保等级
	member .unit is string					$*单位
	member .perWeight is real				$*单重
	member .weightUnit is string			$*单重单位
	member .remark is string				$*备注
	----------from excel table e
	--member .dataarr is array				$*data from input data

    member .quantity is real   				$*数量
    member .weight is real   				$*重量
    member .rev is string   				$*Rev.


    member .mtxx is string					$*

	member .supptext is string

	member .changetype is string
endobject

define method .instSuppMaterial(!mem is string,!quantity is real)
    !this.name = !mem
    !this.type = type of $!mem
    --!pspec = name of spec of spref of $!mem
    !this.spref = name of spref of $!mem
	handle any
		--!this.usesuppmaterial(!mem,!quantity)
		--return
	endhandle
	--!this.itemcode = !this.spref.after(!pspec).substring(2).before(':')

	!this.itemcode = :itemcode of $!mem
	handle any

	endhandle
	if !this.itemcode.unset() or !this.itemcode eq '' then
		!specname = name of spec of $!this.spref
		handle any
		elsehandle none
			!this.itemcode = !this.spref.after(!specname + '/')
		endhandle
	endif

	!this.desc = desc of $!this.name
	handle any
		!this.desc = ''
	endhandle

	!this.uniquecode = !this.spref
	!this.ns = ''
	!this.material= dtxr of $!mem
	handle any
		!this.material = ''
	endhandle
	!this.materialstandard = ''
	!this.specstandard = ''
	!this.size = ''
	!this.generatestyle = ''
	!this.rccm = ''
	!this.qualitylevel = ''
	!this.unit = ''
	!this.perweight = 0
	!this.weightunit = ''
	!this.remark = ''


	--!this.rev = 'a'	$*暂时用这个
    --modify by jyg 20240731
	!rev = :ZD_Rev of zone of $!mem
    if !rev.empty() or !rev eq 'A' then
        !this.rev = 'a'
    elseif !rev eq 'A+' or !rev eq 'B' then
        !this.rev = 'b'
    endif




	!this.quantity = !quantity
	--q var !this.quantity
    !this.mtxx = mtxx of spref of $!mem
    handle any
        !this.mtxx = 'NA'
    endhandle

    if !this.perWeight.unset() then
        !this.weight = 0
	else
		!this.weight = !this.perWeight * !this.quantity.string().upcase().before('MM').before('IN').real()
    endif
endmethod

define method .useSuppMaterial(!mem is string,!quantity is real)
	!suppmaterial = object suppmaterial(!mem,!quantity)
	!atts = !this.attributes()

	--q var !atts
	do !att values !atts
		!setcom = '!this.' & !att & ' = !suppmaterial.' & !att
		$!setcom
		handle any
			$p $!setcom
		endhandle
	enddo
	if !this.quantity.unset() then
		!this.quantity = !quantity
	endif
	if !this.weight.unset() then
		!this.weight = 0
		!this.perWeight = 0
	endif
	if !this.mtxx.unset() then
		!this.mtxx = 'NA'
	endif
	if !this.rev.unset() then
		!this.rev = 'a'
	endif

endmethod
