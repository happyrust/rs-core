define object mlabel
	member .owner is string
	member .name is string
	member .pos is position
	member .ori is orientation
	member .stext is string
	member .cheight is real
	member .frame is boolean
	member .function is string			$*function for
	member .desc is string				$*nodenames
	member .dimpos is position
	member .dimppt is string
endobject

define method .mlabel(!item is any)
	!this.name = name of mlabel of $!item
	handle any
		return
	endhandle
	!this.owner = name of owner of $!this.name
	!this.pos = pos of $!this.name wrt/*
	!this.ori = ori of $!this.name wrt/*
	!this.stext = stext of $!this.name
	!this.cheight = cheight of $!this.name
	!this.frame = lframe of $!this.name
	!this.function = function of $!this.name
	!this.desc = desc of $!this.name
	!this.dimpos = pos of first dimpos of $!this.name wrt/*
	handle any
		!this.dimppt = name of posref of first dimppt of $!this.name
		handle any
		endhandle
	endhandle
endmethod

define method .mlabel(!where is any, !mlabelpos is position, !ori is orientation, !stext is string, !cheight is real, !frame is boolean, !function is string, !posorppt is any, !desc is string) is boolean
	--!mlabelpos 指向stext的坐标位置  先 mlabelpos
    --!posorppt 指向物项坐标点的位置  后 dimpos
    --Q VAR !where  !mlabelpos !ori  !stext  !cheight !frame  !function !posorppt !desc

    !this.owner = name of $!where
	handle any
		--$p no where
		return false
	endhandle
	!this.pos = !mlabelpos
	!this.ori = !ori

    --modify by jyg 20240926
    if !function eq '焊点' then
        !this.stext = !stext.Before('\').Before('/')
    else
        !this.stext = !stext
    endif

	!this.cheight = !cheight
	!this.frame = !frame

	if !function.trim() ne '' then
		!this.function = !function.trim()
	else
		!this.function = ''
		--!this.function = '其它'
	endif
	if !desc.trim() ne '' then
		!this.desc = !desc.trim()
	endif

	!otype = !posorppt.objecttype()
	if !otype eq 'STRING' then
		if !posorppt.trim() ne '' then
			!this.dimpos = !posorppt.position()
			handle any
				!dbref = !posorppt.dbref()
				handle any
				elsehandle none
					!this.dimppt = name of $!posorppt
				endhandle
			endhandle
		endif
	elseif !otype eq 'POSITION' then
		!this.dimpos = !posorppt
	elseif !otype eq 'DBREF' then
		!this.dimppt = name of $!posorppt
	endif

	return !this.create()
endmethod

define method .create() is boolean
	$!this.owner
	handle any
		return false
	endhandle

	new mlabel
	handle any
		return false
	endhandle

	if !this.name.set() then
		name $!this.name
		handle any
			return false
		endhandle
	else
		!this.name = name
	endif

	position $!this.pos
	cheight $!this.cheight
	ori $!this.ori
	lframe $!this.frame
    --q var !this.stext
	stext '$!this.stext'
	if !this.function.set() and !this.function.trim() ne '' then
		function '$!this.function'
	endif

	if !this.desc.set() and !this.desc.trim() ne '' then
		desc '$!this.desc'
	endif

	if !this.dimpos.set() then
		new dimpos
		pos $!this.dimpos
		!dimposdesc = !this.dimpos.string()
		desc '$!dimposdesc'
	elseif !this.dimppt.set() then
		new dimppt
		posref $!this.dimppt
	endif
	return true
endmethod

define method .json() is array
	!tplantisuseless = true


	!mlabel = !this.name


	!zone = name of CONVEY of $!mlabel
	handle any
		!zone = name of ZONE of $!mlabel
	endhandle
	if !zone.match('SUPP') ne 0 then
		!issupp = true
	else
		!issupp = false
	endif


	if !this.function eq 'MaterialText' or !this.function eq '材料' then
		if !issupp then
			!lframestring = '2'					$* 代表圆框
		else
			!lframestring = '1'					$* 代表方框
		endif
	else
		!Lframe = Lframe of $!mlabel
		if !lframe then
			if !issupp then
				!lframestring = '2'					$* 代表圆框
			else
				!lframestring = '1'					$* 代表方框
			endif
			$(
			!zone = name of zone of $!mlabel
			handle any
				!Lframestring = '1'
			elsehandle none
				if !zone.match('SUPP') ne 0 then
					!Lframestring = '2'
				else
					!Lframestring = '1'
				endif
			endhandle
			$)
		else
			!lframestring = '0'     $* 无框 2代表圆框
		endif
	endif

	if !tplantisuseless then
		!lframestring = '0'	$*因为Tplant开发不给力，我自己输出外框，不需要他们弄了
	endif

	if !this.dimpos.set() then
		!mempos = !this.dimpos
	elseif !this.dimppt.set() then
		!mempos = pos of $!this.dimppt wrt/*
	endif


	!result = array()
	!result.append(|{|)

	!result.append(!!getNodeNames(!mlabel))
	!result.append(|"type": "lableLine",|)
	--!result.append(|"function": "| + !this.function + |",|)

	if !this.function ne '' then
		!function = !this.function
		--!result.append(|"function": "| + !this.function + |",|)
	else
		!function = |其它|
		--!result.append(|"function": "| + |其它| + |",|)
	endif
	!result.append(|"function": "| + !function + |",|)

	!result.append(|"textPosition": [|)
	!result.appendarray(!!postoArr(!this.pos))
	!result.append(|],|)

	if !tplantisuseless.not() and defined(!mempos) then
		!result.append(|"position": [|)
		!result.appendarray(!!postoArr(!mempos))
		!result.append(|],|)
	endif

	!result.append(|"showEdge": "| + !lframestring + |",|)
	!result.append(|"textcheight": "| + !this.cheight.string().upcase().before('MM').before('IN') + |",|)
	!result.append(|"text": "| + !this.stext.replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
	!result.append(|"textOri": "| + !!oriToTplantAngle(!mlabel)[4] + |"|)
	!result.append(|},|)

	if !tplantisuseless and defined(!mempos) then
		!result.appendarray(!this.addleadline(!mempos,!function))
	endif

	return !result
endmethod

define method .addleadline(!dimpos is position, !function is string) is array
	!stext = stext of $!this.name
	--!len = !!mbdtextlen(!stext) * !this.cheight * 0.75
	!len = !!mbdtextlen(!stext) * !this.cheight
	!poss = array()
	!poss[1] = !this.pos
	!poss[2] = !this.pos.offset(!this.ori.xdir(),!len)
	!poss[3] = !poss[2].offset(!this.ori.ydir(),!this.cheight)
	!poss[4] = !poss[1].offset(!this.ori.ydir(),!this.cheight)
	!mindis = 1000000
	do !pos values !poss
		!onedis = !dimpos.distance(!pos)
		if !onedis lt !mindis then
			!mindis = !onedis
			!textpos = !pos
		endif
	enddo


	!result = array()
	!result.append(|{|)

	!result.append(!!getNodeNames(!this.name))
	!result.append(|"type": "line",|)
	!result.append(|"function": "| + !function + |",|)

	!result.append(|"position": [|)
	!result.appendarray(!!postoArr(!dimpos))
	!result[!result.size()] = !result[!result.size()] + ','
	!result.appendarray(!!postoArr(!textpos))
	!result.append(|]|)

	!result.append(|},|)
	return !result
endmethod


$(
define method .create(!where is any, !mlabelpos is position, !ori is orientation, !text is string, !cheight is real, !frame is boolean, !function is string, !posorppt is any) is boolean
	$!where
	new mlabel
	handle any
		return false
	endhandle
	position $!mlabelpos
	cheight $!cheight
	ori $!ori
	lframe $!frame
	stext '$!text'
	if !function.trim() ne '' then
		function '$!function'
	endif
	!otype = !posorppt.objecttype()
	if !otype eq 'STRING' then
		if !posorppt.trim() ne '' then
			!pos = !posorppt.position()
			handle any
				new dimppt
				posref $!posorppt
				handle any
					delete mlabel
					return false
				endhandle
			elsehandle none
				new dimpos
				pos $!pos
			endhandle
		endif
	elseif !otype eq 'POSITION' then
		new dimpos
		pos $!posorppt
	elseif !otype eq 'DBREF' then
		new dimppt
		posref $!posorppt
	endif
	return true
endmethod
$)


