--Method:
--Public method:
--getjsontext() is array													$* get result of json
--jsonmem() 																$* init method

--Private method:
--getarraytext(!title is string, !temparr is array) is array				$*
--getgoodformat(!array is array) is array   								$*



define object jsonmem
	member .node is string
	member .code is string
	member .type is string			$* 'ISO、支架、暖通、桥架、结构、设备' 'ISO SUPP INSTPIPE INSTPIPESUPP INSTSUPP EQUI CIVIL ARCH'
	member .rev is string

	member .content is array				$* type: lableLine arc circle line point text dim
	member .proofreading is array			$* type: check
	member .weld is array					$* type: branWeld
	member .drawingInfo is array			$* type: drawing

	--member .tabless is array
	member .zyjc is array					$* type:
	member .material is array				$* type: pipeMaterial
	member .separateMaterial is array		$* type: pipeSpecialMaterial
	member .cutPipeLength is array			$* type: cutpipelength
	member .branAtt is array				$* type: branAttribution
    member .annexMaterial is array		    $* type: annexMaterial


	member .suppatt is array

	member .equiatt is array

	member .civilatt is array
	member .abakt is array
	member .rooms is array
	member .doors is array

	member .mergeletter is string
    member .refno is string
    member .E3DProject is string
endobject


define method .jsonmem()
		!this.mergeletter = |#|
endmethod
define method .getjsontext() is array
	!result = array()

	!result.append('[')	$*不能放后面用insert，数组大了后会崩

	!result.append('{')
	!result.append(|   "E3DProject": "| + !this.E3DProject + |",|)
    !result.append(|   "name": "| + !this.node + |",|)
    !result.append(|   "refno": "| + !this.refno + |",|)
	!result.append(|   "code": "| + !this.code + |",|)
	!result.append(|   "type": "| + !this.type + |",|)
	!result.append(|   "version": "| + !this.rev + |",|)

	--q var !this.type


	--如果不需要统一格式，就不把没必要的加进JSON
	!strings = split('content proofreading drawingInfo')
	--if !this.type inset ('EM4PIPE','EM9PIPE','EM4SUPP') then
	if !this.type inset ('EM4PIPE','EM9PIPE') then
		!strings.append('weld')
	endif

	--if !this.type.match('EQUI') eq 0 and !this.type ne 'CIVIL' and !this.type.match('SUPP') eq 0 then
	--	!strings = split('content proofreading weld drawingInfo')
	--else
	--	!strings = split('content proofreading drawingInfo')
	--endif

	do !string values !strings
	--$p $!string
		if !string eq 'content' then
			!temparr = !this.content
		elseif !string eq 'proofreading' then
			!temparr = !this.proofreading
		elseif !string eq 'weld' then
			!temparr = !this.weld
		elseif !string eq 'drawingInfo' then
			!temparr = !this.drawingInfo
		else
			!temparr = array()
		endif

		!result.appendarray(!this.getarraytext(!string,!temparr))
	enddo
	--q var !result
	--return !result
	--Q VAR !result
	--q var !this.type
	!result.append(|"tables": {|)
	if !this.type eq 'EM4PIPE' then
		!strings = split('零部件材料 汇总材料 直管段表 管道属性 在役检查焊缝信息')
	elseif !this.type eq 'EM9PIPE' then
		!strings = split('零部件材料 汇总材料 直管段表 管道属性')
	--elseif !this.type inset ('EM4SUPP','EM9INSTPIPESUPP','EM9INSTSUPP') then
    elseif !this.type inset ('EM4SUPP','EM9INSTSUPP','EM9PIPESUPP') then
		!strings = split('零部件材料 汇总材料 支架属性')
    elseif !this.type eq 'EM8PIPE' then
		!strings = split('汇总材料 零部件材料')
    elseif !this.type eq 'EM8SUPP' then
		!strings = split('汇总材料 零部件材料')
    elseif !this.type eq 'EM5PIPE' then
		!strings = split('零部件材料 附件材料')
    elseif !this.type eq 'EM5SUPP' then
		!strings = split('零部件材料')
	elseif !this.type inset ('EM4EQUI','EM5EQUI','EM8EQUI','EM9EQUI') then
		!strings = split('设备属性')
	elseif !this.type eq 'CIVIL' then
		!strings = split('埋件列表 房间列表')
	elseif !this.type eq 'ARCH' then
		!strings = split('埋件列表 房间列表 门表')
    elseif !this.type eq 'MTGD' then $*设备清单新增，需和Tplant对接字符
        !strings = split('设备材料清单')
    elseif !this.type eq 'COMM' then $*设备清单新增，需和Tplant对接字符
        !strings = split('设备材料清单 模块箱配置说明')
	else
    --$P 1
		!strings = array()
	endif

	if !strings.set() then
		!result.append(|"table_seq": [|)
		do !index indices !strings
			!string = !strings[!index]
			if !index ne !strings.size() then
				!result.append(|"| & !string & |",|)
			else
				!result.append(|"| & !string & |"|)
			endif
		enddo
		!result.append(|],|)
        --$P 2
	endif

	do !string values !strings
	--$p $!string
		if !string inset('汇总材料','设备材料清单') then
			!temparr = !this.material
		elseif !string eq '零部件材料' then
			!temparr = !this.separateMaterial
		elseif !string eq '直管段表' then
			!temparr = !this.cutPipeLength
		elseif !string eq '管道属性' then
			!temparr = !this.branAtt
		elseif !string eq '在役检查焊缝信息' then
			!temparr = !this.zyjc
		elseif !string eq '支架属性' then
			!temparr = !this.suppAtt
		elseif !string eq '设备属性' then
			!temparr = !this.equiAtt
		elseif !string eq '结构属性' then
			!temparr = !this.civilAtt
		elseif !string eq '埋件列表' then
			!temparr = !this.abakt
		elseif !string eq '房间列表' then
			!temparr = !this.rooms
		elseif !string eq '门表' then
			!temparr = !this.doors
        elseif !string inset('附件材料','模块箱配置说明')then
			!temparr = !this.annexMaterial
		else
			!temparr = array()
		endif

		!result.appendarray(!this.getarraytext(!string,!temparr))
		--$P 3
	enddo

	!result.append(|}|) $*tables

	!result.append('}')	$*one model


	--!result.insert(1,'[')
	--q var !result.size()
	--return !result
	!result.append(']')	$* all models

	--q var !result.size()
	--return !result

	!result = !this.getgoodformat(!result)
    --Q VAR !result
	return !result
endmethod



define method .getarraytext(!title is string, !temparr is array) is array
	if !title inset ('content','weld') then
		!result = array()
		!result.append(|"| + !title + |": [|)
		if !temparr.set() then
			!result.appendarray(!temparr)
		endif
		!result.append(|],|)
		return !result
	else
		!result = array()
		!result.append(|"| + !title + |": {|)
		if !temparr.set() then
			!columnsrepeatresult = !this.getordercolumns(!temparr)
			!columns = !columnsrepeatresult[1]
			!repeatkeys = !columnsrepeatresult[2][1]
			handle any
				!repeatkeys = array()
			endhandle
			!repeatsizes = !columnsrepeatresult[2][2]
			handle any
				!repeatsizes = array()
			endhandle
			!repeatindex = array()
			do !x indices !repeatkeys
				!repeatindex[!x] = 0
			enddo

			!result.appendarray(!columns)
			!result.append(|"data":[|)
			do !x indices !temparr
				if !temparr[!x].match(!this.mergeletter) ne 0 then
					!string = |"| & !temparr[!x].part(-1,!this.mergeletter)
					!key = !temparr[!x].part(-1,!this.mergeletter).before(':').before(|"|).trim()
					!mayindex = !repeatkeys.findfirst(!key)
					if !mayindex.set() then
						!repeatindex[!mayindex] = !repeatindex[!mayindex] + 1
						if !repeatindex[!mayindex] gt !repeatsizes[!mayindex] then
							!repeatindex[!mayindex] = 1
						endif
						!key = !key & '_' & !repeatindex[!mayindex]
						!string = |"| & !key & |":| & !temparr[!x].after(|:|)
					endif

					!result.append(!string)
				else
					!result.append(!temparr[!x])
				endif
			enddo
			--!result.appendarray(!temparr)
			!result.append(|]|)
		endif
		!result.append(|},|)
		return !result
	endif
endmethod

define method .getordercolumns(!temparr is array) is array
	!result = array()
	!result.append(|"columns":[|)
	!keysrepeatresult = !this.gettitles(!temparr)
	!keys = !keysrepeatresult[1]
	!result.appendarray(!keys)
	!result.append(|],|)

	!repeatresult = !keysrepeatresult[2]
	!allresult = array()
	!allresult.append(!result)
	!allresult.append(!repeatresult)
	return !allresult
endmethod

define method .gettitles(!temparr is array) is array
	!result = array()
	!merge = false
	do !line values !temparr
		!trimline = !line.trim().trim('	')
		if !trimline.length() le 2 then
			!firstletter = !trimline.substring(1,1)
			if !firstletter eq '{' then
				!start = true
				skip
			elseif !firstletter eq '}' then
				break
			endif
		endif
		if !start then
			!tempstring = !line.before(':').trim()
			if !tempstring inset (|"nodeNames"|,|"type"|) then
				skip
			endif
			!result.append(!tempstring)
			--q var !tempstring !this.mergeletter
			if !tempstring.match(!this.mergeletter) ne 0 then
				!merge = true
			endif
		endif
	enddo
	--q var !merge
	if !merge.not() then
		!size = !result.size()
		do !x from 1 to !size - 1
			!result[!x] = !result[!x] + |,|
		enddo
		!repeatresult = array()
		!allresult = array()
		!allresult.append(!result)
		!allresult.append(!repeatresult)
	else
		!allresult = !this.mergetitles(!result)
	endif
	return !allresult
endmethod

define method .mergetitles(!keys is array) is array
	!result = array()
	!keysize = !keys.size()

	!levels = array()
	do !x from 1 to 10	$*max level is 10
		!levels[!x] = 'xxxxxx'
	enddo

	!fieldstrings = array()
	!repeatnums = array()
	do !x indices !keys
		!key = !keys[!x]
		!keystring = !key.substring(1,!key.length() - 1).after(|"|)
		if !keystring.match(!this.mergeletter) ne 0 then
			!keystring = !keystring.part(-1,!this.mergeletter)
		endif
		!fieldstrings.append(!keystring)
	enddo

	!repeatresult = array()
	!repeatresult[1] = array()
	!repeatresult[2] = array()

	!uniquefieldstrings = !fieldstrings
	!uniquefieldstrings.unique()
	do !onefieldstring values !uniquefieldstrings
		!indices = !fieldstrings.find(!onefieldstring)

		if !indices.size() gt 1 then
			!repeatsize = !repeatresult[1].size() + 1
			!repeatresult[1][!repeatsize] = !onefieldstring
			!repeatresult[2][!repeatsize] = !indices.size()

			do !x indices !indices
				!repeatnums[!indices[!x]] = !x
			enddo
		endif
	enddo


	!letters = array()
	do !x indices !keys
		!key = !keys[!x]
		if !key.match(!this.mergeletter) ne 0 then
			!keystring = !key.substring(1,!key.length() - 1).after(|"|)
			!parts = !keystring.split(!this.mergeletter)
			!partsize = !parts.size()

			do !y indices !parts
				if !levels[!y] ne !parts[!y] then
					!this.addlevelend(!levels,!letters, !result,!y, true)
					!levelletters = array()
					!result.append(|{|)
					!levelletters.append(|}|)
					if !y eq !partsize then
						if defined(!repeatnums[!x]) then
							!result.append(|"title":"| & !parts[!y] & |",|)
							!result.append(|"field":"| & !parts[!y] & '_' & !repeatnums[!x] & |"|)
						else
							!result.append(|"field":"| & !parts[!y] & |"|)
						endif
					else
						!result.append(|"title":"| & !parts[!y] & |",|)
						!result.append(|"children":[|)
						!levelletters.append(|]|)
					endif

					!levels[!y] = !parts[!y]
					!letters[!y] = !levelletters
				endif
			enddo
		else
			!this.addlevelend(!levels,!letters, !result,1, true)

			!result.append(|{|)

			if defined(!repeatnums[!x]) then
				!result.append(|"title":"| & !fieldstrings[!x] & |",|)
				!result.append(|"field":"| & !fieldstrings[!x] & '_' & !repeatnums[!x] & |"|)
			else
				!result.append(|"field":| & !key)
			endif

			if !x ne !keysize then
				!result.append(|},|)
			else
				!result.append(|}|)
			endif
			!levels[1] = !key.substring(1,!key.length() - 1).after(|"|)
		endif
	enddo
	!this.addlevelend(!levels,!letters, !result,1,false)

	!allresult = array()
	!allresult.append(!result)
	!allresult.append(!repeatresult)
	return !allresult
	--return !result
endmethod

define method .addlevelend(!levels is array, !letters is array, !result is array, !currentlevel is real, !notlastone is boolean )
	if !levels[!currentlevel] eq 'xxxxxx' then
		!endnum = !currentlevel + 1
	else
		!endnum = !currentlevel
	endif

	do !z from !letters.size() to !endnum by -1
		do !x from !letters[!z].size() to 1 by -1
			!result.append(!letters[!z][!x])
		enddo
		!letters[!z].delete()
		!levels[!z] = 'xxxxxx'
	enddo
	!letters.compress()

	if !notlastone and !result.set() then
		if !result[!result.size()].substring(-1,1) inset(']','}') then
			!result[!result.size()] = !result[!result.size()] & |,|
		endif
	endif
endmethod

define method .getgoodformat(!array is array) is array
	!oneblank = '   '
	do !x indices !array
		!lines[!x] = !array[!x].trim('LR',' ').trim('LR','	')
	enddo


	!bwords = split(|*[ *{|)
	!awords = split(|] }|)

	!incircles = array()
	!currentblank = ''

	do !x indices !lines
		!line = !lines[!x]
		!lowline = !line.lowcase()
		!find = false

		--!templine = !lowline.replace(|\\|,|\|).replace(|\"|,||)
		!templine = !lowline.replace(|\"|,||)

		if !templine.match(|"|) ne 0 then
			!string = ''
			!type = 'before'
			do
				!index = !templine.match(|"|)
				if !index ne 0 then
					if !type eq 'before' then
						!part = !templine.before(|"|)
						!string = !string + !part
						!type = 'after'
					else
						!type = 'before'
					endif
					!templine = !templine.after(|"|)
				else
					!templine = !string + !templine
					break
				endif
			enddo
		endif

		do !y indices !bwords
			!bword = !bwords[!y]
			!aword = !awords[!y]

			if !templine.matchwild(!bword + '*' + !aword + '*') then
			--if !lowline.matchwild(!bword + '*' + !aword + '*') then

				!lines[!x] = !currentblank + !lines[!x]
				!find = true
				break
			elseif !templine.matchwild(!bword + '*') then
			--elseif !lowline.matchwild(!bword + '*') then
				!incircles.append(!bword)
				!lines[!x] = !currentblank + !lines[!x]
				!currentblank = !currentblank + !oneblank
				!find = true

				break
			elseif !templine.matchwild(!aword + '*') then
			--elseif !lowline.matchwild(!aword + '*') then
				--if !aword eq ']' and !x eq 508 then

				--if !aword eq ']' then
				--	!tempsize = !incircles.size()
				--	$p $!x $!tempsize
				--endif
				do !z from !incircles.size() to 1 by -1
					if !incircles[!z].match(!bword) ne 0 then			$* find relevant bword
						!tempstring = ''
						do !index from !z to !incircles.size()
							!incircles[!index].delete()
							!tempstring = !tempstring + !oneblank
						enddo
						!currentblank = before(!currentblank + 'xxxx',!tempstring + 'xxxx')
						break
					endif
				enddo
				if !x gt 1 then
					if !lines[!x - 1].substring(-1,1) eq ',' then
						!lines[!x - 1] = !lines[!x - 1].substring(1,!lines[!x - 1].length() - 1)
					endif
				endif
				!lines[!x] = !currentblank + !lines[!x]
				!find = true

				break
			endif
		enddo

		if !find.not() then
			!lines[!x] = !currentblank + !lines[!x]
		endif
	enddo

	return !lines
endmethod
