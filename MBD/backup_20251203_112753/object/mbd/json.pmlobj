--Method:
--Public method:
--json(!item is any)														$*init method , item is name/dbref/file/array
--getJson() is array														$*get separate data of json
--getPackJson() is array													$*get packdge data of json
--file()																	$*instore packadge data into selected file
--addItem(!item is any) 													$*add one item, item is name/dbref/file/array

--Private method:
--checkarrisdata(!arr is array) is boolean  								$*
--getdata() 																$*
--getOneData(!item is any)		$* array file item  						$*
--getOneItemData(!item is any)  											$*
--packJson(!arr is array) is array  										$*
--setSkipFunctions()														$*


--Method:
--addItem(!item is any) 											4		$*add json data/json data of item/json data of file into this.data
--file()														3 instore	$*instore json data with packdge into a file
--getdata() 																$*get all json data
--getJson() is array												2b		$*get array of json data without packdge
--getOneData(!item is any)  												$*add json data/json data of item/json data of file into this.data
--getOneItemData(!item is any)  											$*get json data of one item
--getPackJson() is array											2a		$*get array of json data with packdge
--json(!item is any)												1a		$*init with item
--json(!items is array) 											1b		$*init with array of items
--packJson(!arr is array) is array  										$*pack array of json data
--setSkipFunctions()														$*set useless item
------------------------------

--1 init
--2 get result
--3 instore
--4 add one item

$(
init method
1 json(array)		input array, element could be item in PDMS/E3D, file, array
2 json(item)		input one element, element could be item in PDMS/E3D, file, array


add item method
1 additem(!item)	input one thing

get data from this object
getjson()			get json without 'list['
getpackjson()			get json with 'list['
file()				store json file
$)
define object json
	member .items is array
	member .data is array
	member .errors is array
	member .skipFunctions is array
endobject

$(
define method .json(!items is array)
	$p $!items arr
	!this.setSkipFunctions()
	!this.items = !items
	!this.getdata()
endmethod
$)

define method .json(!item is any)
	--$p $!item any
	!this.setSkipFunctions()
    --q var !item
	if !item.objecttype() eq 'ARRAY' then
		if !this.checkarrisdata(!item) then		$*Array   check if item is array of json, yes, add into items as element. no, it would be items itself
			!this.items.append(!item)
		else
			!this.items = !item
		endif
	else
		!this.items = array()
		!this.items.append(!item)				$*file/name/dbref    element of items
	endif
	!this.getdata()
endmethod

define method .checkarrisdata(!arr is array) is boolean
	!num = 0
	do !x from 1 to min(!arr.size(),100)
		if !arr[!x].objecttype() eq 'STRING' then
			if !arr[!x].match(|"|) ne 0 or !arr[!x].match(|:|) ne 0 then		$* "xxx":"xxxx"
				!num = !num + 1
			endif
		else
			return false
		endif
	enddo
	if !num gt 0 then
		return true
	else
		return false
	endif
endmethod

define method .addItem(!item is any)
	!this.getOneData(!item)
endmethod

define method .setSkipFunctions()
	--!this.skipfunctions = split('MaterialTextFrame')
	!tplantisuseless = true
	if !tplantisuseless then
		!this.skipfunctions = split('')
	else
		!this.skipfunctions = split('材料')	$*其实只是针对 材料文字的外框 用这个时会有type来约束，外框的type是aidlin
	endif
    --q var !this.skipfunctions
endmethod

define method .getdata()
	!this.data = array()
	!this.errors = array()
    --q var !this.items
	do !item values !this.items
		!this.getOneData(!item)
	enddo
endmethod

define method .getOneData(!item is any)		$* array file item
	--q var !item
	!dbref = !item.dbref()
	handle any
		if !item.objecttype() eq 'ARRAY' then									$* input data is array
			!arr = !item
			!this.data.append(!arr)
		else
			!file = object file(!item)											$* input data is file
            if !file.exists() then
				!arr = !file.readfile(1000000)
				handle any
					!arr = array()
					$p Cant read file $!item
					!this.errors.append('Cant read file $!item')
				elsehandle none
					!file.close()
				endhandle
			else
				!arr = array()
				$p Cant get data for $!item
				!this.errors.append('Cant get data for $!item')
			endif
			if !arr.set() then
				if !arr.size() ge 4 then
					!arrsize = !arr.size()
					if !arr[1].trim() eq '{' and !arr[!arrsize] eq '}' and (!arr[2] eq |"list": [| or !arr[2] eq |"list":[|) and !arr[!arrsize - 1] eq ']' then
						!arr[1].delete()
						!arr[2].delete()
						!arr[!arrsize - 1].delete()
						!arr[!arrsize].delete()
						!arr.compress()
					endif
				endif
				!this.data.append(!arr)
			endif
		endif
	elsehandle none
		!this.getOneItemData(!item)											$* input data is item in PDMS/E3D
	endhandle
endmethod



define method .getOneItemData(!item is any)
--$p safdsa
	!result = array()
	!skipfunctions = !this.skipFunctions
    --Q VAR !skipfunctions
	!range = name of $!item
	var !mode mode
	forwards
	var !mems coll all (lindim mlabel aidtext aidline aidarc aidcircle aidpoint) for $!range
	--var !mems coll all (lindim mlabel aidtext aidline aidarc aidcircle) for $!range
	do !mem values !mems
		!function = function of $!mem
		!type = type of $!mem
		if !type eq 'AIDLIN' and !skipFunctions.findfirst(!function).set() then
		--$p $!mem
			skip
		endif



		if !type eq 'AIDTEX' then
			!type = 'AIDTEXT'
		elseif !type eq 'AIDLIN' then
			!type = 'MBDAIDLINE'
		elseif !type eq 'AIDCIR' then
			!type = 'AIDCIRCLE'
		elseif !type eq 'AIDPOI' then
			!type = 'AIDPOINT'
		endif
		!com = '!ob' + !type + ' = object ' + !type + |('| + !mem + |')|
        --q var !com
		$!com
		!com = '!arr = !ob' + !type + '.json()'
        --q var !com
		$!com
		!result.appendarray(!arr)
	enddo
	$!mode


	if !result.unset() then
		$p No LINDIM MLABEL AIDTEXT AIDLINE AIDARC AIDCIRCLE AIDPOINT for $!range
	else
		!this.data.append(!result)
	endif
endmethod

$(
define method .analyze(!array is array)

endmethod
$)

define method .getJson() is array
	!arr = array()
	do !onearr values !this.data
		!arr.appendarray(!onearr)
	enddo
	return !arr
endmethod
define method .getPackJson() is array
	!arr = !this.getJson()
	--q var !arr.size()
	return !this.packJson(!arr)
endmethod

define method .packJson(!arr is array) is array
	if !arr.set() then
		!arr[!arr.size()] = !arr[!arr.size()].before(',')
		do !x indices !arr
			if !arr[!x] eq '{' or !arr[!x] eq '}' or !arr[!x] eq '},' then
				!bb = '    '
			else
				!real = !arr[!x].before(',').real()
				handle any
					!bb = '      '
				elsehandle none
					!bb = '        '
				endhandle
			endif
			!arr[!x] = !bb + !arr[!x]
		enddo

		!arr.insert(1,|{|)
		!arr.insert(2,|  "list": [|)
		!arr.append(|  ]|)
		!arr.append(|}|)
	endif

	return !arr
endmethod

define method .file()
	import 'pmlfilebrowser'
	handle any
	endhandle
	var !banner banner
	if !banner.match('PDMS') ne 0 then
		Using namespace 'Aveva.PDMS.Presentation'
	else
		Using namespace 'Aveva.Core.Presentation'
	endif

	!dt = object datetime()
	!month = !dt.month().string()
	if !month.length() le 2 then
		!month = '0' + !month
	endif

	!date = !dt.date().string()
	if !month.length() le 2 then
		!date = '0' + !date
	endif

	!tempstrings = split('month date hour minute second')

	!name = 'xxx-' & !dt.year() & !dt.month() & !dt.date() & !dt.hour() & !dt.minute() & !dt.second() + '.json'

	!browser = object pmlfilebrowser('SAVE')
	!browser.show('',!name,'Save JSON file',false,'all files|*.json',1)
	!savefile = object file(!browser.file())

	--q var !this.data
	!arr = !this.getPackJson()
	!savefile.writefile('overwrite',!arr)
	Syscom 'start $!savefile &'
endmethod

