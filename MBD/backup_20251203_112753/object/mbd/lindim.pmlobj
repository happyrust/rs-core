--Method:
--Public method:
--lindim(!item is any)  													$*
--lindim(!owner is any, !lindimpos is position, !ori is orientation, !points is array, !cheight is real, !function is string, !desc is string) is boolean   	$*
--lindim(!owner is any, !lindimpos is position, !ori is orientation, !points is array, !cheight is real, !function is string, !desc is string, !changeCheightAuto is boolean) is boolean	$*
--json() is array   														$*

--Private method:
--create() is boolean   													$*

define object lindim
	member .owner is string
	member .name is string						$* for input lindim
	member .createNames is array				$* for create lindim
	member .pos is position
	member .ori is orientation
	member .cheight is real
	member .function is string			$*function for
	member .desc is string				$*nodenames
	member .points is array

	member .adddir is boolean

	member .changeCheightAuto is boolean
	member .changeCheightAutobili is real
	member .sepSmallDim is boolean

	--for adjust weld
	member .plusstringcheightbili is real

	--for adjust weld
	member .plus is boolean			$* if there is one or more plus string, it is true, or it is false
	member .adjustwelds is array	$*array of isoadjustweld
	--member .oneAdjustLen is real
	member .plusarrs is array

	--member .polarsystem is polarsystem
endobject

define method .lindim(!item is any)
	!this.name = name of lindim of $!item
	handle any
		return
	endhandle
	!this.owner = name of owner of $!this.name
	!this.pos = pos of $!this.name wrt/*
	!this.ori = ori of $!this.name wrt/*
	!this.cheight = cheight of $!this.name
	!this.function = function of $!this.name
	!this.desc = desc of $!this.name
	var !dimposs coll all dimpos for $!this.name
	!points = !dimposs.evaluate(object block('!dimposs[!evalindex].dbref().pos.wrt(world)'))
	!this.points = !points
	!this.changeCheightAuto = false
endmethod
define method .lindim(!owner is any, !lindimpos is position, !ori is orientation, !points is array, !cheight is real, !function is string, !desc is string, !temparr is array, !objects is array) is boolean
	!this.changeCheightAuto = !temparr[1]
	!this.changeCheightAutobili = !temparr[2]
	!this.sepSmallDim = !temparr[3]
	!this.plusstringcheightbili = !temparr[4]

	!adjustwelds = array()
	do !object values !objects
		if !object.objecttype() eq 'ISOADJUSTWELD' then
			!adjustwelds.append(!object)
		elseif !object.objecttype() eq 'ISODIM' then
			break
		endif
	enddo
	!this.adjustwelds = !adjustwelds

	return !this.lindim(!owner, !lindimpos, !ori, !points, !cheight, !function, !desc)
endmethod

define method .lindim(!owner is any, !lindimpos is position, !ori is orientation, !points is array, !cheight is real, !function is string, !desc is string, !temparr is array) is boolean
	!this.changeCheightAuto = !temparr[1]
	!this.changeCheightAutobili = !temparr[2]
	!this.sepSmallDim = !temparr[3]

	return !this.lindim(!owner, !lindimpos, !ori, !points, !cheight, !function, !desc)
endmethod

define method .lindim(!owner is any, !lindimpos is position, !ori is orientation, !points is array, !cheight is real, !function is string, !desc is string, !changeCheightAuto is boolean, !sepSmallDim is boolean) is boolean
	!this.sepSmallDim = !sepSmallDim
	!this.changeCheightAuto = !changeCheightAuto
	return !this.lindim(!owner, !lindimpos, !ori, !points, !cheight, !function, !desc)
endmethod
define method .lindim(!owner is any, !lindimpos is position, !ori is orientation, !points is array, !cheight is real, !function is string, !desc is string, !sepSmallDim is boolean) is boolean
	!this.sepSmallDim = !sepSmallDim
	return !this.lindim(!owner, !lindimpos, !ori, !points, !cheight, !function, !desc)
endmethod
define method .lindim(!owner is any, !lindimpos is position, !ori is orientation, !points is array, !cheight is real, !function is string, !desc is string, !changeCheightAuto is boolean) is boolean
	!this.changeCheightAuto = !changeCheightAuto
	return !this.lindim(!owner, !lindimpos, !ori, !points, !cheight, !function, !desc)
endmethod
define method .lindim(!owner is any, !lindimpos is position, !ori is orientation, !points is array, !cheight is real, !function is string, !desc is string) is boolean
	!this.owner = name of $!owner
	handle any
		return false
	endhandle

	!this.pos = !lindimpos
	!this.ori = !ori
	!this.points = !points

	--!temppos = e 0 n 0 u 0
	--if !points[1].distance(!temppos) lt 1 then

	--endif

	do !x from 2 to !this.points.size()
		do !y from !x - 1 to 1 by -1
			if defined(!this.points[!y]) then
				!beforepoint = !this.points[!y]
				break
			endif
		enddo

		if !this.points[!x].distance(!beforepoint) lt 1 then
		--if !this.points[!x].distance(!this.points[!y]) lt 1 then
			!this.points[!x].delete()
		endif
	enddo
	!this.points.compress()
	!this.cheight = !cheight




	if !function.trim() ne '' then
		!this.function = !function.trim()
	else
		!this.function = ''
		--!this.function = '其它'
	endif
	if !desc.trim() ne '' then
		!this.desc = !desc.trim()
	endif
	return !this.create()
endmethod

define method .create() is boolean
	$!this.owner
	handle any
		return false
	endhandle
	--!this.oneAdjustLen = 100
	--!this.oneAdjustLen = 100mm
	!this.plus = false

	--new lindim
	--handle any
	--	return false
	--endhandle

	$(
	if !this.name.set() then
		name $!this.name
		handle any
			return false
		endhandle
	endif
	$)




	!this.changeCheightAuto()

	!allpointsPos = !this.sepSmallDim()

	--return false
    --q var !allPointsPos[1]
	do !pointsPos values !allPointsPos
--$p 4444
		new lindim
		handle any
			return false
		endhandle
		--if !this.name.set() then	$*
		--	name $!this.name
		--	handle any
		--		return false
		--	endhandle
		--else
			--!this.name = name
		--endif
		!name = name
		!this.createNames.append(!name)

		!pos = !pointspos[2]
		!points = !pointsPos[1]
		!cheight = !pointsPos[3]
		!pluss = !pointsPos[4]
		handle any
			!pluss = array()
		endhandle


		position $!pos
		--cheight $!this.cheight
		cheight $!cheight
		ori $!this.ori

		if !this.function.set() and !this.function.trim() ne '' then
			function '$!this.function'
		endif

		if !this.desc.set() and !this.desc.trim() ne '' then
			desc '$!this.desc'
		endif

		$(
		if !points.size() eq 5 then
			!temppos = e 13100 n 45800 d 5950 wrt/*
			if !points[4].distance(!temppos) lt 1 then

			endif
		endif
		$)

		do !pos values !points
			new dimpos
			pos $!pos
		enddo

		--if !this.polarsystem.set() then

		--	!this.polarsystem.add(!name)
		--endif


		if !pluss.width() gt 0 then
			!plusarr = array()
			!plusarr.append(!name)
			!plusarr.append(!pluss)
			!this.plusarrs.append(!plusarr)
		endif
	enddo



	$(
	----old way
	position $!this.pos
	cheight $!this.cheight
	ori $!this.ori

	if !this.function.set() and !this.function.trim() ne '' then
		function '$!this.function'
	endif

	if !this.desc.set() and !this.desc.trim() ne '' then
		desc '$!this.desc'
	endif

	do !pos values !this.points
		new dimpos
		pos $!pos
	enddo
	$)
	return true
endmethod


define method .sepSmallDim() is array
	!allpointsPos = array()

	--$(
	if (!this.sepSmallDim.unset() or !this.sepSmallDim.not()) and (!this.changecheightauto.unset() or !this.changecheightauto.not()) then
		--$p 1
        !pointsPos = array()
		!pointsPos.append(!this.points)
		!pointsPos.append(!this.pos)
		!pointsPos.append(!this.cheight)
		!allpointsPos.append(!pointsPos)
		return !allpointsPos
	endif
	--$)
	--$p 1
	--for test
	--!this.points[!this.points.size()].delete()

    --$p 2

	!currentLevel = 0

	!onePoints = array()
	!onepluss = array()
	!points = !this.points
    --q var !points
	do !x from 1 to !points.size() - 1
	----------------------------------------------------get dis and len of dis text			s
		!dis = abs(!!suidirdis(!points[!x],!this.ori.xdir(),!points[!x + 1]))
		--!dis = !points[!x].distance(!points[!x + 1])
		!string = !dis.string('D2').replace('.00','')
		!notindex = !string.match('.')
		if !notindex ne 0 then
			if !string.length() ge !notindex + 2 then
				if !string.substring(!notindex + 2,1) eq '0' then
					!string = !string.substring(1,!notindex + 1) & !string.substring(!notindex + 3)
				endif
			endif
		endif

		!plussize = 0	$*调整焊在这段的个数
		!plusstring = ''
		!pluslen = 0
		!adjustlen = 0
		if !this.adjustwelds.set() then
			!templine = !points[!x].line(!points[!x].offset(!this.ori.xdir(),1000))
			!templine.endposition = !templine.near(!points[!x + 1])
			!linedir = !templine.direction()
			handle any
				pin1 at $!points[$!x]
				$p Warning: Please check if there is any Bad Connection at pin 1 :pos: $!points[$!x]
				skip
			endhandle
			do !y indices !this.adjustwelds
				!object = !this.adjustwelds[!y]
				!tempdis = !!suidirdis(!points[!x],!linedir,!object.pos)
				if (!tempdis gt 0 and !tempdis lt !templine.length()) or (abs(!tempdis) lt 0.01 and !object.dirup.not()) or (abs(!templine.length() - !tempdis) lt 0.01 and !object.dirup) then
					!plussize = !plussize + 1
					!adjustlen = !adjustlen + !object.adjustlen
					!this.adjustwelds[!y].delete()
					break
				endif
			enddo
--q var !adjustlen
			!this.adjustwelds.compress()
			if !plussize ne 0 then
				if !this.plus.not() then
					!this.plus = true
				endif
				!plusstring = ' +' & string(!adjustlen)
				--!plusstring = ' +' & string(!plussize * !this.oneAdjustLen)
				--!string = !plusstring & !string & !plusstring
				--!pluslen = 2 * !!mbdtextlen(!plusstring) * (!this.cheight * !this.plusstringcheightbili) * 0.75			$*附加长度字符要小一点
				!pluslen = 2 * !!mbdtextlen(!plusstring) * (!this.cheight * !this.plusstringcheightbili)
				--!string = !plussize & '00 ' & !string & ' ' & !plussize & '00'
				--!string = !plussize & '00mm ' & !string & ' ' & !plussize & '00mm'		$*调整焊的文字有偏向，所以要两边都加上
			endif
		endif


		--!len = !!mbdtextlen(!string) * !this.cheight * 0.75 + !pluslen
		!len = !!mbdtextlen(!string) * !this.cheight + !pluslen

	----------------------------------------------------get dis and len of dis text			e


		!onepoints.append(!points[!x])
		!onepluss.append(!plusstring)
		if !len gt !dis then
			if !onepoints.size() gt 1 then
				!pointsPos = array()
				!pointsPos.append(!onepoints)
				!pointsPos.append(!this.pos)
				!pointsPos.append(!this.cheight)
				!pointsPos.append(!onepluss)
				!allpointsPos.append(!pointsPos)
				!currentLevel = 0
			endif
			!onepoints = array()
			!onepluss = array()

			!temppoints = array()
			!temppluss = array()
			!temppoints.append(!points[!x])
			!temppoints.append(!points[!x + 1])
			!temppluss.append(!plusstring)
			!temppluss.append('')
			if !this.changecheightautobili.unset() then
				!this.changecheightautobili = 0.5
			endif

			if !this.changecheightauto.set() and !this.changecheightauto then
				!goodcheight = !!getgoodcheight(!temppoints,!this.ori.xdir(),0.8)					$* length of text less than 0.8 * distance between two points
				!tempCheight = Max(!goodcheight,!this.cheight * !this.changecheightautobili)					$* minimum cheight is half of current cheight
				--!tempcheight = !goodcheight
			else
				!tempCheight = !this.cheight
			endif

			!reallen = !len * !tempCheight / !this.cheight

			!pointsPos = array()
			!pointsPos.append(!temppoints)

			--if the text can be put when the cheight changed to a small one(minimum cheight is half of old cheight)
			--if !this.changecheightauto.set() and !this.changecheightauto and !len / 2 le !dis then	$* change cheight for this small dim only
			if !this.changecheightauto.set() and !this.changecheightauto and !reallen le !dis then	$* change cheight for this small dim only 202309060955
				!pointsPos.append(!this.pos)
				!currentLevel = 0
			else
				if (!this.sepSmallDim.unset() or !this.sepSmallDim.not()) then
					!pointsPos.append(!this.pos)
					!currentLevel = 0
				else
					!currentLevel = !currentLevel + 1
					if !temppoints[1].direction(!this.pos).angle(!this.ori.ydir()) lt 90 then
						!pointsPos.append(!this.pos.offset(!this.ori.ydir(),!this.cheight * 1.2 * !currentLevel))
					else
						!pointsPos.append(!this.pos.offset(!this.ori.ydir(), - !this.cheight * 1.2 * !currentLevel))
					endif
				endif
			endif
			!pointsPos.append(!tempCheight)
			!pointsPos.append(!temppluss)
			!allpointsPos.append(!pointsPos)
			if !x eq !points.size() - 1 then		$* if this part is small and is the last part, do not need to create a normal part at the end
				golabel /finish
			endif
		endif
	enddo


	!onepoints.append(!points.last())
	!pointsPos = array()
	!pointsPos.append(!onepoints)
	!pointsPos.append(!this.pos)
	!pointsPos.append(!this.cheight)
	!pointsPos.append(!onepluss)
	!allpointsPos.append(!pointsPos)


	label /finish
    --q var !allpointsPos
	return !allpointsPos
endmethod

define method .changeCheightAuto()		$* change cheight for all
	if !this.changeCheightAuto.unset() or !this.ChangeCheightAuto.not() then
		return
	endif

	!newcheight = !!getgoodcheight(!this.points,!this.ori.xdir(),0.7)
	if !newcheight eq 0 then
		return
	endif
	if !newcheight lt !this.cheight then
		if !this.changecheightautobili.unset() then
			!this.changecheightautobili = 0.5
		endif
		!this.cheight = max(!this.cheight * !this.ChangeCheightAutobili,!newcheight)
	endif
	return

	$(
	-------------old way 202305091521
	!oldcheight = !this.cheight

	label /again
	!len = 0
	do !x from 1 to !this.points.size() - 1
		!dis = !this.points[!x].distance(!this.points[!x + 1])
		!string = !dis.string('D2').replace('.00','')
		!notindex = !string.match('.')
		if !notindex ne 0 then
			if !string.length() ge !notindex + 2 then
				if !string.substring(!notindex + 2,1) eq '0' then
					!string = !string.substring(1,!notindex + 1) & !string.substring(!notindex + 3)
				endif
			endif
		endif
		!len = !len + !!mbdtextlen(!string) * !this.cheight * 0.75

	enddo

	!dimlen = !this.points[1].distance(!this.points.last())

	if !len / !dimlen gt 0.7 and !this.cheight gt 0.5 * !oldcheight then

		!this.cheight = nint(!this.cheight * 0.8)



		golabel /again
	endif
	$)
endmethod

define method .json() is array
	!lindim = !this.name

	!result = array()
	!result.append(|{|)

	!result.append(!!getNodeNames(!lindim))
	!result.append(|"type": "dim",|)
	--!result.append(|"function": "| + !this.function + |",|)

	if !this.function ne '' then
		!result.append(|"function": "| + !this.function + |",|)
	else
		!result.append(|"function": "| + |其它| + |",|)
	endif

	!result.append(|"dimpos": [|)
	!result.appendarray(!!postoArr(!this.pos))
	!result.append(|],|)


	!result.append(|"position": [|)
	--do !pos values !this.points
	do !x indices !this.points
		!pos = !this.points[!x]
		!result.appendarray(!!postoArr(!pos))
		if !x ne !this.points.size() then
			!result[!result.size()] = !result[!result.size()] + ','
		endif
	enddo
	!result.append(|],|)

	!result.append(|"textcheight": "| + !this.cheight.string().upcase().before('MM').before('IN') + |",|)
	!result.append(|"textOri": "| + !!oriToTplantAngle(!lindim)[4] + |"|)
	!result.append(|},|)

	return !result
endmethod
