--
--<<Method>>:
--<<Public method>>:
--mbdinputdata(!typestring is string)   									$*
--add(!typestring is string)												$* public
--addonetype(!type is string)   											$* public
--clear()   																$* public
--getmaterial(!itemcode is string) is array								$* public
--getMaterialInOneType(!itemcode is string,!type is string) is array   	$* public
--
--<<Private method>>:
--addonefiledata(!file is file) is boolean  								$*
-------------------------------------


define object mbdinputdata
	member .alltypes is array
	member .allheadings is array
	member .allmaterials is array
	member .allitemcodes is array
	member .datetimes is array
endobject

define method .mbdinputdata(!typestring is string)
	!this.add(!typestring)
endmethod

define method .add(!typestring is string)	$*public
	!alltypes = split(!typestring)
	do !type values !alltypes
		!this.addonetype(!type)
	enddo
endmethod
define method .addonetype(!type is string)	$*public
	var !projectnumber project number
	!path = !!pml.getpathname('mbdinputdata.pmlobj').before('object/mbdinputdata/') + 'inputdata/' + !projectnumber + '/' + !type + '.csv'
	!file = object file(!path)
	handle any
		!!alert.warning(!type & '.csv 这个文件在 myprojects\inputdata\ 下不存在')
		return
	endhandle

	!tempindex = !this.alltypes.findfirst(!type)
	if !tempindex.set() then
		!datetime = !this.datetimes[!tempindex]
		if !file.dtm() le !datetime then
			return
		endif
	endif

	if !this.addonefiledata(!file) then
		!this.alltypes.append(!type)
		!this.datetimes.append(!file.dtm())
	endif
endmethod

define method .clear()	$*public
	!this.alltypes.clear()
	!this.allheadings.clear()
	!this.allmaterials.clear()
	!this.allitemcodes.clear()
	!this.datetimes.clear()
endmethod

define method .addonefiledata(!file is file) is boolean
	!data = !file.readfile(100000)
	handle any
		return false
	endhandle

	!materials = array()
	!itemcodes = array()
	!headings = array()


	!start = false
	!startcolumn = 1
	do !x indices !data
		!line = !data[!x]
		if !start.not() then
			if !line.replace(',','').replace('	','').replace(' ','').trim().length() lt 20 then
				skip
			else
				!arr = !line.split(',')
				do !y indices !arr
					if !arr[!y].substring(1,1) eq '编' then
						!start = true
						!startcolumn = !y
						!headings = !arr.from(!startcolumn)
						break
					endif
				enddo
				do !index indices !headings
					!headings[!index] = !headings[!index].trim()
				enddo
			endif
		else
			!arr = !line.split(',')
			if !startcolumn eq 1 then
				!temparr = !arr
			else
				!temparr = !arr.from(!startcolumn)
			endif
			!materials.append(!temparr)
			!itemcodes.append(!temparr[1])
		endif
	enddo

	!this.allmaterials.append(!materials)
	!this.allitemcodes.append(!itemcodes)
	!this.allheadings.append(!headings)
	return true
endmethod

define method .getmaterial(!itemcode is string) is array	$*public
	!result = array()
	do !type values !this.alltypes
		!result = !this.getMaterialInOneType(!itemcode,!type)
		if !result.set() then
			break
		endif
	enddo
	return !result
endmethod

define method .getMaterialInOneType(!itemcode is string,!type is string) is array	$*public
	!result = array()
	!index = !this.alltypes.findfirst(!type)
	if !index.set() then
		!headings = !this.allheadings[!index]
		!tempindex = !this.allitemcodes[!index].findfirst(!itemcode)
		if !tempindex.set() then
			!materials = !this.allmaterials[!index][!tempindex]

			!this.dealdata(!headings,!materials)

			!result[1] = !headings
			!result[2] = !materials
		endif
	endif
	return !result
endmethod

define method .dealdata(!headings is array,!materials is array)

	if !materials.size() gt !headings.size() then
		!dels = array()
		do !x from 1 to !materials.size() - 1
			if !dels.findfirst(!x).set() then
				skip
			endif
			if !materials[!x].substring(1,1) eq |"| and !materials[!x].substring(-1,1) ne |"| then
				if !materials[!x + 1].substring(1,1) ne |"| and !materials[!x + 1].substring(-1,1) eq |"| then
					!materials[!x] = !materials[!x] & ',' & !materials[!x + 1]
					!materials[!x + 1].delete()
					!dels.append(!x + 1)
				endif
			endif
		enddo
		!materials.compress()
	endif
	--------------------------------------
	--------------------------------------CSV to txt  10" would be "10""", it is neccesary to change back to 10"
	do !x indices !materials
		if !materials[!x].substring(1,1) eq |"| and !materials[!x].substring(-1,1) eq |"| then
			!materials[!x] = !materials[!x].substring(2,!materials[!x].length() - 2).replace(|""|,|"|)
		endif
	enddo
endmethod

define method .getdata(!itemcode is string,!type is string,!title is string) is string
	!headdata = !this.getmaterialinonetype(!itemcode,!type)
	!index = !headdata[1].findfirst(!title)
	if !index.unset() then
		return ''
	else
		!data = !headdata[2][!index]
		--if !title eq '公称直径' and !data.substring(1,1) eq |"| and !data.substring(-3,3) eq |"""| then
		--	!data = !data.after(|"|).replace(|"""|,||)
		--endif
		return !data
	endif
endmethod

&