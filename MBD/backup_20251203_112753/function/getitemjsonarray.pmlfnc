define function !!getitemjsonarray(!inputname is any) is array
	!name = name of $!inputname
	!result = array()

	!mbdstru = object mbdstru(!name)
	if !mbdstru.checkifdimed().not() then
		return !result
	endif

	!type = !!getmbdtype(!name)
	if !type eq 'PIPE' then

	else
	endif
endfunction

define method .getJsonData(!materialAttS is array, !materialAttShow is array, !elematerialAttS is array, !elematerialAttShow is array, !BranAtts is array ,!branAttShow is array ,!cutpipelengthatts is array, !cutpipelengthattshow is array) is array
	--define method .getJsonData(!materialAttS is array, !materialAttShow is array, !BranAtts is array ,!branAttShow is array ,!cutpipelengthatts is array, !cutpipelengthattshow is array, !merge is boolean) is array
	--$p 123
    !jsonmem = object jsonmem()
	!jsonmem.node = !this.branname
	--!jsonmem.code = !this.branname
	--$(
	!nbbm = :zd_nbbm of $!this.branname
	handle any
	elsehandle none
		if !nbbm.unset() or !nbbm eq '' then
			!jsonmem.code = !this.branname
		else
			!jsonmem.code = !nbbm
		endif
	endhandle
	--$)
	!jsonmem.rev = !this.rev


	!jsonmem.type = 'ISO'
	!jsonmem.content = !this.getDimJson()
	!jsonmem.material = !this.materialsJson(!materialAttS, !materialAttShow)
	!jsonmem.separateMaterial = !this.specialmaterialsJson(!elematerialAttS, !elematerialAttShow)
	!jsonmem.branatt = !this.branAttJson(!BranAtts, !branAttShow)
	!jsonmem.weld = !this.weldJson()
	!jsonmem.cutpipelength = !this.cutpipelengthJson(!cutpipelengthAttS, !cutpipelengthattShow)
	!jsonmem.drawingInfo = !this.getDrawingInfoJson()
	!jsonmem.proofreading = !this.getproofreadingjson()
	return !jsonmem.getjsontext()

	$(
	!arrs = array()
	!arrs.append(!this.getDimJson())
	!arrs.append(!this.materialsJson(!materialAttS, !materialAttShow))
	!arrs.append(!this.specialmaterialsJson(!materialAttS, !materialAttShow))
	!arrs.append(!this.branAttJson(!BranAtts, !branAttShow))
	!arrs.append(!this.weldJson())
	!arrs.append(!this.cutpipelengthJson(!cutpipelengthAttS, !cutpipelengthattShow))


	if !merge then
		!json = object json(!arrs)
		return !json.getpackjson()
	else
		do !x indices !arrs
			--q var !arrs[!x].size()
			!json = object json(!arrs[!x])
			!arrs[!x] = !json.getpackjson()
		enddo
		return !arrs
	endif
	$)
endmethod

define method .getProofreadingJson() is array
	!row = !!getProofreadingJson(!this,!this.branname)
	return !row
endmethod

define method .getdrawinfo()
	if !this.drawgroup.unset() then
		if !this.isinstpipe then
			!this.drawmajor = '仪表管道'
		else
			!this.drawmajor = '工艺管道'
		endif
		!this.drawname = '管道三维制作图'
		!!getdrawinginfo(!this)
	endif
endmethod

define method .getDrawingInfoJson() is array
	!row = !!getdrawinginfojson(!this,!this.branname)
	return !row
endmethod

define method .getDimJson() is array
	if !this.mbdstru.unset() then
		!this.mbdstru = object mbdstru(!this.branname)
	endif
	!json = object json(!this.mbdstru.mbdstru)
	return !json.getJson()
endmethod

define method .materialsJson(!materialAttS is array, !materialAttShow is array ) is array
	!result = array()
	!materials = !this.sumMaterials(!materialAttS)
	do !y indices !materials
		!rowarr = !materials[!y]
		!onearr = array()
		!onearr.append(|{|)
		do !x indices !rowarr
			--!onearr.append(|"| + !materialAttShow[!x] + |": "| + !rowarr[!x].string() + |",|)
			!onearr.append(|"| + !materialAttShow[!x] + |": "| + !rowarr[!x].string().replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
			handle any
			--q var !!error
				!onearr.append(|"| + !materialAttShow[!x] + |": "| + '' + |",|)
			endhandle
			if !x eq !rowarr.size() then
				!onearr[!onearr.size()] = !onearr[!onearr.size()].substring(1,!onearr[!onearr.size()].length() - 1)
			endif
		enddo

		!onearr.insert(2,|"type":"pipeMaterial",|)
		!onearr.insert(2,|"nodeNames":["| + !this.branname + |"],|)
		--if !y ne !materials.size() then
		!onearr.append(|},|)
		--else
		--    !onearr.append(|}|)
		--endif
		!result.appendarray(!onearr)
	enddo

	return !result
	--!result.insert(1,|[|)
	--!result.append(|]|)
endmethod

define method .specialmaterialsJson(!materialAttS is array, !materialAttShow is array ) is array

	!result = array()
	!materials = !this.getspecialMaterials(!materialAttS)
	do !y indices !materials
		!rowarr = !materials[!y]
		!onearr = array()
		!onearr.append(|{|)
		do !x indices !rowarr
			!onearr.append(|"| + !materialAttShow[!x] + |": "| + !rowarr[!x].string().replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
			handle any
				!onearr.append(|"| + !materialAttShow[!x] + |": "| + '' + |",|)
			endhandle
			if !x eq !rowarr.size() then
				!onearr[!onearr.size()] = !onearr[!onearr.size()].substring(1,!onearr[!onearr.size()].length() - 1)
			endif
		enddo

		!onearr.insert(2,|"type":"pipeSpecialMaterial",|)
		!onearr.insert(2,|"nodeNames":["| + !this.branname + |"],|)
		--if !y ne !materials.size() then
		!onearr.append(|},|)
		--else
		--    !onearr.append(|}|)
		--endif
		!result.appendarray(!onearr)
	enddo
	return !result
	--!result.insert(1,|[|)
	--!result.append(|]|)
	--!this.instore(!result,!filename + '_specialMaterials',!path)
endmethod


define method .branAttJson(!BranAtts is array, !branAttShow is array) is array
	!rowarr = !this.getBranAttArr(!branAtts)
	!row = array()
	!row.append(|{|)
	do !x indices !rowarr
		!row.append(|"| + !branAttShow[!x] + |": "| + !rowarr[!x].string().replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
		handle any
			!row.append(|"| + !branAttShow[!x] + |": "| + '' + |",|)
		endhandle
		if !x eq !rowarr.size() then
			!row[!row.size()] = !row[!row.size()].substring(1,!row[!row.size()].length() - 1)
		endif
	enddo
	--!row.append(|}|)
	!row.append(|},|)

	!row.insert(2,|"type":"branAttribution",|)
	!row.insert(2,|"nodeNames":["| + !this.branname + |"],|)
	return !row
	--!this.instore(!row,!filename + '_BranAtt',!path)
endmethod
define method .weldJson() is array
	!maxnum = 16
	!arrs = !this.getweldlist()
	!rows = array()
	do !arr values !arrs
		!temparr = array()
		do !x indices !arr
			!temparr.append(!arr[!x])
			if !x / !maxnum eq int(!x / !maxnum) then
				!rows.append(!temparr)
				!temparr = array()
			elseif !x eq !arr.size() then
				!rows.append(!temparr)
			endif
		enddo
	enddo

	!resultarr = array()
	do !welds values !rows
		!result = array()
		!result.append(|{|)
		!result.append(|"weldText":[|)
		do !x indices !welds
			if !x ne !welds.size() then
				!result.append(|"| + !welds[!x] + |",|)
			else
				!result.append(|"| + !welds[!x] + |"|)
			endif
		enddo
		!result.append(|]|)
		!result.append(|},|)

		!result.insert(2,|"type":"branWeld",|)
		!result.insert(2,|"nodeNames":["| + !this.branname + |"],|)

		!resultarr.appendarray(!result)
	enddo
	return !resultarr

	$(
	!welds = !this.welds
	!result = array()
	!result.append(|{|)
	!result.append(|"weldText":[|)
	do !x indices !welds
		if !x ne !welds.size() then
			!result.append(|"| + !welds[!x] + |",|)
		else
			!result.append(|"| + !welds[!x] + |"|)
		endif
	enddo
	!result.append(|]|)
	--!result.append(|}|)
	!result.append(|},|)

	!result.insert(2,|"type":"branWeld",|)
	!result.insert(2,|"nodeNames":["| + !this.branname + |"],|)
	return !result
	--!this.instore(!result,!filename + '_WeldText',!path)
	$)
endmethod

define method .cutpipelengthJson(!cutpipelengthAttS is array, !cutpipelengthAttShow is array ) is array
	!result = array()
	!cutpipelengths = !this.getcuttubi(!cutpipelengthAttS)
	--q var !cutpipelengths
	do !y indices !cutpipelengths
		!rowarr = !cutpipelengths[!y]
		!onearr = array()
		!onearr.append(|{|)
		do !x indices !rowarr
			!onearr.append(|"| + !cutpipelengthAttShow[!x] + |": "| + !rowarr[!x].string().replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
			handle any
				!onearr.append(|"| + !cutpipelengthAttShow[!x] + |": "| + '' + |",|)
			endhandle
			if !x eq !rowarr.size() then
				!onearr[!onearr.size()] = !onearr[!onearr.size()].substring(1,!onearr[!onearr.size()].length() - 1)
			endif
		enddo

		!onearr.insert(2,|"type":"Tubelength",|)
		!onearr.insert(2,|"nodeNames":["| + !this.branname + |"],|)
		!onearr.append(|},|)
		!result.appendarray(!onearr)
	enddo
	return !result
endmethod
