--Date			= April 24th 2023
--[Function]:	instore att of items into files and return string or merged path of att file
--
--[REV]
--Revision		= 1.1
--Date			= May 5th 2023
--[Function]:	add agr_remitems：do not need to get att for item in remitems
------------------------------------------

define function !!getatt(!items is array, !remitems is array, !attname1 is string) is string
	!cename = name

	if !attname1.unset() or !attname1 eq '' then
		!attName = 'd:\tempatt.att'
	else
		!attname = !attname1
	endif


	----------------------
	----------------------Step x:from siqiang
	!!deliveryModelMigration.WriteToAtt(!items,!attname)
	handle any
	elsehandle none
		return !attname
	endhandle




    var !FILE    |$!AttName|
    var !DILM    |:=|
    var !SEPR    |&end&|
    var !IGNORE  |,NAME,OWNER,|
    var !AIGNORE |,unset,=0/0,|  $*属性值等于其中任意一种，这属性不进行导出
    var !ODEPTH  DDEPTH
    var !PDEPTH  -99

    var !FNAM file "$!FILE" entry
    $* Unable find file (must be a new on)
    handle (41,323)
        $* Uncaptured errors
    elsehandle any
        --return error 1 |$!!ERROR.TEXT|
        q var !!error
        return ''
        $* File exists, do we want to overwrite it?
    elsehandle none
        --if(!!alert.confirm('OK to overwrite file $!FNAM$n?') ne 'YES') then
        -- return ''
        --endif
    endhandle

    $* Open file
    openfile "$!FILE" write !FUNIT		$* when the file is already exists(use OVERWRITE option)
    handle ANY
		--q var !!error
        openfile "$!FILE" overwrite !FUNIT
    endhandle

    $* Write Header
    var !DATE clock date
    var !TIME clock time
    writefile $!FUNIT |CADC_Attributes_File v1.0 , start: NEW , end: END , name_end: $!DILM , sep: $!SEPR|
    writefile $!FUNIT |NEW Header Information|

    var !DPRT compose |  Source$!DILM PDMS Data $!SEPR Date$!DILM $!DATE$n $!SEPR Time$!DILM $!TIME|
    writefile $!FUNIT |$!DPRT[1]|
    var !MDB MDB
    var !PROJECT PROJECT CODE
    var !NAME (FULLNAME)
    var !DPRT compose |  Project$!DILM $!PROJECT $!SEPR MDB$!DILM $!MDB $!SEPR Element$!DILM $!NAME|
    writefile $!FUNIT |$!DPRT[1]|
    writefile $!FUNIT |END|

	!remAllArr = array()
	do !R values !remItems
      var !remAllArr append coll all for $!R
    enddo


    do !M values !items
        $* Get element
		!PDEPTH = '-99'
        $!M
		var !ODEPTH  DDEPTH
        var !COLL coll all for $!M
		$* 判断移除列表在不在!coll中，如果在，进行difference。如果不在，不用对比数组
        !difference = !COLL.difference(!remItems)
        if !difference.size() ne !COLL.size() then
            !COLL = !COLL.difference(!remAllArr)
        endif

        $* Loop through the list of elements
        do !INDX indices !COLL
            --skip if(TYPE of $!COLL[$!INDX] inset (|TUBI|,|GENPRI|,|ARCHIV|,|GENCUR|,|BOX|,|NBOX|,|CYLI|,|NCYL|,|EXTR|,|LOOP|,|VERT|,|NXTR|,|CONE|,|NCON|,|CTOR|,|NCTO|,|RTOR|,|NRTO|,|DISH|,|NDIS|,|PYRA|,|NPYR|,|PJOI|,|PNOD|,|SNOD|,|SJOI|))
            skip if(TYPE of $!COLL[$!INDX] inset (|TUBI|,|GENPRI|,|ARCHIV|,|GENCUR|,|BOX|,|NBOX|,|CYLI|,|NCYL|,|EXTR|,|LOOP|,|VERT|,|NXTR|,|CONE|,|NCON|,|CTOR|,|NCTO|,|RTOR|,|NRTO|,|DISH|,|NDIS|,|PYRA|,|NPYR|,|PJOI|,|PNOD|,|SNOD|,|SJOI|,|POHE|,|POGO|,|AIDGRO|,|AIDLIN|,|AIDARC|,|AIDTEX|,|AIDCIR|,|LINDIM|,|MLABEL|))
			skip if(type of owner of $!COLL[$!INDX] inset (|POGO|))
			skip if (matchwild(name of $!COLL[$!INDX],'*-MBD') and (matchwild(type of $!COLL[$!INDX],'STRU') OR matchwild(type of $!COLL[$!INDX],'ZONE')))

			$!COLL[$!INDX]

            $* Hierarchy level
            var !DEPTH DDEPTH
            var !TAB   $!DEPTH * 2 - $!ODEPTH * 2
            var !ITAB  $!TAB + 2



--$(
            $* End(s)
            if($!DEPTH eq $!PDEPTH and $!PDEPTH neq -99) then		$* current item is not the first member, add end for previous one
                var !DPRT compose space $!TAB |END|
				--var !DPRT compose space $!TAB |END0|
                writefile $!FUNIT |$!DPRT[1]|

            elseif ($!DEPTH lt $!PDEPTH) then						$* when current level go back, add end for all level
                do !INDXA from $!PDEPTH to $!DEPTH by -1


                    var !DPRT compose space $!INDXA |END|
					--var !DPRT compose space $!INDXA |END1|
                    writefile $!FUNIT |$!DPRT[1]|
                enddo
            endif
--$)
            var !PDEPTH $!DEPTH

            $* Attributes of element
            var !ATTL delete
            var !ATTL attlist
            !ATTL.insert(1,'REF')

            $* Check it item is owned by a branch
            if(TYPE neq |WORL|) then
                if(TYPE of OWNER eq |BRAN| and NOT BADREF(SPREF)) then
                    var !ATTL append |APOS|
                    var !ATTL append |LPOS|
                    var !ATTL append |DTXR|
                    var !ATTL append |MTXX|
                    var !ATTL append |CWEI OF CMPREF OF SPREF|
                    var !ATTL append |p1bore|
                    var !ATTL append |LTLE|
                    var !ATTL append |DTXR OF LSTU|
                    var !ATTL append |MTXX OF LSTU|
                elseif(TYPE eq |BRAN|) then
                    var !ATTL append |LTLE|
                    var !ATTL append |DTXR OF HSTU|
                    var !ATTL append |MTXX OF HSTU|
                endif
            endif

            $* Get name
            var !NAME (FULLNAME)
            var !DPRT compose space $!TAB |NEW $!NAME|
            writefile $!FUNIT |$!DPRT[1]|

            var !ASIZE (arraywidth(!ATTL)) + 3

            $* Loop through attribute array
            do !ATTR values !ATTL
                if !attr eq |p1bore| then
                    if(type of $!COLL[$!INDX] inset (|TEE|,|OLET|) )then
                        !p1bore = p1bore of $!COLL[$!INDX]
                        handle ANY
                            skip
                        endhandle
                        !p3bore = p3bore of $!COLL[$!INDX]
                        !DN1 = !p1bore.string().replace('mm','')
                        !DN3 = !p3bore.string().replace('mm','')
                        var !dprt compose space $!ITAB |DN$n$!DILM| width $!ASIZE R space 2 |$!DN1$NX$!DN3 |
                        writefile $!FUNIT |$!dprt[1]|
                        VAR !PL PL of $!COLL[$!INDX]
                        handle ANY
                            skip
                        endhandle
                        !PL2 = !PL.split(' ')
                        !PLDN = !PL2[4]
                        var !dprt compose space $!ITAB |PLDN$n$!DILM| width $!ASIZE R space 2 |$!PLDN |
                        writefile $!FUNIT |$!dprt[1]|
                    elseif(type of $!COLL[$!INDX] inset (|REDU|) )then
                        !p1bore = p1bore of $!COLL[$!INDX]
                        handle ANY
                            skip
                        endhandle
                        !p2bore = p2bore of $!COLL[$!INDX]
                        !DN1 = !p1bore.string().replace('mm','')
                        !DN2 = !p2bore.string().replace('mm','')
                        var !dprt compose space $!ITAB |DN$n$!DILM| width $!ASIZE R space 2 |$!DN1$NX$!DN2 |
                        writefile $!FUNIT |$!dprt[1]|
                        VAR !PL PL of $!COLL[$!INDX]
                        handle ANY
                            skip
                        endhandle
                        !PL2 = !PL.split(' ')
                        !PLDN = !PL2[4]
                        var !dprt compose space $!ITAB |PLDN$n$!DILM| width $!ASIZE R space 2 |$!PLDN |
                         writefile $!FUNIT |$!dprt[1]|
                    else
                        !p1bore = p1bore of $!COLL[$!INDX]
                        handle ANY
                            skip
                        endhandle
                        !DN = !p1bore.string().replace('mm','')
                        var !dprt compose space $!ITAB |DN$n$!DILM| width $!ASIZE R space 2 |$!DN|
                        writefile $!FUNIT |$!dprt[1]|
                    endif
                elseif !attr eq |CWEI OF CMPREF OF SPREF| then
                    !cwei = CWEI OF CMPREF OF SPREF of $!COLL[$!INDX]
                    handle ANY
                        skip
                    endhandle
                    !cwei = !cwei.replace('(','').replace(')','').trim()
                    var !dprt compose space $!ITAB |CWEI OF CMPREF OF SPREF$n$!DILM| width $!ASIZE R space 2 |$!cwei |
                    writefile $!FUNIT |$!dprt[1]|
                elseif !attr eq |:PHLoadRefACN| then
                    !PHLoadRefACN = :PHLoadRefACN of $!COLL[$!INDX]
                    skip if (!PHLoadRefACN.size() gt 7 )
                    skip if(match(|$!IGNORE|,|,$!ATTR$n,|) gt 0)
                    var !ATTRIB (ATTRIB $!ATTR)
                    handle any
                        var !ATTRIB $!ATTR
                        handle ANY
                            skip
                        endhandle
                    endhandle
                    !ATTRIB = !ATTRIB.trim()
                    handle any
                        skip
                    endhandle

                    $* 处理$符号
                    if(match(!ATTRIB,'$$')gt 0)then
                        !newLine = |    $!ATTR$n$!DILM  | + !ATTRIB
                        writefile $!FUNIT !newLine
                    else
                        if(|$!ATTRIB| neq || and match(|$!AIGNORE|,|,$!ATTRIB$n,|) eq 0) then
                            var !DPRT compose space $!ITAB |$!ATTR$n$!DILM| width $!ASIZE R space 2 |$!ATTRIB|
                            writefile $!FUNIT |$!DPRT[1]|
                            handle any
                                skip
                            endhandle
                        endif
                    endif
                else
                    skip if(match(|$!IGNORE|,|,$!ATTR$n,|) gt 0)
                    var !ATTRIB (ATTRIB $!ATTR)
                    handle ANY
                        var !ATTRIB $!ATTR
                        handle ANY
                            skip
                        endhandle
                    endhandle
                    !ATTRIB = !ATTRIB.trim()
                    handle ANY
                        skip
                    endhandle

                    $* 处理$符号
                    if(match(!ATTRIB,'$$')gt 0)then
                        !newLine = |    $!ATTR$n$!DILM  | + !ATTRIB
                        writefile $!FUNIT !newLine
                    else

                        if !attrib.match('|') ne 0 then
                            if('$!ATTRIB' neq || and match(|$!AIGNORE|,',$!ATTRIB$n,') eq 0) then
                                var !DPRT compose space $!ITAB |$!ATTR$n$!DILM| width $!ASIZE R space 2 '$!ATTRIB'
                                writefile $!FUNIT '$!DPRT[1]'
                                handle any
                                    skip
                                endhandle
                            endif
                        else
                            if(|$!ATTRIB| neq || and match(|$!AIGNORE|,|,$!ATTRIB$n,|) eq 0) then
                                var !DPRT compose space $!ITAB |$!ATTR$n$!DILM| width $!ASIZE R space 2 |$!ATTRIB|
                                writefile $!FUNIT |$!DPRT[1]|
                                handle any
                                    skip
                                endhandle
                            endif
                        endif
                    endif
                endif
            enddo

        enddo

        --if($!DEPTH gt $!ODEPTH) then	$*202304261905 sui			if M has no member, no end would be added for M at the end
		if($!DEPTH ge $!ODEPTH) then
            do !INDXA from $!DEPTH to $!ODEPTH by -1
                var !TAB  $!INDXA * 2 - $!ODEPTH * 2
                var !DPRT compose space $!TAB |END|
				--var !DPRT compose space $!TAB |END2|
                writefile $!FUNIT |$!DPRT[1]|
            enddo
        endif
    enddo
    closefile $!FUNIT


	$!cename
    return !attname
-----------------------------20230426 e
endfunction
