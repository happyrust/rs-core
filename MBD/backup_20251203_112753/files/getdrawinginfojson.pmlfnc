define function !!getdrawinginfojson(!object is any, !nodename is string) is array
    --q var !object.drawsubprojectnumber
    --$p 11111111111
	!row = array()
	!row.append(|{|)
	!row.append(|"项目": "| & !object.drawproject & |",|)
	!row.append(|"设计公司": "| & !object.drawcompany & |",|)
	!row.append(|"图名": "| & !object.drawname & |",|)
	!row.append(|"图号": "| + !object.drawnum + |",|)
	!row.append(|"工程号": "| + !object.drawengineering + |",|)
	!row.append(|"子项号": "| + !object.drawsubprojectnumber + |",|)
	!row.append(|"机组": "| + !object.drawgroup + |",|)
	!row.append(|"专业": "| & !object.drawmajor & |"|)
	!row.append(|},|)
	!row.insert(2,|"type":"drawing",|)
	!row.insert(2,|"nodeNames":["| + !nodename + |"],|)
    --q var !row
	return !row
endfunction
