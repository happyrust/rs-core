define function !!getproofreadingjson(!object is any, !nodename is string) is array
	!row = array()
	!row.append(|{|)

	!row.append(|"文件编码": "| & !object.wjbm & |",|)
	!row.append(|"内部编码": "| & !object.nbbm & |",|)

	!row.append(|"版本信息": "| & !object.rev & |",|)
	!row.append(|"状态": "| & !object.status & |",|)

	!row.append(|"施设编制": "| & !object.compliation & |",|)
	!row.append(|"施设编制时间": "| & !object.compliationtime & |",|)

	!row.append(|"施设校对": "| & !object.Proofreading & |",|)
	!row.append(|"施设校对时间": "| & !object.Proofreadingtime & |",|)

	!row.append(|"施设审核1": "| & !object.review1 & |",|)
	!row.append(|"施设审核1时间": "| & !object.review1time & |",|)

	!row.append(|"施设审核2": "| & !object.review2 & |",|)
	!row.append(|"施设审核2时间": "| & !object.review2time & |",|)

	!row.append(|"施设审定1": "| & !object.approval1 & |",|)
	!row.append(|"施设审定1时间": "| & !object.approval1time & |",|)

	!row.append(|"施设审定2": "| & !object.approval2 & |",|)
	!row.append(|"施设审定2时间": "| & !object.approval2time & |",|)

	!row.append(|"施设会签": "| & !object.countersignature & |",|)
	!row.append(|"施设会签时间": "| & !object.countersignaturetime & |",|)

	--!row.append(|"设总": "| & !object.chiefdesign & |",|)
	--!row.append(|"设总时间": "| & !object.chiefdesigntime & |",|)

	!row.append(|"施设批准": "| & !object.ratify & |",|)
	!row.append(|"施设批准时间": "| & !object.ratifytime & |",|)
	$(
	!row.append(|"文件编码": [|)
	!row.append(|"| & !object.wjbm & |"|)
	!row.append(|],|)

	!row.append(|"内部编码": [|)
	!row.append(|"| & !object.nbbm & |"|)
	!row.append(|],|)

	!row.append(|"版本信息": [|)
	!row.append(|"| & !object.rev & |"|)
	!row.append(|],|)

	!row.append(|"编制": [|)
	!row.append(|"| & !object.compliation & |",|)
	!row.append(|"| & !object.compliationtime & |"|)
	!row.append(|],|)

	!row.append(|"校对": [|)
	!row.append(|"| & !object.Proofreading & |",|)
	!row.append(|"| & !object.Proofreadingtime & |"|)
	!row.append(|],|)

	!row.append(|"审核1": [|)
	!row.append(|"| & !object.review1 & |",|)
	!row.append(|"| & !object.review1time & |"|)
	!row.append(|],|)

	!row.append(|"审核2": [|)
	!row.append(|"| & !object.review2 & |",|)
	!row.append(|"| & !object.review2time & |"|)
	!row.append(|],|)

	!row.append(|"审定": [|)
	!row.append(|"| & !object.approval & |",|)
	!row.append(|"| & !object.approvaltime & |"|)
	!row.append(|],|)

	!row.append(|"会签": [|)
	!row.append(|"| & !object.countersignature & |",|)
	!row.append(|"| & !object.countersignaturetime & |"|)
	!row.append(|]|)

	!row.append(|"设总": [|)
	!row.append(|"| & !object.chiefdesign & |",|)
	!row.append(|"| & !object.chiefdesigntime & |"|)
	!row.append(|]|)

	!row.append(|"批准": [|)
	!row.append(|"| & !object.ratify & |",|)
	!row.append(|"| & !object.ratifytime & |"|)
	!row.append(|]|)
	$)

	!row.append(|},|)

	!row.insert(2,|"type":"check",|)
	!row.insert(2,|"nodeNames":["| + !nodename + |"],|)
	return !row
endfunction
