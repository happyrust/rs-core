define method .getdrawinfo()
	if !this.drawgroup.unset() then
		--!this.drawmajor = '布置'
		--!this.drawname = '管道支吊架设计模型（一）'
		!this.drawname = !this.suppname
		if !this.drawname.substring(1,1) eq '/' then
			!this.drawname = !this.drawname.after('/')
		endif
		!!getdrawinginfo(!this)     $*获取图纸信息
	endif
endmethod

define method .getDrawingInfoJson(!tryname is string) is array
	!row = !!getdrawinginfojson(!this,!tryname)
	return !row
endmethod
