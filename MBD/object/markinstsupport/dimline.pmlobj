define object dimline
	member .dir is direction	$*direction of dim
	member .poss is array		$*points need to dim
	member .diss is array		$*diss from start position of axis in this.dir

	member .planedir is direction	$*zdir of plane

	member .axis is line		$*line with first point of poss as startposition, and with direction is this dir

	--member .object is any
	member .objectindex is real	$*item for which this dim is
	member .partnum is real		$*for which part this dim is

	member .class is real		$*priority

	member .uniquepoints is boolean
	--member .ori
	--member .offset
	--member .shape

	member .adlongth is real
endobject
define method .dimline(!dir is direction,!inputposs is array,!objectindex is real,!partnum is real,!class is real,!uniquepoints is boolean)
	!this.uniquepoints = !uniquepoints
	!this.dimline(!dir,!inputposs,!objectindex,!partnum,!class)
endmethod
define method .dimline(!dir is direction,!inputposs is array,!objectindex is real,!class is real,!uniquepoints is boolean)
	!this.uniquepoints = !uniquepoints
	!this.dimline(!dir,!inputposs,!objectindex,!class)
endmethod
define method .dimline(!dir is direction,!inputposs is array,!class is real,!uniquepoints is boolean)
	!this.uniquepoints = !uniquepoints
	!this.dimline(!dir,!inputposs,!class)
endmethod


define method .dimline(!dir is direction,!inputposs is array,!objectindex is real,!partnum is real,!class is real)
	!this.objectindex = !objectindex
	!this.partnum = !partnum
	!this.dimline(!dir,!inputposs,!class)
endmethod
define method .dimline(!dir is direction,!inputposs is array,!objectindex is real,!class is real)
	!this.objectindex = !objectindex
	!this.dimline(!dir,!inputposs,!class)
endmethod
define method .dimline(!dir is direction,!inputposs is array,!class is real)
	!this.class = !class
	!poss = !inputposs
	!pos = !poss[1]
	!this.dir = !dir
	!diss = array()
	do !onepos values !poss
		!dis = !!suidirdis(!poss[1],!dir,!onepos)
		!diss.append(!dis)
	enddo

	!indices = !diss.sortedindices()
	!diss.reindex(!indices)
	!poss.reindex(!indices)
	if !this.uniquepoints.set() and !this.uniquepoints then
		!size = !diss.size()
		!dels = array()
		do !x from 2 to !size
			if !diss[!x] - !diss[!x - 1] lt 0.5 then	$*取整后不会是0
			--if !diss[!x] - !diss[!x - 1] lt 0.01 then
				!dels.append(!x)
			endif
		enddo
		do !x values !dels
			!diss[!x].delete()
			!poss[!x].delete()
		enddo
		!poss.compress()
		!diss.compress()
	endif

	!this.poss = !poss
	!this.diss = !diss
	!this.axis = !pos.offset(!this.dir,!diss[1]).line(!pos.offset(!this.dir,!diss.last()))

	!this.disstozero()
endmethod

define method .disstozero()
	if !this.diss.set() then
		!plus = 0 - !this.diss[1]
		do !x indices !this.diss
			!this.diss[!x] = !this.diss[!x] + !plus
		enddo
	endif
endmethod


define method .addonepos(!pos is position) is boolean
	!dis = !!suidirdis(!this.axis.startposition,!this.dir,!pos)
	if !this.uniquepoints.set() and !this.uniquepoints then
		do !index indices !this.diss
			if abs(!this.diss[!index] - !dis) lt 0.01 then
				return false
			endif
		enddo
	endif
	!goodindex = 0
	do !index indices !this.diss
		if !this.diss[!index] gt !dis then
			!goodindex = !index
			break
		endif
	enddo
	if !goodindex ne 0 then
		!this.poss.insert(!goodindex,!pos)
		!this.diss.insert(!goodindex,!dis)
	else
		!this.poss.append(!pos)
		!this.diss.append(!dis)
	endif

	return true
endmethod
define method .add(!pos is position)
	if !this.addonepos(!pos) then
		!this.axis = !this.axis.startposition.offset(!this.dir,!this.diss[1]).line(!this.axis.startposition.offset(!this.dir,!this.diss.last()))
	endif
	!this.disstozero()
endmethod

define method .add(!poss is array)
	do !pos values !poss
		!this.addonepos(!pos)
	enddo
	!this.axis = !this.axis.startposition.offset(!this.dir,!this.diss[1]).line(!this.axis.startposition.offset(!this.dir,!this.diss.last()))
	!this.disstozero()
endmethod

