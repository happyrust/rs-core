--
--<<Method>>:
--<<Public method>>:
--planesystem(!objects is array,!connections is array,!cheight is real) 	$*
--
--<<Private method>>:
--sortdimlines()															$*
--getconsidershapes(!dir is direction) is array 							$*
--assignDimlines()  														$*
-----Step 1:new way sort order of dimlines for each drawplane in order to get better view
--------Step 1:old way
--mergedimlines()   														$* merge dimline with same direction and distance between them is 0
--deleterepeateddimlines()  												$* delete similar dimline which they are same at dim direction
--------------Step 1:compare
--checksupppoint(!poss is array)											$*
--findlineforpoint(!pos is position)										$*
--getDimLines(!index is real)   											$*
--addcyli(!index is real,!pos1 is position,!pos2 is position,!outdia is real,!ori is orientation,!partnum is real)  	$*
--addcyli(!index is real,!pos1 is position,!pos2 is position,!outdia is real,!ori is orientation)   	$*
--getcyliposs(!pos1 is position,!pos2 is position,!outdia is real,!ori is orientation) is array 	$*
--addvolume(!index is real) 												$*
--getoutdia(!index is real) is real 										$*
--addconcreteshape(!poss is array,!index is real,!dir is direction) 		$*
--addshape(!poss is array,!index is real)   								$*
--addshape(!poss is array,!index is real,!partnum is real)  				$*
--getShapes(!index is real) 												$*
--addconnectionpos(!dir is direction,!poss is array,!index is real,!class is real)  	$*
--addconnectionpos(!dir is direction,!poss is array,!index is real,!x is real,!class is real)   	$*
--addDirconnectionpos(!dir is direction,!poss is array,!index is real,!x is real,!class is real) is boolean 	$*
