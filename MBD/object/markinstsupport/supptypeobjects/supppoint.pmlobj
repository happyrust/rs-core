define object supppoint
	member .pos is position
	member .dir is direction
	member .mems is array

	member .upstream is array		$*instore suppconnection of upstream
	member .downstream is array		$*instore suppconnection of downstream

	member .connections is array	$*instore rest suppconnection which is hard to say upstream or downstream
endobject

define method .supppoint(!item is string)
	!type = type of $!item
	if !type eq 'ATTA' then
		!this.pos = pos of $!item wrt/*
		!this.dir = ldir of $!item wrt/*
		handle any
		endhandle
		!this.mems = array()
		!this.mems.append(!item)
	else
		!this.pos = pos of $!item wrt/*
		!this.dir = ldir of $!item wrt/*
		handle any
		endhandle
		!this.mems = array()
		!this.mems.append(!item)
		--$p This type for clamp is not considered yet
	endif
endmethod

