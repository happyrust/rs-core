--
--<<Method>>:
--<<Public method>>:
--supppad(!attadatas is array)  											$*
--
--<<Private method>>:
-------------------------------------


define object supppad
	member .mems is array
	member .objects is array

	member .upstream is array		$*instore suppconnection of upstream
	member .downstream is array		$*instore suppconnection of downstream

	member .connections is array	$*instore rest suppconnection which is hard to say upstream or downstream
endobject

define method .supppad(!attadatas is array)
	!this.objects = !attadatas
	do !object values !attadatas
		!this.mems.append(!object.name)
	enddo
endmethod
