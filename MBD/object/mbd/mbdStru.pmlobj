define object mbdStru
	member .name is string
	member .type is string
	member .mbdSite is string
	member .mbdZone is string

	member .mbdconvey is string			$* new way

	member .mbdStru is string
	member .DimGro is string
	member .AidGro is string
	--member .valid is boolean

	member .useConvey is boolean
	--if true, onesite zone-site conveyXXX-zone stru-bran/civil/equi/room/supp
	--if false,site-site zone-zone stru-bran/civil/equi/room/supp
endobject

-------------------------------------------------------------------------------------------Init object, and get name and type
define method .mbdStru(!item is any)
	!this.useconvey = true
	--!this.useconvey = false
	!types = split('BRAN WALL GWALL STWALL FLOOR ROOM EQUI :SUPP STRU REST SUPPO SUPC ZONE')
	do !type values !types
		--$P $!TYPE $!ITEM
		!tempname = name of $!type of $!item
		handle any
			!tempname = name of zone of $!item
			if acttype of $!tempname ne ':SUPP' then
				skip
			else
				!this.name = !tempname
				!this.type = 'SUPP'
				break
			endif
		elsehandle none
			!this.name = !tempname
			--if !type inset(':SUPP','STRU','REST','SUPPO','SUPC') or (!type eq 'ZONE' and acttype of $!this.name eq ':SUPP') then
            if !type inset(':SUPP','REST','SUPPO','SUPC') or (!type eq 'ZONE' and acttype of $!this.name eq ':SUPP') then $*20240708去掉STRU用于接地最小单元的标注pk
            --$p 321
				!tempresult = !!getsuppname(!item)
				if !tempresult.set() then
					!this.name = !tempresult[1]
					!this.type = 'SUPP'
				endif
			else
				!this.type = !type
			endif
			break
		endhandle
	enddo
	--q var !this.name
	if !this.name.set() then
		!this.getdata(!this.name)
		--!this.valid = !this.getdata(!this.name)
	endif
endmethod

------------------------------------------------------------------------------------------------------get name of site zone stru dimgro aidgro for MBD
define method .getData(!item is any)

	-- is boolean
	--if name is like /xxx, the max length is 50 (include) ,max length of xxx is 49(include)
	if !this.type ne 'SUPP' then
		!namn = namn of $!item
		if !namn.length() gt 45 then
			var !namn ref of $!item
		endif
		if !namn.substring(1,1) eq '=' then
			!name = '/' + !namn.replace('=','_').replace('/','_')
		else
			!name = '/' + !namn
		endif
	else
		!name = !this.name
	endif
	--q var !name

	!site = namn of site of $!item
	if !site.length() gt 45 then
		var !site ref of site of $!item
	endif
	if !site.substring(1,1) eq '=' then
		!site = '/' + !site.replace('=','_').replace('/','_')
	else
		!site = '/' + !site
	endif
	--q var !this.type
	if !this.type ne 'SUPP' then
		!zone = namn of zone of $!item
		if !zone.length() gt 45 then
			var !zone ref of zone of $!item
		endif
	else
		!zone = namn of owner of :supp of $!item
		handle any
			!zone = namn of zone of $!item
		endhandle
		--q var !zone
		if !zone.length() gt 45 then
			var !zone ref of owner of :supp of $!item
			handle any
				var !zone ref of zone of $!item
			endhandle
		endif
	endif
	if !zone.substring(1,1) eq '=' then
		!zone = '/' + !zone.replace('=','_').replace('/','_')
	else
		!zone = '/' + !zone
	endif


	!MBDSite = !site + '-MBD'
	--!MBDSite = name of site of $!item	$*------------------------------------------------------OLD way


	!MBDZone = !zone + '-MBD'
	!MBDStru = !Name + '-MBD'

	!dimGro = !Name + '-DIM'
	!aidGro = !Name + '-AID'


	--no need
	--!this.name = name of $!item
	--!this.type = type of $!item

	if !this.useconvey then
		!this.mbdSite = '/MBD'
		!this.mbdZone = !mbdSite
		!this.mbdConvey = !mbdZone
		!this.mbdStru = !mbdStru
		!trydb = !this.mbdstru.dbref()
		handle any
		elsehandle none
			!this.mbdconvey = !trydb.owner.name		$* if exist , use old one
		endhandle
		!this.dimGro = !dimGro
		!this.aidGro = !aidGro
	else
		!this.mbdSite = !mbdSite
		!this.mbdZone = !mbdZone
		!this.mbdStru = !mbdStru
		!this.dimGro = !dimGro
		!this.aidGro = !aidGro
	endif

	return

	$(
	--old way 202306121521
	-- is boolean
	--if name is like /xxx, the max length is 50 (include) ,max length of xxx is 49(include)
	!namn = namn of $!item
	if !namn.length() gt 45 then
		var !namn ref of $!name
	endif
	!name = '/' + !namn.replace('=','_').replace('/','_')

	!site = namn of site of $!item
	if !site.length() gt 45 then
		var !site ref of site of $!item
	endif
	!site = '/' + !site.replace('=','_').replace('/','_')

	!zone = namn of zone of $!item
	if !zone.length() gt 45 then
		var !zone ref of zone of $!item
	endif
	!zone = '/' + !zone.replace('=','_').replace('/','_')

	!MBDSite = !site + '-MBD'
	!MBDSite = name of site of $!item	$*------------------------------------------------------temp way

	!MBDZone = !zone + '-MBD'
	!MBDStru = !Name + '-MBD'

	!dimGro = !Name + '-DIM'
	!aidGro = !Name + '-AID'


	!this.name = name of $!item
	!this.type = type of $!item
	!this.mbdSite = !mbdSite
	!this.mbdZone = !mbdZone
	!this.mbdStru = !mbdStru
	!this.dimGro = !dimGro
	!this.aidGro = !aidGro
	$)

	$(
	!dbref = object dbref(!this.dimgro)
	handle any
		if !this.todim().not() then
			return false
		endif
	endhandle

	!dbref = object dbref(!this.aidgro)
	handle any
		if !this.toaid().not() then
			return false
		endif
	endhandle
	return true
	$)
endmethod

-------------------------------------------------------navigate to site zone stru dimgro or aidgro
define method .toSite() is boolean
	$!this.mbdsite
	handle any
		return false
	endhandle
	return true
endmethod

define method .toZone() is boolean
	$!this.mbdZone
	handle any
		if !this.tosite().not() then
			return false
		endif
		new zone name $!this.mbdzone
		handle any
			return false
		endhandle
	endhandle
	return true
endmethod

define method .toConvey() is boolean
	$!this.mbdConvey
	handle any
		!this.mbdConvey = !this.mbdConvey.before('-MBD') + '-MBD'
		if !this.toZone().not() then
			return false
		endif
		!maxsize = 200
		--var !conveys coll all convey for ce
		--q var !conveys
		!matchstring = !this.mbdconvey + '*'
		var !conveys coll all convey with(matchwild(name,!matchstring)) for ce

		--直接这样用不行
		--var !conveys coll all convey with(matchwild(name,!this.mbdconvey + '*')) for ce

		--!cename = name
		--$p zone $!cename
		--q var !this.mbdconvey
		--q var !conveys
		if !conveys.set() then
			--q var !conveys
			!nums = !conveys.evaluate(object block('!conveys[!evalindex].dbref().name.substring(-3,3).real()'))
			--q var !nums
			if !nums.set() then
				!nums.sort()
				!lastnumstring = !this.getfullnumberstring(!nums.last())
				!tryname = !this.mbdconvey & !lastnumstring
				!countnum = mem count of $!tryname
				handle any
				elsehandle none
					if !countnum lt !maxsize then
						--if the number of mem of last convey with this name is less than maxsize, use this convey
						!this.mbdConvey = !tryname
						$!tryname
						return true
					endif
				endhandle

				!newnum = !nums.last() + 1
				!numstring = !this.getfullnumberstring(!newnum)
			else
				!numstring = '001'
			endif
		else
			!numstring = '001'
		endif


		!conveyname = !this.mbdconvey & !numstring
		--q var !conveyname
		new Convey name $!conveyname
		handle any
			return false
		elsehandle none
			!this.mbdconvey = !conveyname
		endhandle
	endhandle
	return true
endmethod

define method .getfullnumberstring(!num is real) is string
	!numstring = !num.string()
	if !numstring.length() lt 2 then
		!numstring = '0' +!numstring
	endif
	if !numstring.length() lt 3 then
		!numstring = '0' +!numstring
	endif
	return !numstring
endmethod

define method .toStru() is boolean
	$!this.mbdStru
	handle any
		--not exist, create a new one
		if !this.useconvey then
			if !this.toConvey().not() then
				return false
			endif
		else
			if !this.toZone().not() then
				return false
			endif
		endif
		new stru name $!this.mbdstru
		handle any
			return false
		endhandle
	endhandle
	return true
endmethod

define method .toDim() is boolean
	!good = true
	$!this.dimgro
	handle any
		if !this.tostru().not() then
			return false
		endif
		--$p $!this.dimgro
		--$p asdfasdfs
		new dimgro
		handle any
			!good = false
		elsehandle none
			name $!this.dimgro
			handle any
				delete dimgro
				!good = false
			endhandle
		endhandle

		if !good.not() then
			!memcount = mem count of $!this.mbdzone
			if !memcount eq 0 then
				$!this.mbdzone
				delete zone
			endif
			return false
		endif
	endhandle
	return true
endmethod

define method .toAid() is boolean
	!good = true
	--q var !this.aidgro
	$!this.aidgro
	handle any
		if !this.tostru().not() then
			return false
		endif
		new aidgro
		handle any
			--$p fail new
			!good = false
		elsehandle none
			--$p success new
			name $!this.aidgro
			--$p safd
			handle any
				delete aidgro
				!good = false
			endhandle
		endhandle
		--q var !good
		if !good.not() then
			!memcount = mem count of $!this.mbdzone
			if !memcount eq 0 then
				$!this.mbdzone
				delete zone
			endif
			return false
		endif
		--$p asdfsaf
	endhandle
	return true
endmethod

----------------------------------------------delete
define method .deleteStru() is boolean
	$!this.mbdStru
	handle any
		return true
	endhandle
	delete stru
	handle any
		return false
	elsehandle none
		return true
	endhandle
endmethod

define method .deleteDim() is boolean
	if !this.dimgro.unset() then
		return true
	endif
	$!this.dimgro
	handle any
		return true
	elsehandle none
		delete dimgro
		handle any
			q var !!error
			return false
		elsehandle none
			return true
		endhandle
	endhandle
	!this.deletecheck()
	return true
endmethod

define method .deleteAid() is boolean
	if !this.aidgro.unset() then
		return true
	endif
	$!this.aidgro
	handle any
		return true
	elsehandle none
		delete aidgro
		handle any
			q var !!error
			return false
		elsehandle none
			return true
		endhandle
	endhandle
	!this.deletecheck()
	return true
endmethod

define method .gettypestring(!types is any) is string
	if !types.objecttype() eq 'STRING' then
		if !types.upcase().trim() eq 'ALL' then
			!type = 'lindim aidlin aidtex aidarc aidcir aidpoi mlabel'
		else
			!colltypes = array()
			!colltypes.append(!types)
		endif
	elseif !types.objecttype() eq 'ARRAY' then
		!colltypes = !types
	endif
	if defined(!colltypes) then
		!type = ''
		do !onetype values !colltypes
			if !type eq '' then
				!type = !onetype
			else
				!type = !type + ' ' + !onetype
			endif
		enddo
	endif
	return !type
endmethod
define method .getFunctionString(!functions is any) is string
	if !functions.objecttype() eq 'STRING' then
		if !functions.trim() eq '' then
			return ''
		else
			!arr[1] = !functions
		endif
	else
		!arr = !functions
	endif

	do !x indices !arr
		!one = !arr[!x].trim()
		if !x eq 1 then
			!functionstring = |'| + !one
		else
			!functionstring = !functionstring + |','| + !one
		endif
	enddo
	!functionstring = !functionstring + |'|
	return !functionstring
endmethod
define method .getitems(!types is any, !functions is any) is array
	!type = !this.getTypeString(!types)
	!functionstring = !this.getFunctionString(!functions)
	if !functionstring eq '' then
		var !all coll all ($!type) for $!this.mbdstru
		handle any
			!all = array()
		elsehandle none
			do !x indices !all
				!type = type of $!all[$!x]
				if !type inset ('STRU','AIDGRO','DIMGRO') then
					!all[!x].delete()
				endif
			enddo
			!all.compress()
		endhandle
	else
		var !all coll all ($!type) with (function inset ($!functionstring)) for $!this.mbdstru
		handle any
			!all = array()
		endhandle
	endif
	return !all
endmethod
define method .deleteFunction(!types is any, !functions is any) is boolean
	!all = !this.getitems(!types,!functions)

	do !one values !all
		!type = type of $!one
		$!one
		--$p $!type
		delete $!type
		handle any
			$!one cant be delete
			return false
		endhandle
	enddo

	!this.deletecheck()
	return true
endmethod

define method .deletecheck()
	!dimmemcount = mem count of $!this.dimgro
	handle any
		!dimmemcount = 0
	elsehandle none
		if !dimmemcount eq 0 then
			$!this.dimgro
			delete dimgro
		endif
	endhandle

	!aidmemcount = mem count of $!this.aidgro
	handle any
		!aidmemcount = 0
	elsehandle none
		if !aidmemcount eq 0 then
			$!this.aidgro
			delete aidgro
		endif
	endhandle

	if !dimMemCount eq 0 and !aidMemCount eq 0 then
		$!this.mbdstru
		handle any
		elsehandle none
			delete stru
		endhandle
	endif
endmethod

---------------------------------------------------------------remove
define method .removeStru() is boolean
	!name = name of $!this.mbdStru
	handle any
		return true
	endhandle
	remove $!this.mbdStru
	handle any
		return false
	elsehandle none
		return true
	endhandle
endmethod

define method .removeDim() is boolean
	!name = name of $!this.dimgro
	handle any
		return true
	elsehandle none
		remove $!this.dimgro
		handle any
			return false
		elsehandle none
			return true
		endhandle
	endhandle
endmethod

define method .removeAid() is boolean
	!name = name of $!this.aidgro
	handle any
		return true
	elsehandle none
		remove $!this.aidgro
		handle any
			return false
		elsehandle none
			return true
		endhandle
	endhandle
endmethod

define method .removeFunction(!types is any, !functions is any) is boolean
	!all = !this.getitems(!types,!functions)

	do !one values !all
		remove $!one
		handle any
			$!one cant be remove
			return false
		endhandle
	enddo
	return true
endmethod

---------------------------------------------------------------add
define method .addStru() is boolean
	!name = name of $!this.mbdStru
	handle any
		return true
	endhandle
	add $!this.mbdStru
	handle any
		return false
	elsehandle none
		--return true
	endhandle
	--q var !name
	var !all coll all (aidtex aidlin aidpoi aidcir mlabel lindim) for $!this.mbdstru
	do !item values !all
		!desc = desc of $!item
		!items = !desc.after('node:').split()
		do !aaa values !items
			add $!aaa
			handle any
			endhandle
		enddo
	enddo
	return true
endmethod

define method .addDim() is boolean
	!name = name of $!this.dimgro
	handle any
		return true
	elsehandle none
		add $!this.dimgro
		handle any
			return false
		elsehandle none
			return true
		endhandle
	endhandle
endmethod

define method .addAid() is boolean
	!name = name of $!this.aidgro
	handle any
		return true
	elsehandle none
		add $!this.aidgro
		handle any
			return false
		elsehandle none
			return true
		endhandle
	endhandle
endmethod

define method .addFunction(!types is any, !functions is any) is boolean
	!all = !this.getitems(!types,!functions)

	do !one values !all
		add $!one
		handle any
			$!one cant be add
			return false
		endhandle
	enddo
	return true
endmethod

---------------------------------------------------------------check
$(
define method .checkDim() is boolean
	return !this.checktype('LINDIM')
endmethod

define method .checkmlabel() is boolean
	return !this.checktype('MLABEL')
endmethod
$)

define method .checktype(!types is any) is boolean
	return !this.checktype(!types,'')
endmethod

define method .checktype(!types is any, !functions is any) is boolean
	!all = !this.getitems(!types,!functions)
	if !all.set() then
		return true
	else
		return false
	endif
endmethod

define method .checkifdimed() is boolean
	!all = !this.getitems('ALL','')
	if !all.set() then
		return true
	else
		return false
	endif
endmethod

