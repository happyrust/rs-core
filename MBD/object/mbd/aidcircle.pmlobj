define object aidcircle
	member .owner is string
	member .name is string
	member .pos is position
	member .ori is orientation
	member .radius is real


	member .function is string			$*function for
	member .desc is string				$*nodenames
endobject

define method .aidcircle(!item is any)
	!this.name = name of aidcircle of $!item
	handle any
		return
	endhandle
	!this.owner = name of owner of $!this.name
	!this.pos = pos of $!this.name wrt/*
	!this.ori = ori of $!this.name wrt/*
	!this.radius = radius of $!this.name


	!this.function = function of $!this.name
	!this.desc = desc of $!this.name
endmethod

define method .aidcircle(!owner is any, !pos is position, !ori is orientation, !radius is real, !function is string, !desc is string) is boolean
	!this.owner = name of $!owner
	!this.pos = !pos
	!this.ori = !ori
	!this.radius = !radius

	if !function.trim() ne '' then
		!this.function = !function.trim()
	else
		!this.function = ''
		--!this.function = '其它'
	endif
	if !desc.trim() ne '' then
		!this.desc = !desc.trim()
	endif

	return !this.create()
endmethod

define method .create() is boolean
	$!this.owner
	handle any
		return false
	endhandle

	new aidcircle
	handle any
		return false
	endhandle

	if !this.name.set() then
		name $!this.name
		handle any
			return false
		endhandle
	else
		!this.name = name
	endif

	position $!this.pos
	ori $!this.ori
	radius $!this.radius


	if !this.function.set() and !this.function.trim() ne '' then
		function '$!this.function'
	endif

	if !this.desc.set() and !this.desc.trim() ne '' then
		desc '$!this.desc'
	endif
	return true
endmethod

define method .json() is array
	!aidcircle = !this.name

	!result = array()
	!result.append(|{|)

	!result.append(!!getNodeNames(!aidcircle))
	!result.append(|"type": "circle",|)
	--!result.append(|"function": "| + !this.function + |",|)

	if !this.function ne '' then
		!result.append(|"function": "| + !this.function + |",|)
	else
		!result.append(|"function": "| + |其它| + |",|)
	endif


	!result.append(|"position": [|)
	!result.appendarray(!!postoArr(!this.pos))
	!result.append(|],|)

	!result.append(|"radius": "| + !this.radius.string().upcase().before('MM') + |",|)
	!result.append(|"ori": "| + !!oriToTplantAngle(!aidcircle)[4] + |"|)
	!result.append(|},|)

	return !result
endmethod


