define object projectdata
	member .name is string
	member .number is string
	member .desc is string
	member .message is string
	member .id is string
	member .group is string
	member .project is string
endobject

define method .projectdata()
	var !projectnum project number
	var !projectname project name
	var !projectdescription project description
	var !projectmessage project message
	var !projectid project id

	if !projectmessage.match('机组') ne 0 then
		!tempstring = !projectmessage
	else
		!tempstring = !projectdescription
	endif
	if !tempstring.match('号机组') ne 0 then
		!tempstring = !tempstring.before('号机组')
	elseif !tempstring.match('机组') ne 0 then
		!tempstring = !tempstring.before('机组')
	endif

	!group = ''
	do !x from 1 to !tempstring.length()
		!letter = !tempstring.substring(- !x ,1)
		--q var !letter
		if !letter inset ('1','2','3','4','5','6','7','8','9','、','.') then
			!group = !letter + !group
		else
			break
		endif
	enddo
	--q var !group


	!project = !tempstring

    if  !projectnum eq '2016' then
        !project ='浙江金七门核电厂1、2号机组'
    endif
        -- !project = '江苏徐圩核能供热发电厂一期工程'
    -- endif

    --q var !project

	!this.project = !project
	!this.number = !projectnum
	!this.name = !projectname
	!this.desc = !projectdescription
	!this.message = !projectmessage
	!this.id = !projectid
	!this.group = !group
endmethod

C