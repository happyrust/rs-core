--
--<<Method>>:
--<<Public method>>:
--floorRoom(!item is any)   												$*
--
--<<Private method>>:
--getroomvertpoints()   													$*
--getatts() 																$*
--getdrawpoints()   														$*
--getdrawpoints2(!profile is profile)   									$*
--getdrawpoints3(!insidepoints is array, !insidedirs is array,!profile is profile)  	$*
--split(!profile is profile,!insidepoint is position,!dir is direction) is array	$*
--cutedge(!interpoint is position,!edge is any) is array					$*
--getinterpoint(!line is line,!edge is any) is array						$*
--getposdir(!edge is any, !headortail is boolean) is array  				$* head true,tail false
