define object markCivil
	member .ref is string
	member .civilname is string
	member .type is string
	member .owner is string
	member .markname is string

	member .checkedmem is boolean
	member .mems is array
	member .thick is real			$* it is for floor and all kinds of wall
	member .ori is orientation
	member .zdir is direction
	member .level is real			$* for floor


	member .profiles is array		$* it is for GWALL FLOOR STWALL

	member .arcs is array			$* it is for wall
	member .height is real			$* it is for wall

	member .originori1 is orientation
	member .originpoint1 is position
	member .originori2 is orientation
	member .originpoint2 is position

	member .mbdstru is mbdstru
	member .cenpoint is position

	member .Textoffsetdis is real
	member .civilCheight is real
	member .roomCheight is real
	member .doorCheight is real
	member .apdpCheight is real
	member .openingCheight is real
	member .elthickCheight is real
	member .memdimcheight is real
	member .civildimcheight is real

	member .lines is array			$* for gwall stwall

	member .otherLineOrArcs is array		$* line or arc from other walls

	member .onwallindices is array			$* for floor (walls on floor)

	member .otherwallindices is array		$* for wall (relation between current wall and other walls)
	member .interpoints1 is array
	member .interpoints2 is array
	member .pointsymbles1 is array
	member .pointsymbles2 is array
	member .otherendpoints is array
	member .volume is volume
	member .currentfloorname is string


	member .markThickAfterName is boolean
	member .vertDim is boolean				$* lindim in vertical direction to describe the length of the wall
	member .mat is boolean
	member .secondcon is boolean
	member .openingpos is boolean


	member .autocheight is boolean
	member .autocheightbili is real
	member .sepSmallDim is boolean

	member .markmem is boolean

	--member .specialnum is string
	member .purpose is string
	member .strongclass is string

	member .generatejson is boolean
	member .filepath is string

	member .wrongs is array

	member .lookdir is direction


	member .rooms is array
	member .doors is array

	member .form is form


	--for modelatt drawing and proofreading
	!tempstrings = split('membermodelatt memberdrawinginfo memberproofreading')
	do !string values !tempstrings
		!tempfile = object file(!!commonpath() + !string + '.txt')
		!lines = !tempfile.readfile()
		do !line values !lines
			if !line.trim().trim('	') ne '' then
				$!line
			endif
		enddo
	enddo
endobject

define method .markcivil(!item is any, !getdata is boolean, !form is form)
	!this.form = !form
	!this.markcivil(!item,!getdata)
endmethod
define method .markcivil(!item is any, !form is form)
	!this.form = !form
	!this.markcivil(!item)
endmethod
define method .markcivil(!item is any, !getdata is boolean)
	!this.markcivil(!item)
	if !getdata then
		!this.getDataOfCivil()
	endif
endmethod
define method .markCivil(!item is any)
	--!this.getspecialnum()
	!this.textOffsetDis = 5
	!this.civilCheight = 350
	!this.roomCheight = 350
	!this.doorCheight = 150
	!this.apdpCheight = 70
	!this.openingCheight = 70
	!this.elthickCheight = 70
	!this.memdimcheight = 70
	!this.markThickAfterName = false
	--!this.markThickAfterName = true
	!this.vertDim = false

	!this.markmem = true

	!types = split('WALL GWALL STWALL FLOOR')
	do !type values !types
		!this.civilname = name of $!type of $!item
		handle any
			--q var !!error
			--$p adsfasf $!type
		elsehandle none
			!this.type = !type
			var !ref ref of $!this.civilname
			!this.ref = !ref
			break
		endhandle
	enddo

	if !this.civilname.set() then
		!this.setform(!item)
		--!this.getDataOfCivil()
		!this.getatts()
		--!this.getDataOfMem()
		--!this.getDimName()
		!this.mbdstru = object mbdstru(!this.civilname)
		!this.volume = object volume(object dbref(!this.civilname))
	else
		$p Choose right Type please
	endif
endmethod

define method .setform(!item is any)
	if !this.form.unset() then
		!sitename = name of site of $!item
		if !sitename.match('ARCH') ne 0 then
			!this.form = !!markarchform
			handle any
				show !!markarchform
				handle any
					!this.form = !!markcivilform
				elsehandle none
					hide !!markarchform
					!this.form = !!markarchform
				endhandle
			endhandle
		else
			!this.form = !!markcivilform
			handle any
				show !!markcivilform
				handle any
					!this.form = !!markarchform
				elsehandle none
					hide !!markcivilform
					!this.form = !!markcivilform
				endhandle
			endhandle
		endif
	endif
endmethod
$(
define method .getspecialnum()
	!this.specialnum = 'xxxxxxxxxxxx'
endmethod



define method .markCivil(!item is any, !onlyCivilData is boolean)	$*useless
	!types = split('WALL GWALL STWALL FLOOR')
	do !type values !types
		!this.civilname = name of $!type of $!item
		handle any
		elsehandle none
			!this.type = !type
			var !ref ref of $!this.civilname
			!this.ref = !ref
			break
		endhandle
	enddo

	if !this.civilname.set() then
		!this.getatts()
		--!this.getDataOfCivil()
	endif
endmethod
$)

define method .clearcontent()
	!this.checkedmem = false
endmethod

define method .getatts()
	!name = name of frmw of $!this.civilname
	!!setattvalue(!this,!name,split('purpose/purpose,drawnum/:zd_nbbm,thick/:jj_qthd,strongclass/:jj_qddj',','))
	!!setattvalue(!this,!name,split('room/:room_no,tssm/:zd_tssm,wjbm/:zd_wjbm,nbbm/:zd_nbbm,status/:zd_status,rev/:zd_rev',','))
	!this.owner = !name
	if !this.form.name() eq 'MARKARCHFORM' then
		!this.markname = !this.owner.part(-3,'-')
	else
		!this.markname = !this.owner.part(-1,'-')
	endif
	if type of $!this.civilname eq 'FLOOR' then
		!pos = pos of $!this.civilname wrt/*
		!this.level = !pos.up.string('D1').replace('.0','').real()
	endif

	!this.rev = 'A' $*4月30日前
	!this.getdrawinfo()
	!!setproofreadinginfo(!this,!name)

	if !this.thick.unset() or !this.thick eq 0 then
		!this.getdataofcivil()
	endif

	$(
	------------------------------------------------------
	------------------------------------------------------
	!civil = !this.civilname

	!this.purpose = purpose of $!civil
	handle any
		!this.purpose = ''
	endhandle

	!this.drawnum = :zd_nbbm of $!civil
	handle any
		!this.drawnum = ''
	endhandle

	--!this.owner = name of owner of $!civil
	!this.owner = name of frmw of $!civil
	--!this.markname = !this.owner.part(-1,'-')
	--q var !this.form
	if !this.form.name() eq 'MARKARCHFORM' then
		!this.markname = !this.owner.part(-3,'-')
	else
		!this.markname = !this.owner.part(-1,'-')
	endif

	!this.thick = :jj_qthd OF $!this.owner
	handle any
		--!this.thick = 0
		!this.getdataofcivil()
	endhandle

	!this.strongclass = :jj_qddj of $!this.owner
	handle any
		!this.strongclass = ''
	endhandle

	if type of $!civil eq 'FLOOR' then
		!pos = pos of $!civil wrt/*
		!this.level = !pos.up.string('D1').replace('.0','').real()
	endif
	$)
endmethod

define method .getcivilAttArr(!civilAtts is array) is array
	if !this.purpose.unset() then
		!this.getatts()
	endif

	!row = array()
	do !x indices !civilatts
		!att = !civilAtts[!x]
		!com = |!row[!x] = !this.| + !att
		$!com
		handle any
			!rows[!x] = ''
			$p No civilatt: $!att for civil $!this.civilname
		endhandle
	enddo
	--q var !row
	return !row
endmethod


define method .getDataOfCivil()
	if !this.thick.set() and !this.thick ne 0 then
		return
	endif
	!this.ori = ori of $!this.civilname wrt/*
	--q var !this.ori
	--!this.zdir = !this.ori.zdir()
	!type = !this.type
    --q var !this.civilname
	if !type eq 'STWALL' then
		!this.zdir = !this.ori.ydir()
		--!desp = desp of $!this.civilname
		!widthstring = prop thk of $!this.civilname
        handle any
            --modify by jyg 20241129,处理墙没有实体的情况
            return
        endhandle
		!height1string = prop height of $!this.civilname
		handle any
			return
		endhandle
		!width = !widthstring.real()
		!heightstart = !height1string.real()
		!height2string = prop haut of $!this.civilname
		handle any
		elsehandle none
			!heightend = !height2string.real()
		endhandle
		var !posstartstring pos ppli na prop 0 of $!this.civilname wrt/*
		var !posendstring pos ppli na prop 1 of $!this.civilname wrt/*
		!poss[1] = !posstartstring.position()
		!poss[2] = !posendstring.position()
		!ori = !this.ori
		!xdir = !ori.xdir()
		!ydir = !ori.ydir()

		!drnstart = drnstart of $!this.civilname wrt/*
		!tempdir = !poss[1].direction(!poss[2])
		!tempangle = !tempdir.angle(!drnstart)
		if !tempangle gt 85 and !tempangle lt 95 then
			!drnstart = !tempdir
		endif
		!drnend = drnend of $!this.civilname wrt/*
		!tempangle = !tempdir.angle(!drnend)
		if !tempangle gt 85 and !tempangle lt 95 then
			!drnend = !tempdir
		endif

		!posstart1 = !poss[1].offset(!xdir,!width)
		!posend1 = !poss[2].offset(!xdir,!width)
		!line2 = !posstart1.line(!posend1)

		!pointvector = object pointvector(!poss[1],!drnstart)
		!plane1 = !pointvector.plane()
		!poss[3] = !plane1.intersection(!line2)

		!pointvector = object pointvector(!poss[2],!drnend)
		!plane2 = !pointvector.plane()
		!poss[4] = !plane2.intersection(!line2)

		!poss[5] = !poss[1].offset(!ydir,!heightstart)
		!poss[7] = !poss[3].offset(!ydir,!heightstart)
		if defined(!heightend) then
			!poss[6] = !poss[2].offset(!ydir,!heightend)
			!poss[8] = !poss[4].offset(!ydir,!heightend)
		else
			!poss[6] = !poss[2].offset(!ydir,!heightstart)
			!poss[8] = !poss[4].offset(!ydir,!heightstart)
		endif


		!profileOri = y is $!ydir and z is $!xdir
		!poss1 = array()
		!poss1.append(!poss[1])
		!poss1.append(!poss[2])
		!poss1.append(!poss[6])
		!poss1.append(!poss[5])

		!profile1 = object profile(!poss[1],!profileori,!poss1)

		!tempzdir = !xdir.opposite()
		!profileOri = y is $!ydir and z is $!tempzdir
		!poss2 = array()
		!poss2.append(!poss[3])
		!poss2.append(!poss[4])
		!poss2.append(!poss[8])
		!poss2.append(!poss[7])

		!profile2 = object profile(!poss[3],!profileori,!poss2)

		!this.profiles.append(!profile1)
		!this.profiles.append(!profile2)
		!thick = !line2.distance(!poss[1])
		!this.height = !heightstart
	elseif !type eq 'WALL' then
		!this.zdir = !this.ori.zdir()
		!thicknessString = prop thk of $!this.civilname
		!thickness = !thicknessString.real()
		!heightString = prop heig of $!this.civilname
		!height = !heightstring.real()

		!this.height = !height


		!mems = members of first spine of $!this.civilname
		!poss = array()
		do !mem values !mems
			!mempos = pos of $!mem wrt/*
			!poss.append(!mempos)
		enddo

		!pos1 = !poss[1]
		!pos2 = !poss[2]
		!pos3 = !poss[3]
		!line1 = !pos1.line(!pos2)
		!line2 = !pos2.line(!pos3)
		!dir1 = !line1.direction()
		!dir2 = !line2.direction()
		!zdir = !dir1.orthogonal(!dir2)
		!mdir1 = !dir1.orthogonal(!zdir)
		!mpos1 = !pos1.midpoint(!pos2)
		!mpos2 = !pos2.midpoint(!pos3)
		!mdir2 = !dir2.orthogonal(!zdir)
		!templine1 = !mpos1.line(!mpos1.offset(!mdir1,1000))
		!templine2 = !mpos2.line(!mpos2.offset(!mdir2,1000))
		!cenpos = !templine1.intersection(!templine2)

		!radius = !cenpos.distance(!pos1)

		!dir1 = !cenpos.direction(!pos1)
		!dir2 = !cenpos.direction(!pos2)
		!dir3 = !cenpos.direction(!pos3)

		!angle = 0
		do !x from 2 to !poss.size()
			!dira = !cenpos.direction(!poss[!x - 1])
			!dirb = !cenpos.direction(!poss[!x])
			!angle = !angle + !dira.angle(!dirb)
		enddo
		--!angle = !dir1.angle(!dir2) + !dir2.angle(!dir3)
		!arcZdir = !this.ori.zdir()


		var !cbowposstring  pos ppli cbow prop 0 of $!this.civilname wrt/*
		!cbowpos = !cbowposstring.position()

		$(
		if !zdir.angle(!arcZdir) lt 90 then
			!arcxdir = !dir1
			!arc = object arc(!cenpos,object orientation('X is $!dir1 and Z is $!arczdir'),0,!angle,!radius,true)
			if !cbowpos.distance(!cenpos) lt !radius then
				--if !this.ori.xdir().angle(!dir1) lt 90 then
				!radius = !radius - !thickness
			else
				!radius = !radius + !thickness
			endif
		else
			!arcxdir = !dir3
			!arc = object arc(!cenpos,object orientation('X is $!dir3 and Z is $!arczdir'),0,!angle,!radius,true)
			if !cbowpos.distance(!cenpos) lt !radius then
				--if !this.ori.xdir().angle(!dir3) lt 90 then
				!radius = !radius - !thickness
			else
				!radius = !radius + !thickness
			endif
		endif
		$)
		if !zdir.angle(!arcZdir) lt 90 then
			!arcxdir = !dir1
		else
			!arcxdir = !dir3
		endif
		!arc = object arc(!cenpos,object orientation('X is $!arcxdir and Z is $!arczdir'),0,!angle,!radius,true)
		!this.arcs.append(!arc)
		if !cbowpos.distance(!cenpos) lt !radius then
			!radius2 = !radius - !thickness
		else
			!radius2 = !radius + !thickness
		endif
		!arc = object arc(!cenpos,object orientation('X is $!arcxdir and Z is $!arczdir'),0,!angle,!radius2,true)
		--!arc = object arc(!cenpos,object orientation('X is $!dir3 and Z is $!arczdir'),0,!angle,!radius,true)
		--if !radius2 gt !radius then
		!this.arcs.append(!arc)
		--else
		--	!this.arcs.insert(1,!arc)
		--endif
		!thick = !thickness
	elseif !type eq 'FLOOR' then

		!vertresult = object VertPoints(!this.civilname,true)
		!zdir = !vertresult.zdir
		!thick = !vertresult.height
		!this.zdir = !this.ori.zdir()

		!vertresult.getTwoProfiles()
		!profiles = !vertResult.twoProfiles

		!this.profiles.append(!profiles[1])
		if !zdir.angle(d) lt 90 then
			!this.profiles.append(!profiles[2])
		else
			!this.profiles.insert(1,!profiles[2])
		endif
	elseif !type eq 'GWALL' then
		--$p asfdsadf
		!vertresult = object VertPoints(!this.civilname,true)
		!pos = !vertresult.pos
		!ori = !vertresult.ori
		!zdir = !vertresult.zdir
		!height = !vertresult.height
		!points1 = !vertresult.points1
		!points2 = !vertresult.points2

		!vertresult.getTwoProfiles()
		!profiles = !vertResult.twoProfiles

		!this.profiles.append(!profiles[1])
		if !zdir.angle(d) lt 90 then
			!this.profiles.insert(1,!profiles[2])
		else
			!this.profiles.append(!profiles[2])
		endif

		!vertresult.getOtherProfiles()

		!this.profiles.appendarray(!vertresult.otherProfiles)


		!maxProfileNums[1] = 1
		!maxProfileNums[2] = 2
		!areas = array()
		do !profile values !this.profiles
			!zdir = !profile.orientation.zdir()
			!angle = !zdir.angle(u)
			!angle = min(!angle,180 - !angle)
			if !angle lt 20 then
				if undefined(!minup) then
					!minup = !profile.position.up
					!maxup = !profile.position.up
					!this.zdir = !profile.orientation.zdir()
				else
					!minup = min(!minup,!profile.position.up)
					if !profile.position.up gt !maxup then
						!this.zdir = !profile.orientation.zdir()
						!maxup = !profile.position.up
					endif
				endif
				!areas.append(0)
			else
				!area = !profile.area()
				!areas.append(!area)
			endif
		enddo
		if !this.zdir.angle(d) lt 90 then
			!this.zdir = !this.zdir.opposite()
		endif

		!indices = !areas.sortedindices().invert()
		!maxProfiles[1] = !this.profiles[!indices[1]]
		!maxProfiles[2] = !this.profiles[!indices[2]]

		!tempProfile1 = !this.profiles[!indices[1]]
		!tempProfile2 = !this.profiles[!indices[2]]
		!this.profiles[!indices[1]] = !this.profiles[1]
		!this.profiles[!indices[2]] = !this.profiles[2]
		!this.profiles[1] = !tempProfile1
		!this.profiles[2] = !tempProfile2

		!thick = !maxprofiles[2].position.distance(!maxprofiles[1].plane())
		--q var !thick


		if abs(!maxup - !minup - !height) lt 0.1 then
			!this.height = !height
		else
			!this.height = !maxup - !minup
		endif
		$(
	elseif !type eq 'FLOOR' or !type eq 'GWALL' then
		!ori = !this.ori
		!zdir = !ori.zdir()
		!pos = pos of $!this.civilname wrt/*
		!plane = object plane(!pos,!ori)

		!plooname = name of first ploo of $!this.civilname
		handle any
			!height = height of $!this.civilname
			!plooname = name of first loop of $!this.civilname
		elsehandle none
			!height = height of $!plooname
			!sjust = sjust of $!plooname
			if !sjust.matchwild('*TO*') then
				!zdir = !zdir.opposite()
			elseif !sjust.matchwild('*CEN*') then
				!pos = !pos.offset(!zdir, - !height / 2)
				!plane = object plane(!pos,!ori)
				--!height = !height / 2
			endif
		endhandle
		if !type eq 'FLOOR' then
			!this.zdir = !this.ori.zdir()
			!this.thick = !height
		endif


		var !paves coll all (pave vert) for $!plooname
		!points1 = array()
		!points2 = array()
		do !pave values !paves
			!onepos = pos of $!pave wrt/*
			!temppos = !plane.near(!onepos)

			if !points1.set() and !temppos.distance(!points1.last()) lt 0.1 then
				skip
			endif

			!points1.append(!temppos)
			!points2.append(!temppos.offset(!zdir,!height))
		enddo


		!profile = object profile(!pos,!ori,!points1)


		--q var !profile
		!profile = !profile.mergepoints()
		!profile = !profile.mergelines()
		!this.profiles.append(!profile)
		--!profile.position = !profile.position.offset(!zdir,!height)

		!profile = object profile(!pos.offset(!zdir,!height),!ori,!points2)
		!profile = !profile.mergepoints()
		!profile = !profile.mergelines()
		if !zdir.angle(d) lt 90 then
			!this.profiles.insert(1,!profile)
		else
			!this.profiles.append(!profile)
		endif


		if !type eq 'GWALL' then
			!maxProfileNums[1] = 1
			!maxProfileNums[2] = 2
			var !paves coll all (pave vert) for $!plooname
			!points = array()
			do !pave values !paves
				!onepos = pos of $!pave wrt/*
				!temppos = !this.profiles[1].plane().near(!onepos)
				if !points.unset() then
					!points.append(!temppos)
				elseif !temppos.distance(!points.last()) gt 0.1 then
					!points.append(!this.profiles[1].plane().near(!onepos))
				endif
			enddo

			!points.unique()
			--!points[4].delete()
			--!points.unique()


			do !x indices !points
				!poss = array()
				if !x lt !points.size() then
					!poss[1] = !points[!x]
					!poss[2] = !points[!x + 1]
				else
					!poss[1] = !points[!x]
					!poss[2] = !points[1]
				endif
				!poss[3] = !poss[2].offset(!zdir,!height)
				!poss[4] = !poss[1].offset(!zdir,!height)
				--$p $!this.civilname


				!profile = object profile(!poss[1],!!getOriwithpoints(!poss),!poss)
				!profile = !profile.mergepoints()
				!profile = !profile.mergelines()
				!profile.close()
				!this.profiles.append(!profile)
			enddo


			--!this.profiles.deletefrom(1,2)
			--!this.profiles.compress()

			!areas = array()
			do !profile values !this.profiles
				!zdir = !profile.orientation.zdir()
				!angle = !zdir.angle(u)
				!angle = min(!angle,180 - !angle)
				if !angle lt 20 then
					if undefined(!minup) then
						!minup = !profile.position.up
						!maxup = !profile.position.up
						!this.zdir = !profile.orientation.zdir()
					else
						!minup = min(!minup,!profile.position.up)
						if !profile.position.up gt !maxup then
							!this.zdir = !profile.orientation.zdir()
							!maxup = !profile.position.up
						endif
					endif
					!areas.append(0)
				else
					!area = !profile.area()
					!areas.append(!area)
				endif
			enddo
			if !this.zdir.angle(d) lt 90 then
				!this.zdir = !this.zdir.opposite()
			endif

			!indices = !areas.sortedindices().invert()
			!maxProfiles[1] = !this.profiles[!indices[1]]
			!maxProfiles[2] = !this.profiles[!indices[2]]


			!tempProfile1 = !this.profiles[!indices[1]]
			!tempProfile2 = !this.profiles[!indices[2]]
			!this.profiles[!indices[1]] = !this.profiles[1]
			!this.profiles[!indices[2]] = !this.profiles[2]
			!this.profiles[1] = !tempProfile1
			!this.profiles[2] = !tempProfile2

			!this.thick = !maxprofiles[2].position.distance(!maxprofiles[1].plane())


			if abs(!maxup - !minup - !height) lt 0.1 then
				!this.height = !height
			else
				!this.height = !maxup - !minup
			endif

			$ (
			!mindis = !height
			do !x from 1 to !points.size() - 2
				!dis = !points[!x + 2].distance(!this.profiles[!x + 2].plane())
				if !dis lt !mindis then
					!mindis = !dis
					!maxProfiles[1] = !x + 2
					!maxProfiles[2] = !x + 4
				endif
				if !x eq !points.size() - 2 then
					!dis = !points[1].distance(!this.profiles[!x + 2].plane())
				else
					!dis = !points[!x + 2].distance(!this.profiles[!x + 2].plane())
				endif

				if !dis lt !mindis then
					!mindis = !dis
					!maxProfiles[1] = !x + 2
					!maxProfiles[2] = !x + 4
				endif
			enddo
			!this.thick = !mindis
			if !this.thick lt !height then
				!this.height = !height
			endif


			if !maxProfiles[1] ne 1 then
				!tempProfile1 = !this.profiles[!maxProfiles[1]]
				!tempProfile2 = !this.profiles[!maxProfiles[2]]
				!this.profiles[!maxProfiles[1]] = !this.profiles[1]
				!this.profiles[!maxProfiles[2]] = !this.profiles[2]
				!this.profiles[1] = !tempProfile1
				!this.profiles[2] = !tempProfile2
			endif
			$ )
		endif
		$)
	endif

	!tempangle = !this.zdir.angle(u)
	!tempangle = min(!tempangle,180 - !tempangle)
	if !tempangle lt 0.1 then
		!this.zdir = u
	endif

	if !this.thick.set() and !this.thick ne 0 and abs(!thick - !this.thick) gt 0.1 then
		!this.wrongs.append('Please check the :JJ_QTHD of ' + !this.civilname)
		$p Please check the :JJ_QTHD of $!this.civilname
	endif

	if !this.thick.unset() or !this.thick eq 0 then
		!this.thick = !thick
	endif

	if abs(!this.thick - !this.thick.nint()) lt 0.1 then
		!this.thick = !this.thick.nint()
	endif

	if !this.height.set() and abs(!this.height - nint(!this.height)) lt 0.01 then
		!this.height = nint(!this.height)
	endif

	--------------------------------------set ori of profile
	if !this.profiles.set() then
		$(
		do !x indices !this.profiles
			if !this.profiles[!x].isclosed().not() then
				!this.profiles[!x] = !this.profiles[!x].close()
			endif
		enddo
		$)
		--$(
		!poss = array()

		do !x indices !this.profiles
			!poss.appendarray(!!getpointsofprofile(!this.profiles[!x]))
		enddo

		!this.cenpoint = !!getcenpoint(!poss)
		do !x indices !this.profiles
			!zdir = !this.cenpoint.direction(!this.profiles[!x].plane().near(!this.cenpoint))
            handle any
                --modify by jyg 20240828
                skip
            endhandle
			!angle = !zdir.angle(u)
			!angle = min(!angle,180 - !angle)
			if !angle lt 20 then
				!ydir = !zdir.orthogonal(!this.ori.xdir())
				handle any
					!xdir = !zdir.orthogonal(!this.ori.ydir())
				elsehandle none
					!xdir = !ydir.orthogonal(!zdir)
				endhandle
			else
				!ydir = u
				!xdir = !ydir.orthogonal(!zdir)
			endif
			!ori = object orientation('X is $!xdir and z is $!zdir')



			--!this.profiles[!x].orientation = !ori
			--$(
			--!temppos = !this.profiles[!x].position
			--!edges = !this.profiles[!x].edges()
			--!this.profiles[!x] = object profile(!temppos,!ori,!edges)
			!this.profiles[!x] = object profile(!this.profiles[!x].position,!ori,!this.profiles[!x].edges())


			if !this.profiles[!x].isValidClosed().not() then	$*202304231132
				!this.profiles[!x] = !this.profiles[!x].mergepoints(0.1)
				!this.profiles[!x] = !this.profiles[!x].mergelines(1)
			endif
			--$)
		enddo
		--$)


		do !x indices !this.profiles
			if !this.profiles[!x].isclosed().not() then
				!this.profiles[!x] = !this.profiles[!x].close()
			endif
		enddo
		if !this.type ne 'FLOOR' then
			do !x from 1 to 2
				!edges = !this.profiles[!x].edges()
				!tempangles = array()
                --Q  VAR !edges
                --Q  VAR  !this.profiles[!x]
				do !edge values !edges
                    --!edge.Draw(1,2,3)
                    --q var !edge
					!angle = abs(!edge.direction().angle(u) - 90)
                    handle (2,779)
                    --modify by jyg 20250121 处理支吊架在计算墙面弧边朝向问题时，无法获取direction()的问题,跳过。
                        skip
                    endhandle
					!tempangles.append(!angle)
				enddo
				!indices = !tempangles.sortedindices()
				!newedges = array()
				!newedges[1] = !edges[!indices[1]]
				!newedges[2] = !edges[!indices[2]]


				!templines = array()
				!tempups = array()
				do !edge values !newedges
					!templines.append(!edge)
					!tempups.append(!edge.startposition.midpoint(!edge.endposition).up)
				enddo
				if !tempups.set() then
					!indices = !tempups.sortedindices()
					!this.lines[!x] = !templines[!indices[1]]
				endif

				$(
				!templines = array()
				!tempups = array()
				do !edge values !edges
					!angle = !edge.direction().angle(u)
					if !angle gt 85 and !angle lt 95 then
						--!this.lines[!x] = !edge
						--break
						!templines.append(!edge)
						!tempups.append(!edge.startposition.midpoint(!edge.endposition).up)
					endif
				enddo
				if !tempups.set() then
					!indices = !tempups.sortedindices()
					!this.lines[!x] = !templines[!indices[1]]
				endif
				$)
			enddo
		endif
	endif
	!this.getoriginalpointori()
endmethod

define method .draworigin()
	do !x from 1 to 2
		!ori = !this.originori$!x
		!point = !this.originpoint$!x

		!this.drawoneorigin(!point,!ori)
	enddo
endmethod

define method .drawoneorigin(!inputpos is position, !inputori is orientation)
	if !this.mbdstru.toaid().not() then
		return
	endif
	!ori = !inputori
	if !this.type eq 'WALL' then
		if !this.arcs[1].radius lt !this.arcs[2].radius then
			!shortarc = !this.arcs[1]
		else
			!shortarc = !this.arcs[2]
		endif
	endif

	!pos = !inputpos.offset(!ori.zdir(),!this.textoffsetdis)
	!cheight = !this.civilcheight * 0.5
	!xdir = !ori.xdir()
	!ydir = !ori.ydir()
	!unitlen = !cheight * 2
	do !x from 1 to 2
		if !x eq 1 then
			!dir = !xdir
			!theotherdir = !ydir
		else
			!dir = !ydir
			!theotherdir = !xdir
		endif

		!dp1 = !pos
		!dp2 = !pos.offset(!dir,!unitlen)

		if !x eq 1 and !this.type eq 'WALL' then
			if abs(!shortarc.position.distance(!inputpos) - !shortarc.radius) lt 1 then
				!offsetangle = !unitlen * 1.1 * 180 / (!shortarc.radius * pi)
				if !shortarc.near(!dp1) gt !shortarc.near(!dp2) then
					!tempangle = !shortarc.near(!dp1).value() - !offsetangle.value()
				else
					!tempangle = !shortarc.near(!dp1).value() + !offsetangle.value()
				endif
				!dp2 = !shortarc.angleposition(!tempangle)
				!dir = !dp1.direction(!dp2)
				!xdir = !dir
				!dp2 = !dp1.offset(!dir,!unitlen)
				!ori = x is $!dir and y is $!ydir
			endif
		endif

		!temppos = !dp2.offset(!dir, - 0.20 * !unitlen)
		!dp3 = !temppos.offset(!theotherdir, 0.12 * !unitlen)
		!dp4 = !temppos.offset(!theotherdir, - 0.12 * !unitlen)

		!nodename = 'node:' + !this.civilname
		!aidline = object mbdaidline(!this.mbdstru.aidgro,!dp1,!dp2,'局部坐标系',!nodename)

		!aidline = object mbdaidline(!this.mbdstru.aidgro,!dp2,!dp3,'局部坐标系',!nodename)

		!aidline = object mbdaidline(!this.mbdstru.aidgro,!dp2,!dp4,'局部坐标系',!nodename)

	enddo

	if !this.type eq 'FLOOR' then
		if !ori.zdir().angle(u) lt 90 then
			!ydir = !this.lookdir
			!textori = y is $!ydir and z is u
		else
			!ydir = !this.lookdir.opposite()
			!textori = y is $!ydir and z is d
		endif
	else
		!textori = !ori
	endif

	!pos0 = !pos.offset(!xdir,!cheight / 2).offset(!ydir,!cheight / 2)
	!posx = !pos.offset(!xdir,!unitlen * 7 / 8).offset(!ydir,!cheight * 3 / 4)
	!posy = !pos.offset(!ydir,!unitlen * 7 / 8).offset(!xdir,!cheight * 3 / 4)

	!pos0 = !pos0.offset(!textori.xdir(), - !cheight / 2).offset(!textori.ydir(), - !cheight / 2)
	!posx = !posx.offset(!textori.xdir(), - !cheight / 2).offset(!textori.ydir(), - !cheight / 2)
	!posy = !posy.offset(!textori.xdir(), - !cheight / 2).offset(!textori.ydir(), - !cheight / 2)


	!zore = object mlabel(!this.mbdstru.dimgro,!pos0,!textori,'0',!cheight,false,'局部坐标系','',!nodename)
	!mlabelx = object mlabel(!this.mbdstru.dimgro,!posx,!textori,'X',!cheight,false,'局部坐标系','',!nodename)
	!mlabely = object mlabel(!this.mbdstru.dimgro,!posy,!textori,'Y',!cheight,false,'局部坐标系','',!nodename)
endmethod

define method .getoriginalpointori()
	if !this.form.unset() then
		!this.setform(!this.civilname)
	endif
	if !this.profiles.set() then
		if !this.type eq 'FLOOR' then
			--q var !this.form
			!ydir1 = !this.form.lookdir.displaytext().direction()
			!xdir1 = !ydir1.orthogonal(u)

			!ydir2 = !ydir1.opposite()
			!xdir2 = !xdir1
			!ori1 = x is $!xdir1 and y is $!ydir1
			!ori2 = x is $!xdir2 and y is $!ydir2
			if !this.profiles[1].position.up gt !this.profiles[2].position.up then
				!this.originori1 = !ori1
				!this.originori2 = !ori2
			else
				!this.originori1 = !ori2
				!this.originori2 = !ori1
			endif
		else
			do !x from 1 to 2
				!this.originori$!x = !this.profiles[!x].orientation
			enddo
		endif
		!this.getoriginpoint()
	else
		do !x from 1 to 2
			!currentradius = !this.arcs[!x].radius
			if !x eq 1 then
				!theotherradius = !this.arcs[2].radius
			else
				!theotherradius = !this.arcs[1].radius
			endif
			if !currentradius lt !theotherradius then
            --$p 1
				if !this.arcs[!x].orientation.zdir().angle(u) gt 90 then
					!pptpos = !this.arcs[!x].angleposition(!this.arcs[!x].startangle)
					!xdir = !this.arcs[!x].starttangent()
				else
					!pptpos = !this.arcs[!x].angleposition(!this.arcs[!x].endangle)
					!xdir = !this.arcs[!x].endtangent().opposite()
				endif
			else
            --$p 2
				if !this.arcs[!x].orientation.zdir().angle(u) gt 90 then
					!pptpos = !this.arcs[!x].angleposition(!this.arcs[!x].endangle)
					!xdir = !this.arcs[!x].endtangent().opposite()
				else
					!pptpos = !this.arcs[!x].angleposition(!this.arcs[!x].startangle)
					!xdir = !this.arcs[!x].starttangent()
				endif
			endif

			!this.originori$!x = object orientation('x is $!xdir and y is u')
            handle any
                --modify by jyg 20240809
                !this.originori$!x = object orientation('x is e and y is u')
            endhandle
			!this.originpoint$!x = !pptpos
		enddo
	endif
endmethod

define method .getoriginpoint()
	do !times from 1 to 2
		--do !times indices !this.profiles
		!profile = !this.profiles[!times]

		!ori = !this.originori$!times
		!xdir = !ori.xdir()
		!ydir = !ori.ydir()

		!edges = !profile.edges()
		--!xdiss = array()
		--!ydiss = array()
		!xydiss = array()
		!poss = array()
		!edgex = 0
		do !edge values !edges
			!pos = !edge.startposition
			handle any
				!pos = !edge.angleposition(!edge.startangle)
			endhandle
			!edgex = !edgex + 1
			if !edgex eq 1 then
				!measurepos = !pos
			endif
			!xdis = !!suidirdis(!measurepos,!xdir,!pos)
			!ydis = !!suidirdis(!measurepos,!ydir,!pos)
			--!xdiss.append(!xdis)
			--!ydiss.append(!ydis)
			!xydis = !xdis + !ydis
			!xydiss.append(!xydis)
			!poss.append(!pos)
		enddo
		!indices = !xydiss.sortedindices()
		!this.originpoint$!times = !poss[!indices[1]]
		$(
		!indices = !xdiss.sortedindices()
		!xdiss.reindex(!indices)
		!ydiss.reindex(!indices)
		!poss.reindex(!indices)

		do !x indices !xdiss
			if abs(!xdiss[!x] - !xdiss[!x + 1]) gt 1 then
				!goodx = !x
				break
			endif
		enddo

		if !goodx eq 1 then
			!startpos = !poss[1]
			!this.originpoint$!times = !startpos
		else
			!ydiss.deletefrom(!goodx + 1)
			!poss.deletefrom(!goodx + 1)
			!indices = !ydiss.sortedindices()
			!poss.reindex(!indices)
			!startpos = !poss[1]
			!this.originpoint$!times = !startpos
		endif
		$)
	enddo
endmethod

define method .getmeminfo(!atts is array) is array
	!this.getdataofmem()
	!rowarrs = array()
	--if !this.lookdir.unset() then
	--	!this.lookdir = !this.form.lookdir.displaytext().direction()
	--endif
	--!xdir = !this.lookdir.orthogonal(u)
	--!ydir = !this.lookdir
	do !memdata values !this.mems
		--if !this.type eq 'FLOOR' then
		--	!memdata.ydir = !ydir
		--q var !this.lookdir
		--	!memdata.xdir = !xdir
		--endif

		!memdata.getxydis()
		!rowarr = array()
		do !x indices !atts
			!att = !atts[!x]
			!com = '!rowarr[!x] = !memdata.' + !att + '.string()'
			$!com
			handle any
				!rowarr[!x] = ''
				$p No att: $!att in CivilMem object
			elsehandle none
				if !rowarr[!x] ne '' and !this.arcs.set() and (!att eq 'axdis' or !att eq 'bxdis') then
					!rowarr[!x] = !rowarr[!x] + '°'
				endif
			endhandle
		enddo
		!rowarrs.append(!rowarr)
	enddo
	return !rowarrs
endmethod

define method .getroominfo(!atts is array) is array
	!this.getrooms()
	!rowarrs = array()
	do !roomdata values !this.rooms
		!rowarr = array()
		do !x indices !atts
			!att = !atts[!x]
			!com = '!rowarr[!x] = !roomdata.' + !att + '.string()'
			$!com
			handle any
				!rowarr[!x] = ''
				$p No att: $!att in FloorRoom object
			endhandle
		enddo
		!rowarrs.append(!rowarr)
	enddo
	return !rowarrs
endmethod
define method .getdoorinfo(!atts is array) is array
	!this.getdoors()
	!rowarrs = array()
	do !doordata values !this.doors
		!rowarr = array()
		do !x indices !atts
			!att = !atts[!x]
			!com = '!rowarr[!x] = !doordata.' + !att + '.string()'
			$!com
			handle any
				!rowarr[!x] = ''
				$p No att: $!att in civildoor object
			endhandle
		enddo
		!rowarrs.append(!rowarr)
	enddo
	return !rowarrs
endmethod

define method .getDataOfMem()
	if !this.checkedmem.set() and !this.checkedmem then
		return
	endif
	if !this.profiles.unset() and !this.arcs.unset() then
		return
	endif
	!this.checkedmem = true


	if !this.form.name() eq 'MARKARCHFORM' then
		!archmodel = true
	else
		!archmodel = false
	endif

	--$p $!archmodel

	--var !mems coll all (NBOX NXTR NPYR PFIT FITT CMFI CMPF FIXING) for $!this.civilname

	if !archmodel then
		if !this.type eq 'FLOOR' then
			var !mems coll all NXTR for $!this.civilname
		else
			var !mems coll all fitt with(purpose eq 'DOOR') for $!this.civilname
		endif
	else
		var !mems coll all (NBOX NXTR NPYR NCYL NRTO PFIT FITT SBFI FIXING) for $!this.civilname

		!abakts = !!getabakt(!this.civilname)
		do !abakt values !abakts
			var !mems append coll all pane for $!abakt
			handle any
			endhandle
		enddo
	endif


	!civilindex = !this.getcivilindex(!this.civilname)
	--if !this.profiles.set() then
	--	!civildata = !this.profiles
	--else
	--	!civildata = !this.arcs
	--endif
	!this.mems = array()
	do !mem values !mems
		--!tempppp = e 38400 s 32100 d 5050
		--!mempos = pos of $!mem wrt/*
		--aid text number 1234 '1' at $!mempos
		--if !mempos.distance(!tempppp) lt 1000 then
		--$p $!mem
		--endif
		--if !mem ne '=17400/17500' then
		--	skip
		--endif

		--if !mem ne '=17394/66693' then
		--	skip
		--endif


		!civilMem = object civilmem(!mem,!civilindex,!this.form)
		handle any
			$p Warning: $!MEM 得不到形状，请检查建模是否规范
			skip
		endhandle
		if !archmodel then
			if !civilmem.radiuss.set() then	$*no arc in arch opening
				skip
			endif
		endif

		--if !civildata[1].objecttype() eq 'PROFILE' then
		--!civilMem = object civilmem(!mem,!civildata)
		--else
		--	!civilMem = object civilmem(!mem,!civildata,!this.height)
		--endif

		--!memname = name of $!mem

		--q var !civilmem.cenpoints

		if !civilmem.cenpoints.set() then
			!this.mems.append(!civilmem)
		endif
		--break
		--$p $!mem ok
	enddo



	do !x indices !this.mems
		!this.mems[!x].order = !x
		$(
		if !this.mems[!x].spec ne 'X' then
			!this.mems[!x].markstring = !x & ' ' & !this.mems[!x].spec & ' ' & !this.mems[!x].code
		else
			!this.mems[!x].markstring = !x & ' ' & !this.mems[!x].code
		endif
		$)
	enddo
endmethod

define method .civilAttJson(!civilAtts is array, !civilAttShow is array) is array
	!rowarr = !this.getcivilAttArr(!civilAtts)
	!row = array()
	!row.append(|{|)
	do !x indices !rowarr
		!row.append(|"| + !civilAttShow[!x] + |": "| + !rowarr[!x].string().replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
		handle any
			!row.append(|"| + !civilAttShow[!x] + |": "| + '' + |",|)
		endhandle
		if !x eq !rowarr.size() then
			!row[!row.size()] = !row[!row.size()].substring(1,!row[!row.size()].length() - 1)
		endif
	enddo
	--!row.append(|}|)
	!row.append(|},|)

	!row.insert(2,|"type":"civilAttribution",|)
	!row.insert(2,|"nodeNames":["| + !this.civilname + |"],|)
	return !row
endmethod

define method .getmemJson(!mematts is array, !memattShow is array) is array
	!result = array()
	!allrowarr = !this.getmeminfo(!memAtts)
	do !rowarr values !allrowarr
		!row = array()
		!row.append(|{|)
		do !x indices !rowarr
			!row.append(|"| + !memAttShow[!x] + |": "| + !rowarr[!x].string().replace(|\|,|\\|).replace(|"|,|\"|) + |",|)
			handle any
				!row.append(|"| + !memAttShow[!x] + |": "| + '' + |",|)
			endhandle
			if !x eq !rowarr.size() then
				!row[!row.size()] = !row[!row.size()].substring(1,!row[!row.size()].length() - 1)
			endif
		enddo
		--!row.append(|}|)
		!row.append(|},|)

		!row.insert(2,|"type":"memList",|)
		!row.insert(2,|"nodeNames":["| + !this.civilname + |"],|)
		!result.appendarray(!row)
	enddo
	return !result
endmethod

