define object suispco
	member .spco is string				$*spref form design element

	member .matref is string			$* material reference

	member .Detref is string			$* SDTE		detailing Text
		--next level
		member .skey is string				$* SKEY	for isodraft
		member .Rtext is string				$* dtxr	for isodraft
		member .Stext is string				$* DTXS	STEX and TTEX are used primarily by the detailing interface modules
		member .Ttext is string				$* DTXT	STEX and TTEX are used primarily by the detailing interface modules
		--back level

	member .Matxt is string				$* SMTE		material text
		--next level
		member .Maxtext is string			$* for isodraft
		member .Maytext is string			$*
		member .Maztext is string			$*
		--back level

	member .Cmpref is string			$* CMPD		weight iweight
		--next level
		member .Weight is real				$*
		member .iWeight is real				$*
		member .sdthickness is array		$* array of real saddle thickness
		--back level

	member .Bltref is string			$*SBOL(ref)	length of components of bolt and table of length and weight of bolt
	--type of owner is BLIS, type of owner of BLIS is BLTA
		--next level
		member .Xtralength is real			$* adjust length of bolt
		member .Bitems is array				$* additional bolt items to be used when calculating bolt length
		member .Bitlength is array			$* the lengths of the additional bolt items

		member .nstdblength is string		$* DTAB(ref) ref of table of length and weight of bolt
		--type of owner is LTAB, owner of LTAB is BLTA
		--the Diameter Table stores information on standard bolt lengths,
		--held as a string of values in its BLEN attribute.
			--next level
			member .Blength is array			$*
			member .Bweight is array			$*
			--back level
		--back level

	member .catref is string
		--next level
		member .ptref is string				$* member is p point
		member .gmref is string				$* member is primitive element
		member .dtref is string				$* DTSE is description element(different from TEXT in cata)
		member .blrfarray is string			$* member is BTSE, BLPT is member of BTSE
			--next level
			--member is BTSE		$*bolt set
				--next level
				--member noff is real			$* Number of standard bolt holes in the bolt circle.
				--member bdia is real			$* Bolt diameter.
				--member btype is string		$* The Bolt type, which is used to select the Bolt from the specification, and also affects how the bolt length is calculated.
				--member bthkness is real		$* Bolt length through flange (flange thickness and facing thickness).
				--member is BLPT				$* bolt point	one btse can has more than one blpt
					--next level
					--member number is real
					--member bthk is real
					--member btype is string
					--member bdis is real
					--find good sele with this value and spec of bolt (from attribution bspec of spec of bran)
					--get spco with Tdefault
						--next level
						--member is same with this object
						--back level
					--back level
				--back level
			--back level
		member .param is array				$* paramter
		--The BDIA, BTHK and BTYPE attributes of Bolt Points can all be set from Catalogue Component or Design parameters.
		--back level
endobject

define method .suispco(!input is any)
	if type of $!input ne 'SPCO' then
		!spco = name of spref of $!input
		handle any
			return
		endhandle
	else
		!spco = name of $!input
	endif

	-----------------------------------------------------------------matref
	!matref = name of matref of $!spco
	handle any
	elsehandle none
	endhandle

	----------------------------------------------------------------detref
	!Detref = name of detref of $!spco
	handle any
		!skey = ''
		!rtext = ''
		!stext = ''
		!ttext = ''
	elsehandle none
		!skey = skey of $!detref		$*for isodraft
		!Rtext = rtext of $!detref		$*for isodraft
		!Stext = stext of $!detref		$*STEX and TTEX are used primarily by the detailing interface modules
		!Ttext = ttext of $!detref		$*STEX and TTEX are used primarily by the detailing interface modules
	endhandle

	------------------------------------------------------------------matxt
	!Matxt = name of matxt of $!spco	$*材料 material text
	handle any
		!maxtext = ''
		!maytext = ''
		!maztext = ''
	elsehandle none
		!Maxtext = xtext of $!Matxt
		!Maytext = ytext of $!Matxt
		!Maztext = ztext of $!Matxt
	endhandle
	--$P $!SPCO

	------------------------------------------------------------------cmpref
	!Cmpref = name of cmpref of $!spco
	handle any
		!Weight = 0
		!iweight = 0
	elsehandle none
		!sdthickness = sdthickness of $!cmpref

		if type of $!cmpref eq 'CMPD' then
			!Weightstring = cweight of $!cmpref		$*重量 component weight
			!iWeightstring = ciweight of $!cmpref		$*重量 insulation weight
		elseif type of $!cmpref eq 'TUBD' then
			!Weightstring = uweight of $!cmpref		$*重量 component weight
			!iWeightstring = uiweight of $!cmpref		$*重量 insulation weight
		endif

		!Weight = !Weightstring.replace('(','').replace(')','').trim().real()
		!iWeight = !iWeightstring.replace('(','').replace(')','').trim().real()
	endhandle

	----------------------------------------------------------------------bolt
	!Bltref = name of bltref of $!spco
	handle any
	elsehandle none
		!Bitems = bitems of $!bltref		$*占螺栓长度的部件
		!Bitlength = bitlength of $!bltref	$*各部件长度

		!Xtralength = xtralength of $!bltref

		!nstdblength = name of nstdblength of $!bltref	$*存放圆整数组的地方
		handle any
		elsehandle none
            --q var !nstdblength
			!Blength = blength of $!nstdblength			$*圆整数组
			!Bweight = bweight of $!nstdblength
		endhandle
	endhandle
	--q var !Blength


	----------------------------------------------------------------------catref
	!catref = name of catref of $!spco
	handle any
	elsehandle none
		!ptref = name of ptref of $!catref
		handle any
		endhandle
		!gmref = name of gmref of $!catref
		handle any
		endhandle
		!dtref = name of dtref of $!catref
		handle any
		endhandle
		!blrfarray = blrfarray of $!catref
		handle any
		endhandle
	endhandle

	-----------------------------------------------------------------------------
	!commonWords = split('spco matref detref skey rtext stext ttext matxt maxtext maytext maztext cmpref weight iweight sdthickness bltref xtralength bitems bitlength nstdblength blength bweight catref ptref gmref dtref ptref')
	do !word values !commonwords
		!com = |!this.| + !word + | = !| + !word
		$!com
		handle any
			--$p $!com
		endhandle
	enddo
endmethod





