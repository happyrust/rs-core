define object polarcyli
	member .name is string
	member .pos is position
	member .ori  is orientation
	member .diameter is real
	member .height is real
endobject

define method .polarcyli(!pos is position, !ori is orientation, !diameter is real,!height is real)
	!this.pos = !pos
	!this.ori = !ori
	!this.diameter = !diameter
	!this.height = !height
endmethod





