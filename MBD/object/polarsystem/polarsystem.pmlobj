--Method:
--Public method:
--polarSystem(!startpos is position, !endpos is position, !cenpos is position, !basicRadius is real)	$*init method   cenpos是pipe中心点，用来决定其它元素观察角度的

--dis范围     	在polarsystem的轴线方向距轴线原点距离范围的数组，数组元素为两个real值的数组， 可为空，一般都有值
--angle范围     在polarsystem的ori参考下的角度的数组，数组元素为两个real值的数组， 可为空，一般空，olet等带值
--radius范围    距polarsystem的轴线的距离的数组，数组元素为两个real值的数组，可为空，一般带值，说明优先放什么位置比较好
--needs			要需要的dis,angle,radius
--bestdiss		优先选择的dis，可为空，一般为空
--bestdirs		优先选择的dir,可为空，一般为空，olet有指向要求的带值
--bestradius	优先选择的radius,可为空，一般为空
--isdim			说明是不是尺寸标注，是的话在方向上会进行限制，以保证所有dim方向一致
--leadline		说明是否带引线，带引线的话判断空间是否合适与不带引线的不一样，要考虑引线与其它物项的碰撞


--1 !inputdisranges, !inputallangleranges, !inputradiusranges, !needs,                 !bestdiss, !bestdirs, !bestradiuss, !isdim,     !inputleadLine
--  dis范围				angle范围			radius 范围		所需dis,angle,radius     最好dis    最好dir     最好radius   是否是尺寸   是否带引线
--2 !disranges, !allangleranges, !radiusranges, !polarelement,               !bestdiss, !bestdirs, !bestradiuss,   !isdim,     !leadLine
--  dis范围		angle范围	   radius 范围	ele得到所需dis,angle,radius     最好dis    最好dir     最好radius   是否是尺寸   是否带引线
--3 !needs , 			!bestdiss,   !isdim ,     !leadLine
--所需dis,angle,radius     最好dis   是否是尺寸   是否带引线      其它的程序补齐
--4!point,    				!text, !realod , !cheight , 		!isdim , !leadLine
-- to get bestdis   	 to get needs				是否带引线      其它的程序补齐
--5!polarelement, 	!bestdiss,		 !isdim, !leadLine
--to get needs 	 	bestdiss		是否带引线      其它的程序补齐


--getBestPosAndOri(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needs is array, !bestdiss is array, !bestdirs is array, !bestradiuss is array, !isdim is boolean, !inputleadLine is boolean) is array	$*
--getBestPosAndOri(!disranges is array, !allangleranges is array, !radiusranges is array, !polarelement is polarelement, !bestdiss is array, !bestdirs is array, !bestradiuss is array, !isdim is boolean, !leadLine is boolean) is array  	$*
--getBestPosAndOri(!needs is array, !bestdiss is array, !isdim is boolean, !leadLine is boolean) is array   	$*
--getBestPosAndOri(!point is position, !text is string, !realod is real, !cheight is real, !isdim is boolean, !leadLine is boolean) is array	$*
--getBestPosAndOri(!polarelement is polarelement, !bestdiss is array, !isdim is boolean, !leadLine is boolean) is array 	$*

--Private method:
--add(!item is any) 														$*dbref of lindim mlabel aidtext and so on, or line arc
--add(!item is any, !basic is boolean)  									$*add elements of item with basic(true means it is self of pipe(or other thing))
--getBestAngles(!inputdirs is array, !isdim is boolean) is array			$*get good angles to put element
--getBestPosAndOriold(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needs is array, !bestdiss is array, !bestdirs is array, !bestradiuss is array, !isdim is boolean, !inputleadLine is boolean) is array 	$*
--getDetail(!cenpos is position, !midpos is position)   					$*get showdir horidir maindimdir
--getdisarr(!disarr is array) is array  									$*ensure the dis is in the range around limitmindis to limitmaxdis
--getDirAndCha(!eles is array, !needangle is real, !bestdirs is array, !anglerange is array) is array 	$*in one disrange and radius range, get good direction and cha(more high,more bad)
--getMainDimDir()   														$*get dimdir
--getresult(!gooddis is real, !goodangle is real, !goodradius is real, !needs is array, !isdim is boolean) is array 	$*get result after getting dis angle radius
--getSplitRange(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needs is array, !bestdiss is array, !bestdirs is array, !bestradiuss is array ,!isdim is boolean) is array  	$*
--get split range for dis,angle,radius to small one

--getUsedAngles(!eles is array, !anglerange is array) is array  			$*get used angles in one dis range and radius range
--mergeangles(!angles is array) is array									$*merge angles
--replenish(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needs is array, !bestdiss is array, !bestdirs is array, !bestradiuss is array ,!isdim is boolean) is array  	$*
--replenish dis angle radius bestdir

--splitrange(!inputrange is array, !need is real, !inputbests is array, !isangle is boolean) is array		$* first to use bests, then use middle   	$*
--split one range

define object polarsystem
	member .pos is position
	member .dir is direction
	member .ori  is orientation
	member .basicRadius is real		$* e.g. half of od of pipe

	member .limitMinDis is real
	member .limitMaxDis is real

	member .horidir is direction
	member .showdir is direction	$* the opposite direction is best angle to look
	member .mainDimDir is direction

	--member .maindimwidth is real
	--member .dimdirs is array		$* best choices of direction for dimension
	--member .chardirs is array		$* best choices of direction for text

	member .elements is array		$* array of polarElement
	member .objects is array

	member .ignoreline is boolean	$* if true, ignore line element

	--member .predir is direction
	-----------------------it is direction of previous polarsystem
	-----------------------

	--member .nextdir is direction
	-----------------------it is direction of next polarsystem
	-----------------------

	member .referencedirs is array
	-----------------------it is array from direction of previous part or next part or tee or valv
	-----------------------

	member .lookangle is real
	member .fromltor is boolean
	member .branlookdirection is direction
	member .prehoridir is direction

	member .isinstpipe is boolean
endobject

define method .polarSystem(!startpos is position, !endpos is position, !cenpos is position, !basicRadius is real, !lookangle is real, !referencedirs is array,!branlookdirection is direction,!isinstpipe is boolean,!prehoridir is direction)
	!this.referencedirs = !referencedirs
	if !prehoridir.set() then
		!this.prehoridir = !prehoridir
	endif
	!this.polarSystem(!startpos, !endpos, !cenpos, !basicRadius,!lookangle,!branlookdirection,!isinstpipe)
endmethod
define method .polarSystem(!startpos is position, !endpos is position, !cenpos is position, !basicRadius is real, !lookangle is real, !referencedirs is array,!fromltor is boolean,!isinstpipe is boolean,!prehoridir is direction)
	--!this.predir = !prenextdir[1]
	--!this.nextdir = !prenextdir[2]
	!this.referencedirs = !referencedirs
	if !prehoridir.set() then
		!this.prehoridir = !prehoridir
	endif
	!this.polarSystem(!startpos, !endpos, !cenpos, !basicRadius,!lookangle,!fromltor,!isinstpipe)
endmethod
define method .polarSystem(!startpos is position, !endpos is position, !cenpos is position, !basicRadius is real, !lookangle is real,!branlookdirection is direction,!isinstpipe is boolean)
	!this.branlookdirection = !branlookdirection
	!this.polarSystem(!startpos, !endpos, !cenpos, !basicRadius, !lookangle,!isinstpipe)
endmethod
define method .polarSystem(!startpos is position, !endpos is position, !cenpos is position, !basicRadius is real, !lookangle is real,!fromltor is boolean,!isinstpipe is boolean)
	!this.fromltor = !fromltor
	!this.polarSystem(!startpos, !endpos, !cenpos, !basicRadius, !lookangle,!isinstpipe)
endmethod
define method .polarSystem(!startpos is position, !endpos is position, !cenpos is position, !basicRadius is real, !lookangle is real,!isinstpipe is boolean)
	!this.pos = !startpos
	!this.dir = !startpos.direction(!endpos)
	!this.limitMinDis = 0
	!this.limitMaxDis = !startpos.distance(!endpos)
	!this.basicRadius = !basicradius
	--!this.maindimwidth = 0
	!this.ignoreline = false
	!this.lookangle = !lookangle
	--

	!this.isinstpipe = !isinstpipe
	!this.getDetail(!cenpos,!startpos.midpoint(!endpos))	$*horidir showdir ori maindimdir
endmethod

define method .getDetail(!cenpos is position, !midpos is position)
--q var !this.referencedirs
    --pin 6 at $!cenpos
	!trydir = !this.dir.orthogonal(u)
	handle any
    --$p 56
		if !this.referencedirs.set() then
            --q var !this.referencedirs
			do !tempdir values !this.referencedirs
				if !tempdir.set() and abs(!tempdir.angle(u) - 90) lt 60 then
					!horidir = !tempdir.orthogonal(u)

					$(
					if !this.fromltor.set() then
						if !this.fromltor.not() then
							!horidir = !horidir.opposite()
						endif
					endif
					$)


					$(
					!horidir = !tempdir.orthogonal(u)
					!ctmdir = !cenpos.direction(!midpos)
					if !horidir.angle(!ctmdir) gt 90 then
						!horidir = !horidir.opposite()
					endif
					$)
					golabel /horidirok
				endif
			enddo
		endif
	elsehandle none
    --$p 66
		!horidir = !this.dir.orthogonal(u)  $*极坐标轴向(lookdir)

		$(
		if !this.fromltor.set() then
			if !this.fromltor.not() then
				!horidir = !horidir.opposite()
			endif
		endif
		$)

		golabel /horidirok
	endhandle




	--$(
	!ctmdir = !cenpos.direction(!midpos)
	handle any
		!horidir = !this.dir.orthogonal(u)			$*direction of pipe is up or down
		handle any
			!horidir = n
		endhandle
	elsehandle none
		!horidir = !this.dir.orthogonal(u)
		handle any									$* if pipe is vertical
			!temppos = !midpos
			!temppos.up = !cenpos.up
			!horidir = !cenpos.direction(!temppos)	$*get horidir according cenpos
			handle any
				!horidir = n
			endhandle
		elsehandle none
			if !horidir.angle(!ctmdir) gt 90 then
				!horidir = !horidir.opposite()
			endif
		endhandle
	endhandle
	--$)

	label /horidirok
	--$p $!this.prehoridir $!horidir
	if !this.prehoridir.set() then
		!angle = !horidir.angle(!this.prehoridir)
        --q !angle
		if !angle lt 45 or !angle gt 135 then
		--current horidir and too different with prehoridir
		--if prehoridir almost decide the current horidir, use it
			if !angle gt 135 then
				!horidir = !horidir.opposite()
			endif
			golabel /sethoridirok
		endif
	endif

	if !this.branlookdirection.set() then
		if !horidir.angle(!this.branlookdirection) lt 90 then
			!horidir = !horidir.opposite()
		endif
	elseif !this.fromltor.set() then
		if !this.fromltor.not() then
			!horidir = !horidir.opposite()
		endif
	endif
	--q var !horidir
	label /sethoridirok
	--$p horidir $!horidir
	!this.horidir = !horidir
	!lookupangle = !this.lookangle
	--!this.ori = x is $!horidir and z is $!this.dir



	!tempangle = !this.dir.angle(u)
	if !tempangle gt 10 and !tempangle lt 170 then

		--!temppos = e 0 n 0 u 0
		--!arc = object arc(!this.pos,!this.ori,0,360,1000,true)		$*cant use this
		--!this.showdir = !arc.angledirection(30)

		!tempdir = !horidir.orthogonal(u)

		-----
		--ensure the showdir is orthogonal the zdir of orientation of this s 202306281001
		if !tempdir.angle(!this.dir) le 90 then
			!tempdir = !this.dir
		else
			!tempdir = !this.dir.opposite()
		endif
		--ensure the showdir is orthogonal the zdir of orientation of this e
		----
		!temppos = e 0 n 0 u 0
		!arc = object arc(!this.pos,object orientation('X is $!horidir and z is $!tempdir'),0,360,1000,true)
        --!arc.draw(1,1,1)
		--q var !lookupangle
		!this.showdir = !arc.angledirection(!lookupangle)

	else
		!this.showdir = !horidir
	endif




	!this.ori = x is $!this.showdir and z is $!this.dir
    --q var !this.ori
	--$)
	--!this.getMainDimDir()
	return
	$(
	!ctmdir = !cenpos.direction(!midpos)
	handle any
		!horidir = !this.dir.orthogonal(u)			$*direction of pipe is up or down
		handle any
			!horidir = n
		endhandle
	elsehandle none

		!tempdir = !ctmdir.orthogonal(u)
		handle any
			!horidir = !this.dir.orthogonal(u)
			handle any
				!horidir = n
			endhandle
		elsehandle none
			!horidir = !tempdir.orthogonal(u).opposite()
		endhandle
		!tempangle = !horidir.angle(!this.dir)
		if !tempangle lt 1 or !tempangle gt 179 then
			!horidir = !this.dir.orthogonal(u)
		endif
	endhandle




	!tempdir = !horidir.orthogonal(u)
	!temppos = e 0 n 0 u 0
	!arc = object arc(!temppos,object orientation('X is $!horidir and z is $!tempdir'),0,360,1000,true)
	!this.showdir = !arc.angledirection(!lookupangle)



	!tempori = z is $!this.dir
	!temparc = object arc(!temppos,!tempori,0,360,1000,true)
	!xdir = !temparc.angledirection(!temparc.near(!temppos.offset(!horidir,1000)))
	--!dimdir = !temparc.angledirection(!temparc.near(!temppos.offset(!horidir,1000)) - 30)

	--!xdir = !horidir.orthogonal(!this.dir).opposite()
	!this.ori = x is $!xdir and z is $!this.dir
	--!zdir = !horidir.orthogonal(!this.dir)
	--!this.ori = y is $!this.dir and z is $!zdir



	--!this.dimdirs.append(!dimdir)
	--!this.dimdirs.append(!horidir)
	--!this.dimdirs.append(u)

	$)
endmethod

define method .getMainDimDir()
	if !this.maindimdir.set() then
		return
	endif
	!emptyarr = array()
	!needs[1] = !this.limitMaxDis - !this.limitMinDis
	!needs[2] = 30
	!needs[3] = !this.basicradius

	!bestdiss = array()
	!bestdiss.append((!this.limitMaxDis + !this.limitMinDis) / 2)
	!result = !this.getBestPosAndOri(!emptyarr, !emptyarr, !emptyarr, !needs, !bestdiss, !emptyarr, !emptyarr, true, false)
	--q var !result

	!dimpos = !result[1]
	--!textori = !result[2]
	!templine = !this.pos.line(!this.pos.offset(!this.dir,1000))

	!this.maindimdir = !templine.near(!dimpos).direction(!dimpos)
	return

	!tempangle = !this.dir.angle(u)
	if !tempangle gt 10 and !tempangle lt 170 then	$*hori
		!zdir = !this.getzdir()

		!ori = x is $!this.showdir and z is $!zdir
		!this.maindimdir = !ori.ydir().opposite()
	else											$*vertical
		!this.maindimdir = !this.showdir.orthogonal(u)
	endif
endmethod


define method .getzdir() is direction
	!angle = !this.horidir.angle(!this.showdir)
	if !angle lt 1 or !angle gt 179 then
	--!zdir = !this.horidir.orthogonal(!this.showdir)	$*N.orthogonal(N) = D, I dont know why
	--handle any
		-----------------------
		-----------------------202308241002
		if !this.dir.orthogonal(!this.horidir).angle(d) lt 90 then
			!zdir = !this.dir.opposite()
		else
			!zdir = !this.dir
		endif
	--endhandle
	else
		!zdir = !this.horidir.orthogonal(!this.showdir)
	endif

	return !zdir
endmethod

define method .add(!item is any)
	!basic = false
	!this.add(!item,!basic)
endmethod
define method .add(!item is any, !basic is boolean)
	--q var !item
	--q var !this.basicRadius
	!getElement = object getPolarElement(!this.pos,!this.ori,!this.basicRadius,!item,!basic)
	--if !item.objecttype() eq 'POLARCYLI' then
	--if !item.objecttype() eq 'POLARBOX' and !basic then

	--endif
	!index = !this.elements.size() + 1
	!objectadded = false
	do !ele values !getelement.elements
		--if !ele.type eq 'ARRAY' and !ele.endradius lt 0.2  then
		--endif
		--超出范围太多没必要考虑
		if !ele.startdis gt !this.limitMaxDis + 2 * !this.basicradius or !ele.enddis lt !this.limitMinDis - 2 * !this.basicradius then
			skip
		elseif !ele.startradius gt 15 * !this.basicradius and !this.isinstpipe.not() then
			skip
		elseif !ele.startradius gt 50 * !this.basicradius and !this.isinstpipe then
			skip
		else
			!this.elements.append(!ele)
			if !objectadded.not() then
				!this.objects[!index] = !getelement.objects[1]
				!objectadded = true
			endif
		endif
	enddo
	--!this.objects.appendarray(!getelement.objects)
endmethod


--easy way 1
define method .getBestPosAndOri(!point is position, !text is string, !realod is real, !cheight is real, !isdim is boolean, !leadLine is boolean) is array
	--!textlen = !!mbdtextlen(!text) * !cheight * 0.75
	----!textlen = !!mbdtextlen(!text) * !cheight * 0.8
	!textlen = !!mbdtextlen(!text) * !cheight
	!bestdis = !!suidirdis(!this.pos,!this.dir,!point)

	!disarr = array()
	!disarr[1] = !bestdis - !textlen / 2
	!disarr[2] = !bestdis + !textlen / 2
	!disranges = array()
	!disranges.append(!disarr)

	!allangleranges = array()


	!radiusarr = array()
	if !realod ne 0 then
		!radiusarr[1] = !realod / 2 + !cheight * 0.5
	else
		!radiusarr[1] = !cheight * 0.1
	endif
	!radiusarr[2] = !radiusarr[1] + !cheight
	!radiusranges = array()
	!radiusranges.append(!radiusarr)

	!needs = array()
	!needs.append(!textlen)
	!needs.append(30)
	!needs.append(!cheight)

	!bestdiss = array()
	!bestdiss.append(!bestdis)
	!bestdirs = array()
	!bestradiuss = array()
	return !this.getBestPosAndOri(!disranges, !allangleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, !isdim, !leadLine)
endmethod

--easy way 2
define method .getBestPosAndOri(!polarelement is polarelement, !bestdiss is array, !isdim is boolean, !leadLine is boolean) is array
	!disranges = array()
	!allangleranges = array()
	!radiusranges = array()
	!bestdirs = array()
	!bestangles = array()
	return !this.getBestPosAndOri(!disranges, !allangleranges, !radiusranges, !polarelement, !bestdiss, !bestdirs, !bestradiuss, !isdim, !leadLine)
endmethod

--easy way 3
define method .getBestPosAndOri(!needs is array, !bestdiss is array, !isdim is boolean, !leadLine is boolean) is array
	!disranges = array()
	!allangleranges = array()
	!radiusranges = array()
	!bestdirs = array()
	!bestangles = array()
	return !this.getBestPosAndOri(!disranges, !allangleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, !isdim, !leadLine)
endmethod


----------------------------------------
----------------------------------------
--disranges anglerange radiusrange is 	array of array of real			good range for item
--leadline is 															malbel has line or not
define method .getBestPosAndOri(!disranges is array, !allangleranges is array, !radiusranges is array, !polarelement is polarelement, !bestdiss is array, !bestdirs is array, !bestradiuss is array, !isdim is boolean, !leadLine is boolean) is array
	!needdis = !polarelement.enddis - !polarelement.startdis
	!needangle = !polarelement.endangle - !polarelement.startangle
	!needradius = !polarelement.endradius - !polarelement.startradius
	!needs = array()
	!needs.append(!needdis)
	!needs.append(!needangle)
	!needs.append(!needradius)
	return !this.getBestPosAndOri(!disranges, !allangleranges, !radiusranges, !needs, !bestdiss, !bestdirs, !bestradiuss, !isdim, !leadLine)
endmethod

define method .getdiseles(!disarr is array) is array

	!eles = array()
	do !ele values !this.elements
		--if not(!ele.startdis ge !disarr[2] or !ele.enddis le !disarr[1]) then
		if !this.ignoreline then
			if !ele.enddis - !ele.startdis lt 1 then
				skip
			endif
		endif
		if !this.isinstpipe.not() then
			if not(!ele.startdis ge !disarr[2] or !ele.enddis le !disarr[1]) and !ele.startradius lt !this.basicradius * 20 then
				!eles.append(!ele)
			endif
		else
			if not(!ele.startdis ge !disarr[2] or !ele.enddis le !disarr[1]) and !ele.startradius lt !this.basicradius * 50 then
				!eles.append(!ele)
			endif
		endif
	enddo
	--if !disarr[1] gt 375 and !disarr[2] lt 400 then

	--endif

	return !eles
endmethod
--
define method .balance(!disarr is array, !anglerange  is array, !needangle is real, !newbestdirs is array, !isdim is boolean) is array
	!arc = object arc(!this.pos,!this.ori,0,360,1000,true)

	!eles = !this.getdiseles(!disarr)

	!radiuss = array()
	!radiuss.append(!this.basicradius)
	do !ele values !eles
		!r2 = !ele.endradius.nint()
		if !this.isinstpipe then
			if !r2 gt !this.basicradius and !r2 lt !this.basicradius * 50 then
				!radiuss.append(!r2)

				--if !ele.basic.not() then

				--endif
			--elseif !r2 ge !this.basicradius * 50 then
				--$p $!r2

				--if !ele.basic.not() then

				--endif
			endif
		else
			if !r2 gt !this.basicradius and !r2 lt !this.basicradius * 20 then
				!radiuss.append(!r2)
			endif
		endif
	enddo
	!radiuss.unique()
	!radiuss.sort()



	if !radiuss.size() ge 2 then
		!largeRadius = !radiuss.last()
		do !x from !radiuss.size() - 1 to 1 by -1

			if !largeRadius - !radiuss[!x] lt !this.basicradius / 20 then
				!radiuss[!x].delete()
			else
				!largeRadius = !radiuss[!x]
			endif
		enddo
		!radiuss.compress()
	endif



	if !isdim and !this.maindimdir.set() then

		!newbestdirs = array()
		!newbestdirs.append(!this.maindimdir)
		!anglerange = array()
		!angle = !arc.near(!this.pos.offset(!this.maindimdir,1000))
		!temparr = array()
		!temparr.append(!angle - !needangle / 2)
		!temparr.append(!angle + !needangle / 2)
		!anglerange.append(!temparr)
	else
		--!disarr = !disrange[1]
		!cenpos = !this.pos.offset(!this.dir,(!disarr[1] + !disarr[2]) / 2)
		!e = 0
		!n = 0
		!u = 0
		!totalw = 0
		--!eles = array()

		do !ele values !this.elements
			if not(!ele.startdis ge !disarr[2] or !ele.enddis le !disarr[1]) then
				!wr = !ele.endradius - !ele.startradius
				!wl = min(!disarr[2],!ele.enddis) - max(!disarr[1],!ele.startdis)
				!weight = !wr.value() * !wl.value()
				!wpos = !cenpos.offset(!arc.angledirection((!ele.startangle + !ele.endangle) / 2),1000)


				!newtotalw = !totalw + !weight
				--if abs(!newtotalw) lt 0.01 then


				--endif
				!e = !e * !totalw / !newtotalw + !wpos.east * !weight / !newtotalw
				!n = !n * !totalw / !newtotalw + !wpos.north * !weight / !newtotalw
				!u = !u * !totalw / !newtotalw + !wpos.up * !weight / !newtotalw
				--!eles.append(!ele)
			endif
		enddo
		!twpos = e $!e n $!n u $!u
		!wdir = !twpos.direction(!cenpos)
		handle any
		elsehandle none
			!angles = array()
			do !dir values !newbestdirs
				!tempangle = !dir.angle(!wdir)
				!angles.append(!tempangle)
			enddo
			!indices = !angles.sortedindices()
			!newbestdirs.reindex(!indices)
		endhandle
	endif

	!result = array()
	!result.append(!anglerange)
	!result.append(!newbestdirs)

	!result.append(!eles)
	!result.append(!radiuss)
	--if defined(!eles) then
	--	!result.append(!eles)
	--endif
	return !result
endmethod

define method .getdisrange(!bestdiss is array, !needdis is real) is array
	!usebest = true
	!disrange = array()
	if !bestdiss.unset() or !usebest.not() then
		!disrange = array()
		!temparr = array()
		if !this.limitmindis.unset() then
			!temparr[1] = 0
		else
			!temparr[1] = !this.limitmindis
		endif
		if !this.limitmaxdis.unset() then
			!temparr[2] = 1000000
		else
			!temparr[2] = !this.limitmaxdis
		endif
		!disrange.append(!temparr)
	else
		do !bestdis values !bestdiss
			!disarr = array()
			!disarr[1] = !bestdis - !needdis / 2
			!disarr[2] = !bestdis + !needdis / 2

			!disarr = !this.getdisarr(!disarr)
			!disrange.append(!disarr)
		enddo
	endif
	return !disrange
endmethod


-----------------------
-----------------------for isombdangle
define method .getgoodradius(!object is isombdangle,!cheight is real) is real
	!radiusdir = !object.dir1.bisect(!object.dir2)
	!zdir = !object.dir1.orthogonal(!object.dir2)
	!offdir = !radiusdir.orthogonal(!zdir)
	--!textlen = !!mbdtextlen(!object.text) * !cheight * 0.55
	!textlen = !!mbdtextlen(!object.text) * !cheight

	!poss = array()
	--!poss[1] = !object.anglepos.offset(!offdir,!textlen / 2).offset(!radiusdir,!textlen / 2)
	--!poss[2] = !object.anglepos.offset(!offdir, - !textlen / 2).offset(!radiusdir,!textlen / 2)
	-----------------------unnecessary to offset, it would be considered at the end
	-----------------------
	!poss[1] = !object.anglepos.offset(!offdir,!textlen / 2)
	!poss[2] = !object.anglepos.offset(!offdir, - !textlen / 2)
	!poss[3] = !poss[2].offset(!radiusdir,!object.aod * 20)
	!poss[4] = !poss[1].offset(!radiusdir,!object.aod * 20)
	!lines = array()
	do !x from 1 to 4
		if !x ne 4 then
			!lines.append(!poss[!x].line(!poss[!x + 1]))
		else
			!lines.append(!poss[!x].line(!poss[1]))
		endif
	enddo
	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 1: got possible area data for angle text, it is a rectangle

	!diss = array()
	do !pos values !poss
		!dis = !!suidirdis(!this.pos,!this.dir,!pos)
		!diss.append(!dis)
	enddo
	!diss.sort()
	!disarr = array()
	!disarr.append(!diss[1])
	!disarr.append(!diss.last())
	!eles = !this.getdiseles(!disarr)

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 2:got elements which possible to clash
	if !disarr.last() - !disarr[1] gt 2 then
		-----------------------
		-----------------------for angle in pipe direction
		!arc = object arc(!this.pos,!this.ori,0,360,1000,true)
		-----------------------
		-----------------------use fourth point inorder to get accurate direction
		!angle = !arc.near(!poss[4])
		!posdir = !arc.angledirection(!angle)

		!angles = array()
		!angles[1] = !angle - 15
		!angles[2] = !angle + 15
		!points = array()
		!badradiuss = array()
		do !ele values !eles
			!tempangles = array()
			!tempangles.append(!ele.startangle)
			!tempangles.append(!ele.endangle)
			if !!checkanglesinter(!angles,!tempangles) then
				-----------------------------------------------------------------------------------
				-----------------------------------------------------------------------------------Step 3:if angles intersection, get the radius of inter points
				!oneposs = array()
				!oneposs[1] = !this.pos.offset(!this.dir,!ele.startdis).offset(!posdir,!ele.startradius)
				!oneposs[2] = !this.pos.offset(!this.dir,!ele.enddis).offset(!posdir,!ele.startradius)
				!oneposs[3] = !this.pos.offset(!this.dir,!ele.enddis).offset(!posdir,!ele.endradius)
				!oneposs[4] = !this.pos.offset(!this.dir,!ele.startdis).offset(!posdir,!ele.endradius)

				--!insides = array()
				!radiuss = array()
				--!alloffdiss = array()
				do !pos values !oneposs
					!tempdis = !!suidirdis(!poss[2],!offdir,!pos)
					if !tempdis ge 0 and !tempdis le !textlen then
						--!insides.append(true)
						--!points.append(!pos)
						!radiuss.append(!!suidirdis(!object.anglepos,!radiusdir,!pos))
						--else
						--!insides.append(false)
					endif
					--!alloffdiss.append(!tempdis)
				enddo

				do !x from 1 to 4
					if !x eq 4 then
						!y = 1
					else
						!y = !x + 1
					endif

					-----------------------
					-----------------------unnecessary to use this if, and this if has bug, it it better to unuse it
					--if !insides[!x] ne !insides[!y] or (!insides[!x].not() and !insides[!y].not() and (!alloffdiss[!x] + !alloffdiss[!y]) le (abs(!alloffdiss[!x]) + abs(!alloffdiss[!y]))) then
					!oneline = !oneposs[!x].line(!oneposs[!y])
					do !line values !lines
						!interpos = !oneline.intersection(!line)
						handle any
						elsehandle none
							if !line.onprojected(!interpos) and !oneline.onprojected(!interpos) then
								--!points.append(!interpos)
								!radiuss.append(!!suidirdis(!object.anglepos,!radiusdir,!interpos))
							endif
						endhandle
					enddo
					--endif
				enddo

				if !radiuss.set() then
					!radiuss.sort()
					if !radiuss.last() gt 0 then
						!onebadradiuss = array()
						!onebadradiuss.append(!radiuss[1])
						!onebadradiuss.append(!radiuss.last())
						!badradiuss.append(!onebadradiuss)
					endif
				else
					-----------------------
					-----------------------angle text is possible inside of current ele, but it is rare
				endif
			endif
		enddo
	else
		-----------------------
		-----------------------for angle in radius direction

		!temppos = !this.pos.line(!this.pos.offset(!this.ori.zdir(),1000)).near(!object.anglepos)
		!arc = object arc(!temppos,!this.ori,0,360,1000,true)
		!badradiuss = array()
		do !ele values !eles

			!oneposs = array()
			!oneposs[1] = !temppos.offset(!arc.angledirection(!ele.startangle),!ele.startradius)
			!oneposs[2] = !temppos.offset(!arc.angledirection(!ele.endangle),!ele.startradius)
			!oneposs[3] = !temppos.offset(!arc.angledirection(!ele.endangle),!ele.endradius)
			!oneposs[4] = !temppos.offset(!arc.angledirection(!ele.startangle),!ele.endradius)

			!points = array()
			!radiuss = array()
			do !pos values !oneposs
				!tempdis = !!suidirdis(!poss[2],!radiusdir,!pos)
				if !tempdis gt 0 then	$*202311281411
					!tempdis = !!suidirdis(!poss[2],!offdir,!pos)
					if !tempdis ge 0 and !tempdis le !textlen then
						!points.append(!pos)
						!radiuss.append(!!suidirdis(!object.anglepos,!radiusdir,!pos))
					endif
				endif
			enddo

			!onelines = array()
			!onelines.append(!oneposs[1].line(!oneposs[4]))
			!onelines.append(!oneposs[2].line(!oneposs[3]))

			!onearcs = array()
			!temparc = !arc
			!temparc.startangle = !ele.startangle
			!temparc.endangle = !ele.endangle
			!temparc.radius = !ele.startradius
			if !temparc.radius gt 1 then
				!onearcs.append(!temparc)
			endif
			!temparc.radius = !ele.endradius
			if !temparc.radius gt 1 then
				!onearcs.append(!temparc)
			endif

			--
			do !line values !lines
				do !oneline values !onelines
					!interpos = !line.intersection(!oneline)
					handle any
					elsehandle none
						if !line.onprojected(!interpos) and !oneline.onprojected(!interpos) then
							!points.append(!interpos)
							!radiuss.append(!!suidirdis(!object.anglepos,!radiusdir,!interpos))
						endif
					endhandle
				enddo
				do !onearc values !onearcs
					!interposs = !line.intersections(!onearc)
					handle any
					elsehandle none
						do !interpos values !interposs
							if !line.onprojected(!interpos) and !onearc.onprojected(!interpos) then
								!points.append(!interpos)
								!radiuss.append(!!suidirdis(!object.anglepos,!radiusdir,!interpos))
							endif
						enddo
					endhandle
				enddo
			enddo





			if !radiuss.set() then
				!radiuss.sort()
				if !radiuss.last() gt 0 then
					!onebadradiuss = array()
					!onebadradiuss.append(!radiuss[1])
					!onebadradiuss.append(!radiuss.last())
					!badradiuss.append(!onebadradiuss)
				endif
			else

				!temparr = !onelines
				if !onearcs.set() then
					!temparr.insert(2,!onearcs[1])
				endif
				if !onearcs.size() ge 2 then
					!temparr.append(!onearcs[2])
				endif

				if !onearcs.unset() or !temparr.unset() then	$*dimline in other isoline maybe have endradius le 0.1
					skip
				endif

				!tempprofile = object profile(!!getcenpoint(!oneposs),!onearcs[1].orientation,!temparr)
				!tempprofile.close()
				if !!posinprofile(!lines[1].startposition,!tempprofile) then
					!radiuss.append(!!suidirdis(!object.anglepos,!radiusdir,!onearcs[1].angleposition((!onearcs[1].startangle + !onearcs[1].endangle) / 2)))
					!radiuss.append(!!suidirdis(!object.anglepos,!radiusdir,!onearcs[2].angleposition((!onearcs[2].startangle + !onearcs[2].endangle) / 2)))
					!radiuss.sort()
					!onebadradiuss = array()
					!onebadradiuss.append(!radiuss[1])
					!onebadradiuss.append(!radiuss.last())
					!badradiuss.append(!onebadradiuss)
				endif
				-----------------------
				-----------------------angle text is possible inside of current ele, but it is rare

			endif
		enddo
		--q var !badradius
	endif



	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 4:if no elements, use the shortest radius
	if !badradiuss.unset() then
		return !textlen / 2
	endif




	return !this.getgoodradiusfrombadradiuss(!badradiuss,1.2 * !cheight,!textlen)



	$(
	!startbadradiuss = array()
	do !oneradiuss values !badradiuss
		!startbadradiuss.append(!oneradiuss[1])
	enddo
	!badradiuss.reindex(!startbadradiuss.sortedindices())


	!needradius = 1.2 * !cheight
	do !x indices !badradiuss
		if !x eq 1 then
			if !badradiuss[!x][1] le !textlen / 2 then
				skip
			endif
			!goodradius = !textlen / 2
		else
			!goodradius = !badradiuss[!x - 1][2]
		endif

		if !badradiuss[!x][1] - !goodradius gt !needradius then
			-----------------------------------------------------------------------------------
			-----------------------------------------------------------------------------------Step 5: find a good radius, use it
			--!!1l(!goodradius,!x)
			--q var !goodradius
			return !goodradius
		endif
	enddo

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 6: cant find any good radius, use the last one
	--q var !badradiuss.last()[2]
	return !badradiuss.last()[2]
	$)
endmethod

define method .getgoodradiusfrombadradiuss(!badradiuss is array, !width is real, !textlen is real) is real
------------------------------------------------------
	!diss1 = array()
	!diss2 = array()
	do !x indices !badradiuss
		--if !badradiuss[!x][2] gt 0 then
			!diss1.append(!badradiuss[!x][1])
			!diss2.append(!badradiuss[!x][2])
		--endif
	enddo

	!indices = !diss1.sortedindices()
	!diss1.reindex(!indices)
	!diss2.reindex(!indices)

	!size = !diss1.size()
	do !x from 1 to !size - 1
		!y = !x + 1
		if !diss1[!y] le !diss2[!x] then
			!diss1[!y] = !diss1[!x]
			!diss2[!y] = max(!diss2[!x],!diss2[!y])
			!diss1[!x].delete()
			!diss2[!x].delete()
		endif
	enddo

	!diss1.compress()
	!diss2.compress()

	!goodradius = !width / 2
	--!gaps = array()
	!onegap = array()
	do !x indices !diss1
		if !x eq 1 then
			if !diss1[1] - !width gt !textlen / 2 then
				!goodradius = !textlen / 2
				break
			endif

			--!onegap[1] = !diss1[1] - !width
			--!onegap[2] = !diss1[1]
		elseif !diss1[!x] - !diss2[!x - 1] gt !width then
			!goodradius = !diss2[!x - 1]
			break
			--!onegap[1] = !diss2[!x - 1]
			--!onegap[2] = !diss1[!x]
		endif
		--!gaps.append(!onegap)
	enddo
	!goodradius = !diss2.last()
	--!onegap[1] = !diss2.last()
	--!onegap[2] = !diss2.last() + !width
	--!gaps.append(!onegap)
	--return !gaps
	return !goodradius
	------------------------------------------------------
endmethod

--为加快速度做出改变 202306161102 目前用的是这个202308031910
define method .getBestPosAndOri(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needs is array, !bestdiss is array, !bestdirs is array, !bestradiuss is array, !isdim is boolean, !inputleadLine is boolean) is array
	if !inputleadline.unset() then
		!leadline = true
	else
		!leadline = !inputleadline
	endif
	--q var !inputdisranges !inputallangleranges !inputradiusranges !needs !bestdiss !bestdirs !bestradiuss !isdim !inputleadLine
	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 1: 得到放置标签标注最常用的方向
	!normaldirs = !this.getnormaldirs()

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 2:得到轴向可放置范围单元，这个用处不大了
	---------------------------------split range s
	if !inputdisranges.unset() then
		!disrange = !this.getdisrange(!bestdiss,!needs[1])
	else
		!disrange = !inputdisranges
	endif
	--q var !disrange[1]
	!olddisrange = !disrange
	!disrange = !this.splitrange(!disrange,!needs[1],!bestdiss,false)
	--if !needs[1] lt 100 and !disrange.size() ne 1 then
		--q var !disrange
	--endif
	if !disrange.unset() then
	--q var !olddisrange
		!disrange = !olddisrange
	endif


	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 3:得到可以用的角度，现在没有限制，也就是0-360都可以用，所以这个现在没什么用
	!anglerange = !this.getanglerange(!inputallangleranges,!needs[2],!bestdirs)

	if !inputradiusranges.set() then
		-----------------------------------------------------------------------------------
		-----------------------------------------------------------------------------------Step 4:得到径向可放置范围单元，用处不大了
		!radiusrange = !this.splitrange(!inputradiusranges,!needs[3],!bestradiuss,false)
		-----------------------
		-----------------------if inputradiusranges is set, use it first
	else
		!radiusrange = array()
	endif

	--------------------------------split range e
	--set data for each disrange
	!allangleranges = array()
	!allbestdirss = array()
	!alleles = array()
	!allradiuss = array()
	do !x indices !disrange
		-----------------------------------------------------------------------------------
		-----------------------------------------------------------------------------------Step 5:在第个轴向单元获取最佳角度、方向、需要考虑避让的元素、径向范围
		-----------------------------------------------------------------------------------考虑了平衡
		-----------------------------------------------------------------------------------
		!balancearr = !this.balance(!disrange[!x], !anglerange, !needs[2], !normaldirs, !isdim)
		!allangleranges[!x] = !balancearr[1]	$* if it is dim , this will change
		if !bestdirs.set() then
			!allbestdirss[!x] = !bestdirs
		else
			!allbestdirss[!x] = array()
		endif
		!allbestdirss[!x].appendarray(!balancearr[2])
		!alleles[!x] = !balancearr[3]
		!allradiuss[!x] = !balancearr[4]
	enddo
	!allradiusrange = array()

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 6:如果径向有输入范围，先考虑这个范围
	--------use input radius range first
	!allmaxradius = array()
	if !radiusrange.set() then
		do !x indices !disrange
			!allradiusrange[!x] = !radiusrange
			!allmaxradius[!x] = !radiusrange.last()[1]
		enddo
	else
		do !x indices !disrange
			!allradiusrange[!x] = array()
			!allmaxradius[!x] = 0
		enddo
	endif

	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 7:然后考虑轴向范围向需要避让元素的径向半径
	-----------------------------------------------------------------------------------用这些半径来确定尝试的位置
	-----------------------------------------------------------------------------------
	---then use radius from ele.
	do !x indices !disrange
		--$(
		do !radius values !allradiuss[!x]
			!minradius = !radius + !needs[3] / 10
			!maxradius = !radius + !needs[3] * 11 / 10
			if !minradius ge !allmaxradius[!x] then
				-----------------------
				-----------------------if minradius le allmaxradius[!x], it would be unnecessary to add
				!radiusarr = array()
				!radiusarr.append(!minradius)
				!radiusarr.append(!maxradius)
				!allradiusrange[!x].append(!radiusarr)
			endif
		enddo
		$(
		--not good 202308231635
		do !y indices !allradiuss[!x]
			!minradius = !allradiuss[!x][!y]
			if !y eq !allradiuss[!x].size() then
				!maxradius = !minradius + !needs[3] * 10
			else
				!maxradius = !allradiuss[!x][!y + 1]
			endif

			if !maxradius - !minradius ge !needs[3] * 1.2 then
				!minradius = !minradius + !needs[3] / 10
				!maxradius = !minradius + !needs[3]
				if !minradius ge !allmaxradius[!x] then
					!radiusarr = array()
					!radiusarr.append(!minradius)
					!radiusarr.append(!maxradius)
					!allradiusrange[!x].append(!radiusarr)
				endif
			endif
		enddo
		$)
	enddo
	--got allangleranges allbestdirss alleles allradiusrange for each disrange
	--!tolerance = 1
	!tolerance = 0.01	$*202308211709
	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 8:从轴向、径向尝试找到合适位置
	--对所有单元遍历，找到合适的为止，最佳选择单元优先
	!alldisbests = array()
	--!ifAcceptableToQuit = true
	!ifAcceptableToQuit = false
	!acceptableweighted = (5 + 20) * 1.3 + 0.1
	do !disindex indices !disrange
		!disarr = !disrange[!disindex]
		!disanglerange = !allangleranges[!disindex]
		!disbestdirs = !allbestdirss[!disindex]
		!diseles = !alleles[!disindex]
		!disradiusarr = !allradiusrange[!disindex]
		!radiuseles = array()
		!leadradiuseles = array()
		do !x indices !disradiusarr
			!radiuseles[!x] = array()
			!leadradiuseles[!x] = array()
		enddo
		-----------------------------------------------------------------------------------
		-----------------------------------------------------------------------------------Step 9:得到每个径向范围的障碍元素，分不考虑引线的元素，除此外再考虑引线的
		do !ele values !diseles
			do !x indices !disradiusarr
				!minradius = !disradiusarr[!x][1]
				!maxradius = !disradiusarr[!x][2]
				--if not(!ele.startradius gt !maxradius + !tolerance or !ele.endradius lt !minradius - !tolerance) then
				if not(!ele.startradius gt !maxradius - !tolerance or !ele.endradius lt !minradius + !tolerance) then		$* it is allowed that a little part is overlapped
					!radiuseles[!x].append(!ele)
				elseif !leadline and !ele.basic.not() and !ele.startradius lt !minradius - !tolerance and !ele.endradius gt !this.basicradius then
					!leadradiuseles[!x].append(!ele)
				endif
			enddo
		enddo
		!minvalue = 1000000
		!values = array()
		!dirs = array()
		!levels = array()
		!radiusdiss = array()
		-----------------------------------------------------------------------------------
		-----------------------------------------------------------------------------------Step 10:按径向遍历找出加权重后最好的位置
		do !x indices !radiuseles
			--!dirangle[1] is direction
			--!dirangle[2] is angle between nearest bestdir and dirangle[1]
			--!x is level of radius
			--!leadCoefficient is 1(consider leadline or no leadline) or 1.3(leadline is true, but not consider)
			-----------------------------------------------------------------------------------
			-----------------------------------------------------------------------------------Step 11:对某一个径向范围进行计算，找出好角度
			!dirangle = !this.getDirAndCha(!radiuseles[!x],!needs[2],!disbestdirs,!disanglerange)
			if !leadradiuseles[!x].set() then
				!leadCoefficient = 1.3
				!havelead = true
			else
				!leadCoefficient = 1
				!havelead = false
			endif
			----!tempvalue = !dirangle[2] * !x
			----!tempvalue = (!dirangle[2] + 100) * abs(!x + 3) * !leadCoefficient			$* reduce
			-----------------------------------------------------------------------------------
			-----------------------------------------------------------------------------------Step 12:用半径、方向、引线 加权重
			--!tempvalue = (!dirangle[2] + 90) * ((!disradiusarr[!x][1] + 10) / (!this.basicradius + 5) + 3) * !leadCoefficient	$*202306251527
			-----------------------
			-----------------------202308230920
			!tempvalue = !this.weightedweight(!dirangle[2],!disradiusarr[!x][1],!havelead,!needs[2])

			!dirs.append(!dirangle[1])
			!values.append(!tempvalue)
			!levels.append(!x)
			!radiusdiss.append(!disradiusarr[!x][1])

			if !leadradiuseles[!x].set() then
				!oneradiuseles = !radiuseles[!x]
				!oneradiuseles.appendarray(!leadradiuseles[!x])
				!dirangle = !this.getDirAndCha(!oneradiuseles,!needs[2],!disbestdirs,!disanglerange)
				!leadCoefficient = 1
				----!tempvalue = (!dirangle[2] + 100) * abs(!x + 3) * !leadCoefficient			$* reduce
				-----------------------
				-----------------------202308230920
				!tempvalue = !this.weightedweight(!dirangle[2],!disradiusarr[!x][1],!havelead,!needs[2])
				--!tempvalue = (!dirangle[2] + 90) * ((!disradiusarr[!x][1] + 10) / (!this.basicradius + 5) + 3) * !leadCoefficient	$*202306251527

				!dirs.append(!dirangle[1])
				!values.append(!tempvalue)
				!levels.append(!x)
				!radiusdiss.append(!disradiusarr[!x][1])
			endif
		enddo

		if !dirs.set() then
			!indices = !values.sortedindices()
			!bestindex = !indices[1]
			!minvalue = !values[!bestindex]
			!bestdir = !dirs[!bestindex]
			!level = !levels[!bestindex]
			!radiusdis = !radiusdiss[!bestindex]

			!gooddis = (!disarr[1] + !disarr[2]) / 2
			!arc = object arc(!this.pos,!this.ori,0,360,1000,true)
			!goodangle = !arc.near(!arc.position.offset(!bestdir,1000))
			!goodradius = (!disradiusarr[!level][1] + !disradiusarr[!level][2]) / 2
			-----------------------------------------------------------------------------------
			-----------------------------------------------------------------------------------Step 13:找到最好的位置
			-----------------------
			-----------------------202308230920
			if !ifAcceptableToQuit and ((!disindex eq !disrange.maxindex() and !minvalue ne 1000000) or (!disindex ne !disrange.maxindex() and !minvalue le !acceptableweighted)) then
				golabel /end
			else
				!temparr = array()
				!temparr.append(!minvalue)
				!temparr.append(!gooddis)
				!temparr.append(!goodangle)
				!temparr.append(!goodradius)
				!alldisbests.append(!temparr)
			endif
		endif
	enddo
	if !alldisbests.set() then
		!values = array()
		do !onearr values !alldisbests
			!values.append(!onearr[1])
		enddo
		!alldisbests.reindex(!values.sortedindices())
		!gooddis = !alldisbests[1][2]
		!goodangle = !alldisbests[1][3]
		!goodradius = !alldisbests[1][4]
		golabel /end
	endif
	-----------------------------------------------------------------------------------
	-----------------------------------------------------------------------------------Step 14:如果没有通过计算找到合适位置，也要给出一个位置
	--不能返回空值，标注元素总要放一个地方的。在没有引线的情况下通过调整radius，是肯定能得到值的
	--$p fail to get good dir and pos and ori     times: $!times

	!gooddis = (!disrange[1][1] + !disrange[1][2]) / 2
	!goodangle = (!allradiusrange[1][1][1] + !allradiusrange[1][1][2]) / 2
	!goodradius = (!allradiusrange[1][1][1] + !allradiusrange[1][1][2]) / 2

	label /end
	!resultarr = !this.getresult(!gooddis,!goodangle,!goodradius,!needs,!isdim)
	return !resultarr
endmethod

define method .weightedweight(!anglecha is real, !minradius is real, !havelead is boolean,!needangle is real) is real
	if !havelead then
		!leadCoefficient = 1.3
	else
		!leadCoefficient = 1
	endif

	!anglecha = !anglecha * !needangle / 30


	--if !this.isinstpipe.not() then
		if !anglecha le 5 then
			!anglew = 0
		elseif !anglecha le 15 then
			!anglew = 3
		elseif !anglecha lt 20 then
			!anglew = 5
		elseif !anglecha lt 30 then
			!anglew = 8
		elseif !anglecha lt 45 then
			!anglew = 10
		elseif !anglecha lt 60 then
			!anglew = 12
		elseif !anglecha lt 80 then
			!anglew = 15
		else
			!anglew = 25
		endif
		$(
	else
		if !anglecha le 5 then
			!anglew = 0
		elseif !anglecha le 15 then
			!anglew = 1.5
		elseif !anglecha lt 20 then
			!anglew = 2.5
		elseif !anglecha lt 30 then
			!anglew = 4
		elseif !anglecha lt 45 then
			!anglew = 5
		else
			!anglew = 12.5
		endif
		!anglew = 0
	endif
	$)


	if !this.basicradius ne 0 then
		!basicradius = !this.basicradius
	else
		!basicradius = 200
	endif
	!rt = !minradius / !basicradius

	if !this.isinstpipe.not() then
		if !rt lt 2 then
			!radiusw = 0
		elseif !rt lt 3 then
			!radiusw = 1
		elseif !rt lt 4 then
			!radiusw = 3
		elseif !rt lt 5 then
			!radiusw = 5
		elseif !rt lt 7 then
			!radiusw = 6
		elseif !rt lt 10 then
			!radiusw = 7
		elseif !rt lt 15 then
			!radiusw = 9
		elseif !rt lt 20 then
			!radiusw = 11
		elseif !rt lt 25 then
			!radiusw = 12
		elseif !rt lt 30 then
			!radiusw = 13
		elseif !rt lt 40 then
			!radiusw = 14
		else
			!radiusw = 50
		endif
	--$(
	else
		if !rt lt 4 then
			!radiusw = 0
		elseif !rt lt 6 then
			!radiusw = 1
		elseif !rt lt 8 then
			!radiusw = 3
		elseif !rt lt 10 then
			!radiusw = 5
		elseif !rt lt 14 then
			!radiusw = 6
		elseif !rt lt 20 then
			!radiusw = 7
		elseif !rt lt 30 then
			!radiusw = 10
		elseif !rt lt 40 then
			!radiusw = 15
		elseif !rt lt 40 then
			!radiusw = 20
		else
			!radiusw = 50
		endif
		--!radiusw = 0.7 * !radiusw
		--!radiusw = 0
	endif
	--$)




	--q var !this.isinstpipe

	!tempvalue = (!anglew + !radiusw) * !leadCoefficient


	return !tempvalue

	--!tempvalue = (!dirangle[2] + 90) * ((!disradiusarr[!x][1] + 10) / (!this.basicradius + 5) + 3) * !leadCoefficient
endmethod

--为加快速度做出改变
--202306152004
define method .getBestPosAndOriold2(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needs is array, !bestdiss is array, !bestdirs is array, !bestradiuss is array, !isdim is boolean, !inputleadLine is boolean) is array
	if !inputleadline.unset() then
		!leadline = true
	else
		!leadline = !inputleadline
	endif


	--这部分需要改，计算方式改了，不需要对三者都进行分割，这样浪费时间
	!temparr = !this.replenish(!inputdisranges, !inputallangleranges, !inputradiusranges, !needs,!bestdiss,!bestdirs,!bestradiuss,!isdim)
	!disrange = !temparr[1]		$* splited
	!anglerange = !temparr[2]		$* not splited
	!radiusrange = !temparr[3]		$* splited
	!newbestdirs = !temparr[4]




	!allangleranges = array()
	!allbestdirss = array()
	!alleles = array()
	!allradiuss = array()
	do !x indices !disrange
		!balancearr = !this.balance(!disrange[!x], !anglerange, !needs[2], !newbestdirs, !isdim)
		--!anglerange = !balancearr[1]
		--q var !anglerange[1]
		--!newbestdirs = !balancearr[2]

		!allangleranges[!x] = !balancearr[1]
		!allbestdirss[!x] = !balancearr[2]
		!alleles[!x] = !balancearr[3]
		!allradiuss[!x] = !balancearr[4]

		--if !balancearr.size() eq 3 then
		--cant use eles as this.elements, because eles is only for the first element of disrange
		--	!eles = !balancearr[3]
		--else
		--	!eles = !this.elements
		--endif
	enddo


	--对所有单元遍历，找到合适的为止，最佳选择单元优先
	!times = 0
	label /again
	!times = !times + 1


	do !disindex indices !disrange
		!disarr = !disrange[!disindex]
		--do !disarr values !disrange			$*per disarr
		!anglerange = !allangleranges[!disindex]
		!newbestdirs = !allbestdirss[!disindex]
		!diseles = !alleles[!disindex]
		!radiuss = !allradiuss[!disindex]

		$(
		!diseles = array()
		do !ele values !this.elements
			--do !ele values !eles
			if not(!ele.startdis gt !disarr[2] or !ele.enddis lt !disarr[1]) then
				!diseles.append(!ele)
			endif
		enddo
		$)


		if !inputradiusranges.unset() then
			!radiuseles = array()
			do !x indices !radiuss
				!radiuseles[!x] = array()
			enddo
			do !ele values !diseles
				do !x indices !radiuss
					--$p asdfasf
					!minradius = !radiuss[!x] + !needs[3] / 10
					!maxradius = !radiuss[!x] + !needs[3] * 11 / 10
					if not(!ele.startradius gt !maxradius or !ele.endradius lt !minradius) then
						--$p asdfasf 3
						!radiuseles[!x].append(!ele)
					elseif !leadline and !ele.startradius le !maxradius then
						--$p asdfasf 4
						--q var !ele.basic
						if !ele.basic then
							if !ele.endradius ge !minradius then
								!radiuseles[!x].append(!ele)
							endif
						elseif !ele.endradius gt 0 then
							!radiuseles[!x].append(!ele)
						endif
					endif
				enddo
			enddo

		else
			!radiuseles = array()
			do !x indices !radiusrange
				!radiuseles[!x] = array()
			enddo
			do !ele values !diseles
				do !x indices !radiusrange
					--$p asdfasf
					if not(!ele.startradius gt !radiusrange[!x][2] or !ele.endradius lt !radiusrange[!x][1]) then
						--$p asdfasf 3
						!radiuseles[!x].append(!ele)
					elseif !leadline and !ele.startradius le !radiusrange[!x][2] then
						--$p asdfasf 4
						--q var !ele.basic
						if !ele.basic then
							if !ele.endradius ge !radiusrange[!x][1] then
								!radiuseles[!x].append(!ele)
							endif
						elseif !ele.endradius gt 0 then
							!radiuseles[!x].append(!ele)
						endif
					endif
				enddo
			enddo
		endif

		--q var !radiuseles

		!minvalue = 1000000

		do !x indices !radiuseles

			!dirangle = !this.getDirAndCha(!radiuseles[!x],!needs[2],!newbestdirs,!anglerange)

			--!tempvalue = !dirangle[2] * !x
			if !dirangle[2] le 30 then
				!tempvalue = !dirangle[2] * abs(!x - 10)	$* reduce
				if !tempvalue lt !minvalue then
					!minvalue = !tempvalue
					!bestdir = !dirangle[1]
					!radiusindex = !x
				endif
			endif
		enddo

		if !minvalue ne 1000000 then
			!gooddis = (!disarr[1] + !disarr[2]) / 2
			!arc = object arc(!this.pos,!this.ori,0,360,1000,true)
			!goodangle = !arc.near(!arc.position.offset(!bestdir,1000))
			!goodradius = (!radiusrange[!radiusindex][1] + !radiusrange[!radiusindex][2]) / 2
			golabel /end
		endif
	enddo


	if !times eq 1 and !leadline then
		!leadline = false
		golabel /again
	elseif !times lt 5 then
		!maxradius = 0

		do !radiusarr values !radiusrange
			!maxradius = max(!maxradius,!radiusarr[1])
		enddo
		!temparr = array()

		!temparr[1] = !maxradius + min(!needs[3],!this.basicRadius / 2)
		!temparr[2] = !temparr[1] + !needs[3]

		!radiusrange = array()
		!radiusrange.append(!temparr)

		golabel /again
	else
		--不能返回空值，标注元素总要放一个地方的。在没有引线的情况下通过调整radius，是肯定能得到值的
		--$p fail to get good dir and pos and ori     times: $!times

		!gooddis = (!disrange[1][1] + !disrange[1][2]) / 2
		!goodangle = (!anglerange[1][1] + !anglerange[1][2]) / 2
		!goodradius = (!radiusrange[1][1] + !radiusrange[1][2]) / 2
		---这是为了速度而妥协的值
		golabel /end
	endif

	label /end

	!resultarr = !this.getresult(!gooddis,!goodangle,!goodradius,!needs,!isdim)
	return !resultarr
endmethod



define method .getDirAndCha(!eles is array, !needangle is real, !bestdirs is array, !anglerange is array) is array
	!result = array()

	!usedangles = !this.getusedangles(!eles,!anglerange)

	if !usedangles.unset() then
		!bestdir = !bestdirs[1]
		!anglecha = 0
		golabel /end
	endif

	!notbestplusangle = 30

	!minGapAngle = !needangle / 2
	--!mingapangle = !mingapangle
	!arc = object arc(!this.pos,!this.ori,0,360,1000,true)
	--q var !bestdirs
	--------------------尽量选择优先考虑的方向 1
	do !x indices !bestdirs
		!trydir = !bestdirs[!x]
		!good = true
		!tryangle = !arc.near(!arc.position.offset(!trydir,1000))

		do !usedangle values !usedangles

			if !!angleinangles(!tryangle,!usedangle[1],!usedangle[2]) or (abs(!tryangle - !usedangle[1]) lt !minGapAngle) or (abs(!tryangle - !usedangle[2]) lt !minGapAngle) then
				!good = false
				break
			endif
		enddo

		if !good then

			!bestdir = !trydir
			!anglecha = 0
			if !bestdirs.size() ge 3 and !x ne 1 then	$*if size is ge 3 , it means the first bestdir is different with others

				-----------------------202308230920
				-----------------------if size of bestdirs is 3, the first dir is better than other two direction, so if it is not 1, plus 15
				!anglecha = !notbestplusangle
				--!anglecha = 60 + !anglecha
			endif
			golabel /end
		endif
	enddo

	if !usedangles.size() eq 1 then
		if !usedangles[1][1] eq 0 and !usedangles[1][2] eq 360 then
			!bestdir = !bestdirs[1]
			!anglecha = 360
			golabel /end
		endif
	endif

	----------------------get nearest direction 2
	!dimdirs = array()
	!dimangles = array()

	!minangle = 360
	do !x indices !usedangles
		!startangle = !usedangles[!x][2]
		if !x eq !usedangles.size() then
			!endangle = !usedangles[1][1]
		else
			!endangle = !usedangles[!x + 1][1]
		endif

		!cha = !endangle - !startangle
		if !cha lt 0 then
			!cha = !cha + 360
		endif


		--$p $!endangle $!startangle $!cha

		if !cha ge !needangle then
			!tempdirs = array()
			!tempdirs[1] = !arc.angledirection(!startangle + !mingapangle)
			!tempdirs[2] = !arc.angledirection(!endangle - !mingapangle)

			do !tempdir values !tempdirs
				do !y indices !bestdirs
					!onedir = !bestdirs[!y]
					!tempangle = !onedir.angle(!tempdir)

					!tempzdir1 = !onedir.orthogonal(!this.showdir)
					handle any
					elsehandle none
						!tempzdir2 = !onedir.orthogonal(!tempdir)
						handle any
						elsehandle none
							if !tempzdir1.angle(!tempzdir2) lt 90 then
								!tempangle = min(0.9 * !tempangle,360)		$*consider showdir
							endif
						endhandle
					endhandle
					if !tempangle lt !minangle then
						!bestdir = !tempdir
						!anglecha = !tempangle
						if !bestdirs.size() ge 3 and !y ne 1 then	$*if size is ge 3 , it means the first bestdir is different with others
							!anglecha = !notbestplusangle + !anglecha
						endif
						!minangle = !tempangle
					endif
				enddo
			enddo
		else
			!dir1 = !arc.angledirection(!startangle)
			!dir2 = !arc.angledirection(!endangle)
			if !dir1.angle(!dir2) lt 0.1 then
				!middir = !dir1
			elseif !dir1.angle(!dir2) gt 179 then
				!middir = !arc.angledirection((!startangle + !endangle) / 2)
			else
				!middir = !dir1.bisect(!dir2)
			endif


			-----------------------
			-----------------------following way is not good, e.g. the usedangle is only one element, 0 - 360, the result is 180
			-----------------------actually it should be 0
			-----------------------
			--!middir = !arc.angledirection((!startangle + !endangle) / 2)
			!dimdirs.append(!middir)
			!dimangles.append(!cha)

		endif
	enddo

	--q var !anglecha

	if defined(!anglecha) then
		golabel /end
	else
		-------------------------------no enough angle to put element 3

		!indices = !dimangles.sortedindices()
		--!dimdirs.reindex(!indices)
		!bestdir = !dimdirs[!indices.last()]

		!anglecha = 360

		-----------------------
		-----------------------202308231008
		do !y indices !bestdirs
			!tempangle = !bestdirs[!y].angle(!bestdir)
			!anglecha = min(!anglecha,!tempangle)
		enddo

		--!anglecha = 360 - !dimangles[!indices.last()]	$*202312111718

		--!anglecha = 10000
	endif

	label /end
	--if abs(!bestdir.angle(d) - 30) lt 1 then

	--endif
	!result.append(!bestdir)
	!result.append(!anglecha)

	return !result
endmethod

define method .normalanglerange() is array
	!anglerange = array()
	!temparr = array()

	!tolerance = 45
	!tempangle = !this.dir.angle(u)
	if !tempangle gt 10 and !tempangle lt 170 then
		!tempdir = !this.getzdir()

		if !tempdir.angle(!this.dir) lt 90 then
			!temparr[1] = 90 - !tolerance
			!temparr[2] = 90 + !tolerance
			!anglerange.append(!temparr)

			!temparr[1] = -90 - !tolerance
			!temparr[2] = -90 + !tolerance
			!anglerange.append(!temparr)
		else
			!temparr[1] = -90 - !tolerance
			!temparr[2] = -90 +!tolerance
			!anglerange.append(!temparr)

			!temparr[1] = 90 - !tolerance
			!temparr[2] = 90 + !tolerance
			!anglerange.append(!temparr)
		endif
	else
		--!temparr[1] = - !tolerance
		--!temparr[2] = !tolerance
		--!anglerange.append(!temparr)

		!temparr[1] = 90 - !tolerance
		!temparr[2] = 90 + !tolerance
		!anglerange.append(!temparr)

		!temparr[1] = -90 - !tolerance
		!temparr[2] = -90 + !tolerance
		!anglerange.append(!temparr)
	endif
	return !anglerange
endmethod
define method .getanglerange(!inputallangleranges is array, !needangle is real, !bestdirs is array) is array
	!usebest = true

	if !inputallangleranges.unset() then
		!limit = false
		if !limit then
			--$(
			if !bestdirs.unset() or !usebest.not() then
				!anglerange = array()
				!temparr = array()

				!usenewwayangle = true	$*only use part, it is better than 0-360
				--!usenewwayangle = false
				if !usenewwayangle then
					!anglerange = !this.normalanglerange()
				else
					!temparr[1] = 0
					!temparr[2] = 360
					!anglerange.append(!temparr)
				endif

			else
				!anglerange = array()
				!arc = object arc(!this.pos,!this.ori,0,360,1000,true)
				do !bestdir values !bestdirs
					!bestangle = !arc.near(!this.pos.offset(!bestdir,1000)).nint()
					!anglearr = array()
					!anglearr[1] = !bestangle - !needangle / 2
					!anglearr[2] = !bestangle + !needangle / 2
					!anglerange.append(!anglearr)
				enddo
			endif
			--$)
		else
			-- no need to limit it

			!anglerange = array()
			!temparr[1] = 0
			!temparr[2] = 360
			!anglerange.append(!temparr)
		endif
	else
		!anglerange = !inputallangleranges
	endif

	return !anglerange
endmethod

--202306161024
define method .replenishold(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needs is array, !bestdiss is array, !bestdirs is array, !bestradiuss is array ,!isdim is boolean) is array
	!needdis = !needs[1]
	!needangle = !needs[2]
	!needradius = !needs[3]
	!usebest = true

	--!usebest = false
	if !inputdisranges.unset() then
		if !bestdiss.unset() or !usebest.not() then
			!disrange = array()
			!temparr = array()
			if !this.limitmindis.unset() then
				!temparr[1] = 0
			else
				!temparr[1] = !this.limitmindis
			endif
			if !this.limitmaxdis.unset() then
				!temparr[2] = 1000000
			else
				!temparr[2] = !this.limitmaxdis
			endif
			!disrange.append(!temparr)
		else
			!disrange = array()
			do !bestdis values !bestdiss
				!disarr = array()
				!disarr[1] = !bestdis - !needdis / 2
				!disarr[2] = !bestdis + !needdis / 2
				!disarr = !this.getdisarr(!disarr)
				!disrange.append(!disarr)
			enddo
		endif
	else
		!disrange = !inputdisranges
	endif

	if !inputallangleranges.unset() then

		if !bestdirs.unset() or !usebest.not() then
			!anglerange = array()
			!temparr = array()

			!usenewwayangle = true	$*only use part, it is better than 0-360
			--!usenewwayangle = false
			if !usenewwayangle then
				!anglerange = !this.normalanglerange()
			else
				!temparr[1] = 0
				!temparr[2] = 360
				!anglerange.append(!temparr)
			endif

		else
			!anglerange = array()
			!arc = object arc(!this.pos,!this.ori,0,360,1000,true)
			do !bestdir values !bestdirs
				!bestangle = !arc.near(!this.pos.offset(!bestdir,1000)).nint()
				!anglearr = array()
				!anglearr[1] = !bestangle - !needangle / 2
				!anglearr[2] = !bestangle + !needangle / 2
				!anglerange.append(!anglearr)
			enddo
			--!anglerange.appendarray(!this.normalanglerange())
			--!anglerange = !!mergeangles(!anglerange)



		endif

		$(
		!anglerange = array()
		!temparr[1] = 0
		!temparr[2] = 360
		!anglerange.append(!temparr)
		$)
	else
		!anglerange = !inputallangleranges
	endif


	if !inputradiusranges.unset() then

		if !bestradiuss.unset() or !usebest.not() then
			!radiusrange = array()
			!temparr = array()
			!temparr[1] = 0
			!temparr[2] = !this.basicradius * 20
			!radiusrange.append(!temparr)
		else
			!radiusrange = array()
			do !bestradius values !bestradiuss
				!radiusarr = array()
				!radiusarr[1] = !bestradius - !needradius / 2
				!radiusarr[2] = !bestradius + !needradius / 2
				!radiusrange.append(!radiusarr)
			enddo
		endif

	else
		!radiusrange = !inputradiusranges
	endif




	!bestangles = !this.getBestAngles(!bestdirs,!isdim)
	!bestdirs = array()
	!arc = object arc(!this.pos,!this.ori,0,360,1000,true)
	do !oneangle values !bestangles
		!bestdirs.append(!arc.angledirection(!oneangle))
	enddo

	!result = array()
	!result.append(!this.splitrange(!disrange,!needdis,!bestdiss,false))
	--!result.append(!this.splitrange(!anglerange,!needangle,!bestangles,true))
	!result.append(!anglerange)
	!result.append(!this.splitrange(!radiusrange,!needradius,!bestradiuss,false))
	!result.append(!bestdirs)


	return !result
endmethod

define method .getUsedAngles(!eles is array, !anglerange is array) is array
	!usedangles = array()

	do !x indices !anglerange
		!startangle = !anglerange[!x][2]
		if !x eq !anglerange.size() then
			!endangle = !anglerange[1][1]
		else
			!endangle = !anglerange[!x + 1][1]
		endif

		if !startangle lt 0 then
			!startangle = !startangle + 360
		elseif !startangle ge 360 then
			!startangle = !startangle - 360
		endif
		if !endangle lt 0 then
			!endangle = !endangle + 360
		elseif !endangle ge 360 then
			!endangle = !endangle - 360
		endif

		if !startangle ne !endangle then		$* 0-360
			!temparr = array()
			!temparr[1] = !startangle
			!temparr[2] = !endangle
			!usedangles.append(!temparr)
		endif
	enddo



	do !ele values !eles													$* get array of used angle
		!minangle = !ele.startangle
		!maxangle = !ele.endangle
		if !minangle lt 0 then
			--!minangle = !minangle + 360
		endif
		if !maxangle ge 360 then
			--!maxangle = !maxangle - 360
		endif

		--minangle maybe large than maxangle, it is normal
		!temparr = array()
		!temparr.append(!minangle)
		!temparr.append(!maxangle)

		!usedangles.append(!temparr)
	enddo

	!usedangles = !!mergeangles(!usedangles)



	!startangles = !usedangles.evaluate(object block('!usedangles[!evalindex][1]'))
	!usedangles.reindex(!startangles.sortedindices())

	return !usedangles
endmethod

$(
define method .mergeangles(!angles is array) is array		$*useless
	!usedangles = array()
	do !temparr values !angles
		!size = !usedangles.size()
		if !size eq 0 then
			!usedangles.append(!temparr)
		else
			!successMerge = false
			do !x from 1 to !size
				!usedangle = !usedangles[!x]
				!mergeresult = !!mergeangles(!temparr,!usedangle)

				if !mergeresult.size() eq 1 then
					!usedanlges[!x] = !mergeresult[1]
					!successMerge = true
					break
				endif
			enddo
			if !successMerge.not() then
				!usedangles.append(!temparr)
			endif

		endif

	enddo
	return !usedangles
endmethod
$)


----分别对dis angle radius 遍历太慢了
define method .getBestPosAndOriold(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needs is array, !bestdiss is array, !bestdirs is array, !bestradiuss is array, !isdim is boolean, !inputleadLine is boolean) is array
	if !inputleadline.unset() then
		!leadline = true
	else
		!leadline = !inputleadline
	endif
	--!bestangles = !this.getBestAngles(!bestdirs,!isdim)
	--!temparr = !this.getsplitrange(!inputdisranges, !inputallangleranges, !inputradiusranges, !needs[1], !needs[2], !needs[3],!bestdiss,!bestangles,!bestradiuss)
	!temparr = !this.getsplitrange(!inputdisranges, !inputallangleranges, !inputradiusranges, !needs,!bestdiss,!bestdirs,!bestradiuss,!isdim)
	!disrange = !temparr[1]
	!anglerange = !temparr[2]
	!radiusrange = !temparr[3]

	--if !this.objects.maxindex() eq 10 then

	--endif

	--对所有单元遍历，找到合适的为止，最佳选择单元优先
	!times = 0
	label /again
	!times = !times + 1

	do !disarr values !disrange			$*per disarr
		!diseles = array()
		do !ele values !this.elements

			if not(!ele.startdis gt !disarr[2] or !ele.enddis lt !disarr[1]) then
				!diseles.append(!ele)
			endif
		enddo
		----------------new s
		--do !radiusarr values !radiusrange
		--do !ele values !diseles

		--enddo
		--enddo
		-----------------new e

		do !anglearr values !anglerange			$*per disarr_anglearr
			!angleeles = array()
			do !ele values !diseles
				!temparr = array()
				!temparr.append(!ele.startangle)
				!temparr.append(!ele.endangle)

				if !!checkanglesinter(!anglearr,!temparr) then
					!angleeles.append(!ele)
				endif
			enddo

			--if !this.objects.maxindex() eq 10 then

			--endif


			do !radiusarr values !radiusrange			$*per disarr_anglearr_radiusarr
				--if !bestdirs.set() then

				--endif
				!radiuseles = array()
				do !ele values !angleeles
					if not(!ele.startradius gt !radiusarr[2] or !ele.endradius lt !radiusarr[1]) then
						!radiuseles.append(!ele)
						break
					elseif !leadline and !ele.startradius le !radiusarr[2] then
						if !ele.basic then
							if !ele.endradius ge !radiusarr[1] then
								!radiuseles.append(!ele)
							endif
						elseif !ele.endradius gt 0 then
							!radiuseles.append(!ele)
						endif
					endif
				enddo

				--if !this.objects.maxindex() eq 10 then
				--q var !disrange !disrange[1] !disrange[2]

				--endif



				if !radiuseles.unset() then
					!gooddis = (!disarr[1] + !disarr[2]) / 2
					!goodangle = (!anglearr[1] + !anglearr[2]) / 2
					!goodradius = (!radiusarr[1] + !radiusarr[2]) / 2
					golabel /end
				endif
			enddo
		enddo
	enddo


	if !times eq 1 and !leadline then
		!leadline = false
		golabel /again
	elseif !times lt 5 then
		!maxradius = 0

		$(
		do !radiusarr values !radiusrange
			!maxradius = max(!maxradius,!radiusarr[2])
		enddo
		!temparr = array()
		!temparr[1] = !maxradius
		!temparr[2] = !maxradius + !needs[3]
		$)
		do !radiusarr values !radiusrange
			!maxradius = max(!maxradius,!radiusarr[1])
		enddo
		!temparr = array()
		!temparr[1] = !maxradius + !this.basicRadius / 3
		!temparr[2] = !temparr[1] + !needs[3]



		!radiusrange = array()
		!radiusrange.append(!temparr)
		golabel /again
	else
		--不能返回空值，标注元素总要放一个地方的。在没有引线的情况下通过调整radius，是肯定能得到值的
		--$p fail to get good dir and pos and ori     times: $!times

		!gooddis = (!disrange[1][1] + !disrange[1][2]) / 2
		!goodangle = (!anglerange[1][1] + !anglerange[1][2]) / 2
		!goodradius = (!radiusrange[1][1] + !radiusrange[1][2]) / 2
		---这是为了速度而妥协的值
		golabel /end
	endif



	label /end
	!resultarr = !this.getresult(!gooddis,!goodangle,!goodradius,!needs,!isdim)

	$(
	if !isdim and !needs[1] gt !this.maindimwidth then
		!this.maindimwidth = !needs[1]
		!templine = !this.pos.line(!this.pos.offset(!this.dir,1000))
		!this.maindimdir = !templine.near(!resultarr[1]).direction(!resultarr[1])
		handle any	$*normal it is impossible, in case error
		endhandle
	endif
	$)


	return !resultarr

	$(
	-------------------------------old way	202305251958


	--clock init
	if !inputleadline.unset() then
		!leadline = true
	else
		!leadline = !inputleadline
	endif

	!bestangles = !this.getBestAngles(!bestdirs,!isdim)
	--clock read elapsed
	!temparr = !this.getsplitrange(!inputdisranges, !inputallangleranges, !inputradiusranges, !needs[1], !needs[2], !needs[3],!bestdiss,!bestangles,!bestradiuss)
	!disrange = !temparr[1]
	!anglerange = !temparr[2]
	!radiusrange = !temparr[3]





	$  (
	if !bestdirs.set() then



	endif
	$  )
	--clock read elapsed
	--对所有单元遍历，找到合适的为止，最佳选择单元优先
	!times = 0
	label /again
	!times = !times + 1

	do !disarr values !disrange			$*per disarr
		!diseles = array()
		do !ele values !this.elements

			if not(!ele.startdis gt !disarr[2] or !ele.enddis lt !disarr[1]) then
				!diseles.append(!ele)
			endif
		enddo

		--if !inputdisranges[1][2] lt 100 then

		--endif
		--$p                                                dis $!disarr[1] $!disarr[2]

		--do !xx from 1 to 1
		--!anglearr = !anglerange[!xx]
		do !anglearr values !anglerange			$*per disarr_anglearr
			!angleeles = array()
			do !ele values !diseles
				!temparr = array()
				!temparr.append(!ele.startangle)
				!temparr.append(!ele.endangle)



				if !!checkanglesinter(!anglearr,!temparr) then
					--if !inputdisranges[1][2] lt 100 then


					--endif
					!angleeles.append(!ele)
					--else
					--if !inputdisranges[1][2] lt 100 then

					--endif
				endif
			enddo

			--if !inputdisranges[1][2] lt 100 then

			--endif

			--$p                      angle $!anglearr[1] $!anglearr[2]


			do !radiusarr values !radiusrange			$*per disarr_anglearr_radiusarr
				!radiuseles = array()
				do !ele values !angleeles
					if not(!ele.startradius gt !radiusarr[2] or !ele.endradius lt !radiusarr[1]) then
						!radiuseles.append(!ele)
						break
					elseif !leadline and !ele.startradius le !radiusarr[2] then
						if !ele.basic then
							if !ele.endradius ge !radiusarr[1] then
								!radiuseles.append(!ele)
							endif
						elseif !ele.endradius gt 0 then
							!radiuseles.append(!ele)
						endif
					endif
				enddo

				--if !inputdisranges[1][2] lt 100 then

				--endif

				--$p radius $!radiusarr[1] $!radiusarr[2]
				--clock read elapsed
				if !radiuseles.unset() then
					--clock read elapsed
					!gooddis = (!disarr[1] + !disarr[2]) / 2
					!goodangle = (!anglearr[1] + !anglearr[2]) / 2
					!goodradius = (!radiusarr[1] + !radiusarr[2]) / 2

					golabel /end
					$ (
					!resultarr = !this.getresult(!gooddis,!goodangle,!goodradius,!needs,!isdim)
					if !isdim and !needs[1] gt !this.maindimwidth then
						!this.maindimwidth = !needs[1]
						!templine = !this.pos.line(!this.pos.offset(!this.dir,1000))
						!this.maindimdir = !templine.near(!resultarr[1]).direction(!resultarr[1])
					endif
					return !resultarr
					$ )
					$ (
					!result = array()
					!result.append(!gooddis)
					!result.append(!goodangle)
					!result.append(!goodradius)
					return !result
					$ )
					--else
					--if !inputdisranges[1][2] lt 100 then

					--endif
				endif
			enddo
		enddo
	enddo



	if !times eq 1 then
		!leadline = false
		golabel /again
	elseif !times lt 5 then
		!maxradius = 0
		do !radiusarr values !radiusrange
			!maxradius = max(!maxradius,!radiusarr[2])
		enddo
		!temparr = array()
		!temparr[1] = !maxradius
		!temparr[2] = !maxradius + !needs[3]
		!radiusrange = array()
		!radiusrange.append(!temparr)
		golabel /again
	else
		--不能返回空值，标注元素总要放一个地方的。在没有引线的情况下通过调整radius，是肯定能得到值的
		--!result = array()
		--return !result

		--$p fail to get good dir and pos and ori     times: $!times

		!gooddis = (!disrange[1][1] + !disrange[1][2]) / 2
		!goodangle = (!anglerange[1][1] + !anglerange[1][2]) / 2
		!goodradius = (!radiusrange[1][1] + !radiusrange[1][2]) / 2

		--!tempgoodpos = !this.pos.offset(!this.dir,!gooddis)

		golabel /end
	endif



	label /end
	!resultarr = !this.getresult(!gooddis,!goodangle,!goodradius,!needs,!isdim)
	if !isdim and !needs[1] gt !this.maindimwidth then
		!this.maindimwidth = !needs[1]
		!templine = !this.pos.line(!this.pos.offset(!this.dir,1000))
		!this.maindimdir = !templine.near(!resultarr[1]).direction(!resultarr[1])
		handle any	$*normal it is impossible, in case error
		endhandle
	endif


	$ (
	if !inputdisranges[1][2] lt 100 then

		!tempgoodpos = !this.pos.offset(!this.dir,!gooddis)





	endif
	$ )
	return !resultarr
	$)
endmethod

define method .getresult(!gooddis is real, !goodangle is real, !goodradius is real, !needs is array, !isdim is boolean) is array
	!arc = object arc(!this.pos,!this.ori,0,360,1000,true)
	!outdir = !arc.angledirection(!goodangle)

	!angle = !this.dir.angle(U)
	!angle = min(!angle,180 - !angle)
	if !angle gt 10 then
		!tempdir = !this.getzdir()
		!bestchardir = !tempdir.orthogonal(!this.showdir)

		$(
		!tempdir = !this.horidir.orthogonal(!this.showdir)
		handle any
			!bestchardir = !this.dir.orthogonal(!this.horidir)
			if !bestchardir.angle(d) lt 90 then
				!bestchardir = !bestchardir.opposite()
			endif
		elsehandle none
			!bestchardir = !tempdir.orthogonal(!this.showdir)
		endhandle
		-----------------------
		-----------------------202308231642
		$)

		--$p $!bestchardir $!this.showdir
		--!bestchardir = !this.dir.orthogonal(!this.showdir)
	else
		!bestchardir = !this.showdir.orthogonal(u)
	endif

	!tempangle = !outdir.angle(!bestchardir)
	if abs(!tempangle - 90) lt 5 then					$*almost vertical with showdir
		if !outdir.angle(!this.showdir) lt 90 then
		--if !outdir.angle(d) lt 90 then
			!chardir = !outdir.opposite()
		else
			!chardir = !outdir
		endif
	elseif !tempangle gt 90 then
		!chardir = !outdir.opposite()
	else
		!chardir = !outdir

	endif

	$(
	if !angle gt 10 then
		--水平或斜管需要确定文字方便察看
		!tempdir = !outdir.orthogonal(!this.showdir)
		handle any
			!tempdir = !outdir.orthogonal(u)
		endhandle
		if !tempdir.angle(!this.dir) gt 90 then
			--绕this.ori正方向。如果方向在showdir前面180以内，文字方向与标注方向相反
			!chardir = !outdir
		else
			--绕this.ori正方向。如果方向在showdir后面180以内，文字方向与标注方向一致
			!chardir = !outdir.opposite()
		endif
	else
		--竖直的不需要改变
		!chardir = !outdir
	endif
	$)

	$(
	!chardir = !outdir

	!bestchardir = !this.dir.orthogonal(!this.showdir)
	if !chardir.angle(!bestchardir) gt 91 then
		!chardir = !chardir.opposite()
	endif
	$)



	!zdir = !this.dir.orthogonal(!chardir)

	!tempangle = !zdir.angle(!this.showdir)
	if abs(!tempangle - 90) lt 1 then
		--$p show $!zdir $!this.showdir
		-----------------------202308240924 when the lookangle is 90, the zdir is almost orthogonal with showdir,use bestchardir to judge
		-----------------------
		if !zdir.angle(!bestchardir) lt 90 then
			!xdir = !this.dir
		else
			!xdir = !this.dir.opposite()
		endif
	elseif !tempangle gt 90 then
		!xdir = !this.dir.opposite()
	else
		!xdir = !this.dir
	endif
	!textori = y is $!chardir and x is $!xdir

	!goodpos = !this.pos.offset(!this.dir,!gooddis).offset(!outdir, !goodradius).offset(!chardir, - !needs[3] / 2)

	$(
	--mark the chardir is best angle to look. but it does not show the difference with the mlabel with best angle
	if !isdim.not() then
		!tempdir = !chardir.orthogonal(!this.showdir)
		handle any
			--!tempdir = !chardir.orthogonal(u)
			!tempdir = !tempdir.orthogonal(u).opposite()
		elsehandle none
			!tempdir = !tempdir.orthogonal(!this.showdir).opposite()
		endhandle
		!chardir = !tempdir
		!textori = y is $!chardir and x is $!xdir
	endif
	$)

	!result = array()
	!result.append(!goodpos)
	!result.append(!textori)
	return !result
	--else
	--	!textori = y is $!
	--endif
endmethod

define method .getnormaldirs() is array
	!dirs = array()
	!arc = object arc(!this.pos,!this.ori,0,360,1000,true)

	$(
	if !inputdirs.set() then
		!dirs = !inputdirs
		if !this.maindimdir.set() then
			!dirs.append(!this.maindimdir)
		endif
	else
	$)
	--!dirs = !inputdirs

	if !this.maindimdir.set() then
		!dirs.append(!this.maindimdir)
	endif
	!tempangle = !this.dir.angle(u)
	if !tempangle lt 10 or !tempangle gt 170 then	$*if vert , it is easy to see to keep same with dim
		!dirs.append(!this.showdir.orthogonal(u))
		!dirs.append(!this.showdir.orthogonal(u).opposite())
	else
		!tempzdir = !this.getzdir()


		!tempori = x is $!this.showdir and z is $!tempzdir
		!temparc = object arc(!this.pos,!tempori,0,360,1000,true)
		!dirs.append(!temparc.angledirection(90))
		!dirs.append(!temparc.angledirection(-90))
	endif
	--endif
	!dirs.unique()
	return !dirs
endmethod

--设定优先选择的方位
define method .getBestAngles(!inputdirs is array, !isdim is boolean) is array
	!dirs = !inputdirs
	!dirs.appendarray(!this.getnormaldirs())
	!arc = object arc(!this.pos,!this.ori,0,360,1000,true)

	!angles = array()
	do !dir values !dirs
		!oneangle = !arc.near(!this.pos.offset(!dir,1000)).nint()
		!repeat = false
		do !angle values !angles
			if abs(!oneangle - !angle) lt 5 then
				!repeat = true
				break
			endif
		enddo
		if !repeat.not() then
			!angles.append(!oneangle)
		endif
	enddo
	return !angles
endmethod

---it is for some tag which is out of range, such as connection tag at the tail of bran
define method .getdisarr(!disarr is array) is array
	if (!disarr[2] - !disarr[1] - !this.limitmaxdis + !this.limitmindis + !this.basicradius / 2) gt 0 then
		!plus = 0
	else

		if !disarr[1] lt !this.limitmindis then
		--$p asfasdf lt
			!plus = - !disarr[1] + !this.basicradius / 2
		elseif !disarr[2] gt !this.limitmaxdis - !this.basicradius / 2 then
			--$p asfasdf gt

			!plus = !this.limitmaxdis - !disarr[2] - !this.basicradius / 2
		else
			--$p asfasdf 0
			!plus = 0
		endif
		--$p $!plus
	endif
	!disarr[1] = !disarr[1] + !plus
	!disarr[2] = !disarr[2] + !plus

	return !disarr
endmethod

define method .getSplitRange(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needs is array, !bestdiss is array, !bestdirs is array, !bestradiuss is array ,!isdim is boolean) is array
	--define method .getSplitRange(!inputdisranges is array, !inputallangleranges is array, !inputradiusranges is array, !needdis is real, !needangle is real, !needradius is real, !bestdiss is array, !bestangles is array, !bestradiuss is array) is array
	!needdis = !needs[1]
	!needangle = !needs[2]
	!needradius = !needs[3]
	!usebest = true
	--!usebest = false
	if !inputdisranges.unset() then
		if !bestdiss.unset() or !usebest.not() then
			!disrange = array()
			!temparr = array()
			if !this.limitmindis.unset() then
				!temparr[1] = 0
			else
				!temparr[1] = !this.limitmindis
			endif
			if !this.limitmaxdis.unset() then
				!temparr[2] = 1000000
			else
				!temparr[2] = !this.limitmaxdis
			endif
			!disrange.append(!temparr)
		else
			!disrange = array()
			do !bestdis values !bestdiss
				!disarr = array()
				!disarr[1] = !bestdis - !needdis / 2
				!disarr[2] = !bestdis + !needdis / 2
				!disarr = !this.getdisarr(!disarr)
				!disrange.append(!disarr)
			enddo
		endif
	else
		!disrange = !inputdisranges
	endif

	if !inputallangleranges.unset() then
		if !bestdirs.unset() or !usebest.not() then
			!anglerange = array()
			!temparr = array()

			!usenewwayangle = true
			--!usenewwayangle = false
			if !usenewwayangle then
				!tolerance = 45
				!tempangle = !this.dir.angle(u)
				if !tempangle gt 10 and !tempangle lt 170 then
					!tempdir = !this.getzdir()


					if !tempdir.angle(!this.dir) lt 90 then
						!temparr[1] = 90 - !tolerance
						!temparr[2] = 90 + !tolerance
						!anglerange.append(!temparr)

						!temparr[1] = -90 - !tolerance
						!temparr[2] = -90 + !tolerance
						!anglerange.append(!temparr)
					else
						!temparr[1] = -90 - !tolerance
						!temparr[2] = -90 +!tolerance
						!anglerange.append(!temparr)

						!temparr[1] = 90 - !tolerance
						!temparr[2] = 90 + !tolerance
						!anglerange.append(!temparr)
					endif
				else
					--!temparr[1] = - !tolerance
					--!temparr[2] = !tolerance
					--!anglerange.append(!temparr)

					!temparr[1] = 90 - !tolerance
					!temparr[2] = 90 + !tolerance
					!anglerange.append(!temparr)

					!temparr[1] = -90 - !tolerance
					!temparr[2] = -90 + !tolerance
					!anglerange.append(!temparr)
				endif
			else
				!temparr[1] = 0
				!temparr[2] = 360
				!anglerange.append(!temparr)
			endif
		else
			!anglerange = array()
			!arc = object arc(!this.pos,!this.ori,0,360,1000,true)
			do !bestdir values !bestdirs
				!bestangle = !arc.near(!this.pos.offset(!bestdir,1000)).nint()
				!anglearr = array()
				!anglearr[1] = !bestangle - !needangle / 2
				!anglearr[2] = !bestangle + !needangle / 2
				!anglerange.append(!anglearr)
			enddo

		endif
	else
		!anglerange = !inputallangleranges
	endif

	if !inputradiusranges.unset() then
		if !bestradiuss.unset() or !usebest.not() then
			!radiusrange = array()
			!temparr = array()
			!temparr[1] = 0
			!temparr[2] = 1000000
			!radiusrange.append(!temparr)
		else
			!radiusrange = array()
			do !bestradius values !bestradiuss
				!radiusarr = array()
				!radiusarr[1] = !bestradius - !needradius / 2
				!radiusarr[2] = !bestradius + !needradius / 2
				!radiusrange.append(!radiusarr)
			enddo
		endif
	else
		!radiusrange = !inputradiusranges
	endif




	!bestangles = !this.getBestAngles(!bestdirs,!isdim)

	!result = array()
	!result.append(!this.splitrange(!disrange,!needdis,!bestdiss,false))
	!result.append(!this.splitrange(!anglerange,!needangle,!bestangles,true))
	!result.append(!this.splitrange(!radiusrange,!needradius,!bestradiuss,false))

	return !result
endmethod

----------------------------------------
----------------------------------------
--range的element会按need分成多块，块的优先级取决于与element内部最近best的距离
--同优先级会以range的element先后来决定优先级
--想完成由range的element顺序来决定优先级的话，那只能把element里面的单元都调成最高优先级，只有一种方法，把每个范围都设置best，也可以把element分割成最小单元
-----range的元素的两个元素必须是前面的小于等于后面的

define method .splitrange(!inputrange is array, !need is real, !inputbests is array, !isangle is boolean) is array		$* first to use bests, then use middle

	!range = !inputrange
	!allarrs = array()
	--储存每个最佳值分割单元的数组
	!allnums = array()
	--储存每个最佳值分割单元的优先级的数组


	--根据bests给range排序
	if !inputbests.set() then
		!nums = array()
		!temprange = !range
		do !num indices !inputbests
			!onebest = !inputbests[!num]
			do !x indices !temprange
				!arr = !range[!x]
				if (!isangle.not() and !arr[1] le !onebest and !arr[2] ge !onebest) or (!isangle and !!angleinangles(!onebest,!arr[1],!arr[2])) then
					!nums[!x] = !num
					!temprange[!x].delete()
					break
				endif
			enddo
		enddo

		do !x indices !temprange
			!nums[!x] = 10000
		enddo
		!indices = !nums.sortedindices()
		!range.reindex(!indices)
	endif


	--如果是角度，需要把圆形角度改成直线形坐标，这样就容易比较了，直线坐标需要三个360
	if !isangle then
		!bests = array()
		do !best values !inputbests
			!bests.append(!best)
			!bests.append(!best + 360)
			!bests.append(!best - 360)
		enddo
	else
		!bests = !inputbests
	endif



	do !arr values !range
		--循环每个range
		if !isangle and !arr[2] lt !arr[1] then
			--保证arr两个元素的顺序，方便后面计算
			!arr[1] = !arr[1] - 360
		endif
		if !arr[2] - !arr[1] lt !need then
			--放不下最小单元的range跳过
			skip
		endif

		--初始化range前面的最佳值
		!beforebest = -1000000
		--初始化range后面的最佳值
		!afterbest = 1000000

		!goodbests = array()
		do !best values !bests
			if (!best - !need / 2) ge !arr[1] and (!best + !need / 2) le !arr[2] then
				--最佳值加上最小要求单元在范围里面的直接取
				!goodbests.append(!best)
			elseif !best ge !arr[1] and !best le !arr[2] then
				--最佳值在范围内，加上最小要求单元不在范围里面的，改动一下取
				if (!best - !need / 2) lt !arr[1] then
					!goodbests.append(!arr[1] + !need / 2)
				else
					!goodbests.append(!arr[2] - !need / 2)
				endif
			else
				--获取范围前面最近的优选值和后面最近的优选值
				if !best lt !arr[1] then
					!beforebest = max(!beforebest,!best)
				else
					!afterbest = min(!afterbest,!best)
				endif
			endif
		enddo


		--如果没有定义优选值，取范围中间的值做为优选值
		if !goodbests.unset() then
			!goodbests.append((!arr[1] + !arr[2]) / 2)
			!goodbests.sort()
		endif



		!edges = array()
		if (!beforebest + !goodbests[1]) / 2 gt !arr[1] then
			--范围前面的值与第一个优选值的中点如果比范围低值大时，中点前面的优先等级应该由beforebest来定义，所以增加这个中点作为edge
			--!edges.append(!arr[1] + !need / 2)
			!beforeedge = (!beforebest + !goodbests[1]) / 2
			--max(!goodbests[1] - (int((!goodbests[1] - (!beforebest + !goodbests[1]) / 2) / !need) + 0.5) * !need,!arr[1])
			if !beforeedge le (!arr[1] + !arr[2]) / 2 - !need / 2 then	$* ensure the first one
				--$p kkk
				--q var !range[1]
				!edges.append(!beforeedge)
			else
				--if !beforeedge le !arr[1] then
				--$p klkljl
				!edges.append(!arr[1])
				!beforebest.delete()
				!beforeedge.delete()
			endif
		else
			--如果中点在低值前面，就不用管低值前面的beforebest了
			--$p asdf
			--q var !range[1]
			!edges.append(!arr[1])
			!beforebest.delete()
		endif



		--best计算等级时的边界
		if !goodbests.size() gt 1 then
			do !x from 1 to !goodbests.size() - 1
				!edges.append((!goodbests[!x] + !goodbests[!x + 1]) / 2)
			enddo
		endif

		if (!afterbest + !goodbests.last()) / 2 lt !arr[2] then
			--if !this.objects.maxindex() eq 10 and !isangle then

			--endif
			--范围前面的值与最后一个优选值的中点如果比范围高值小时，中点后面的优先等级应该由afterbest来定义，所以增加这个中点作为edge
			!afteredge = (!afterbest + !goodbests.last()) / 2
			--min(!goodbests.last() + (int(((!afterbest + !goodbests.last()) / 2 - !goodbests.last()) / !need) + 0.5) * !need,!arr[2])
			if !afteredge ge (!arr[1] + !arr[2]) / 2 + !need / 2 then	$* ensure the first one
				!edges.append(!afteredge)
			else
				--if !afteredge ge !arr[2] then
				!edges.append(!arr[2])
				!afteredge.delete()
				!afterbest.delete()
			endif
			--!edges.append(!arr[2] - !need / 2)
		else
			--如果中点在高值后面，就不用管高值后面的afterbest了
			!edges.append(!arr[2])
			!afterbest.delete()
		endif
		--if !isangle then
		--if !this.objects.maxindex() eq 10 and !isangle then

		--endif

		--if !isangle then

		--endif

		--------------------------------------got goodbests edges and maybe beforebest afterbest for one ele in range
		--q var !goodbests !edges
		do !xx indices !goodbests		$* split arr
			--$p $!xx

			--坐标轴上从best值向左，向右分割最小单元，直到碰上边界
			!best = !goodbests[!xx]
			!edge1 = !edges[!xx]
			!edge2 = !edges[!xx + 1]

			--一个最佳值得到的单元的数组
			!onearrs = array()
			--一个最佳值得到的单元优先级的数组
			!onenums = array()

			--可以向左
			!left = true
			--右以向右
			!right = true

			!onearr = array()
			--优先级
			!x = 0
			do
				!x = !x + 1
				if !x eq 1 then
					--第一个单元中心在best
					!onearr[1] = !best - 0.5 * !need
					!onearr[2] = !best + 0.5 * !need
					!onearrs.append(!onearr)
					!onenums.append(!x)
				else
					--向坐标轴左边走
					if !left then
						!onearr[1] = !best - (!x - 0.5) * !need
						!onearr[2] = !best - (!x - 1.5) * !need
						!add = true

						if !onearr[1] le !edge1 then
							--超过低值时，后面不再进行向左的计算
							!left = false
							--如果不是range的边界，都可以加上
							if !xx eq 1 and undefined(!beforebest) then
								if abs(!onearr[1] - !edge1) lt 0.1 then
									!add = true
								else
									!add = false
								endif
							elseif !onearr[2] le !edge1 then
								!add = false
							endif
						endif

						if !add then
							--增加分割单元和优先级
							!onearrs.append(!onearr)
							!onenums.append(!x)
						endif
					endif

					--向右边走
					if !right then
						!onearr[1] = !best + (!x - 1.5) * !need
						!onearr[2] = !best + (!x - 0.5) * !need
						!add = true
						if !onearr[2] ge !edge2 then
							--超过高值时，后面不再进行向右的计算
							!right = false
							if !xx eq !goodbests.size() and undefined(!afterbest) then

								--同一个范围里面按best分割时边界可能会有重合部分，在范围里面的，允许这种重合
								--如果不是range的边界，都可以加上
								if abs(!onearr[2] - !edge2) lt 0.1 then
									!add = true
								else
									!add = false
								endif
							elseif !onearr[1] ge !edge2 then
								!add = false
							endif
						endif
						if !add then
							--增加分割单元和优先级
							!onearrs.append(!onearr)
							!onenums.append(!x)
						endif
					endif
					if !left.not() and !right.not() then
						--即不用向左又不用向右时，分割结束
						break
					endif
				endif
			enddo



			if !onearrs.set() then

				--收集这个最佳值分割的单元和优先级
				!allarrs.append(!onearrs)
				!allnums.append(!onenums)

			endif
		enddo

		if defined(!beforebest) then
			--如果range前面的最佳值是有效的，也就是说range最前面的单元离Beforebest比离goodbests的第一个值近
			--优先级初始值

			!startnum = (!arr[1] + !need / 2 - !beforebest) / !need
			if !startnum ne int(!startnum) then
				!startnum = int(!startnum) + 1
			endif
			!onearrs = array()
			!onenums = array()
			!x = 0
			do
				!x = !x + 1
				!onearr = array()
				--从range的左边界开始向右推
				!onearr[1] = !arr[1] + (!x - 1) * !need
				!onearr[2] = !arr[1] + !x * !need
				if !onearr[2] ge !edges[1] then
					!onearrs.append(!onearr)
					--优先级需要加上初始值
					!onenums.append(!x + !startnum)
					break
				endif
			enddo
			if !onearrs.set() then
				--收集beforebest分割的单元和优先级
				!allarrs.append(!onearrs)
				!allnums.append(!onenums)

			endif
		endif

		if defined(!afterbest) then
			--如果range后面的最佳值是有效的，也就是说range最后面的单元离afterbest比离goodbests的最后一个值近
			--优先级初始值
			!startnum = (!afterbest - (!arr[2] - !need / 2)) / !need
			if !startnum ne int(!startnum) then
				!startnum = int(!startnum) + 1
			endif
			!onearrs = array()
			!onenums = array()
			!x = 0
			do
				!x = !x + 1
				!onearr = array()
				--从range的右边界开始向左推
				!onearr[1] = !arr[2] - !x * !need
				!onearr[2] = !arr[2] - (!x - 1) * !need
				if !onearr[2] le !edges.last() then
					!onearrs.append(!onearr)
					--优先级需要加上初始值
					!onenums.append(!x + !startnum)
					break
				endif
			enddo
			if !onearrs.set() then
				--收集beforebest分割的单元和优先级
				!allarrs.append(!onearrs)
				!allnums.append(!onenums)

			endif
		endif

		--if !onearrs.size() eq 1 and !onearrs[1][2] lt !arr[1] then

		--endif
		--if !inputbests.set() and !inputbests[1] eq 240 then

		--endif
	enddo

	--if !this.objects.maxindex() eq 10 and !isangle then

	--endif



	!maxsize = 0
	do !onenums values !allnums
		!maxsize = max(!maxsize,!onenums.last())
	enddo


	--按优先级排序
	--order acoording to priority
	!allcells =array()
	do !x from 1 to !maxsize
		do !z indices !allarrs
			!onearrs = !allarrs[!z]
			--do !onearrs values !allarrs
			do !y indices !onearrs
				if !allnums[!z][!y] eq !x then
					!allcells.append(!onearrs[!y])
				elseif !allnums[!z][!y] gt !x then
					break
				endif
			enddo
		enddo
	enddo
	--if !isangle then

	--endif

	return !allcells
endmethod

$(
define method .mergeCellAngles(!eles is array) is array
	!usedangles = array()
	do !ele values !eles
		!minangle = !ele.startangle
		!maxangle = !ele.endangle
		if !minangle lt 0 then
			!minangle = !minangle + 360
		endif
		if !maxangle ge 360 then
			!maxangle = !maxangle - 360
		endif

		--minangle maybe large than maxangle, it is normal
		!temparr = array()
		!temparr.append(!minangle)
		!temparr.append(!maxangle)

		!size = !usedangles.size()
		if !size eq 0 then
			!usedangles.append(!temparr)
		else
			!successMerge = false
			do !x from 1 to !size
				!usedangle = !usedangles[!x]
				!mergeresult = !!mergeangles(!temparr,!usedangle)
				if !mergeresult.size() eq 1 then
					!usedanlges[!x] = !mergeresult[1]
					!successMerge = true
					break
				endif
			enddo
			if !successMerge.not() then
				!usedangles.append(!temparr)
			endif
		endif
	enddo
	!startangles = !usedangles.evaluate(object block('!usedangles[!evalindex][1]'))
	!usedangles.reindex(!startangles.sortedindices())
	return !usedangles
endmethod
$)

