define method .getStudData()
	if !this.studsele.unset() then		$*螺杆
		return
	endif
	!tdefault = tdefault of $!this.studsele
	if !tdefault ne '' then
		var !spcos coll all spco with(tanswer eq !tdefault) for $!this.studsele
		!this.studspco = name of $!spcos[1]
		handle any
			!this.studspco = name of first spco of $!this.studsele
		endhandle
	else
		!this.studspco = name of first spco of $!this.studsele
	endif
	!this.studDetref = name of detref of $!this.studspco
	handle any
	elsehandle none
		!this.studRtext = rtext of $!this.studdetref		$*带中文描述
		!this.studStext = stext of $!this.studdetref		$*不带中文描述
	endhandle

	!this.studMatxt = name of matxt of $!this.studspco
	handle any
	elsehandle none
		!this.studMaxtext = xtext of $!this.studMatxt
		!this.studMaytext = ytext of $!this.studMatxt
		!this.studMaztext = ztext of $!this.studMatxt
	endhandle

	!this.studCmpref = name of cmpref of $!this.studspco
	handle any
		!this.studWeight = 0
	elsehandle none
		!studWeightstring = cweight of $!this.studcmpref		$*重量
		!this.studWeight = !studWeightstring.replace('(','').replace(')','').trim().real()
	endhandle

	!this.studBltref = name of bltref of $!this.studspco
	handle any

	elsehandle none
		!this.studBitems = bitems of $!this.studbltref		$*占螺栓长度的部件
		!this.studBitlength = bitlength of $!this.studbltref	$*各部件长度

		!this.studXtralength = xtralength of $!this.studbltref

		!nstdblength = nstdblength of $!this.studbltref	$*存放圆整数组的地方
		!this.studBlength = blength of $!nstdblength			$*圆整数组
		!this.studbweight = bweight of $!nstdblength
	endhandle
endmethod


define method .getNutData()
	if !this.Nutsele.unset() then		$*螺母
		return
	endif
	!tdefault = tdefault of $!this.nutsele
	if !tdefault ne '' then
		var !spcos coll all spco with(tanswer eq !tdefault) for $!this.nutsele
		!this.nutspco = name of $!spcos[1]
		handle any
			!this.nutspco = name of first spco of $!this.nutsele
		endhandle
	else
		!this.nutspco = name of first spco of $!this.nutsele
	endif

	!this.nutspco = name of first spco of $!this.nutsele
	!this.nutDetref = name of detref of $!this.nutspco
	handle any
	elsehandle none
		!this.nutRtext = rtext of $!this.nutdetref
		!this.nutStext = stext of $!this.nutdetref
	endhandle

	!this.nutMatxt = name of matxt of $!this.nutspco
	!this.nutCmpref = name of cmpref of $!this.nutspco
	handle any
	elsehandle none
		!nutWeightstring = cweight of $!this.nutcmpref
		!this.nutWeight = !nutWeightstring.replace('(','').replace(')','').trim().real()
	endhandle

	!this.nutBltref = name of bltref of $!this.nutspco
	handle any

	elsehandle none
		!this.nutBitems = bitems of $!this.nutbltref		$*占螺栓长度的部件
		!this.nutBitlength = bitlength of $!this.nutbltref	$*各部件长度

		!this.nutXtralength = xtralength of $!this.nutbltref

		!nstdblength = nstdblength of $!this.nutbltref	$*存放圆整数组的地方
		!this.nutBlength = blength of $!nstdblength			$*圆整数组
		!this.nutbweight = bweight of $!nstdblength
	endhandle
endmethod

