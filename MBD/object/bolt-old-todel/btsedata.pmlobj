define method .setRealLenWei(!dis is real)		$* dis is sum of all elements between two flans(or valv and so on)
	!netlength = 0
	!plusNutNum = 0
	do !x indices !this.studBitems
		!netlength = !netlength + !this.studBitlength[!x]
		if !this.studBitems[!x] eq 'NUT' then
			!plusNutNum = !plusNutNum + 1
			!nutlen = !this.studBitlength[!x]
		endif
	enddo

	--!addNutLen = Max(0,(2 - !plusNutnum)) * !nutlen
	--!addNutLen = !plusNutnum * !nutlen
	--!addNutLen = !plusNutnum * 5
	--!reallength = !netlength + !addNutlen + !dis
	!reallength = !netlength + !this.studXtralength + !dis

	--$p $!reallength
	--q var !this.studblength

	do !x indices !this.studBlength
		!len = !this.studBlength[!x]
		if !len ge !reallength then
			--$p $!len
			!reallength = !len
			!goodx = !x
			break
		endif
	enddo


	--q var !goodx

	----no consider weight of cap nut wash

	if undefined(!goodx) then
		!maxlen = !this.studBlength.last()
		$p this bolt is too long $!reallength ( maxlen $!maxlen)
		!this.realboltweight = !this.studweight * !reallength / !netlength		$*修整重量
	else
		--q var !this.studBweight
		if defined(!this.studBweight[!goodx]) and !this.studBweight[!goodx] ne 0 then
			!this.realboltweight = !this.studBweight[!goodx]

		else
			!this.realboltweight = !this.studweight * !reallength / !netlength		$*修整重量

			--$p real $!reallength   net $!netlength
			--$p studweight $!this.studweight
			--$p realweight $!this.realboltweight
		endif
	endif
	!this.realboltlength = !reallength									$*修整长度
endmethod
$)
