define method .btsedata(!inputbtse is any, !boltspec is any)
	!this.btsedata(!inputbtse)
	if !this.bltpsize ne 0 then
		!this.getspecdata(!boltspec)
	endif
endmethod

define method .btsedata(!inputbtse is any)
	if type of $!inputbtse ne 'BTSE' then
		return
	endif
	!this.btse = name of $!inputbtse
	--q var !this.btse
	var !bltps coll all bltp for $!this.btse
	if !bltps.unset() then
		return
	endif
	--q var !bltps
	!this.bltps = !bltps
	!this.bltpsize = !bltps.size()
	!this.bltp = !bltps[1]

	!bdiastring = bdiam of $!this.bltp
	!this.bdiameter = !bdiastring.replace('(','').replace(')','').trim().real()

	--!bthkstring = bthk of $!this.bltp
	--!this.bthkness = !!evalCata(!this.name,!bthkstring)
	!this.bthkness = bthk of $!this.bltp
	--$p $!this.bltp
	!this.btype = btype of $!this.bltp
endmethod

define method .getspecdata(!inputboltspec is any)			$* to get more detail information for other program to use
	if type of $!inputboltspec ne 'SPEC' then
		return
	endif
	!this.boltspec = name of $!inputboltspec
	!this.getseles()

	if !this.btype.set() and !this.btype ne '' then
		var !seles coll all sele with(tanswer eq !this.btype) for $!this.bdiasele
		if !seles.set() then
			!this.getdata(!this.btype)
			return
		endif
	endif


	!tdefault = tdefault of $!this.bdiasele
	handle any
		!this.getdata('STUD')
	elsehandle none
		--!com = |!this.get| + !tdefault + |Data()|
		--$!com

		--!this.getStudData()
		!this.getdata(!tdefault)
	endhandle
endmethod


define method .getseles()
	--q var !this.bdiameter
	--q var !this.boltspec
	--$p $!this.boltspec

	--var !seles coll all sele with(tanswer eq 'BOLT' and question eq 'BDIA') for $!this.boltspec
	--var !seles coll all sele with(real(answer) eq !this.bdiameter) for $!seles[1]
	--if !seles.size() ne 1 then
	--	return
	--endif

	!seles = member of $!this.boltspec
	do !sele values !seles
		if tanswer of $!sele eq 'BOLT' and question of $!sele eq 'BDIA' then
			!boltsele = name of $!sele
			break
		endif
	enddo
	if undefined(!boltsele) then
		return
	endif

	--var !seles coll all sele for $!seles[1]
	!seles = member of $!boltsele
	do !sele values !seles
		!answer = answer of $!sele
		if !answer.real() eq !this.bdiameter then
			!bdiasele = name of $!sele
			break
		endif
		--q var !answer
	enddo
	if undefined(!bdiasele) then
		return
	endif


	!this.bdiasele = !bdiasele
	var !seles coll all sele for $!this.bdiasele
	do !sele values !seles
		!tanswer = tanswer of $!sele
		if !tanswer eq 'STUD' then
			!this.studsele = !sele
		elseif !tanswer eq 'NUT' then
			!this.nutsele = !sele
		elseif !tanswer eq 'WASH' then
			!this.washsele = !sele
		elseif !tanswer eq 'CAP' then
			!this.capsele = !sele
		elseif !tanswer eq 'JACK' then
			!this.jacksele = !sele
		endif
	enddo
endmethod

define method .getData(!seletype is string) is array
	!com = |!sele = !this.| + !seletype + |sele|
	$!com
	if !sele.unset() then		$*螺杆
		return
	endif
	!tdefault = tdefault of $!sele
	if !tdefault ne '' then
		var !spcos coll all spco with(tanswer eq !tdefault) for $!sele
		!spco = name of $!spcos[1]
		handle any
			!spco = name of first spco of $!sele
		endhandle
	else
		!spco = name of first spco of $!sele
	endif
	!Detref = name of detref of $!spco
	handle any
	elsehandle none
		!Rtext = rtext of $!detref		$*带中文描述
		!Stext = stext of $!detref		$*不带中文描述
		!Ttext = ttext of $!detref		$*不带中文描述
	endhandle

	--$p $!spco

	!Matxt = name of matxt of $!spco
	handle any
	elsehandle none
		!Maxtext = xtext of $!Matxt
		!Maytext = ytext of $!Matxt
		!Maztext = ztext of $!Matxt
	endhandle
	--$P $!SPCO

	!Cmpref = name of cmpref of $!spco
	handle any
		!Weight = 0
	elsehandle none
		!Weightstring = cweight of $!cmpref		$*重量
		!Weight = !Weightstring.replace('(','').replace(')','').trim().real()
	endhandle

	!Bltref = name of bltref of $!spco
	handle any

	elsehandle none
		!Bitems = bitems of $!bltref		$*占螺栓长度的部件
		!Bitlength = bitlength of $!bltref	$*各部件长度

		!Xtralength = xtralength of $!bltref

		!nstdblength = name of nstdblength of $!bltref	$*存放圆整数组的地方
		!Blength = blength of $!nstdblength			$*圆整数组
		!bweight = bweight of $!nstdblength
	endhandle

	!selewords = split('spco')

	!commonWords = split('spco detref matxt cmpref bltref rtext stext ttext maxtext maytext maztext weight xtralength bitems bitlength nstdblength blength bweight')
	do !word values !selewords
		!com = |!this.| + !seletype + !word + | = !| + !word
		$!com
		handle any
		endhandle
	enddo

	do !word values !commonwords
		!com = |!this.| + !word + | = !| + !word
		$!com
		handle any
			--$p $!com
		endhandle
	enddo
endmethod

define method .setRealLenWei(!dis is real)		$* dis is sum of all elements between two flans(or valv and so on)
	!netlength = 0
	!plusNutNum = 0
	do !x indices !this.Bitems
		!netlength = !netlength + !this.Bitlength[!x]
		if !this.Bitems[!x] eq 'NUT' then
			!plusNutNum = !plusNutNum + 1
			!nutlen = !this.Bitlength[!x]
		endif
	enddo


	$(
	if !this.xtralength eq 0 then
		!this.xtralength = !nutlen

		--!this.xtralength = Max(0,(2 - !plusNutnum)) * !nutlen
		--!this.xtralength = !plusNutnum * !nutlen
	endif
	$)
	!reallength = !netlength + !this.Xtralength + !dis





	do !x indices !this.Blength
		!len = !this.Blength[!x]
		if !len ge !reallength then
			--$p $!len
			!reallength = !len
			!goodx = !x
			break
		endif
	enddo


	--q var !goodx

	----no consider weight of cap nut wash

	if undefined(!goodx) then
		!this.realboltweight = 0
		--!maxlen = !this.Blength.last()
		--$p this bolt is too long $!reallength ( maxlen $!maxlen)
		--!this.realboltweight = !this.weight * !reallength / !netlength		$*修整重量
	else
		--q var !this.Bweight
		if defined(!this.Bweight[!goodx]) and !this.Bweight[!goodx] ne 0 then
			!this.realboltweight = !this.Bweight[!goodx]

		else
			!this.realboltweight = 0


			--!this.realboltweight = !this.weight * !reallength / !netlength		$*修整重量

			--$p real $!reallength   net $!netlength
			--$p weight $!this.weight
			--$p realweight $!this.realboltweight
		endif
	endif
	!this.realboltlength = !reallength									$*修整长度
endmethod

