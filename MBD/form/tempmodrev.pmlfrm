kill !!tempmodrev
setup form !!tempmodrev  resize
	title '修改零部件材料版本'
	path right
	text .path '日志文件路径' tagwidth 12  width 20 scroll 100 is string
	--!this.path.val = 'xxxxxx'
	!this.path.val = |\\10.102.2.77\Evars\E3D\PDMSTOOLS\pmllib\hbtools\数字化交付版次|			$*服务器路径
	!this.path.editable = false
	option .revs '新版本' tagwidth 6 at x 0.5 y 1.5 width 4
	!this.revs.dtext = split('a b c d e f g h i')
	!this.revs.select('dtext','b')

    button .mod '修改' call |!this.mod()| width 4

    mem .CurForm is FORM
    mem .Type is string
exit
define method .tempmodrev()
endmethod
define method .mod()
    !AllForms = 'markpipeform,markinstpipeform,marksuppform,markInstSuppform,markInstpipeSuppform'
    do  !From values !AllForms.split(',')

        !Createform = '!!'&!From
        !Isopen = $!<Createform>
        handle any
            skip
        endhandle
        !ListData = !Isopen.list4.val
        if !Isopen.shown() and !ListData.set() then
           if  !From.lowcase().Matchwild('*supp*') then
               !this.Type = 'supp'
           else
               !this.Type = 'pipe'
           endif
           !this.CurForm = !Isopen
        endif
    enddo
    --q var !this.CurForm
    !dtext = !this.CurForm.list4.dtext
	!revnum = !this.findrevindex(!dtext) $*获取rev列号
    --q var !revnum
	if !revnum eq 0 then
		$p 得不到版本列
		return
	endif

    !vals = !this.CurForm.list4.val
	!val = !vals[1]
	handle any
		$p 请选择零部件材料
		return
	endhandle
    --q var !vals
	do !val values !vals
		!temparr = !dtext[!val].split('	')
		!temparr[!revnum] = !this.revs.selection('DTEXT')
		do !x indices !temparr
			if !x eq 1 then
				!string = !temparr[!x]
			else
				!string = !string & '	' & !temparr[!x]
			endif
		enddo
		!dtext[!val] = !string
	enddo
    !this.CurForm.list4.dtext = !dtext

	!this.instorefile(!dtext,!revnum)
endmethod

define method .instorefile(!dtext is array,!revnum is real)
    !val = !this.CurForm.getJsonIndex()
	if !val eq 0 then
		return
	endif
    if  !this.Type eq  'pipe' then
        !branname = !this.CurForm.brandatas[!val].branname
    else
        !branname = !this.CurForm.suppdatas[!val].suppname
    endif
	!file = object file(!this.path.val & !branname & 'rev.txt')
	--!file = object file(|D:\| & !branname & 'rev.txt')

	!arr = array()
	do !x indices !dtext
		!rows = !dtext[!x].split('	')
		!string = !x & ' ' & !rows[!revnum]
		!arr.append(!string)
	enddo
	!file.writefile('overwrite',!arr)
endmethod

define method .findrevindex(!dtext is array) is real
	!goodnums = array()

	do !x indices !dtext
		!rows = !dtext[!x].split('	')
        --q var !rows
		if !goodnums.unset() then
			!goodnums = !rows.indices()
            --q var !goodnums
		endif

		do !y indices !goodnums
			if !this.revs.dtext.findfirst(!rows[!goodnums[!y]]).unset() then
				!goodnums[!y].delete()
			endif
		enddo
		!goodnums.compress()
	enddo
	if !goodnums.size() eq 1 then
		return !goodnums[1]
	endif
	return 0
endmethod

