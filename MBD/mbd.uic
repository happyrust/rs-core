  <Tabs>
    <Tab Name="MBD">
      <Caption>Easy Definition</Caption>
      <ContextualTabGroup>
        <Item>None</Item>
      </ContextualTabGroup>
      <Groups>
        <Group Name="EM4">
          <Tools>
            <Tool Name="MARK PIPE" />
            <Tool Name="MARK SUPP" />
            <Tool Name="mark em4 equi" />
          </Tools>
          <Caption>EM4</Caption>
        </Group>
        <Group Name="EM9">
          <Tools>
            <Tool Name="MARK PIPE1" />
            <Tool Name="MARK PIPE SUPP" />
            <Tool Name="MARK INST SUPP" />
            <Tool Name="mark inst equi form" />
          </Tools>
          <Caption>EM9</Caption>
        </Group>
        <Group Name="CIVIL">
          <Tools>
            <Tool Name="MARK CIVIL" />
          </Tools>
          <Caption>土建结构</Caption>
        </Group>
        <Group Name="ARCH">
          <Tools>
            <Tool Name="MARK ARCH" />
          </Tools>
          <Caption>建筑</Caption>
        </Group>
        <Group Name="MBD FORMAT">
          <Tools>
            <Tool Name="set mbd format" />
            <Tool Name="recover dp label" />
          </Tools>
          <Caption>尺寸格式</Caption>
        </Group>
        <Group Name="MBD MODIFY">
          <Tools>
            <Tool Name="set mbd rev" />            
          </Tools>
          <Caption>零部件版本</Caption>
        </Group>        
        <Group Name="Aveva.GridsAndAids.Aids" LayoutDirection="Horizontal">
          <Tools>
            <Tool Name="AVEVA.Aids.CreatePoint1" LargeImage="True" ImageOnly="False" />
            <Tool Name="AVEVA.Aids.CreateLines1" LargeImage="True" />
            <Tool Name="AVEVA.Aids.CreateArcs1" LargeImage="True" />
            <Tool Name="AVEVA.Aids.CreateCircles1" LargeImage="True" />
            <Tool Name="AVEVA.Aids.CreateAidCir_Fillet1" LargeImage="True" ImageOnly="False" />
            <Tool Name="AVEVA.Aids.CreateText1" LargeImage="True" />
          </Tools>
          <Caption>手动标注辅助类型</Caption>
        </Group>
        <Group Name="Aveva.GridsAndAids.Annotation">
          <Tools>
            <Tool Name="AVEVA.Annotations.ButtonMLabel1" LargeImage="True" ImageOnly="False" />
            <Tool Name="AVEVA.Annotations.ButtonDimLin1" LargeImage="True" />
            <Tool Name="AVEVA.Annotations.ButtonDimLinAligned1" LargeImage="True" />
          </Tools>
          <Caption>手动标注和标签</Caption>
        </Group>
      </Groups>
    </Tab>
  </Tabs>
