          "pos": [1000, 0, 40],
          "expect": { "isoline": 0, "write": "insert_front" },
          "notes": "ISOADJUSTWELD ∈ insert(1) 型：插到袋首"
        },
        {
          "id": "MBD-T1",
          "objecttype": "ISOMBDANGLE",
          "name": "T1",
          "member_adir": [-1, 0, 0],
          "member_ldir": [1, 0, 0],
          "pos": [420, 0, 40],
          "expect": { "isoline": 0, "write": "insert_front" },
          "notes": "ISOMBDANGLE ∈ insert(1) 型：再插到袋首 → 多个 insert(1) 呈逆序叠放（MBD 在 ADJ 之前）"
        },
        {
          "id": "LEG-NOATTA",
          "objecttype": "ISOLEG",
          "name": "LEGX",
          "elboname": "EA",
